// fannkuch-redux (Computer Language Benchmarks Game): permutations and flips.
// set_at updates a list in place when nothing else refers to it, so after the first
// copy of each permutation the flips and rotations allocate nothing.

fn count_flips(perm1: List<Int>) -> Int do
  var perm = perm1
  var flips = 0
  if len(perm) == 0 then
    return 0
  end if
  var k = perm[0]
  while (k > 0) and (k < len(perm)) invariant len(perm) == len(perm1) do
    // Reverse perm[0..k].
    var i = 0
    var j = k
    while i < j invariant (0 <= i) and (j < len(perm)) invariant len(perm) == len(perm1) decreases j - i do
      let t = perm[i]
      set perm = set_at(list: perm, at: i, value: perm[j])
      set perm = set_at(list: perm, at: j, value: t)
      set i = i + 1
      set j = j - 1
    end while
    set flips = flips + 1
    set k = perm[0]
  end while
  return flips
end fn count_flips

fn main() uses console, proc do
  let a = args()
  var n = 7
  if len(a) > 0 then
    set n = value_or(opt: str_to_int(a[0]), default: 7)
  end if
  if (n < 1) or (n > 12) then
    panic("n must be between 1 and 12")
  end if
  var perm1: List<Int> = []
  var count: List<Int> = []
  for i in 0..n invariant len(perm1) == i invariant len(count) == i do
    set perm1 = push(list: perm1, item: i)
    set count = push(list: count, item: 0)
  end for
  var max_flips = 0
  var checksum = 0
  var perm_count = 0
  var r = n
  while true invariant len(perm1) == n invariant len(count) == n invariant (1 <= r) and (r <= n) do
    while r != 1 invariant (1 <= r) and (r <= n) invariant len(count) == n decreases r do
      set count = set_at(list: count, at: r - 1, value: r)
      set r = r - 1
    end while
    let flips = count_flips(perm1)
    if flips > max_flips then
      set max_flips = flips
    end if
    if (perm_count % 2) == 0 then
      set checksum = checksum + flips
    else
      set checksum = checksum - flips
    end if
    // The next permutation: rotate the first r + 1 elements while counts run out.
    var more = true
    while more invariant len(perm1) == n invariant len(count) == n invariant (1 <= r) and (r <= n) do
      if r == n then
        print(int_to_str(checksum) ++ "\nPfannkuchen(" ++ int_to_str(n) ++ ") = " ++ int_to_str(max_flips) ++ "\n")
        return
      end if
      let p0 = perm1[0]
      for i in 0..r invariant len(perm1) == n do
        set perm1 = set_at(list: perm1, at: i, value: perm1[i + 1])
      end for
      set perm1 = set_at(list: perm1, at: r, value: p0)
      set count = set_at(list: count, at: r, value: count[r] - 1)
      if count[r] > 0 then
        set more = false
      else
        set r = r + 1
      end if
    end while
    set perm_count = perm_count + 1
  end while
end fn main
