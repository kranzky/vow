    "  if code < 128 then\n" ++
    "    return char(code)\n" ++
    "  elif code < 2048 then\n" ++
    "    return char(192 + (code / 64)) ++ char(128 + (code % 64))\n" ++
    "  elif code < 65536 then\n" ++
    "    return (char(224 + (code / 4096)) ++ char(128 + ((code / 64) % 64))) ++ char(128 + (code % 64))\n" ++
    "  end if\n" ++
    "  let a = char(240 + (code / 262144))\n" ++
    "  let b = char(128 + ((code / 4096) % 64))\n" ++
    "  return ((a ++ b) ++ char(128 + ((code / 64) % 64))) ++ char(128 + (code % 64))\n" ++
    "end fn json_utf8\n" ++
    ""
end fn std_json
