// Shared helpers for the self-hosted compiler. Text utilities come from the
// standard library.

import "std/text.vow"

struct Pos
  file: Int,
  line: Int,
  col: Int,
end struct Pos

struct Diag
  pos: Pos,
  kind: String,
  msg: String,
  notes: List<String>,
end struct Diag

fn no_pos() -> Pos do
  return Pos(file: 0, line: 0, col: 0)
end fn no_pos

fn diag(pos: Pos, msg: String) -> Diag do
  return Diag(pos: pos, kind: "error", msg: msg, notes: [])
end fn diag

fn with_note(d: Diag, note: String) -> Diag do
  return d with (notes: push(list: d.notes, item: note))
end fn with_note

fn contains_str(xs: List<String>, x: String) -> Bool
  ensures result == (exists i in 0..len(xs): xs[i] == x)
do
  for i in 0..len(xs) invariant forall j in 0..i: xs[j] != x do
    if xs[i] == x then
      return true
    end if
  end for
  return false
end fn contains_str

fn index_of_str(xs: List<String>, x: String) -> Int
  ensures (-1 <= result) and (result < len(xs))
  ensures (result >= 0) implies (xs[result] == x)
  ensures (result == -1) implies (forall i in 0..len(xs): xs[i] != x)
do
  for i in 0..len(xs) invariant forall j in 0..i: xs[j] != x do
    if xs[i] == x then
      return i
    end if
  end for
  return -1
end fn index_of_str

fn int_list_contains(xs: List<Int>, x: Int) -> Bool
  ensures result == (exists i in 0..len(xs): xs[i] == x)
do
  for i in 0..len(xs) invariant forall j in 0..i: xs[j] != x do
    if xs[i] == x then
      return true
    end if
  end for
  return false
end fn int_list_contains

fn pop_strings(xs: List<String>) -> List<String> do
  if len(xs) == 0 then
    return xs
  end if
  return slice(of: xs, from: 0, to: len(xs) - 1)
end fn pop_strings

fn hex_digit(n: Int where (0 <= it) and (it < 16)) -> String do
  return slice(of: "0123456789abcdef", from: n, to: n + 1)
end fn hex_digit

fn octal3(b: Int where (0 <= it) and (it < 256)) -> String do
  let d0 = b / 64
  let d1 = (b / 8) % 8
  let d2 = b % 8
  return char('0' + d0) ++ char('0' + d1) ++ char('0' + d2)
end fn octal3

// A decimal value as digits D, without leading or trailing zeros ("" for zero), and an
// exponent E: the value is D * 10^E.
struct Decimal
  digits: String,
  exp: Int,
end struct Decimal

fn decimal_of(text: String) -> Decimal do
  var mant = text
  var e = 0
  let cut = find_byte(s: text, c: 'e', from: 0)
  var cut2 = find_byte(s: text, c: 'E', from: 0)
  var at = cut
  if (at < 0) or ((cut2 >= 0) and (cut2 < at)) then
    set at = cut2
  end if
  if (at >= 0) and (at < len(text)) then
    set mant = slice(of: text, from: 0, to: at)
    var digits = slice(of: text, from: at + 1, to: len(text))
    var neg = false
    if starts_with(s: digits, p: "-") or starts_with(s: digits, p: "+") then
      set neg = starts_with(s: digits, p: "-")
      set digits = slice(of: digits, from: 1, to: len(digits))
    end if
    // The exponent's value, not its length: leading zeros don't count. One beyond 18
    // digits is capped at 10^18, which keeps the value far outside the range of doubles
    // (no source file has 10^17 mantissa digits), where it is only ordered non-strictly.
    var z = 0
    while (z < len(digits)) and (digits[z] == '0') invariant (0 <= z) and (z <= len(digits)) do
      set z = z + 1
    end while
    set digits = slice(of: digits, from: z, to: len(digits))
    if len(digits) > 18 then
      set e = 1000000000000000000
    else
      set e = value_or(opt: str_to_int(digits), default: 0)
    end if
    if neg then
      set e = -e
    end if
  end if
  var parts: List<String> = []
  var frac = 0
  var point = false
  for i in 0..len(mant) do
    let ch = mant[i]
    if ch == '.' then
      set point = true
    elif is_digit(ch) then
      set parts = push(list: parts, item: char(ch))
      if point then
        set frac = frac + 1
      end if
    end if
  end for
  var ds = join(parts: parts, sep: "")
  var exp = e - frac
  var a = 0
  while (a < len(ds)) and (ds[a] == '0') invariant (0 <= a) and (a <= len(ds)) do
    set a = a + 1
  end while
  set ds = slice(of: ds, from: a, to: len(ds))
  if len(ds) == 0 then
    return Decimal(digits: "", exp: 0)
  end if
  var b = len(ds)
  while (b > 0) and (ds[b - 1] == '0') invariant (0 <= b) and (b <= len(ds)) do
    set b = b - 1
    set exp = exp + 1
  end while
  return Decimal(digits: slice(of: ds, from: 0, to: b), exp: exp)
end fn decimal_of

// True if the digits a, read as the fraction 0.a, are at least 0.b. Neither ends in a
// zero.
fn digits_at_least(a: String, b: String) -> Bool do
  var i = 0
  while (i < len(a)) and (i < len(b)) invariant i >= 0 do
    if a[i] != b[i] then
      return a[i] > b[i]
    end if
    set i = i + 1
  end while
  return len(a) >= len(b)
end fn digits_at_least

// Whether a Float can hold the value of a Float literal: "" if so, "large" if it would
// be infinity, and "small" if it is not zero but would be 0.0. The largest Float is
// 1.7976931348623157e308; a value below half the smallest one above zero (which is
// 4.9406564584124654e-324) is rounded to zero. Both bounds are a digit in the last
// place on the safe side.
fn float_literal_range(text: String) -> String do
  let d = decimal_of(text)
  if len(d.digits) == 0 then
    return ""
  end if
  let mag = (len(d.digits) - 1) + d.exp
  if (mag > 308) or ((mag == 308) and digits_at_least(a: d.digits, b: "17976931348623158")) then
    return "large"
  end if
  if (mag < -324) or ((mag == -324) and (not digits_at_least(a: d.digits, b: "24703282292062328"))) then
    return "small"
  end if
  return ""
end fn float_literal_range

// True if s has a UTF-8 continuation byte at i that is between lo and hi.
fn utf8_tail(s: String, i: Int, lo: Int, hi: Int) -> Bool
  ensures result implies ((0 <= i) and (i < len(s)))
do
  if (i < 0) or (i >= len(s)) then
    return false
  end if
  return (s[i] >= lo) and (s[i] <= hi)
end fn utf8_tail

// The number of bytes in the UTF-8 character that starts at s[at]: 1 to 4, or 0 if
// the bytes there are not well-formed UTF-8 (a stray continuation byte, a sequence
// that is cut short or longer than it need be, a surrogate, or a value past U+10FFFF).
fn utf8_len(s: String, at: Int) -> Int
  requires (0 <= at) and (at < len(s))
  ensures (0 <= result) and ((at + result) <= len(s))
do
  let c = s[at]
  if c < 128 then
    return 1
  end if
  if (c >= 194) and (c <= 223) then
    if utf8_tail(s: s, i: at + 1, lo: 128, hi: 191) then
      return 2
    end if
    return 0
  end if
  if (c >= 224) and (c <= 239) then
    var lo = 128
    var hi = 191
    if c == 224 then
      set lo = 160
    elif c == 237 then
      set hi = 159
    end if
    if utf8_tail(s: s, i: at + 1, lo: lo, hi: hi) and utf8_tail(s: s, i: at + 2, lo: 128, hi: 191) then
      return 3
    end if
    return 0
  end if
  if (c >= 240) and (c <= 244) then
    var lo4 = 128
    var hi4 = 191
    if c == 240 then
      set lo4 = 144
    elif c == 244 then
      set hi4 = 143
    end if
    if utf8_tail(s: s, i: at + 1, lo: lo4, hi: hi4) and utf8_tail(s: s, i: at + 2, lo: 128, hi: 191) and utf8_tail(s: s, i: at + 3, lo: 128, hi: 191) then
      return 4
    end if
    return 0
  end if
  return 0
end fn utf8_len

fn out_edges(edges: Map<String, List<String>>, n: String) -> List<String> do
  match lookup(map: edges, key: n)
  case Some(value: es) then
    return es
  case None then
    let none: List<String> = []
    return none
  end match
end fn out_edges

// The strongly connected components (Kosaraju): each name's component number.
fn components(names: List<String>, edges: Map<String, List<String>>) -> Map<String, Int> do
  // Pass 1: the order in which depth-first searches finish.
  var visited: Map<String, Bool> = {}
  var order: List<String> = []
  for root in names do
    if has(map: visited, key: root) then
      continue
    end if
    set visited = insert(map: visited, key: root, value: true)
    var stack = [root]
    var pos = [0]
    while len(stack) > 0 invariant len(pos) == len(stack) do
      let k = len(stack) - 1
      let n = stack[k]
      let es = out_edges(edges: edges, n: n)
      let p = pos[k]
      if (p >= 0) and (p < len(es)) then
        set pos = set_at(list: pos, at: k, value: p + 1)
        let m = es[p]
        if not has(map: visited, key: m) then
          set visited = insert(map: visited, key: m, value: true)
          set stack = push(list: stack, item: m)
          set pos = push(list: pos, item: 0)
        end if
      else
        set order = push(list: order, item: n)
        set stack = slice(of: stack, from: 0, to: k)
        set pos = slice(of: pos, from: 0, to: k)
      end if
    end while
  end for
  // Pass 2: search the reversed graph in reverse finishing order.
  var rev: Map<String, List<String>> = {}
  for n in names do
    for m in out_edges(edges: edges, n: n) do
      set rev = insert(map: rev, key: m, value: push(list: out_edges(edges: rev, n: m), item: n))
    end for
  end for
  var comp: Map<String, Int> = {}
  var next = 0
  var i = len(order)
  while i > 0 invariant i <= len(order) do
    set i = i - 1
    let root = order[i]
    if has(map: comp, key: root) then
      continue
    end if
    set comp = insert(map: comp, key: root, value: next)
    var stack = [root]
    while len(stack) > 0 do
      let n = stack[len(stack) - 1]
      set stack = slice(of: stack, from: 0, to: len(stack) - 1)
      for m in out_edges(edges: rev, n: n) do
        if not has(map: comp, key: m) then
          set comp = insert(map: comp, key: m, value: next)
          set stack = push(list: stack, item: m)
        end if
      end for
    end while
    set next = next + 1
  end while
  return comp
end fn components

// The names that can reach themselves along the edges: those in a component of more
// than one name, and those with an edge to themselves.
fn on_cycles(names: List<String>, edges: Map<String, List<String>>) -> Map<String, Bool> do
  let comp = components(names: names, edges: edges)
  var size: Map<Int, Int> = {}
  for n in names do
    let k = value_or(opt: lookup(map: comp, key: n), default: -1)
    set size = insert(map: size, key: k, value: value_or(opt: lookup(map: size, key: k), default: 0) + 1)
  end for
  var out: Map<String, Bool> = {}
  for n in names do
    let k = value_or(opt: lookup(map: comp, key: n), default: -1)
    if (value_or(opt: lookup(map: size, key: k), default: 0) > 1) or contains_str(xs: out_edges(edges: edges, n: n), x: n) then
      set out = insert(map: out, key: n, value: true)
    end if
  end for
  return out
end fn on_cycles

// A new directory for temporary files, or "" if none can be made.
fn make_temp_dir() -> String uses proc do
  let o = run(argv: ["mktemp", "-d"], input: "")
  if o.code != 0 then
    return ""
  end if
  return trim(o.out)
end fn make_temp_dir

// "a", "a and b", "a, b and c".
fn list_and(xs: List<String>) -> String do
  if len(xs) < 2 then
    return join(parts: xs, sep: "")
  end if
  return join(parts: slice(of: xs, from: 0, to: len(xs) - 1), sep: ", ") ++ " and " ++ xs[len(xs) - 1]
end fn list_and
