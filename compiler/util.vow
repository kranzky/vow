// Shared helpers for the self-hosted compiler.

struct Pos
  file: Int,
  line: Int,
  col: Int,
end struct Pos

struct Diag
  pos: Pos,
  kind: String,
  msg: String,
  notes: List<String>,
end struct Diag

fn no_pos() -> Pos do
  return Pos(file: 0, line: 0, col: 0)
end fn no_pos

fn diag(pos: Pos, msg: String) -> Diag do
  return Diag(pos: pos, kind: "error", msg: msg, notes: [])
end fn diag

fn with_note(d: Diag, note: String) -> Diag do
  return d with (notes: push(list: d.notes, item: note))
end fn with_note

fn is_digit(c: Int) -> Bool do
  return (c >= '0') and (c <= '9')
end fn is_digit

fn is_alpha(c: Int) -> Bool do
  return ((c >= 'a') and (c <= 'z')) or ((c >= 'A') and (c <= 'Z')) or (c == '_')
end fn is_alpha

fn is_alnum(c: Int) -> Bool do
  return is_alpha(c) or is_digit(c)
end fn is_alnum

fn is_space(c: Int) -> Bool do
  return (c == ' ') or (c == '\t') or (c == '\r') or (c == '\n')
end fn is_space

// True if `p` occurs in `s` starting at byte `at`.
fn starts_at(s: String, at: Int where it >= 0, p: String) -> Bool do
  if (at + len(p)) > len(s) then
    return false
  end if
  for k in 0..len(p) do
    if s[at + k] != p[k] then
      return false
    end if
  end for
  return true
end fn starts_at

fn starts_with(s: String, p: String) -> Bool do
  return starts_at(s: s, at: 0, p: p)
end fn starts_with

fn ends_with(s: String, p: String) -> Bool do
  if len(p) > len(s) then
    return false
  end if
  return starts_at(s: s, at: len(s) - len(p), p: p)
end fn ends_with

fn contains_str(xs: List<String>, x: String) -> Bool do
  for y in xs do
    if y == x then
      return true
    end if
  end for
  return false
end fn contains_str

fn index_of_str(xs: List<String>, x: String) -> Int
  ensures result >= -1
  ensures result < len(xs)
do
  for i in 0..len(xs) do
    if xs[i] == x then
      return i
    end if
  end for
  return -1
end fn index_of_str

fn find_byte(s: String, c: Int) -> Int
  ensures result >= -1
  ensures result < len(s)
do
  for i in 0..len(s) do
    if s[i] == c then
      return i
    end if
  end for
  return -1
end fn find_byte

fn find_last_byte(s: String, c: Int) -> Int
  ensures result >= -1
  ensures result < len(s)
do
  var i = len(s) - 1
  while i >= 0 invariant i < len(s) do
    if s[i] == c then
      return i
    end if
    set i = i - 1
  end while
  return -1
end fn find_last_byte

fn find_sub(s: String, p: String) -> Int
  ensures result >= -1
do
  var i = 0
  while (i + len(p)) <= len(s) invariant i >= 0 do
    if starts_at(s: s, at: i, p: p) then
      return i
    end if
    set i = i + 1
  end while
  return -1
end fn find_sub

fn repeat(s: String, n: Int) -> String do
  var parts: List<String> = []
  for i in 0..n do
    set parts = push(list: parts, item: s)
  end for
  return join(parts: parts, sep: "")
end fn repeat

fn split(s: String, sep: Int) -> List<String> do
  var out: List<String> = []
  var start = 0
  for i in 0..len(s) invariant (0 <= start) and (start <= len(s)) do
    if s[i] == sep then
      if start <= i then
        set out = push(list: out, item: slice(of: s, from: start, to: i))
      end if
      set start = i + 1
    end if
  end for
  if start <= len(s) then
    set out = push(list: out, item: slice(of: s, from: start, to: len(s)))
  end if
  return out
end fn split

fn trim(s: String) -> String do
  var a = 0
  var b = len(s)
  while (a < b) and is_space(s[a]) invariant 0 <= a invariant a <= b invariant b <= len(s) do
    set a = a + 1
  end while
  while (b > a) and is_space(s[b - 1]) invariant 0 <= a invariant a <= b invariant b <= len(s) do
    set b = b - 1
  end while
  if a > b then
    return ""
  end if
  return slice(of: s, from: a, to: b)
end fn trim

fn int_list_contains(xs: List<Int>, x: Int) -> Bool do
  for y in xs do
    if y == x then
      return true
    end if
  end for
  return false
end fn int_list_contains

fn pop_strings(xs: List<String>) -> List<String> do
  if len(xs) == 0 then
    return xs
  end if
  return slice(of: xs, from: 0, to: len(xs) - 1)
end fn pop_strings

fn hex_digit(n: Int where (0 <= it) and (it < 16)) -> String do
  return slice(of: "0123456789abcdef", from: n, to: n + 1)
end fn hex_digit

fn octal3(b: Int where (0 <= it) and (it < 256)) -> String do
  let d0 = b / 64
  let d1 = (b / 8) % 8
  let d2 = b % 8
  return char('0' + d0) ++ char('0' + d1) ++ char('0' + d2)
end fn octal3
