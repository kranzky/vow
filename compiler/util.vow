// Shared helpers for the self-hosted compiler. Text utilities come from the
// standard library.

import "std/text.vow"

struct Pos
  file: Int,
  line: Int,
  col: Int,
end struct Pos

struct Diag
  pos: Pos,
  kind: String,
  msg: String,
  notes: List<String>,
end struct Diag

fn no_pos() -> Pos do
  return Pos(file: 0, line: 0, col: 0)
end fn no_pos

fn diag(pos: Pos, msg: String) -> Diag do
  return Diag(pos: pos, kind: "error", msg: msg, notes: [])
end fn diag

fn with_note(d: Diag, note: String) -> Diag do
  return d with (notes: push(list: d.notes, item: note))
end fn with_note

fn contains_str(xs: List<String>, x: String) -> Bool
  ensures result == (exists i in 0..len(xs): xs[i] == x)
do
  for i in 0..len(xs) invariant forall j in 0..i: xs[j] != x do
    if xs[i] == x then
      return true
    end if
  end for
  return false
end fn contains_str

fn index_of_str(xs: List<String>, x: String) -> Int
  ensures (-1 <= result) and (result < len(xs))
  ensures (result >= 0) implies (xs[result] == x)
  ensures (result == -1) implies (forall i in 0..len(xs): xs[i] != x)
do
  for i in 0..len(xs) invariant forall j in 0..i: xs[j] != x do
    if xs[i] == x then
      return i
    end if
  end for
  return -1
end fn index_of_str

fn int_list_contains(xs: List<Int>, x: Int) -> Bool
  ensures result == (exists i in 0..len(xs): xs[i] == x)
do
  for i in 0..len(xs) invariant forall j in 0..i: xs[j] != x do
    if xs[i] == x then
      return true
    end if
  end for
  return false
end fn int_list_contains

fn pop_strings(xs: List<String>) -> List<String> do
  if len(xs) == 0 then
    return xs
  end if
  return slice(of: xs, from: 0, to: len(xs) - 1)
end fn pop_strings

fn hex_digit(n: Int where (0 <= it) and (it < 16)) -> String do
  return slice(of: "0123456789abcdef", from: n, to: n + 1)
end fn hex_digit

fn octal3(b: Int where (0 <= it) and (it < 256)) -> String do
  let d0 = b / 64
  let d1 = (b / 8) % 8
  let d2 = b % 8
  return char('0' + d0) ++ char('0' + d1) ++ char('0' + d2)
end fn octal3
