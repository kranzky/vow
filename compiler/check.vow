// Type and effect checker. Records each expression's type and each call's resolution
// in side tables keyed by expression id, for the verifier and code generator.

import "ast.vow"

enum Ty
  TInt,
  // A 64-bit IEEE double.
  TFloat,
  TBool,
  TStr,
  TUnit,
  TList(elem: Ty),
  TMap(key: Ty, val: Ty),
  THashMap(key: Ty, val: Ty),
  TOpt(inner: Ty),
  TStruct(name: String),
  TEnum(name: String),
  // A type parameter, inside the generic declaration that declares it: a type about
  // which nothing is known.
  TParam(name: String),
  TUnknown,
end enum Ty

fn ty_show(t: Ty) -> String do
  match t
  case TInt then
    return "Int"
  case TFloat then
    return "Float"
  case TBool then
    return "Bool"
  case TStr then
    return "String"
  case TUnit then
    return "Unit"
  case TList(elem: e) then
    return "List<" ++ ty_show(e) ++ ">"
  case TMap(key: k, val: v) then
    return "Map<" ++ ty_show(k) ++ ", " ++ ty_show(v) ++ ">"
  case THashMap(key: k, val: v) then
    return "HashMap<" ++ ty_show(k) ++ ", " ++ ty_show(v) ++ ">"
  case TOpt(inner: x) then
    return "Option<" ++ ty_show(x) ++ ">"
  case TStruct(name: n) then
    return n
  case TEnum(name: n) then
    return n
  case TParam(name: n) then
    return n
  case TUnknown then
    return "?"
  end match
end fn ty_show

fn ty_eq(a: Ty, b: Ty) -> Bool do
  return ty_show(a) == ty_show(b)
end fn ty_eq

fn is_unknown(t: Ty) -> Bool do
  return ty_show(t) == "?"
end fn is_unknown

fn compatible(got: Ty, want: Ty) -> Bool do
  return ty_eq(a: got, b: want) or is_unknown(got) or is_unknown(want)
end fn compatible

// A type with its refinements: preds, of the value ('it'), and args, of the values
// inside it, one for each type argument of a List, an Option or an instance of a
// generic type (empty when none of them is refined). List<Int where it >= 0> is a
// List<Int> each of whose elements satisfies it >= 0; Box<Nat> a Box<Int> whose fields
// of type T are Nats (struct_field_refs).
struct RTy
  ty: Ty,
  preds: List<Expr>,
  args: List<RTy>,
end struct RTy

fn plain(t: Ty) -> RTy do
  return RTy(ty: t, preds: [], args: [])
end fn plain

// Whether a type says nothing beyond its Ty.
fn is_plain(r: RTy) -> Bool do
  return (len(r.preds) == 0) and (len(r.args) == 0)
end fn is_plain

struct FieldInfo
  name: String,
  rty: RTy,
end struct FieldInfo

struct VariantInfo
  name: String,
  fields: List<FieldInfo>,
end struct VariantInfo

struct FnInfo
  name: String,
  params: List<FieldInfo>,
  io: List<Bool>,
  ret: RTy,
  effects: List<String>,
  pre: List<Expr>,
  post: List<Expr>,
  dec: Option<Expr>,
  // For a pure, non-recursive function whose whole body is 'return e': that e.
  // Such a function may be used in specifications, where it is inlined.
  inline: Option<Expr>,
  // For any other specification function (see compute_inline): its body, and whether
  // it is recursive.
  spec_body: Option<List<Stmt>>,
  spec_rec: Bool,
  pos: Pos,
end struct FnInfo

// kind is "builtin", "user", "struct" or "variant"; for a variant, name is the enum
// ("Option" for the built-in) and variant is its index. order[i] is the index of the
// argument supplying parameter i.
struct CallInfo
  kind: String,
  name: String,
  variant: Int,
  order: List<Int>,
end struct CallInfo

struct NamedTy
  name: String,
  ty: Ty,
end struct NamedTy

struct HoleInfo
  id: Int,
  pos: Pos,
  name: String,
  expected: Ty,
  locals: List<NamedTy>,
end struct HoleInfo

// Generic declarations are kept as written (gfns, gstructs, genums). Each use with
// particular type arguments creates an instance, named like "Pair<Int, String>", whose
// fields or signature are entered in structs, enums or fns like any other.
struct Info
  structs: Map<String, List<FieldInfo>>,
  enums: Map<String, List<VariantInfo>>,
  aliases: Map<String, RTy>,
  fns: Map<String, FnInfo>,
  types: Map<Int, Ty>,
  calls: Map<Int, CallInfo>,
  holes: List<HoleInfo>,
  gfns: Map<String, FnDecl>,
  gstructs: Map<String, StructDecl>,
  genums: Map<String, EnumDecl>,
  // The type parameters in scope while resolving types.
  tenv: Map<String, Ty>,
  // The type arguments of each instance of a generic type.
  inst_args: Map<String, List<Ty>>,
  // The generic function each function instance was made from.
  origins: Map<String, String>,
  // Instances of generic types whose field refinements have not been checked yet.
  pending: List<String>,
  // Instances of generic functions with concrete types: checked, and compiled.
  instances: List<FnDecl>,
  next_id: Int,
  // Each function's group of mutually recursive functions (see total.vow), and the
  // functions that can call themselves.
  scc: Map<String, Int>,
  recursive: Map<String, Bool>,
  // Whether any measure is structural (not an Int).
  structural: Bool,
  // Why a function a specification reaches cannot be used there, when that is not
  // evident from its body.
  spec_notes: Map<String, String>,
end struct Info

// ---- built-in functions ----

fn builtin_params(name: String) -> Option<List<String>> do
  match name
  case "len" then
    return Option.Some(value: ["x"])
  case "value_or" then
    return Option.Some(value: ["opt", "default"])
  case "is_some" then
    return Option.Some(value: ["x"])
  case "is_none" then
    return Option.Some(value: ["x"])
  case "push" then
    return Option.Some(value: ["list", "item"])
  case "set_at" then
    return Option.Some(value: ["list", "at", "value"])
  case "slice" then
    return Option.Some(value: ["of", "from", "to"])
  case "join" then
    return Option.Some(value: ["parts", "sep"])
  case "int_to_str" then
    return Option.Some(value: ["n"])
  case "str_to_int" then
    return Option.Some(value: ["s"])
  case "char" then
    return Option.Some(value: ["code"])
  case "insert" then
    return Option.Some(value: ["map", "key", "value"])
  case "lookup" then
    return Option.Some(value: ["map", "key"])
  case "has" then
    return Option.Some(value: ["map", "key"])
  case "keys" then
    return Option.Some(value: ["map"])
  case "hash" then
    return Option.Some(value: ["s"])
  case "panic" then
    return Option.Some(value: ["msg"])
  case "print" then
    return Option.Some(value: ["s"])
  case "eprint" then
    return Option.Some(value: ["s"])
  case "read_file" then
    return Option.Some(value: ["path"])
  case "write_file" then
    return Option.Some(value: ["path", "contents"])
  case "args" then
    let none: List<String> = []
    return Option.Some(value: none)
  case "make_dir" then
    return Option.Some(value: ["path"])
  case "list_dir" then
    return Option.Some(value: ["path"])
  case "getenv" then
    return Option.Some(value: ["name"])
  case "run" then
    return Option.Some(value: ["argv", "input"])
  case "exit" then
    return Option.Some(value: ["code"])
  case "read_line" then
    let none: List<String> = []
    return Option.Some(value: none)
  case "read_bytes" then
    return Option.Some(value: ["n"])
  case "int_to_float" then
    return Option.Some(value: ["n"])
  case "str_to_float" then
    return Option.Some(value: ["s"])
  case "float_to_fixed" then
    return Option.Some(value: ["x", "digits"])
  else
    if contains_str(xs: float_unary_builtins(), x: name) then
      return Option.Some(value: ["x"])
    end if
    return Option.None
  end match
end fn builtin_params

// The built-ins that take one Float.
fn float_unary_builtins() -> List<String> do
  return ["float_to_int", "float_to_str", "floor", "ceil", "round", "sqrt", "abs_float", "is_nan"]
end fn float_unary_builtins

fn is_builtin(name: String) -> Bool do
  if name == "old" then
    return true
  end if
  match builtin_params(name)
  case Some(value: p) then
    return true
  case None then
    return false
  end match
end fn is_builtin

fn builtin_effect(name: String) -> String do
  if (name == "print") or (name == "eprint") or (name == "read_line") or (name == "read_bytes") then
    return "console"
  elif (name == "read_file") or (name == "write_file") or (name == "make_dir") or (name == "list_dir") then
    return "fs"
  elif (name == "args") or (name == "getenv") or (name == "run") or (name == "exit") then
    return "proc"
  end if
  return ""
end fn builtin_effect

// Built-ins that may appear in specifications.
fn spec_builtin(name: String) -> Bool do
  return contains_str(xs: ["len", "value_or", "is_some", "is_none", "is_nan", "int_to_float"], x: name)
end fn spec_builtin

fn builtin_noreturn(name: String) -> Bool do
  return (name == "panic") or (name == "exit")
end fn builtin_noreturn

// ---- lookups ----

fn struct_fields(info: Info, name: String) -> List<FieldInfo> do
  match lookup(map: info.structs, key: name)
  case Some(value: fs) then
    return fs
  case None then
    let none: List<FieldInfo> = []
    return none
  end match
end fn struct_fields

fn find_field(fields: List<FieldInfo>, name: String) -> Int
  ensures result >= -1
  ensures result < len(fields)
do
  for i in 0..len(fields) do
    if fields[i].name == name then
      return i
    end if
  end for
  return -1
end fn find_field

fn find_variant(vs: List<VariantInfo>, name: String) -> Int
  ensures result >= -1
  ensures result < len(vs)
do
  for i in 0..len(vs) do
    if vs[i].name == name then
      return i
    end if
  end for
  return -1
end fn find_variant

fn get_fn(info: Info, name: String) -> Option<FnInfo> do
  return lookup(map: info.fns, key: name)
end fn get_fn

// The variants of an enum-like type, with field types instantiated.
fn variants_of(info: Info, t: Ty) -> Option<List<VariantInfo>> do
  match t
  case TOpt(inner: x) then
    let none = VariantInfo(name: "None", fields: [])
    let some = VariantInfo(name: "Some", fields: [FieldInfo(name: "value", rty: plain(x))])
    return Option.Some(value: [none, some])
  case TEnum(name: n) then
    return lookup(map: info.enums, key: n)
  else
    return Option.None
  end match
end fn variants_of

// The first map type inside t, which stops values of t being compared with '=='; ""
// when they can be. seen holds the struct and enum names already being looked at.
fn eq_blocker(info: Info, t: Ty, seen: inout List<String>) -> String do
  match t
  case TMap(key: k, val: x) then
    return ty_show(t)
  case THashMap(key: k, val: x) then
    return ty_show(t)
  case TList(elem: x) then
    return eq_blocker(info: info, t: x, seen: inout seen)
  case TOpt(inner: x) then
    return eq_blocker(info: info, t: x, seen: inout seen)
  case TStruct(name: n) then
    if contains_str(xs: seen, x: n) then
      return ""
    end if
    set seen = push(list: seen, item: n)
    for f in struct_fields(info: info, name: n) do
      let b = eq_blocker(info: info, t: f.rty.ty, seen: inout seen)
      if len(b) > 0 then
        return b
      end if
    end for
    return ""
  case TEnum(name: n) then
    if contains_str(xs: seen, x: n) then
      return ""
    end if
    set seen = push(list: seen, item: n)
    match lookup(map: info.enums, key: n)
    case Some(value: vs) then
      for vi in vs do
        for f in vi.fields do
          let b = eq_blocker(info: info, t: f.rty.ty, seen: inout seen)
          if len(b) > 0 then
            return b
          end if
        end for
      end for
    case None then
    end match
    return ""
  else
    return ""
  end match
end fn eq_blocker

// Whether values of t can hold a Float (and so a NaN, which is not equal to itself).
fn contains_float(info: Info, t: Ty) -> Bool do
  var seen: List<String> = []
  return has_float(info: info, t: t, seen: inout seen)
end fn contains_float

fn has_float(info: Info, t: Ty, seen: inout List<String>) -> Bool do
  match t
  case TFloat then
    return true
  case TList(elem: x) then
    return has_float(info: info, t: x, seen: inout seen)
  case TOpt(inner: x) then
    return has_float(info: info, t: x, seen: inout seen)
  case TStruct(name: n) then
    if contains_str(xs: seen, x: n) then
      return false
    end if
    set seen = push(list: seen, item: n)
    for f in struct_fields(info: info, name: n) do
      if has_float(info: info, t: f.rty.ty, seen: inout seen) then
        return true
      end if
    end for
    return false
  case TEnum(name: n) then
    if contains_str(xs: seen, x: n) then
      return false
    end if
    set seen = push(list: seen, item: n)
    match lookup(map: info.enums, key: n)
    case Some(value: vs) then
      for vi in vs do
        for f in vi.fields do
          if has_float(info: info, t: f.rty.ty, seen: inout seen) then
            return true
          end if
        end for
      end for
    case None then
    end match
    return false
  case TParam(name: n) then
    // A type parameter may stand for Float.
    return true
  else
    return false
  end match
end fn has_float

// Int, Bool, Unit and String are compared directly; other types structurally.
fn simple_eq(t: Ty) -> Bool do
  match t
  case TInt then
    return true
  case TFloat then
    return true
  case TBool then
    return true
  case TUnit then
    return true
  case TStr then
    return true
  case TUnknown then
    return true
  else
    return false
  end match
end fn simple_eq

// A variant whose fields are all Unit (such as Ok in Result<Unit, E>) can be written
// without them: Result.Ok.
fn all_unit(fields: List<FieldInfo>) -> Bool do
  for f in fields do
    if ty_show(f.rty.ty) != "Unit" then
      return false
    end if
  end for
  return true
end fn all_unit

fn type_of(info: Info, e: Expr) -> Ty do
  match lookup(map: info.types, key: e.id)
  case Some(value: t) then
    return t
  case None then
    return Ty.TUnknown
  end match
end fn type_of

fn call_info(info: Info, e: Expr) -> Option<CallInfo> do
  return lookup(map: info.calls, key: e.id)
end fn call_info

// ---- type resolution ----

fn resolve_type(info: inout Info, te: TypeExpr, errs: inout List<Diag>) -> RTy do
  var base = plain(Ty.TUnknown)
  let n = len(te.args)
  let msg = "'" ++ te.name ++ "' takes "
  var is_param = false
  match lookup(map: info.tenv, key: te.name)
  case Some(value: pt) then
    set is_param = true
    if n != 0 then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: "type parameter " ++ msg ++ "no type arguments"))
    end if
    set base = plain(pt)
  case None then
  end match
  if is_param then
  elif (te.name == "Int") or (te.name == "Float") or (te.name == "Bool") or (te.name == "String") or (te.name == "Unit") or (te.name == "Output") then
    if n != 0 then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ "0 type argument(s), got " ++ int_to_str(n)))
    end if
    match te.name
    case "Int" then
      set base = plain(Ty.TInt)
    case "Float" then
      set base = plain(Ty.TFloat)
    case "Bool" then
      set base = plain(Ty.TBool)
    case "String" then
      set base = plain(Ty.TStr)
    case "Unit" then
      set base = plain(Ty.TUnit)
    else
      set base = plain(Ty.TStruct(name: "Output"))
    end match
  elif (te.name == "List") or (te.name == "Option") then
    if n != 1 then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ "1 type argument(s), got " ++ int_to_str(n)))
    else
      // The element type may be refined (List<Nat>): checked where a value is stored,
      // assumed where it is read, like a refinement of the value itself.
      let a = resolve_type(info: inout info, te: te.args[0], errs: inout errs)
      var inner: List<RTy> = []
      if not is_plain(a) then
        set inner = [a]
      end if
      if te.name == "List" then
        set base = RTy(ty: Ty.TList(elem: a.ty), preds: [], args: inner)
      else
        set base = RTy(ty: Ty.TOpt(inner: a.ty), preds: [], args: inner)
      end if
    end if
  elif (te.name == "Map") or (te.name == "HashMap") then
    if n != 2 then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ "2 type argument(s), got " ++ int_to_str(n)))
    else
      let k = resolve_arg(info: inout info, te: te.args[0], errs: inout errs)
      let v = resolve_arg(info: inout info, te: te.args[1], errs: inout errs)
      let ks = ty_show(k)
      // A type parameter may be a key; each instance checks its own key type.
      if (ks != "Int") and (ks != "String") and (ks != "?") and not is_tparam(k) then
        set errs = push(list: errs, item: diag(pos: te.args[0].pos, msg: "map keys must be Int or String"))
      end if
      if te.name == "Map" then
        set base = plain(Ty.TMap(key: k, val: v))
      else
        set base = plain(Ty.THashMap(key: k, val: v))
      end if
    end if
  elif has(map: info.gstructs, key: te.name) or has(map: info.genums, key: te.name) then
    let want = len(generic_tparams(info: info, name: te.name))
    if n != want then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ int_to_str(want) ++ " type argument(s), got " ++ int_to_str(n)))
    else
      // A type argument may be refined (Result<Nat, String>): its fields of that type
      // parameter are then refined too (inst_field_refs).
      var targs: List<Ty> = []
      var rargs: List<RTy> = []
      var refined = false
      for a in te.args do
        let ra = resolve_type(info: inout info, te: a, errs: inout errs)
        set targs = push(list: targs, item: ra.ty)
        set rargs = push(list: rargs, item: ra)
        if not is_plain(ra) then
          set refined = true
        end if
      end for
      let inst = instantiate_type(info: inout info, name: te.name, args: targs, pos: te.pos, errs: inout errs)
      if refined then
        set base = RTy(ty: inst, preds: [], args: rargs)
      else
        set base = plain(inst)
      end if
    end if
  elif has(map: info.structs, key: te.name) then
    if n != 0 then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ "0 type argument(s), got " ++ int_to_str(n)))
    end if
    set base = plain(Ty.TStruct(name: te.name))
  elif has(map: info.enums, key: te.name) then
    if n != 0 then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ "0 type argument(s), got " ++ int_to_str(n)))
    end if
    set base = plain(Ty.TEnum(name: te.name))
  else
    match lookup(map: info.aliases, key: te.name)
    case Some(value: a) then
      if n != 0 then
        set errs = push(list: errs, item: diag(pos: te.pos, msg: msg ++ "0 type argument(s), got " ++ int_to_str(n)))
      end if
      set base = a
    case None then
      set errs = push(list: errs, item: diag(pos: te.pos, msg: "unknown type '" ++ te.name ++ "'"))
    end match
  end if
  match te.refine
  case Some(value: r) then
    set base = base with (preds: push(list: base.preds, item: r))
  case None then
  end match
  return base
end fn resolve_type

// The refinements of the fields of an instance of a generic struct whose type arguments
// are refined as args (Box<Nat>: its fields of type T are Nats), field by field: each
// field's declared type with each type parameter replaced by its argument's refinement.
fn struct_field_refs(info: Info, name: String, args: List<RTy>) -> List<RTy> do
  var out: List<RTy> = []
  let fields = struct_fields(info: info, name: name)
  match lookup(map: info.gstructs, key: generic_base(name))
  case Some(value: s) then
    for i in 0..len(fields) do
      if i < len(s.fields) then
        set out = push(list: out, item: refine_like(info: info, t: fields[i].rty.ty, te: s.fields[i].ty, tps: s.tparams, args: args))
      end if
    end for
  case None then
  end match
  return out
end fn struct_field_refs

// The same for an instance of a generic enum, variant by variant.
fn variant_field_refs(info: Info, name: String, args: List<RTy>) -> List<List<RTy>> do
  var out: List<List<RTy>> = []
  match lookup(map: info.genums, key: generic_base(name))
  case Some(value: e) then
    match lookup(map: info.enums, key: name)
    case Some(value: vs) then
      for vi in 0..len(vs) do
        var refs: List<RTy> = []
        if vi < len(e.variants) then
          let ps = e.variants[vi].fields
          for fi in 0..len(vs[vi].fields) do
            if fi < len(ps) then
              set refs = push(list: refs, item: refine_like(info: info, t: vs[vi].fields[fi].rty.ty, te: ps[fi].ty, tps: e.tparams, args: args))
            end if
          end for
        end if
        set out = push(list: out, item: refs)
      end for
    case None then
    end match
  case None then
  end match
  return out
end fn variant_field_refs

// The refinement a value of type t gets from the refined type arguments args, where the
// generic declaration wrote its type as te over the type parameters tps.
fn refine_like(info: Info, t: Ty, te: TypeExpr, tps: List<String>, args: List<RTy>) -> RTy do
  for i in 0..len(tps) do
    if (tps[i] == te.name) and (i < len(args)) then
      return args[i] with (ty: t)
    end if
  end for
  if len(te.args) == 0 then
    return plain(t)
  end if
  var parts: List<Ty> = []
  match t
  case TList(elem: et) then
    set parts = [et]
  case TOpt(inner: ot) then
    set parts = [ot]
  case TStruct(name: n) then
    set parts = value_or(opt: lookup(map: info.inst_args, key: n), default: [])
  case TEnum(name: n) then
    set parts = value_or(opt: lookup(map: info.inst_args, key: n), default: [])
  else
  end match
  var sub: List<RTy> = []
  var refined = false
  for k in 0..len(te.args) do
    if k < len(parts) then
      let r = refine_like(info: info, t: parts[k], te: te.args[k], tps: tps, args: args)
      set sub = push(list: sub, item: r)
      if not is_plain(r) then
        set refined = true
      end if
    end if
  end for
  if refined then
    return RTy(ty: t, preds: [], args: sub)
  end if
  return plain(t)
end fn refine_like

fn resolve_arg(info: inout Info, te: TypeExpr, errs: inout List<Diag>) -> Ty do
  let r = resolve_type(info: inout info, te: te, errs: inout errs)
  if not is_plain(r) then
    let d = diag(pos: te.pos, msg: "refined types are allowed inside the type arguments of List, Option and generic types, not here")
    set errs = push(list: errs, item: with_note(d: d, note: "wrap the value in a struct with a refined field instead"))
  end if
  return r.ty
end fn resolve_arg

fn resolve_quiet(info: Info, te: TypeExpr) -> RTy do
  var errs: List<Diag> = []
  var scratch = info
  return resolve_type(info: inout scratch, te: te, errs: inout errs)
end fn resolve_quiet

// ---- generic types ----

fn is_tparam(t: Ty) -> Bool do
  match t
  case TParam(name: n) then
    return true
  else
    return false
  end match
end fn is_tparam

// True if a type mentions a type parameter anywhere.
fn has_tparam(info: Info, t: Ty) -> Bool do
  match t
  case TParam(name: n) then
    return true
  case TList(elem: x) then
    return has_tparam(info: info, t: x)
  case TOpt(inner: x) then
    return has_tparam(info: info, t: x)
  case TMap(key: k, val: v) then
    return has_tparam(info: info, t: k) or has_tparam(info: info, t: v)
  case THashMap(key: k, val: v) then
    return has_tparam(info: info, t: k) or has_tparam(info: info, t: v)
  case TStruct(name: n) then
    return args_have_tparam(info: info, name: n)
  case TEnum(name: n) then
    return args_have_tparam(info: info, name: n)
  else
    return false
  end match
end fn has_tparam

fn args_have_tparam(info: Info, name: String) -> Bool do
  match lookup(map: info.inst_args, key: name)
  case Some(value: args) then
    for a in args do
      if has_tparam(info: info, t: a) then
        return true
      end if
    end for
    return false
  case None then
    return false
  end match
end fn args_have_tparam

fn generic_tparams(info: Info, name: String) -> List<String> do
  match lookup(map: info.gstructs, key: name)
  case Some(value: s) then
    return s.tparams
  case None then
  end match
  match lookup(map: info.genums, key: name)
  case Some(value: e) then
    return e.tparams
  case None then
  end match
  let none: List<String> = []
  return none
end fn generic_tparams

fn inst_name(base: String, args: List<Ty>) -> String do
  var shown: List<String> = []
  for a in args do
    set shown = push(list: shown, item: ty_show(a))
  end for
  return base ++ "<" ++ join(parts: shown, sep: ", ") ++ ">"
end fn inst_name

// The name a generic instance was made from: "Pair" for "Pair<Int, String>".
fn generic_base(name: String) -> String do
  for i in 0..len(name) do
    if name[i] == '<' then
      return slice(of: name, from: 0, to: i)
    end if
  end for
  return name
end fn generic_base

fn is_instance_name(name: String) -> Bool do
  return len(generic_base(name)) < len(name)
end fn is_instance_name

// A form of an instance name, or a module-qualified name, that is a valid C and SMT
// identifier fragment. Distinct
// names give distinct results ('_' is doubled), and the result is only ever used with
// a prefix that no plain name gets.
fn mangle(name: String) -> String do
  var parts: List<String> = []
  for i in 0..len(name) do
    let ch = name[i]
    if ch == '_' then
      set parts = push(list: parts, item: "__")
    elif ch == '<' then
      set parts = push(list: parts, item: "_L")
    elif ch == '>' then
      set parts = push(list: parts, item: "_R")
    elif ch == ',' then
      set parts = push(list: parts, item: "_C")
    elif ch == '.' then
      set parts = push(list: parts, item: "_D")
    elif ch != ' ' then
      set parts = push(list: parts, item: char(ch))
    end if
  end for
  return join(parts: parts, sep: "")
end fn mangle

fn tparam_env(tps: List<String>, args: List<Ty>) -> Map<String, Ty> do
  var env: Map<String, Ty> = {}
  for i in 0..len(tps) do
    if i < len(args) then
      set env = insert(map: env, key: tps[i], value: args[i])
    end if
  end for
  return env
end fn tparam_env

fn identity_env(tps: List<String>) -> Map<String, Ty> do
  var env: Map<String, Ty> = {}
  for t in tps do
    set env = insert(map: env, key: t, value: Ty.TParam(name: t))
  end for
  return env
end fn identity_env

// Enters the instance of a generic struct or enum for these type arguments, if it is
// new, and returns its type.
fn instantiate_type(info: inout Info, name: String, args: List<Ty>, pos: Pos, errs: inout List<Diag>) -> Ty do
  let inst = inst_name(base: name, args: args)
  var t = Ty.TEnum(name: inst)
  if has(map: info.gstructs, key: name) then
    set t = Ty.TStruct(name: inst)
  end if
  if has(map: info.inst_args, key: inst) then
    return t
  end if
  if len(inst) > 300 then
    set errs = push(list: errs, item: diag(pos: pos, msg: "the generic type '" ++ name ++ "' is instantiated with ever larger types"))
    return Ty.TUnknown
  end if
  let saved = info.tenv
  set info = info with (inst_args: insert(map: info.inst_args, key: inst, value: args))
  match lookup(map: info.gstructs, key: name)
  case Some(value: s) then
    let empty: List<FieldInfo> = []
    set info = info with (structs: insert(map: info.structs, key: inst, value: empty), tenv: tparam_env(tps: s.tparams, args: args))
    let fields = inst_fields(info: inout info, ps: s.fields, errs: inout errs)
    set info = info with (structs: insert(map: info.structs, key: inst, value: fields))
  case None then
    match lookup(map: info.genums, key: name)
    case Some(value: e) then
      let empty: List<VariantInfo> = []
      set info = info with (enums: insert(map: info.enums, key: inst, value: empty), tenv: tparam_env(tps: e.tparams, args: args))
      var vs: List<VariantInfo> = []
      for v in e.variants do
        set vs = push(list: vs, item: VariantInfo(name: v.name, fields: inst_fields(info: inout info, ps: v.fields, errs: inout errs)))
      end for
      set info = info with (enums: insert(map: info.enums, key: inst, value: vs))
    case None then
    end match
  end match
  set info = info with (tenv: saved, pending: push(list: info.pending, item: inst))
  return t
end fn instantiate_type

// The fields of an instance. Each instance gets its own copy of every refinement, so
// that the checker can record the instance's types for it.
fn inst_fields(info: inout Info, ps: List<Param>, errs: inout List<Diag>) -> List<FieldInfo> do
  var fields: List<FieldInfo> = []
  for p in ps do
    var next = info.next_id
    let te = copy_type(t: p.ty, next: inout next)
    set info = info with (next_id: next)
    let r = resolve_type(info: inout info, te: te, errs: inout errs)
    set fields = push(list: fields, item: FieldInfo(name: p.name, rty: r))
  end for
  return fields
end fn inst_fields

// Binds type parameters by matching a declared type against an actual one. The first
// binding wins; a conflicting one shows up later as a type mismatch.
fn unify(info: Info, te: TypeExpr, t: Ty, tps: List<String>, subst: inout Map<String, Ty>) do
  if contains_str(xs: tps, x: te.name) then
    if (not has(map: subst, key: te.name)) and not is_unknown(t) then
      set subst = insert(map: subst, key: te.name, value: t)
    end if
    return
  end if
  let n = len(te.args)
  match t
  case TList(elem: x) then
    if (te.name == "List") and (n == 1) then
      unify(info: info, te: te.args[0], t: x, tps: tps, subst: inout subst)
    end if
  case TOpt(inner: x) then
    if (te.name == "Option") and (n == 1) then
      unify(info: info, te: te.args[0], t: x, tps: tps, subst: inout subst)
    end if
  case TMap(key: k, val: v) then
    if (te.name == "Map") and (n == 2) then
      unify(info: info, te: te.args[0], t: k, tps: tps, subst: inout subst)
      unify(info: info, te: te.args[1], t: v, tps: tps, subst: inout subst)
    end if
  case THashMap(key: k, val: v) then
    if (te.name == "HashMap") and (n == 2) then
      unify(info: info, te: te.args[0], t: k, tps: tps, subst: inout subst)
      unify(info: info, te: te.args[1], t: v, tps: tps, subst: inout subst)
    end if
  case TStruct(name: sn) then
    unify_inst(info: info, te: te, name: sn, tps: tps, subst: inout subst)
  case TEnum(name: en) then
    unify_inst(info: info, te: te, name: en, tps: tps, subst: inout subst)
  else
  end match
end fn unify

fn unify_inst(info: Info, te: TypeExpr, name: String, tps: List<String>, subst: inout Map<String, Ty>) do
  if generic_base(name) != te.name then
    return
  end if
  match lookup(map: info.inst_args, key: name)
  case Some(value: args) then
    for i in 0..len(te.args) do
      if i < len(args) then
        unify(info: info, te: te.args[i], t: args[i], tps: tps, subst: inout subst)
      end if
    end for
  case None then
  end match
end fn unify_inst

// True if every type parameter that te mentions is bound.
fn bound_in(te: TypeExpr, tps: List<String>, subst: Map<String, Ty>) -> Bool do
  if contains_str(xs: tps, x: te.name) and not has(map: subst, key: te.name) then
    return false
  end if
  for a in te.args do
    if not bound_in(te: a, tps: tps, subst: subst) then
      return false
    end if
  end for
  return true
end fn bound_in

// A type expression written with the declaration's own parameters: Pair<A, B>.
fn self_type(name: String, tps: List<String>, pos: Pos) -> TypeExpr do
  var args: List<TypeExpr> = []
  for t in tps do
    set args = push(list: args, item: TypeExpr(name: t, args: [], refine: Option.None, pos: pos))
  end for
  return TypeExpr(name: name, args: args, refine: Option.None, pos: pos)
end fn self_type

// ---- checker state ----

struct Local
  name: String,
  ty: Ty,
  mutable: Bool,
end struct Local

struct Checker
  info: Info,
  errs: List<Diag>,
  locals: List<Local>,
  marks: List<Int>,
  effects: List<String>,
  ret: Ty,
  loops: Int,
  spec: Bool,
  it_ty: Option<Ty>,
  result_ty: Option<Ty>,
  inout_ok: Bool,
  files: List<String>,
  // Instances of generic functions whose bodies are still to be checked.
  queue: List<Inst>,
  // The inout parameters of the function being checked, and those that old(x) may
  // name here (in an ensures or a loop invariant).
  inouts: List<String>,
  olds: List<String>,
  // While checking the refinement of a var or an inout parameter: the variables it may
  // not name because they can change, and whose refinement it is.
  changing: List<String>,
  refined: String,
end struct Checker

// An instance whose body is to be checked: for the code generator when its types are
// concrete (compiled), and otherwise only for the verifier, which translates the body
// of an instance of a specification function.
struct Inst
  decl: FnDecl,
  env: Map<String, Ty>,
  compiled: Bool,
end struct Inst

fn at(c: Checker, p: Pos) -> String do
  var f = "?"
  if (p.file >= 0) and (p.file < len(c.files)) then
    set f = c.files[p.file]
  end if
  return f ++ ":" ++ int_to_str(p.line)
end fn at

fn err(c: inout Checker, pos: Pos, msg: String) do
  set c = c with (errs: push(list: c.errs, item: diag(pos: pos, msg: msg)))
end fn err

fn err_d(c: inout Checker, d: Diag) do
  set c = c with (errs: push(list: c.errs, item: d))
end fn err_d

fn resolve(c: inout Checker, te: TypeExpr) -> RTy do
  var errs = c.errs
  var info = c.info
  let r = resolve_type(info: inout info, te: te, errs: inout errs)
  set c = c with (info: info, errs: errs)
  check_pending(inout c)
  return r
end fn resolve

// Checks the field refinements of new instances of generic types.
fn check_pending(c: inout Checker) do
  if len(c.info.pending) == 0 then
    return
  end if
  let saved = c
  while len(c.info.pending) > 0 do
    let inst = c.info.pending[0]
    let info = c.info
    set c = c with (info: info with (pending: slice(of: info.pending, from: 1, to: len(info.pending))))
    match lookup(map: c.info.structs, key: inst)
    case Some(value: fields) then
      check_info_preds(c: inout c, fields: fields)
    case None then
    end match
    match lookup(map: c.info.enums, key: inst)
    case Some(value: vs) then
      for v in vs do
        check_info_preds(c: inout c, fields: v.fields)
      end for
    case None then
    end match
  end while
  set c = saved with (info: c.info, errs: c.errs, queue: c.queue)
end fn check_pending

fn check_info_preds(c: inout Checker, fields: List<FieldInfo>) do
  for i in 0..len(fields) do
    var others: List<NamedTy> = []
    for j in 0..len(fields) do
      if j != i then
        set others = push(list: others, item: NamedTy(name: fields[j].name, ty: fields[j].rty.ty))
      end if
    end for
    for p in fields[i].rty.preds do
      check_pred(c: inout c, e: p, scope: others, subject: Option.Some(value: fields[i].rty.ty), res: Option.None)
    end for
    check_rty_args(c: inout c, r: fields[i].rty)
  end for
end fn check_info_preds

// The refinements inside a type's arguments, each of a value of the argument's type
// with nothing else in scope: a value inside a list or option is checked where the
// list or option is stored, where no other name is known to be in scope.
fn check_rty_args(c: inout Checker, r: RTy) do
  for a in r.args do
    let scope: List<NamedTy> = []
    for p in a.preds do
      check_pred(c: inout c, e: p, scope: scope, subject: Option.Some(value: a.ty), res: Option.None)
    end for
    check_rty_args(c: inout c, r: a)
  end for
end fn check_rty_args

// The generic type that the refinements inside r's type arguments reach again through
// its own fields, or "": a refined recursive type (Tree<Nat>), whose refinement would
// have to hold at every node, which no finite formula says.
fn refined_cycle(info: Info, r: RTy, seen: List<String>) -> String do
  if len(r.args) == 0 then
    return ""
  end if
  match r.ty
  case TList(elem: x) then
    return refined_cycle(info: info, r: r.args[0], seen: seen)
  case TOpt(inner: x) then
    return refined_cycle(info: info, r: r.args[0], seen: seen)
  case TStruct(name: n) then
    if contains_str(xs: seen, x: n) then
      return n
    end if
    for f in struct_field_refs(info: info, name: n, args: r.args) do
      let c = refined_cycle(info: info, r: f, seen: push(list: seen, item: n))
      if len(c) > 0 then
        return c
      end if
    end for
    return ""
  case TEnum(name: n) then
    if contains_str(xs: seen, x: n) then
      return n
    end if
    for vs in variant_field_refs(info: info, name: n, args: r.args) do
      for f in vs do
        let c = refined_cycle(info: info, r: f, seen: push(list: seen, item: n))
        if len(c) > 0 then
          return c
        end if
      end for
    end for
    return ""
  else
    return ""
  end match
end fn refined_cycle

// The refinements written inside the type arguments of te (List<Int where it > 0>);
// those of a named alias are checked once, with the alias.
// True, after reporting it, if te (or a type inside it) is a refined recursive type.
fn check_refined_cycles(c: inout Checker, te: TypeExpr) -> Bool do
  if len(te.args) > 0 then
    let seen: List<String> = []
    let cyc = refined_cycle(info: c.info, r: resolve_quiet(info: c.info, te: te), seen: seen)
    if len(cyc) > 0 then
      let d = diag(pos: te.pos, msg: "a refined type argument of a recursive type cannot be checked: '" ++ generic_base(cyc) ++ "' contains itself")
      err_d(c: inout c, d: with_note(d: d, note: "refine the values where they are used instead"))
      return true
    end if
  end if
  return false
end fn check_refined_cycles

fn check_arg_refines(c: inout Checker, te: TypeExpr) do
  if check_refined_cycles(c: inout c, te: te) then
    return
  end if
  for a in te.args do
    match a.refine
    case Some(value: r) then
      let scope: List<NamedTy> = []
      check_pred(c: inout c, e: r, scope: scope, subject: Option.Some(value: resolve_quiet(info: c.info, te: a).ty), res: Option.None)
    case None then
    end match
    check_arg_refines(c: inout c, te: a)
  end for
end fn check_arg_refines

fn find_local(c: Checker, name: String) -> Option<Local> do
  var i = len(c.locals) - 1
  while i >= 0 invariant i < len(c.locals) do
    if c.locals[i].name == name then
      return Option.Some(value: c.locals[i])
    end if
    set i = i - 1
  end while
  return Option.None
end fn find_local

fn is_local(c: Checker, name: String) -> Bool do
  match find_local(c: c, name: name)
  case Some(value: l) then
    return true
  case None then
    return false
  end match
end fn is_local

fn declare(c: inout Checker, pos: Pos, name: String, t: Ty, mutable: Bool) do
  if is_local(c: c, name: name) then
    err(c: inout c, pos: pos, msg: "'" ++ name ++ "' is already defined in this scope (Vow has no shadowing)")
  end if
  set c = c with (locals: push(list: c.locals, item: Local(name: name, ty: t, mutable: mutable)))
end fn declare

fn enter(c: inout Checker) do
  set c = c with (marks: push(list: c.marks, item: len(c.locals)))
end fn enter

fn leave(c: inout Checker) do
  let n = len(c.marks)
  if n == 0 then
    return
  end if
  let m = c.marks[n - 1]
  var locals = c.locals
  if (m >= 0) and (m <= len(locals)) then
    set locals = slice(of: locals, from: 0, to: m)
  end if
  set c = c with (locals: locals, marks: slice(of: c.marks, from: 0, to: n - 1))
end fn leave

fn visible(c: Checker) -> List<NamedTy> do
  var v: List<NamedTy> = []
  for l in c.locals do
    // Names that start with a digit are made by 'try'.
    if (len(l.name) > 0) and not is_digit(l.name[0]) then
      set v = push(list: v, item: NamedTy(name: l.name, ty: l.ty))
    end if
  end for
  return v
end fn visible

fn expect_ty(c: inout Checker, pos: Pos, got: Ty, want: Ty, what: String) do
  if not compatible(got: got, want: want) then
    err(c: inout c, pos: pos, msg: what ++ " must be " ++ ty_show(want) ++ ", but this is " ++ ty_show(got))
  end if
end fn expect_ty

fn set_ty(c: inout Checker, e: Expr, t: Ty) -> Ty do
  let info = c.info
  set c = c with (info: info with (types: insert(map: info.types, key: e.id, value: t)))
  return t
end fn set_ty

fn add_call(c: inout Checker, e: Expr, ci: CallInfo) do
  let info = c.info
  set c = c with (info: info with (calls: insert(map: info.calls, key: e.id, value: ci)))
end fn add_call

// ---- program ----

fn new_info() -> Info do
  var structs: Map<String, List<FieldInfo>> = {}
  set structs = insert(map: structs, key: "Output",
    value: [FieldInfo(name: "code", rty: plain(Ty.TInt)), FieldInfo(name: "out", rty: plain(Ty.TStr))])
  return Info(structs: structs, enums: {}, aliases: {}, fns: {}, types: {}, calls: {}, holes: [],
    gfns: {}, gstructs: {}, genums: {}, tenv: {}, inst_args: {}, origins: {}, pending: [], instances: [],
    next_id: 0, scc: {}, recursive: {}, structural: false, spec_notes: {})
end fn new_info

fn alias_ready(info: Info, te: TypeExpr, alias_names: List<String>) -> Bool do
  if contains_str(xs: alias_names, x: te.name) and not has(map: info.aliases, key: te.name) then
    return false
  end if
  for a in te.args do
    if not alias_ready(info: info, te: a, alias_names: alias_names) then
      return false
    end if
  end for
  return true
end fn alias_ready

fn primitive_types() -> List<String> do
  return ["Int", "Float", "Bool", "String", "Unit", "List", "Map", "HashMap", "Option", "Output"]
end fn primitive_types

fn check_program(items: List<Item>, files: List<String>, next_id: Int) -> Checker do
  let none: Option<Ty> = Option.None
  var c = Checker(info: new_info() with (next_id: next_id), errs: [], locals: [], marks: [], effects: [], ret: Ty.TUnit,
    loops: 0, spec: false, it_ty: none, result_ty: none, inout_ok: false, files: files, queue: [],
    inouts: [], olds: [], changing: [], refined: "")
  // Phase 1: names.
  var seen_types: Map<String, Pos> = {}
  var seen_fns: Map<String, Pos> = {}
  for item in items do
    let name = item_name(item)
    let pos = item_pos(item)
    var is_type = true
    match item
    case FnItem(decl: f) then
      set is_type = false
    else
    end match
    if is_type then
      if contains_str(xs: primitive_types(), x: local_name(name)) then
        err(c: inout c, pos: pos, msg: "'" ++ local_name(name) ++ "' is a built-in type")
      else
        match lookup(map: seen_types, key: name)
        case Some(value: p) then
          err(c: inout c, pos: pos, msg: "type '" ++ name ++ "' is already declared at " ++ at(c: c, p: p))
        case None then
        end match
      end if
      set seen_types = insert(map: seen_types, key: name, value: pos)
    else
      if is_builtin(local_name(name)) then
        err(c: inout c, pos: pos, msg: "'" ++ local_name(name) ++ "' is a built-in function")
      else
        match lookup(map: seen_fns, key: name)
        case Some(value: p) then
          err(c: inout c, pos: pos, msg: "function '" ++ name ++ "' is already declared at " ++ at(c: c, p: p))
        case None then
        end match
      end if
      set seen_fns = insert(map: seen_fns, key: name, value: pos)
    end if
    let info = c.info
    match item
    case StructItem(decl: s) then
      if len(s.tparams) > 0 then
        set c = c with (info: info with (gstructs: insert(map: info.gstructs, key: s.name, value: s)))
      else
        let empty: List<FieldInfo> = []
        set c = c with (info: info with (structs: insert(map: info.structs, key: s.name, value: empty)))
      end if
    case EnumItem(decl: e) then
      if len(e.variants) == 0 then
        // No value has such a type, and a match on one would have no arms to denote.
        err(c: inout c, pos: e.pos, msg: "enum '" ++ e.name ++ "' has no variants")
      end if
      if len(e.tparams) > 0 then
        set c = c with (info: info with (genums: insert(map: info.genums, key: e.name, value: e)))
      else
        let empty: List<VariantInfo> = []
        set c = c with (info: info with (enums: insert(map: info.enums, key: e.name, value: empty)))
      end if
    case FnItem(decl: f) then
      if len(f.tparams) > 0 then
        set c = c with (info: info with (gfns: insert(map: info.gfns, key: f.name, value: f)))
      end if
    else
    end match
  end for
  // A function may not share a type's name: a call such as P(a: x) would mean the
  // function to one part of the compiler and the constructor to another.
  for item in items do
    match item
    case FnItem(decl: f) then
      match lookup(map: seen_types, key: f.name)
      case Some(value: p) then
        err(c: inout c, pos: f.pos, msg: "function '" ++ f.name ++ "' has the same name as the type declared at " ++ at(c: c, p: p))
      case None then
      end match
    else
    end match
  end for
  for item in items do
    for tp in item_tparams(item) do
      if contains_str(xs: primitive_types(), x: tp) or has(map: seen_types, key: tp) then
        err(c: inout c, pos: item_pos(item), msg: "type parameter '" ++ tp ++ "' has the same name as a type")
      end if
    end for
  end for
  // Phase 2: aliases in dependency order, then fields and signatures.
  var alias_decls: List<AliasDecl> = []
  var alias_names: List<String> = []
  for item in items do
    match item
    case AliasItem(decl: a) then
      set alias_decls = push(list: alias_decls, item: a)
      set alias_names = push(list: alias_names, item: a.name)
    else
    end match
  end for
  var pending = alias_decls
  var progress = true
  while progress and (len(pending) > 0) do
    let before = len(pending)
    var still: List<AliasDecl> = []
    for a in pending do
      if alias_ready(info: c.info, te: a.ty, alias_names: alias_names) then
        let r = resolve(c: inout c, te: a.ty)
        let info = c.info
        set c = c with (info: info with (aliases: insert(map: info.aliases, key: a.name, value: r)))
      else
        set still = push(list: still, item: a)
      end if
    end for
    set pending = still
    set progress = len(pending) != before
  end while
  for a in pending do
    err(c: inout c, pos: a.pos, msg: "type alias '" ++ a.name ++ "' is defined in terms of itself")
    let info = c.info
    set c = c with (info: info with (aliases: insert(map: info.aliases, key: a.name, value: plain(Ty.TUnknown))))
  end for
  for item in items do
    if len(item_tparams(item)) > 0 then
      // A generic type is resolved per instance, but the shape of its declaration
      // (distinct variants and fields, none inout) is checked here, as for any other.
      check_generic_shape(c: inout c, item: item)
      continue
    end if
    match item
    case StructItem(decl: s) then
      let fields = collect_fields(c: inout c, ps: s.fields)
      let info = c.info
      set c = c with (info: info with (structs: insert(map: info.structs, key: s.name, value: fields)))
    case EnumItem(decl: e) then
      var vs: List<VariantInfo> = []
      for v in e.variants do
        if find_variant(vs: vs, name: v.name) >= 0 then
          err(c: inout c, pos: v.pos, msg: "duplicate variant '" ++ v.name ++ "'")
        end if
        let fields = collect_fields(c: inout c, ps: v.fields)
        set vs = push(list: vs, item: VariantInfo(name: v.name, fields: fields))
      end for
      let info = c.info
      set c = c with (info: info with (enums: insert(map: info.enums, key: e.name, value: vs)))
    else
    end match
  end for
  for item in items do
    match item
    case FnItem(decl: f) then
      set_tenv(c: inout c, env: identity_env(f.tparams))
      let fi = fn_signature(c: inout c, f: f)
      let info = c.info
      set c = c with (info: info with (fns: insert(map: info.fns, key: f.name, value: fi)))
      set_tenv(c: inout c, env: {})
    else
    end match
  end for
  compute_inline(c: inout c, items: items)
  // Generic types are checked through the instance with their own parameters.
  for item in items do
    match item
    case StructItem(decl: s) then
      if len(s.tparams) > 0 then
        set_tenv(c: inout c, env: identity_env(s.tparams))
        let _ = resolve(c: inout c, te: self_type(name: s.name, tps: s.tparams, pos: s.pos))
        set_tenv(c: inout c, env: {})
      end if
    case EnumItem(decl: e) then
      if len(e.tparams) > 0 then
        set_tenv(c: inout c, env: identity_env(e.tparams))
        let _ = resolve(c: inout c, te: self_type(name: e.name, tps: e.tparams, pos: e.pos))
        set_tenv(c: inout c, env: {})
      end if
    else
    end match
  end for
  // Phase 3: refinement predicates and contracts.
  for item in items do
    match item
    case AliasItem(decl: a) then
      check_arg_refines(c: inout c, te: a.ty)
      match a.ty.refine
      case Some(value: r) then
        var base = Ty.TUnknown
        match lookup(map: c.info.aliases, key: a.name)
        case Some(value: ar) then
          set base = ar.ty
        case None then
        end match
        let scope: List<NamedTy> = []
        check_pred(c: inout c, e: r, scope: scope, subject: Option.Some(value: base), res: Option.None)
      case None then
      end match
    case StructItem(decl: s) then
      if len(s.tparams) == 0 then
        check_field_preds(c: inout c, ps: s.fields, fields: struct_fields(info: c.info, name: s.name))
      else
        // Its fields' refinements are checked per instance; a refined recursive type
        // among them is refused here, before an instance can be unfolded.
        set_tenv(c: inout c, env: identity_env(s.tparams))
        for f in s.fields do
          let _ = check_refined_cycles(c: inout c, te: f.ty)
        end for
        set_tenv(c: inout c, env: {})
      end if
    case EnumItem(decl: e) then
      if len(e.tparams) > 0 then
        set_tenv(c: inout c, env: identity_env(e.tparams))
        for vd in e.variants do
          for f in vd.fields do
            let _ = check_refined_cycles(c: inout c, te: f.ty)
          end for
        end for
        set_tenv(c: inout c, env: {})
      end if
      match lookup(map: c.info.enums, key: e.name)
      case Some(value: vs) then
        for vi in 0..len(e.variants) do
          if vi < len(vs) then
            check_field_preds(c: inout c, ps: e.variants[vi].fields, fields: vs[vi].fields)
          end if
        end for
      case None then
      end match
    case FnItem(decl: f) then
      set_tenv(c: inout c, env: identity_env(f.tparams))
      check_contracts(c: inout c, f: f)
      set_tenv(c: inout c, env: {})
    end match
  end for
  // Phase 4: bodies. A generic function's body is checked once, with its type
  // parameters as types about which nothing is known; then the body of each instance
  // with concrete types is checked, for the code generator.
  for item in items do
    match item
    case FnItem(decl: f) then
      set_tenv(c: inout c, env: identity_env(f.tparams))
      check_fn(c: inout c, f: f)
      set_tenv(c: inout c, env: {})
    else
    end match
  end for
  while len(c.queue) > 0 do
    let next = c.queue[0]
    set c = c with (queue: slice(of: c.queue, from: 1, to: len(c.queue)))
    set_tenv(c: inout c, env: next.env)
    let before = len(c.errs)
    check_fn(c: inout c, f: next.decl)
    set_tenv(c: inout c, env: {})
    // An error that only this instance has (such as '==' on a map type) names it; one
    // the generic declaration already has is dropped.
    var old = c.errs
    if before <= len(c.errs) then
      set old = slice(of: c.errs, from: 0, to: before)
    end if
    var errs = old
    for i in len(old)..len(c.errs) do
      let d = c.errs[i]
      var dup = false
      for o in old do
        if (o.msg == d.msg) and (o.pos.file == d.pos.file) and (o.pos.line == d.pos.line) and (o.pos.col == d.pos.col) then
          set dup = true
        end if
      end for
      if not dup then
        set errs = push(list: errs, item: d with (msg: d.msg ++ ", in " ++ next.decl.name))
      end if
    end for
    set c = c with (errs: errs)
    if next.compiled then
      let info = c.info
      set c = c with (info: info with (instances: push(list: info.instances, item: next.decl)))
    end if
  end while
  check_pending(inout c)
  match get_fn(info: c.info, name: "main")
  case None then
    err(c: inout c, pos: no_pos(), msg: "the program has no 'fn main()'")
  case Some(value: m) then
    if (len(m.params) > 0) or (ty_show(m.ret.ty) != "Unit") then
      err(c: inout c, pos: m.pos, msg: "'main' must take no parameters and return Unit")
    end if
  end match
  // An instance can repeat an error in its generic declaration.
  var unique: List<Diag> = []
  var seen: Map<String, Bool> = {}
  for d in c.errs do
    let k = int_to_str(d.pos.file) ++ ":" ++ int_to_str(d.pos.line) ++ ":" ++ int_to_str(d.pos.col) ++ ":" ++ d.msg
    if not has(map: seen, key: k) then
      set seen = insert(map: seen, key: k, value: true)
      set unique = push(list: unique, item: d)
    end if
  end for
  return c with (errs: unique)
end fn check_program

fn item_tparams(item: Item) -> List<String> do
  match item
  case FnItem(decl: f) then
    return f.tparams
  case StructItem(decl: s) then
    return s.tparams
  case EnumItem(decl: e) then
    return e.tparams
  case AliasItem(decl: a) then
    let none: List<String> = []
    return none
  end match
end fn item_tparams

fn set_tenv(c: inout Checker, env: Map<String, Ty>) do
  let info = c.info
  set c = c with (info: info with (tenv: env))
end fn set_tenv

fn fn_signature(c: inout Checker, f: FnDecl) -> FnInfo do
  var params: List<FieldInfo> = []
  var io: List<Bool> = []
  for p in f.params do
    if find_field(fields: params, name: p.name) >= 0 then
      err(c: inout c, pos: p.pos, msg: "duplicate parameter '" ++ p.name ++ "'")
    end if
    let r = resolve(c: inout c, te: p.ty)
    set params = push(list: params, item: FieldInfo(name: p.name, rty: r))
    set io = push(list: io, item: p.is_inout)
  end for
  var ret = plain(Ty.TUnit)
  match f.ret
  case Some(value: t) then
    set ret = resolve(c: inout c, te: t)
  case None then
  end match
  var effs: List<String> = []
  for u in f.effects do
    if not contains_str(xs: ["console", "fs", "proc"], x: u.name) then
      err(c: inout c, pos: u.pos, msg: "unknown effect '" ++ u.name ++ "' (expected console, fs or proc)")
    end if
    set effs = push(list: effs, item: u.name)
  end for
  return FnInfo(name: f.name, params: params, io: io, ret: ret, effects: effs, pre: f.pre,
    post: f.post, dec: f.dec, inline: Option.None, spec_body: Option.None, spec_rec: false, pos: f.pos)
end fn fn_signature

fn check_contracts(c: inout Checker, f: FnDecl) do
  match get_fn(info: c.info, name: f.name)
  case Some(value: fi) then
    var all: List<NamedTy> = []
    for p in fi.params do
      set all = push(list: all, item: NamedTy(name: p.name, ty: p.rty.ty))
    end for
    for i in 0..len(f.params) do
      check_arg_refines(c: inout c, te: f.params[i].ty)
      match f.params[i].ty.refine
      case Some(value: r) then
        if i < len(all) then
          if (i < len(fi.io)) and fi.io[i] then
            var changing: List<String> = []
            for k in 0..i do
              if (k < len(fi.io)) and fi.io[k] then
                set changing = push(list: changing, item: all[k].name)
              end if
            end for
            check_fixed_pred(c: inout c, e: r, scope: slice(of: all, from: 0, to: i), subject: all[i].ty, refined: all[i].name,
              changing: changing)
          else
            check_pred(c: inout c, e: r, scope: slice(of: all, from: 0, to: i),
              subject: Option.Some(value: all[i].ty), res: Option.None)
          end if
        end if
      case None then
      end match
    end for
    match f.ret
    case Some(value: t) then
      check_arg_refines(c: inout c, te: t)
      match t.refine
      case Some(value: r) then
        check_pred(c: inout c, e: r, scope: all, subject: Option.Some(value: fi.ret.ty), res: Option.None)
      case None then
      end match
    case None then
    end match
    for r in f.pre do
      check_pred(c: inout c, e: r, scope: all, subject: Option.None, res: Option.None)
    end for
    set c = c with (olds: inout_names(fi))
    for e in f.post do
      check_pred(c: inout c, e: e, scope: all, subject: Option.None, res: Option.Some(value: fi.ret.ty))
    end for
    set c = c with (olds: [])
    match f.dec
    case Some(value: d) then
      check_measure(c: inout c, e: d, scope: all)
    case None then
    end match
  case None then
  end match
end fn check_contracts

// The instance of a generic function for these type arguments: its name, after
// entering its signature and checking its contracts if it is new. An instance with
// concrete types is queued for its body to be checked and compiled. With the
// function's own parameters as arguments, the instance is the function itself.
fn instantiate_fn(c: inout Checker, g: FnDecl, args: List<Ty>, pos: Pos) -> String do
  var identity = len(args) == len(g.tparams)
  for i in 0..len(args) do
    if (i >= len(g.tparams)) or (ty_show(args[i]) != g.tparams[i]) or not is_tparam(args[i]) then
      set identity = false
    end if
  end for
  if identity then
    return g.name
  end if
  let inst = inst_name(base: g.name, args: args)
  if has(map: c.info.fns, key: inst) then
    return inst
  end if
  if len(inst) > 300 then
    err(c: inout c, pos: pos, msg: "'" ++ g.name ++ "' is instantiated with ever larger types")
    return ""
  end if
  var next = c.info.next_id
  let copy = copy_fn(f: g, next: inout next) with (name: inst, tparams: [])
  let env = tparam_env(tps: g.tparams, args: args)
  let saved = c
  let info0 = c.info
  set c = c with (info: info0 with (next_id: next, tenv: env))
  let fi = fn_signature(c: inout c, f: copy)
  // An instance of a specification function is one too, translated from its own copy
  // of the body, whose types are the instance's.
  var spec = false
  var fi2 = fi
  match get_fn(info: c.info, name: g.name)
  case Some(value: gi) then
    set spec = is_some(gi.inline) or is_some(gi.spec_body)
    if is_some(gi.inline) then
      set fi2 = fi with (inline: return_expr(copy.body))
    elif is_some(gi.spec_body) then
      set fi2 = fi with (spec_body: Option.Some(value: copy.body), spec_rec: gi.spec_rec)
    end if
  case None then
  end match
  let info1 = c.info
  set c = c with (info: info1 with (fns: insert(map: info1.fns, key: inst, value: fi2),
    origins: insert(map: info1.origins, key: inst, value: g.name)))
  check_contracts(c: inout c, f: copy)
  var concrete = true
  for a in args do
    if has_tparam(info: c.info, t: a) then
      set concrete = false
    end if
  end for
  var queue = c.queue
  if concrete or spec then
    set queue = push(list: queue, item: Inst(decl: copy, env: env, compiled: concrete))
  end if
  let info2 = c.info
  set c = saved with (info: info2 with (tenv: saved.info.tenv), errs: c.errs, queue: queue)
  return inst
end fn instantiate_fn

fn check_generic_shape(c: inout Checker, item: Item) do
  match item
  case StructItem(decl: s) then
    check_param_shape(c: inout c, ps: s.fields)
  case EnumItem(decl: e) then
    var names: List<String> = []
    for v in e.variants do
      if contains_str(xs: names, x: v.name) then
        err(c: inout c, pos: v.pos, msg: "duplicate variant '" ++ v.name ++ "'")
      end if
      set names = push(list: names, item: v.name)
      check_param_shape(c: inout c, ps: v.fields)
    end for
  else
  end match
end fn check_generic_shape

fn check_param_shape(c: inout Checker, ps: List<Param>) do
  var names: List<String> = []
  for f in ps do
    if f.is_inout then
      err(c: inout c, pos: f.pos, msg: "only function parameters can be inout")
    end if
    if contains_str(xs: names, x: f.name) then
      err(c: inout c, pos: f.pos, msg: "duplicate field '" ++ f.name ++ "'")
    end if
    set names = push(list: names, item: f.name)
  end for
end fn check_param_shape

fn collect_fields(c: inout Checker, ps: List<Param>) -> List<FieldInfo> do
  var fields: List<FieldInfo> = []
  for f in ps do
    if f.is_inout then
      err(c: inout c, pos: f.pos, msg: "only function parameters can be inout")
    end if
    if find_field(fields: fields, name: f.name) >= 0 then
      err(c: inout c, pos: f.pos, msg: "duplicate field '" ++ f.name ++ "'")
    end if
    let r = resolve(c: inout c, te: f.ty)
    set fields = push(list: fields, item: FieldInfo(name: f.name, rty: r))
  end for
  return fields
end fn collect_fields

fn check_field_preds(c: inout Checker, ps: List<Param>, fields: List<FieldInfo>) do
  for i in 0..len(ps) do
    check_arg_refines(c: inout c, te: ps[i].ty)
    match ps[i].ty.refine
    case Some(value: r) then
      var others: List<NamedTy> = []
      for j in 0..len(fields) do
        if j != i then
          set others = push(list: others, item: NamedTy(name: fields[j].name, ty: fields[j].rty.ty))
        end if
      end for
      var subj = Ty.TUnknown
      if i < len(fields) then
        set subj = fields[i].rty.ty
      end if
      check_pred(c: inout c, e: r, scope: others, subject: Option.Some(value: subj), res: Option.None)
    case None then
    end match
  end for
end fn check_field_preds

// Check a specification predicate in a scope of named values.
// The refinement of a var or an inout parameter (refined), which may not name the
// variables in changing. The verifier assumes such a refinement again where the variable
// may have changed (at a loop head, and after a call that passes it inout), which is
// only sound if it cannot have been made false by a change to another variable.
fn check_fixed_pred(c: inout Checker, e: Expr, scope: List<NamedTy>, subject: Ty, refined: String, changing: List<String>) do
  set c = c with (changing: changing, refined: refined)
  check_pred(c: inout c, e: e, scope: scope, subject: Option.Some(value: subject), res: Option.None)
  set c = c with (changing: [], refined: "")
end fn check_fixed_pred

fn check_pred(c: inout Checker, e: Expr, scope: List<NamedTy>, subject: Option<Ty>, res: Option<Ty>) do
  let saved_locals = c.locals
  let saved_marks = c.marks
  var locals: List<Local> = []
  for s in scope do
    set locals = push(list: locals, item: Local(name: s.name, ty: s.ty, mutable: false))
  end for
  set c = c with (locals: locals, marks: [], it_ty: subject, result_ty: res, spec: true)
  let t = check_expr(c: inout c, e: e, expected: Option.Some(value: Ty.TBool))
  expect_ty(c: inout c, pos: e.pos, got: t, want: Ty.TBool, what: "a specification")
  let none: Option<Ty> = Option.None
  set c = c with (locals: saved_locals, marks: saved_marks, it_ty: none, result_ty: none, spec: false)
end fn check_pred

fn check_measure(c: inout Checker, e: Expr, scope: List<NamedTy>) do
  let saved_locals = c.locals
  let saved_marks = c.marks
  var locals: List<Local> = []
  for s in scope do
    set locals = push(list: locals, item: Local(name: s.name, ty: s.ty, mutable: false))
  end for
  set c = c with (locals: locals, marks: [], spec: true)
  let t = check_expr(c: inout c, e: e, expected: Option.None)
  expect_measure(c: inout c, pos: e.pos, t: t)
  set c = c with (locals: saved_locals, marks: saved_marks, spec: false)
end fn check_measure

// A measure is an Int, which must decrease and stay non-negative, or a list, struct,
// enum or option value, which must get structurally smaller: a call or iteration must
// work on a part of it.
fn expect_measure(c: inout Checker, pos: Pos, t: Ty) do
  var structural = true
  match t
  case TInt then
    set structural = false
  case TList(elem: x) then
  case TStruct(name: n) then
  case TEnum(name: n) then
  case TOpt(inner: x) then
  case TUnknown then
    set structural = false
  else
    set structural = false
    err(c: inout c, pos: pos, msg: "a 'decreases' measure must be an Int, or a list, struct, enum or option value, not " ++ ty_show(t))
  end match
  if structural then
    let info = c.info
    set c = c with (info: info with (structural: true))
  end if
end fn expect_measure

// The functions that may be used in specifications ("specification functions"): pure,
// returning a value, no inout parameters, and a body built only from
// 'let', 'if', 'match', 'assert' and 'return' over specification expressions, so it
// denotes a value. A recursive one needs a 'decreases' measure, so that it denotes a
// function. A non-recursive one whose body is exactly 'return e' is inlined (inline);
// any other is translated from its body (spec_body). Functions with other bodies are
// considered only when a specification reaches them. A generic one is translated per
// instance (see instantiate_fn).
fn compute_inline(c: inout Checker, items: List<Item>) do
  var bodies: Map<String, List<Stmt>> = {}
  var single: Map<String, Expr> = {}
  var named: List<String> = []
  for item in items do
    spec_calls_item(item: item, out: inout named)
    match item
    case FnItem(decl: f) then
      match get_fn(info: c.info, name: f.name)
      case Some(value: fi) then
        var pure = (len(fi.effects) == 0) and (ty_show(fi.ret.ty) != "Unit")
        for b in fi.io do
          if b then
            set pure = false
          end if
        end for
        if pure and tree_shaped(f.body) and terminates(f.body) then
          set bodies = insert(map: bodies, key: f.name, value: f.body)
          if len(f.body) == 1 then
            match f.body[0].kind
            case Return(value: rv) then
              match rv
              case Some(value: e) then
                set single = insert(map: single, key: f.name, value: e)
              case None then
              end match
            else
            end match
          end if
        end if
      case None then
      end match
    else
    end match
  end for
  // Specifications reach these functions, directly or through specification functions.
  var used: Map<String, Bool> = {}
  var todo = named
  while len(todo) > 0 do
    let n = todo[len(todo) - 1]
    set todo = slice(of: todo, from: 0, to: len(todo) - 1)
    if has(map: used, key: n) then
      continue
    end if
    set used = insert(map: used, key: n, value: true)
    match lookup(map: bodies, key: n)
    case Some(value: b) then
      for x in tree_callees(b) do
        set todo = push(list: todo, item: x)
      end for
    case None then
    end match
  end while
  var cand: Map<String, Bool> = {}
  for n in keys(bodies) do
    if has(map: single, key: n) or has(map: used, key: n) then
      set cand = insert(map: cand, key: n, value: true)
    end if
  end for
  var notes: Map<String, String> = {}
  var changed = true
  while changed do
    var drop: List<String> = []
    for n in keys(cand) do
      let b = value_or(opt: lookup(map: bodies, key: n), default: [])
      var safe = true
      for e in tree_exprs(b) do
        if not spec_safe(c: c, e: e, cand: cand) then
          set safe = false
        end if
      end for
      var seen: List<String> = []
      if not safe then
        set drop = push(list: drop, item: n)
      elif reaches(from: n, target: n, bodies: bodies, cand: cand, seen: inout seen) and not has_measure(c: c, n: n) then
        set drop = push(list: drop, item: n)
        set notes = insert(map: notes, key: n, value: "it is recursive and has no 'decreases' measure")
      end if
    end for
    set changed = len(drop) > 0
    for n in drop do
      set cand = remove_key(m: cand, k: n)
    end for
  end while
  for n in keys(cand) do
    match get_fn(info: c.info, name: n)
    case Some(value: fi) then
      var seen: List<String> = []
      let rec = reaches(from: n, target: n, bodies: bodies, cand: cand, seen: inout seen)
      var fi2 = fi
      match lookup(map: single, key: n)
      case Some(value: e) then
        if rec then
          set fi2 = fi with (spec_body: lookup(map: bodies, key: n), spec_rec: true)
        else
          set fi2 = fi with (inline: Option.Some(value: e))
        end if
      case None then
        set fi2 = fi with (spec_body: lookup(map: bodies, key: n), spec_rec: rec)
      end match
      let info = c.info
      set c = c with (info: info with (fns: insert(map: info.fns, key: n, value: fi2)))
    case None then
    end match
  end for
  let info = c.info
  set c = c with (info: info with (spec_notes: notes))
end fn compute_inline

fn has_measure(c: Checker, n: String) -> Bool do
  match get_fn(info: c.info, name: n)
  case Some(value: fi) then
    return is_some(fi.dec)
  case None then
    return false
  end match
end fn has_measure

fn remove_key(m: Map<String, Bool>, k: String) -> Map<String, Bool> do
  var out: Map<String, Bool> = {}
  for x in keys(m) do
    if x != k then
      set out = insert(map: out, key: x, value: true)
    end if
  end for
  return out
end fn remove_key

// A body made only of 'let', 'if', 'match', 'assert' and 'return e'.
fn tree_shaped(stmts: List<Stmt>) -> Bool do
  for s in stmts do
    match s.kind
    case Let(name: n, ty: t, value: v, mutable: m) then
      if m then
        return false
      end if
    case Return(value: v) then
      if not is_some(v) then
        return false
      end if
    case Assert(e: e) then
    case If(arms: arms, els: els) then
      for a in arms do
        if not tree_shaped(a.body) then
          return false
        end if
      end for
      match els
      case Some(value: b) then
        if not tree_shaped(b) then
          return false
        end if
      case None then
      end match
    case Match(scrut: sc, cases: cases, els: els) then
      for cs in cases do
        if not tree_shaped(cs.body) then
          return false
        end if
      end for
      match els
      case Some(value: b) then
        if not tree_shaped(b) then
          return false
        end if
      case None then
      end match
    else
      return false
    end match
  end for
  return true
end fn tree_shaped

// The expressions of a tree-shaped body ('assert's excluded: they are proved, not
// evaluated).
fn tree_exprs(stmts: List<Stmt>) -> List<Expr> do
  var out: List<Expr> = []
  for s in stmts do
    match s.kind
    case Let(name: n, ty: t, value: v, mutable: m) then
      set out = push(list: out, item: v)
    case Return(value: v) then
      match v
      case Some(value: e) then
        set out = push(list: out, item: e)
      case None then
      end match
    case If(arms: arms, els: els) then
      for a in arms do
        set out = push(list: out, item: a.cond)
        set out = out ++ tree_exprs(a.body)
      end for
      match els
      case Some(value: b) then
        set out = out ++ tree_exprs(b)
      case None then
      end match
    case Match(scrut: sc, cases: cases, els: els) then
      set out = push(list: out, item: sc)
      for cs in cases do
        set out = out ++ tree_exprs(cs.body)
      end for
      match els
      case Some(value: b) then
        set out = out ++ tree_exprs(b)
      case None then
      end match
    else
    end match
  end for
  return out
end fn tree_exprs

fn tree_callees(stmts: List<Stmt>) -> List<String> do
  var out: List<String> = []
  for e in tree_exprs(stmts) do
    callees(e: e, out: inout out)
  end for
  return out
end fn tree_callees

// The names called in specification positions of an item: contracts, refinements,
// assertions, checks, loop invariants and measures.
fn spec_calls_item(item: Item, out: inout List<String>) do
  match item
  case FnItem(decl: f) then
    for e in f.pre ++ f.post do
      callees(e: e, out: inout out)
    end for
    for p in f.params do
      spec_calls_type(t: p.ty, out: inout out)
    end for
    match f.ret
    case Some(value: t) then
      spec_calls_type(t: t, out: inout out)
    case None then
    end match
    match f.dec
    case Some(value: d) then
      callees(e: d, out: inout out)
    case None then
    end match
    spec_calls_block(stmts: f.body, out: inout out)
  case StructItem(decl: s) then
    for p in s.fields do
      spec_calls_type(t: p.ty, out: inout out)
    end for
  case EnumItem(decl: e) then
    for vd in e.variants do
      for p in vd.fields do
        spec_calls_type(t: p.ty, out: inout out)
      end for
    end for
  case AliasItem(decl: a) then
    spec_calls_type(t: a.ty, out: inout out)
  end match
end fn spec_calls_item

fn spec_calls_type(t: TypeExpr, out: inout List<String>) do
  match t.refine
  case Some(value: r) then
    callees(e: r, out: inout out)
  case None then
  end match
  for a in t.args do
    spec_calls_type(t: a, out: inout out)
  end for
end fn spec_calls_type

fn spec_calls_block(stmts: List<Stmt>, out: inout List<String>) do
  for s in stmts do
    match s.kind
    case Let(name: n, ty: t, value: v, mutable: m) then
      match t
      case Some(value: x) then
        spec_calls_type(t: x, out: inout out)
      case None then
      end match
    case Assert(e: e) then
      callees(e: e, out: inout out)
    case Check(e: e) then
      callees(e: e, out: inout out)
    case If(arms: arms, els: els) then
      for a in arms do
        spec_calls_block(stmts: a.body, out: inout out)
      end for
      match els
      case Some(value: b) then
        spec_calls_block(stmts: b, out: inout out)
      case None then
      end match
    case While(cond: c, invs: invs, dec: dec, body: body) then
      for i in invs do
        callees(e: i, out: inout out)
      end for
      match dec
      case Some(value: d) then
        callees(e: d, out: inout out)
      case None then
      end match
      spec_calls_block(stmts: body, out: inout out)
    case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
      for i in invs do
        callees(e: i, out: inout out)
      end for
      spec_calls_block(stmts: body, out: inout out)
    case ForEach(name: v, list: l, invs: invs, body: body) then
      for i in invs do
        callees(e: i, out: inout out)
      end for
      spec_calls_block(stmts: body, out: inout out)
    case Match(scrut: sc, cases: cases, els: els) then
      for cs in cases do
        spec_calls_block(stmts: cs.body, out: inout out)
      end for
      match els
      case Some(value: b) then
        spec_calls_block(stmts: b, out: inout out)
      case None then
      end match
    else
    end match
  end for
end fn spec_calls_block

fn spec_safe(c: Checker, e: Expr, cand: Map<String, Bool>) -> Bool do
  match e.kind
  case IntLit(value: v) then
    return true
  case BoolLit(value: v) then
    return true
  case StrLit(value: v) then
    return true
  case Var(name: n) then
    return true
  case Unary(op: op, x: x) then
    return spec_safe(c: c, e: x, cand: cand)
  case Binary(op: op, l: l, r: r) then
    return (op != "++") and spec_safe(c: c, e: l, cand: cand) and spec_safe(c: c, e: r, cand: cand)
  case Index(obj: o, idx: i) then
    return spec_safe(c: c, e: o, cand: cand) and spec_safe(c: c, e: i, cand: cand)
  case Field(obj: o, name: f) then
    match o.kind
    case Var(name: n) then
      return not (has(map: c.info.enums, key: n) or (n == "Option"))
    else
      return spec_safe(c: c, e: o, cand: cand)
    end match
  case Call(callee: callee, args: args) then
    match callee.kind
    case Var(name: n) then
      if not (spec_builtin(n) or has(map: cand, key: n)) then
        return false
      end if
      for a in args do
        if a.is_inout or not spec_safe(c: c, e: a.value, cand: cand) then
          return false
        end if
      end for
      return true
    else
      return false
    end match
  case Quant(q: q, name: v, lo: lo, hi: hi, body: b) then
    return spec_safe(c: c, e: lo, cand: cand) and spec_safe(c: c, e: hi, cand: cand) and spec_safe(c: c, e: b, cand: cand)
  else
    return false
  end match
end fn spec_safe

fn callees(e: Expr, out: inout List<String>) do
  match e.kind
  case Call(callee: c, args: args) then
    match c.kind
    case Var(name: n) then
      set out = push(list: out, item: n)
    else
    end match
    for a in args do
      callees(e: a.value, out: inout out)
    end for
  case Unary(op: op, x: x) then
    callees(e: x, out: inout out)
  case Field(obj: x, name: f) then
    callees(e: x, out: inout out)
  case Binary(op: op, l: l, r: r) then
    callees(e: l, out: inout out)
    callees(e: r, out: inout out)
  case Index(obj: l, idx: r) then
    callees(e: l, out: inout out)
    callees(e: r, out: inout out)
  case Quant(q: q, name: v, lo: lo, hi: hi, body: b) then
    callees(e: lo, out: inout out)
    callees(e: hi, out: inout out)
    callees(e: b, out: inout out)
  else
  end match
end fn callees

// True if 'from' can reach 'target' through calls among the candidates.
// Whether from can call target through specification functions.
fn reaches(from: String, target: String, bodies: Map<String, List<Stmt>>, cand: Map<String, Bool>,
    seen: inout List<String>) -> Bool do
  if not has(map: cand, key: from) then
    return false
  end if
  match lookup(map: bodies, key: from)
  case None then
    return false
  case Some(value: body) then
    for x in tree_callees(body) do
      if x == target then
        return true
      end if
      if not contains_str(xs: seen, x: x) then
        set seen = push(list: seen, item: x)
        if reaches(from: x, target: target, bodies: bodies, cand: cand, seen: inout seen) then
          return true
        end if
      end if
    end for
    return false
  end match
end fn reaches

fn inout_names(fi: FnInfo) -> List<String> do
  var out: List<String> = []
  for i in 0..len(fi.params) do
    if (i < len(fi.io)) and fi.io[i] then
      set out = push(list: out, item: fi.params[i].name)
    end if
  end for
  return out
end fn inout_names

// A loop invariant: a specification in which old(x) names x's value on entry to the
// function.
fn invariant_expr(c: inout Checker, e: Expr) do
  set c = c with (olds: c.inouts)
  spec_expr(c: inout c, e: e)
  set c = c with (olds: [])
end fn invariant_expr

// old(x): the value of the inout parameter x when the function was entered.
fn check_old(c: inout Checker, e: Expr, args: List<Arg>) -> Ty do
  var name = ""
  if (len(args) == 1) and (len(args[0].name) == 0) and not args[0].is_inout then
    match args[0].value.kind
    case Var(name: n) then
      set name = n
    else
    end match
  end if
  if len(name) == 0 then
    err(c: inout c, pos: e.pos, msg: "'old' takes the name of an inout parameter: old(x)")
    return Ty.TUnknown
  end if
  if not contains_str(xs: c.olds, x: name) then
    err(c: inout c, pos: e.pos, msg: "'old(" ++ name ++ ")' must name an inout parameter, in an 'ensures' or a loop invariant")
    return Ty.TUnknown
  end if
  add_call(c: inout c, e: e, ci: CallInfo(kind: "old", name: name, variant: 0, order: []))
  return check_expr(c: inout c, e: args[0].value, expected: Option.None)
end fn check_old

fn spec_expr(c: inout Checker, e: Expr) do
  set c = c with (spec: true)
  let t = check_expr(c: inout c, e: e, expected: Option.Some(value: Ty.TBool))
  expect_ty(c: inout c, pos: e.pos, got: t, want: Ty.TBool, what: "a specification")
  set c = c with (spec: false)
end fn spec_expr

fn check_fn(c: inout Checker, f: FnDecl) do
  match get_fn(info: c.info, name: f.name)
  case None then
    return
  case Some(value: fi) then
    var locals: List<Local> = []
    for i in 0..len(fi.params) do
      var m = false
      if i < len(fi.io) then
        set m = fi.io[i]
      end if
      set locals = push(list: locals, item: Local(name: fi.params[i].name, ty: fi.params[i].rty.ty, mutable: m))
    end for
    set c = c with (locals: locals, marks: [], effects: fi.effects, ret: fi.ret.ty, loops: 0, inouts: inout_names(fi))
    check_block(c: inout c, stmts: f.body)
    set c = c with (inouts: [])
    if (ty_show(fi.ret.ty) != "Unit") and not terminates(f.body) then
      err(c: inout c, pos: f.pos, msg: "function '" ++ f.name ++ "' can finish without returning a " ++ ty_show(fi.ret.ty))
    end if
    set c = c with (locals: [], marks: [])
  end match
end fn check_fn

fn check_block(c: inout Checker, stmts: List<Stmt>) do
  enter(inout c)
  for i in 0..len(stmts) do
    check_stmt(c: inout c, s: stmts[i])
    if ((i + 1) < len(stmts)) and stmt_terminates(stmts[i]) then
      err(c: inout c, pos: stmts[i + 1].pos, msg: "unreachable statement")
    end if
  end for
  leave(inout c)
end fn check_block

fn check_stmt(c: inout Checker, s: Stmt) do
  match s.kind
  case Let(name: name, ty: ty, value: value, mutable: m) then
    var t = Ty.TUnknown
    match ty
    case Some(value: te) then
      let r = resolve(c: inout c, te: te)
      check_arg_refines(c: inout c, te: te)
      match te.refine
      case Some(value: p) then
        if m then
          var changing: List<String> = []
          for l in c.locals do
            if l.mutable then
              set changing = push(list: changing, item: l.name)
            end if
          end for
          check_fixed_pred(c: inout c, e: p, scope: visible(c), subject: r.ty, refined: name, changing: changing)
        else
          check_pred(c: inout c, e: p, scope: visible(c), subject: Option.Some(value: r.ty), res: Option.None)
        end if
      case None then
      end match
      let got = check_expr(c: inout c, e: value, expected: Option.Some(value: r.ty))
      expect_ty(c: inout c, pos: value.pos, got: got, want: r.ty, what: "the value of '" ++ name ++ "'")
      set t = r.ty
    case None then
      set t = check_expr(c: inout c, e: value, expected: Option.None)
    end match
    if name == "_" then
      if m then
        err(c: inout c, pos: s.pos, msg: "use 'let _ = ...' to discard a value")
      end if
    else
      if ty_show(t) == "Unit" then
        err(c: inout c, pos: s.pos, msg: "cannot bind a Unit value")
      end if
      declare(c: inout c, pos: s.pos, name: name, t: t, mutable: m)
    end if
  case Set(name: name, value: value) then
    match find_local(c: c, name: name)
    case None then
      err(c: inout c, pos: s.pos, msg: "unknown variable '" ++ name ++ "'")
    case Some(value: l) then
      if not l.mutable then
        err(c: inout c, pos: s.pos, msg: "'" ++ name ++ "' is not a var and cannot be reassigned")
      end if
      let got = check_expr(c: inout c, e: value, expected: Option.Some(value: l.ty))
      expect_ty(c: inout c, pos: value.pos, got: got, want: l.ty, what: "the new value of '" ++ name ++ "'")
    end match
  case Return(value: v) then
    let ret = c.ret
    match v
    case None then
      if ty_show(ret) != "Unit" then
        err(c: inout c, pos: s.pos, msg: "this function must return a " ++ ty_show(ret))
      end if
    case Some(value: e) then
      if ty_show(ret) == "Unit" then
        err(c: inout c, pos: s.pos, msg: "this function returns Unit; use a bare 'return'")
      end if
      let got = check_expr(c: inout c, e: e, expected: Option.Some(value: ret))
      expect_ty(c: inout c, pos: e.pos, got: got, want: ret, what: "the returned value")
    end match
  case If(arms: arms, els: els) then
    for a in arms do
      let t = check_expr(c: inout c, e: a.cond, expected: Option.Some(value: Ty.TBool))
      expect_ty(c: inout c, pos: a.cond.pos, got: t, want: Ty.TBool, what: "an if condition")
      check_block(c: inout c, stmts: a.body)
    end for
    match els
    case Some(value: b) then
      check_block(c: inout c, stmts: b)
    case None then
    end match
  case While(cond: cond, invs: invs, dec: dec, body: body) then
    let t = check_expr(c: inout c, e: cond, expected: Option.Some(value: Ty.TBool))
    expect_ty(c: inout c, pos: cond.pos, got: t, want: Ty.TBool, what: "a while condition")
    no_inout(c: inout c, e: cond, msg: "an inout argument cannot be in a 'while' condition, which is evaluated before every iteration",
      note: "call it before the loop and again at the end of the body, keeping its result in a var that the condition reads")
    for i in invs do
      invariant_expr(c: inout c, e: i)
    end for
    match dec
    case Some(value: d) then
      set c = c with (spec: true)
      let dt = check_expr(c: inout c, e: d, expected: Option.None)
      expect_measure(c: inout c, pos: d.pos, t: dt)
      set c = c with (spec: false)
    case None then
    end match
    set c = c with (loops: c.loops + 1)
    check_block(c: inout c, stmts: body)
    set c = c with (loops: c.loops - 1)
  case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
    let a = check_expr(c: inout c, e: lo, expected: Option.Some(value: Ty.TInt))
    expect_ty(c: inout c, pos: lo.pos, got: a, want: Ty.TInt, what: "a range bound")
    let b = check_expr(c: inout c, e: hi, expected: Option.Some(value: Ty.TInt))
    expect_ty(c: inout c, pos: hi.pos, got: b, want: Ty.TInt, what: "a range bound")
    enter(inout c)
    declare(c: inout c, pos: s.pos, name: v, t: Ty.TInt, mutable: false)
    for i in invs do
      invariant_expr(c: inout c, e: i)
    end for
    set c = c with (loops: c.loops + 1)
    check_block(c: inout c, stmts: body)
    set c = c with (loops: c.loops - 1)
    leave(inout c)
  case ForEach(name: v, list: l, invs: invs, body: body) then
    let lt = check_expr(c: inout c, e: l, expected: Option.None)
    var et = Ty.TUnknown
    match lt
    case TList(elem: x) then
      set et = x
    case TUnknown then
    else
      err(c: inout c, pos: l.pos, msg: "'for ... in' needs a List, but this is " ++ ty_show(lt))
    end match
    for i in invs do
      invariant_expr(c: inout c, e: i)
    end for
    enter(inout c)
    declare(c: inout c, pos: s.pos, name: v, t: et, mutable: false)
    set c = c with (loops: c.loops + 1)
    check_block(c: inout c, stmts: body)
    set c = c with (loops: c.loops - 1)
    leave(inout c)
  case Match(scrut: scrut, cases: cases, els: els) then
    check_match(c: inout c, pos: s.pos, scrut: scrut, cases: cases, els: els)
  case Assert(e: e) then
    spec_expr(c: inout c, e: e)
  case Check(e: e) then
    spec_expr(c: inout c, e: e)
  case Break then
    if c.loops == 0 then
      err(c: inout c, pos: s.pos, msg: "'break' and 'continue' must be inside a loop")
    end if
  case Continue then
    if c.loops == 0 then
      err(c: inout c, pos: s.pos, msg: "'break' and 'continue' must be inside a loop")
    end if
  case ExprStmt(e: e) then
    let t = check_expr(c: inout c, e: e, expected: Option.None)
    let ts = ty_show(t)
    if (ts != "Unit") and (ts != "?") then
      err(c: inout c, pos: e.pos, msg: "the " ++ ts ++ " result of this call is ignored; bind it with 'let'")
    end if
  end match
end fn check_stmt

fn check_match(c: inout Checker, pos: Pos, scrut: Expr, cases: List<Case>, els: Option<List<Stmt>>) do
  let st = check_expr(c: inout c, e: scrut, expected: Option.None)
  let sts = ty_show(st)
  if sts == "?" then
    return
  end if
  if (sts == "Int") or (sts == "String") then
    var seen: List<String> = []
    for cs in cases do
      var key = ""
      var ok = true
      match cs.pat
      case PInt(value: n) then
        if sts == "Int" then
          set key = int_to_str(n)
        else
          set ok = false
        end if
      case PStr(value: s) then
        if sts == "String" then
          set key = quote_key(s)
        else
          set ok = false
        end if
      else
        set ok = false
      end match
      if not ok then
        err(c: inout c, pos: cs.pos, msg: "this pattern does not match a " ++ sts)
        continue
      end if
      if contains_str(xs: seen, x: key) then
        err(c: inout c, pos: cs.pos, msg: "duplicate case")
      end if
      set seen = push(list: seen, item: key)
      check_block(c: inout c, stmts: cs.body)
    end for
    match els
    case Some(value: b) then
      check_block(c: inout c, stmts: b)
    case None then
      err(c: inout c, pos: pos, msg: "a match on " ++ sts ++ " needs an 'else' arm")
    end match
    return
  end if
  var variants: List<VariantInfo> = []
  let tried = try_kind(scrut: scrut, cases: cases)
  match variants_of(info: c.info, t: st)
  case Some(value: vs) then
    set variants = vs
  case None then
    if len(tried) > 0 then
      err(c: inout c, pos: scrut.pos, msg: try_msg(kind: tried, got: sts))
    else
      err(c: inout c, pos: scrut.pos, msg: "cannot match on a value of type " ++ sts)
    end if
    return
  end match
  if (len(tried) > 0) and ((find_variant(vs: variants, name: tried_variant(tried)) < 0) or not try_type(t: st, kind: tried)) then
    err(c: inout c, pos: scrut.pos, msg: try_msg(kind: tried, got: sts))
    return
  end if
  var covered: List<Int> = []
  for cs in cases do
    match cs.pat
    case PVariant(name: name, binds: binds) then
      let vi = find_variant(vs: variants, name: name)
      if vi < 0 then
        err(c: inout c, pos: cs.pos, msg: sts ++ " has no variant '" ++ name ++ "'")
        continue
      end if
      if int_list_contains(xs: covered, x: vi) then
        err(c: inout c, pos: cs.pos, msg: "duplicate case '" ++ name ++ "'")
      end if
      set covered = push(list: covered, item: vi)
      enter(inout c)
      var used: List<String> = []
      for b in binds do
        if contains_str(xs: used, x: b.field) then
          err(c: inout c, pos: cs.pos, msg: "field '" ++ b.field ++ "' is bound twice")
        end if
        set used = push(list: used, item: b.field)
        let fields = variants[vi].fields
        let fi = find_field(fields: fields, name: b.field)
        if fi >= 0 then
          declare(c: inout c, pos: cs.pos, name: b.binder, t: fields[fi].rty.ty, mutable: false)
        else
          err(c: inout c, pos: cs.pos, msg: "variant '" ++ name ++ "' has no field '" ++ b.field ++ "'")
        end if
      end for
      check_block(c: inout c, stmts: cs.body)
      leave(inout c)
    else
      err(c: inout c, pos: cs.pos, msg: "expected a variant of " ++ sts)
    end match
  end for
  var all = true
  var missing: List<String> = []
  for i in 0..len(variants) do
    if not int_list_contains(xs: covered, x: i) then
      set all = false
      set missing = push(list: missing, item: variants[i].name)
    end if
  end for
  match els
  case Some(value: b) then
    if all then
      err(c: inout c, pos: pos, msg: "every variant is already covered; remove the 'else' arm")
    end if
    check_block(c: inout c, stmts: b)
  case None then
    if not all then
      err(c: inout c, pos: pos, msg: "match is not exhaustive; missing " ++ join(parts: missing, sep: ", "))
    end if
  end match
end fn check_match

// "Result" or "Option" if this match was made from 'try', otherwise "".
fn try_kind(scrut: Expr, cases: List<Case>) -> String do
  match scrut.kind
  case Var(name: n) then
    if (len(n) == 0) or not is_digit(n[0]) or (len(cases) == 0) then
      return ""
    end if
    match cases[0].pat
    case PVariant(name: v, binds: b) then
      if v == "Err" then
        return "Result"
      end if
      return "Option"
    else
      return ""
    end match
  else
    return ""
  end match
end fn try_kind

// Whether t is the kind of value 'try' works on: an Option, or a Result (the
// prelude's, or the program's own), not any enum with variants of those names.
fn try_type(t: Ty, kind: String) -> Bool do
  match t
  case TOpt(inner: x) then
    return kind == "Option"
  case TEnum(name: n) then
    return (kind == "Result") and (local_name(generic_base(n)) == "Result")
  else
    return false
  end match
end fn try_type

fn tried_variant(kind: String) -> String do
  if kind == "Result" then
    return "Err"
  end if
  return "None"
end fn tried_variant

fn try_msg(kind: String, got: String) -> String do
  return "'try' in a function that returns " ++ kind ++ " needs " ++ kind ++ ", but this is " ++ got
end fn try_msg

// Rust's {:?} rendering of a string, used only to detect duplicate cases.
fn quote_key(s: String) -> String do
  return "\"" ++ s ++ "\""
end fn quote_key

// ---- termination ----

fn is_noreturn_call(e: Expr) -> Bool do
  match e.kind
  case Call(callee: c, args: a) then
    match c.kind
    case Var(name: n) then
      return builtin_noreturn(n)
    else
      return false
    end match
  else
    return false
  end match
end fn is_noreturn_call

fn opt_block_has_break(b: Option<List<Stmt>>) -> Bool do
  match b
  case Some(value: s) then
    return has_break(s)
  case None then
    return false
  end match
end fn opt_block_has_break

fn has_break(stmts: List<Stmt>) -> Bool do
  for s in stmts do
    match s.kind
    case Break then
      return true
    case If(arms: arms, els: els) then
      for a in arms do
        if has_break(a.body) then
          return true
        end if
      end for
      if opt_block_has_break(els) then
        return true
      end if
    case Match(scrut: sc, cases: cases, els: els) then
      for cs in cases do
        if has_break(cs.body) then
          return true
        end if
      end for
      if opt_block_has_break(els) then
        return true
      end if
    else
    end match
  end for
  return false
end fn has_break

fn stmt_terminates(s: Stmt) -> Bool do
  match s.kind
  case Return(value: v) then
    return true
  case Break then
    return true
  case Continue then
    return true
  case ExprStmt(e: e) then
    return is_noreturn_call(e)
  case If(arms: arms, els: els) then
    match els
    case Some(value: b) then
      for a in arms do
        if not terminates(a.body) then
          return false
        end if
      end for
      return terminates(b)
    case None then
      return false
    end match
  case Match(scrut: sc, cases: cases, els: els) then
    for cs in cases do
      if not terminates(cs.body) then
        return false
      end if
    end for
    match els
    case Some(value: b) then
      return terminates(b)
    case None then
      return true
    end match
  case While(cond: cond, invs: invs, body: body) then
    match cond.kind
    case BoolLit(value: b) then
      return b and not has_break(body)
    else
      return false
    end match
  else
    return false
  end match
end fn stmt_terminates

fn terminates(stmts: List<Stmt>) -> Bool do
  for s in stmts do
    if stmt_terminates(s) then
      return true
    end if
  end for
  return false
end fn terminates

// ---- expressions ----

fn spec_forbid(c: inout Checker, e: Expr, what: String) -> Bool do
  if c.spec then
    err(c: inout c, pos: e.pos, msg: what ++ " is not allowed in a specification")
    return true
  end if
  return false
end fn spec_forbid

fn need_effect(c: inout Checker, pos: Pos, eff: String, what: String) do
  if not contains_str(xs: c.effects, x: eff) then
    let d = diag(pos: pos, msg: what ++ " uses '" ++ eff ++ "', but the enclosing function does not declare it")
    err_d(c: inout c, d: with_note(d: d, note: "add 'uses " ++ eff ++ "' to the function signature"))
  end if
end fn need_effect

fn check_inout(c: inout Checker, fname: String, args: List<Arg>, order: List<Int>, io: List<Bool>) do
  var seen: List<String> = []
  for pi in 0..len(order) do
    let ai = order[pi]
    if (ai < 0) or (ai >= len(args)) or (pi >= len(io)) then
      continue
    end if
    let a = args[ai]
    if io[pi] and not a.is_inout then
      err(c: inout c, pos: a.pos, msg: "parameter of '" ++ fname ++ "' is inout; pass a var with 'inout'")
    elif (not io[pi]) and a.is_inout then
      err(c: inout c, pos: a.pos, msg: "parameter of '" ++ fname ++ "' is not inout")
    elif a.is_inout then
      match a.value.kind
      case Var(name: v) then
        var ok = false
        match find_local(c: c, name: v)
        case Some(value: l) then
          set ok = l.mutable
        case None then
        end match
        if not ok then
          err(c: inout c, pos: a.pos, msg: "'" ++ v ++ "' must be a var to be passed inout")
        end if
        if contains_str(xs: seen, x: v) then
          err(c: inout c, pos: a.pos, msg: "'" ++ v ++ "' is passed inout more than once in this call")
        end if
        set seen = push(list: seen, item: v)
      else
      end match
    end if
  end for
  // A var passed inout must not also be modified while the other arguments are
  // evaluated: the callee would see a different value from the one passed.
  for v in seen do
    for a in args do
      if not a.is_inout then
        var nested: List<String> = []
        inout_vars(e: a.value, out: inout nested)
        if contains_str(xs: nested, x: v) then
          err(c: inout c, pos: a.pos, msg: "'" ++ v ++ "' is passed inout to '" ++ fname ++ "' and also modified by this argument; use separate statements")
        end if
      end if
    end for
  end for
end fn check_inout

// Reports msg if e passes a variable inout anywhere: e is evaluated repeatedly, which
// the verifier does not model for changes to variables.
fn no_inout(c: inout Checker, e: Expr, msg: String, note: String) do
  var io: List<String> = []
  inout_vars(e: e, out: inout io)
  if len(io) > 0 then
    let d = diag(pos: e.pos, msg: msg)
    set c = c with (errs: push(list: c.errs, item: with_note(d: d, note: note)))
  end if
end fn no_inout

// Variables passed inout anywhere inside an expression.
fn inout_vars(e: Expr, out: inout List<String>) do
  match e.kind
  case Call(callee: c, args: args) then
    inout_vars(e: c, out: inout out)
    for a in args do
      if a.is_inout then
        match a.value.kind
        case Var(name: n) then
          set out = push(list: out, item: n)
        else
        end match
      end if
      inout_vars(e: a.value, out: inout out)
    end for
  case With(obj: c, args: args) then
    inout_vars(e: c, out: inout out)
    for a in args do
      inout_vars(e: a.value, out: inout out)
    end for
  case ListLit(items: items) then
    for x in items do
      inout_vars(e: x, out: inout out)
    end for
  case Unary(op: op, x: x) then
    inout_vars(e: x, out: inout out)
  case Field(obj: x, name: f) then
    inout_vars(e: x, out: inout out)
  case Binary(op: op, l: l, r: r) then
    inout_vars(e: l, out: inout out)
    inout_vars(e: r, out: inout out)
  case Index(obj: l, idx: r) then
    inout_vars(e: l, out: inout out)
    inout_vars(e: r, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    inout_vars(e: lo, out: inout out)
    inout_vars(e: hi, out: inout out)
    inout_vars(e: b, out: inout out)
  else
  end match
end fn inout_vars

fn match_args(c: inout Checker, pos: Pos, what: String, params: List<String>, args: List<Arg>) -> Option<List<Int>> do
  for a in args do
    if a.is_inout and not c.inout_ok then
      err(c: inout c, pos: a.pos, msg: what ++ " takes no inout arguments")
    end if
  end for
  set c = c with (inout_ok: false)
  if (len(params) == 1) and (len(args) == 1) and (len(args[0].name) == 0) then
    return Option.Some(value: [0])
  end if
  var order: List<Int> = []
  for i in 0..len(params) do
    set order = push(list: order, item: -1)
  end for
  var ok = true
  for ai in 0..len(args) do
    let a = args[ai]
    if len(a.name) == 0 then
      err(c: inout c, pos: a.pos, msg: "arguments to " ++ what ++ " must be named")
      set ok = false
    else
      let pi = index_of_str(xs: params, x: a.name)
      if pi < 0 then
        err(c: inout c, pos: a.pos, msg: what ++ " has no parameter '" ++ a.name ++ "'")
        set ok = false
      elif pi < len(order) then
        if order[pi] != -1 then
          err(c: inout c, pos: a.pos, msg: "argument '" ++ a.name ++ "' is given twice")
          set ok = false
        end if
        set order = slice(of: order, from: 0, to: pi) ++ [ai] ++ slice(of: order, from: pi + 1, to: len(order))
      end if
    end if
  end for
  for pi in 0..len(params) do
    if (pi < len(order)) and ok and (order[pi] == -1) then
      err(c: inout c, pos: pos, msg: "missing argument '" ++ params[pi] ++ "' for " ++ what)
      set ok = false
    end if
  end for
  if ok then
    return Option.Some(value: order)
  end if
  for a in args do
    let _ = check_expr(c: inout c, e: a.value, expected: Option.None)
  end for
  return Option.None
end fn match_args

fn check_expr(c: inout Checker, e: Expr, expected: Option<Ty>) -> Ty do
  let t = check_expr_inner(c: inout c, e: e, expected: expected)
  return set_ty(c: inout c, e: e, t: t)
end fn check_expr

fn is_enum_name(c: Checker, n: String) -> Bool do
  return (not is_local(c: c, name: n)) and (has(map: c.info.enums, key: n) or has(map: c.info.genums, key: n) or (n == "Option"))
end fn is_enum_name

fn check_expr_inner(c: inout Checker, e: Expr, expected: Option<Ty>) -> Ty do
  match e.kind
  case IntLit(value: n) then
    return Ty.TInt
  case FloatLit(text: t) then
    return Ty.TFloat
  case StrLit(value: s) then
    return Ty.TStr
  case BoolLit(value: b) then
    return Ty.TBool
  case Var(name: n) then
    match find_local(c: c, name: n)
    case Some(value: l) then
      if contains_str(xs: c.changing, x: n) then
        let d = diag(pos: e.pos, msg: "the refinement of '" ++ c.refined ++ "' names '" ++ n ++ "', which can change")
        let note = "a var's or inout parameter's refinement may name only lets and parameters that are not inout; state the fact as a loop invariant, a check or a postcondition instead"
        set c = c with (errs: push(list: c.errs, item: with_note(d: d, note: note)))
      end if
      return l.ty
    case None then
      if has(map: c.info.enums, key: n) or has(map: c.info.structs, key: n) then
        err(c: inout c, pos: e.pos, msg: "'" ++ n ++ "' is a type, not a value")
      else
        err(c: inout c, pos: e.pos, msg: "unknown variable '" ++ n ++ "'")
      end if
      return Ty.TUnknown
    end match
  case It then
    match c.it_ty
    case Some(value: t) then
      return t
    case None then
      err(c: inout c, pos: e.pos, msg: "'it' is only available inside a 'where' refinement")
      return Ty.TUnknown
    end match
  case Result then
    match c.result_ty
    case Some(value: t) then
      return t
    case None then
      err(c: inout c, pos: e.pos, msg: "'result' is only available inside 'ensures'")
      return Ty.TUnknown
    end match
  case Hole(name: name) then
    if spec_forbid(c: inout c, e: e, what: "a hole") then
      return Ty.TUnknown
    end if
    var t = Ty.TUnknown
    match expected
    case Some(value: x) then
      set t = x
    case None then
    end match
    let h = HoleInfo(id: e.id, pos: e.pos, name: name, expected: t, locals: visible(c))
    let info = c.info
    set c = c with (info: info with (holes: push(list: info.holes, item: h)))
    return t
  case Call(callee: callee, args: args) then
    return check_call(c: inout c, e: e, callee: callee, args: args, expected: expected)
  case Field(obj: obj, name: name) then
    match obj.kind
    case Var(name: tn) then
      if is_enum_name(c: c, n: tn) then
        let none: List<Arg> = []
        return variant_ctor(c: inout c, e: e, tn: tn, vn: name, args: none, expected: expected, called: false)
      end if
    else
    end match
    let ot = check_expr(c: inout c, e: obj, expected: Option.None)
    match ot
    case TStruct(name: sn) then
      let fields = struct_fields(info: c.info, name: sn)
      let fi = find_field(fields: fields, name: name)
      if fi >= 0 then
        return fields[fi].rty.ty
      end if
      err(c: inout c, pos: e.pos, msg: sn ++ " has no field '" ++ name ++ "'")
      return Ty.TUnknown
    case TUnknown then
      return Ty.TUnknown
    else
      err(c: inout c, pos: e.pos, msg: ty_show(ot) ++ " has no fields")
      return Ty.TUnknown
    end match
  case Index(obj: obj, idx: idx) then
    let ot = check_expr(c: inout c, e: obj, expected: Option.None)
    let ix = check_expr(c: inout c, e: idx, expected: Option.Some(value: Ty.TInt))
    expect_ty(c: inout c, pos: idx.pos, got: ix, want: Ty.TInt, what: "an index")
    match ot
    case TList(elem: t) then
      return t
    case TStr then
      return Ty.TInt
    case TUnknown then
      return Ty.TUnknown
    else
      err(c: inout c, pos: e.pos, msg: "cannot index a " ++ ty_show(ot))
      return Ty.TUnknown
    end match
  case ListLit(items: items) then
    if spec_forbid(c: inout c, e: e, what: "a list literal") then
      return Ty.TUnknown
    end if
    var elem: Option<Ty> = Option.None
    match expected
    case Some(value: x) then
      match x
      case TList(elem: t) then
        set elem = Option.Some(value: t)
      else
      end match
    case None then
    end match
    if len(items) == 0 then
      match elem
      case Some(value: t) then
        return Ty.TList(elem: t)
      case None then
        err(c: inout c, pos: e.pos, msg: "cannot infer the element type of '[]'; add a type annotation")
        return Ty.TUnknown
      end match
    end if
    let first = check_expr(c: inout c, e: items[0], expected: elem)
    var et = first
    match elem
    case Some(value: t) then
      set et = t
    case None then
    end match
    expect_ty(c: inout c, pos: items[0].pos, got: first, want: et, what: "a list element")
    for i in 1..len(items) do
      let t = check_expr(c: inout c, e: items[i], expected: Option.Some(value: et))
      expect_ty(c: inout c, pos: items[i].pos, got: t, want: et, what: "a list element")
    end for
    return Ty.TList(elem: et)
  case EmptyMap then
    if spec_forbid(c: inout c, e: e, what: "a map literal") then
      return Ty.TUnknown
    end if
    match expected
    case Some(value: x) then
      match x
      case TMap(key: k, val: v) then
        return x
      case THashMap(key: k, val: v) then
        return x
      else
      end match
    case None then
    end match
    err(c: inout c, pos: e.pos, msg: "cannot infer the type of '{}'; add a type annotation")
    return Ty.TUnknown
  case With(obj: obj, args: args) then
    if spec_forbid(c: inout c, e: e, what: "'with'") then
      return Ty.TUnknown
    end if
    let ot = check_expr(c: inout c, e: obj, expected: expected)
    var sn = ""
    match ot
    case TStruct(name: n) then
      set sn = n
    case TUnknown then
      return Ty.TUnknown
    else
      err(c: inout c, pos: e.pos, msg: "'with' needs a struct, but this is " ++ ty_show(ot))
      return Ty.TUnknown
    end match
    let fields = struct_fields(info: c.info, name: sn)
    var seen: List<String> = []
    for a in args do
      if a.is_inout then
        err(c: inout c, pos: a.pos, msg: "'with' takes no inout arguments")
      end if
      if contains_str(xs: seen, x: a.name) then
        err(c: inout c, pos: a.pos, msg: "field '" ++ a.name ++ "' is updated twice")
      end if
      set seen = push(list: seen, item: a.name)
      let fi = find_field(fields: fields, name: a.name)
      if fi >= 0 then
        let ft = fields[fi].rty.ty
        let got = check_expr(c: inout c, e: a.value, expected: Option.Some(value: ft))
        expect_ty(c: inout c, pos: a.value.pos, got: got, want: ft, what: "field '" ++ a.name ++ "'")
      else
        err(c: inout c, pos: a.pos, msg: sn ++ " has no field '" ++ a.name ++ "'")
        let t = check_expr(c: inout c, e: a.value, expected: Option.None)
      end if
    end for
    return ot
  case Unary(op: op, x: x) then
    var want = Ty.TBool
    if op == "-" then
      set want = Ty.TInt
      // Negation works on Int and Float.
      let t = check_expr(c: inout c, e: x, expected: numeric_expected(x))
      if ty_show(t) == "Float" then
        return Ty.TFloat
      end if
      expect_ty(c: inout c, pos: x.pos, got: t, want: want, what: "the operand of '-'")
      return want
    end if
    let t = check_expr(c: inout c, e: x, expected: Option.Some(value: want))
    expect_ty(c: inout c, pos: x.pos, got: t, want: want, what: "the operand of '" ++ op ++ "'")
    return want
  case Binary(op: op, l: l, r: r) then
    return check_binary(c: inout c, e: e, op: op, l: l, r: r)
  case Quant(q: q, name: v, lo: lo, hi: hi, body: body) then
    no_inout(c: inout c, e: body, msg: "an inout argument cannot be inside '" ++ q ++ "', which evaluates its body any number of times",
      note: "call it in a statement of its own first, and use its result here")
    let a = check_expr(c: inout c, e: lo, expected: Option.Some(value: Ty.TInt))
    expect_ty(c: inout c, pos: lo.pos, got: a, want: Ty.TInt, what: "a quantifier bound")
    let b = check_expr(c: inout c, e: hi, expected: Option.Some(value: Ty.TInt))
    expect_ty(c: inout c, pos: hi.pos, got: b, want: Ty.TInt, what: "a quantifier bound")
    enter(inout c)
    declare(c: inout c, pos: e.pos, name: v, t: Ty.TInt, mutable: false)
    let t = check_expr(c: inout c, e: body, expected: Option.Some(value: Ty.TBool))
    expect_ty(c: inout c, pos: body.pos, got: t, want: Ty.TBool, what: "the body of '" ++ q ++ "'")
    leave(inout c)
    return Ty.TBool
  end match
end fn check_expr_inner

// The expected type for an operand that may be Int or Float: Int for a hole, so that its
// report is useful; otherwise none, since the operand decides.
fn numeric_expected(e: Expr) -> Option<Ty> do
  match e.kind
  case Hole(name: n) then
    return Option.Some(value: Ty.TInt)
  else
    return Option.None
  end match
end fn numeric_expected

fn check_binary(c: inout Checker, e: Expr, op: String, l: Expr, r: Expr) -> Ty do
  let what = "the operands of '" ++ op ++ "'"
  if contains_str(xs: ["+", "-", "*", "/", "%", "<", "<=", ">", ">="], x: op) then
    // Int with Int, or Float with Float (never mixed: convert with int_to_float).
    let a = check_expr(c: inout c, e: l, expected: numeric_expected(l))
    if ty_show(a) == "Float" then
      let fb = check_expr(c: inout c, e: r, expected: Option.Some(value: Ty.TFloat))
      expect_ty(c: inout c, pos: r.pos, got: fb, want: Ty.TFloat, what: what)
      if op == "%" then
        err(c: inout c, pos: e.pos, msg: "'%' works on Int, not Float")
      end if
      if contains_str(xs: ["+", "-", "*", "/", "%"], x: op) then
        return Ty.TFloat
      end if
      return Ty.TBool
    end if
    let b = check_expr(c: inout c, e: r, expected: Option.Some(value: Ty.TInt))
    expect_ty(c: inout c, pos: l.pos, got: a, want: Ty.TInt, what: what)
    expect_ty(c: inout c, pos: r.pos, got: b, want: Ty.TInt, what: what)
    if contains_str(xs: ["+", "-", "*", "/", "%"], x: op) then
      return Ty.TInt
    end if
    return Ty.TBool
  end if
  if (op == "and") or (op == "or") or (op == "implies") then
    let a = check_expr(c: inout c, e: l, expected: Option.Some(value: Ty.TBool))
    let b = check_expr(c: inout c, e: r, expected: Option.Some(value: Ty.TBool))
    expect_ty(c: inout c, pos: l.pos, got: a, want: Ty.TBool, what: what)
    expect_ty(c: inout c, pos: r.pos, got: b, want: Ty.TBool, what: what)
    return Ty.TBool
  end if
  if (op == "==") or (op == "!=") then
    let a = check_expr(c: inout c, e: l, expected: Option.None)
    let b = check_expr(c: inout c, e: r, expected: Option.Some(value: a))
    let sa = ty_show(a)
    let sb = ty_show(b)
    if (sa != "?") and (sb != "?") then
      var seen: List<String> = []
      let blocker = eq_blocker(info: c.info, t: a, seen: inout seen)
      if sa != sb then
        err(c: inout c, pos: e.pos, msg: "cannot compare " ++ sa ++ " with " ++ sb)
      elif blocker == sa then
        err(c: inout c, pos: e.pos, msg: "'" ++ op ++ "' does not work on maps (" ++ sa ++ "); compare lookups instead")
      elif len(blocker) > 0 then
        err(c: inout c, pos: e.pos, msg: "'" ++ op ++ "' does not work on " ++ sa ++ ", because it contains " ++ blocker)
      end if
    end if
    return Ty.TBool
  end if
  // "++"
  if spec_forbid(c: inout c, e: e, what: "'++'") then
    return Ty.TUnknown
  end if
  let a = check_expr(c: inout c, e: l, expected: Option.None)
  let b = check_expr(c: inout c, e: r, expected: Option.Some(value: a))
  match a
  case TStr then
    expect_ty(c: inout c, pos: r.pos, got: b, want: a, what: "the right side of '++'")
    return a
  case TList(elem: x) then
    expect_ty(c: inout c, pos: r.pos, got: b, want: a, what: "the right side of '++'")
    return a
  case TUnknown then
    return b
  else
    err(c: inout c, pos: l.pos, msg: "'++' joins Strings or Lists, not " ++ ty_show(a))
    return Ty.TUnknown
  end match
end fn check_binary

fn variant_ctor(c: inout Checker, e: Expr, tn: String, vn: String, args: List<Arg>, expected: Option<Ty>,
    called: Bool) -> Ty do
  match lookup(map: c.info.genums, key: tn)
  case Some(value: ge) then
    return generic_variant(c: inout c, e: e, ge: ge, vn: vn, args: args, expected: expected, called: called)
  case None then
  end match
  var ty = Ty.TEnum(name: tn)
  var inferred = false
  if tn == "Option" then
    var ok = false
    match expected
    case Some(value: x) then
      match x
      case TOpt(inner: i) then
        set ty = x
        set ok = true
      else
      end match
    case None then
    end match
    if not ok then
      if (vn == "Some") and (len(args) == 1) then
        let inner = check_expr(c: inout c, e: args[0].value, expected: Option.None)
        set ty = Ty.TOpt(inner: inner)
        set inferred = true
      else
        err(c: inout c, pos: e.pos, msg: "cannot infer the type of this Option; add a type annotation")
        return Ty.TUnknown
      end if
    end if
  end if
  var variants: List<VariantInfo> = []
  match variants_of(info: c.info, t: ty)
  case Some(value: vs) then
    set variants = vs
  case None then
  end match
  let vi = find_variant(vs: variants, name: vn)
  if vi < 0 then
    err(c: inout c, pos: e.pos, msg: tn ++ " has no variant '" ++ vn ++ "'")
    return Ty.TUnknown
  end if
  let fields = variants[vi].fields
  if (not called) and (len(fields) > 0) and not all_unit(fields) then
    err(c: inout c, pos: e.pos, msg: "variant '" ++ vn ++ "' has fields; construct it with " ++ tn ++ "." ++ vn ++ "(...)")
    return Ty.TUnknown
  end if
  if called and (len(fields) == 0) then
    err(c: inout c, pos: e.pos, msg: "variant '" ++ vn ++ "' has no fields; write " ++ tn ++ "." ++ vn ++ " without parentheses")
    return Ty.TUnknown
  end if
  if not called then
    add_call(c: inout c, e: e, ci: CallInfo(kind: "variant", name: tn, variant: vi, order: []))
    return ty
  end if
  var names: List<String> = []
  for f in fields do
    set names = push(list: names, item: f.name)
  end for
  match match_args(c: inout c, pos: e.pos, what: "variant '" ++ vn ++ "'", params: names, args: args)
  case Some(value: order) then
    for pi in 0..len(fields) do
      if pi < len(order) then
        let ai = order[pi]
        if (ai >= 0) and (ai < len(args)) and not inferred then
          let a = args[ai]
          let ft = fields[pi].rty.ty
          let got = check_expr(c: inout c, e: a.value, expected: Option.Some(value: ft))
          expect_ty(c: inout c, pos: a.value.pos, got: got, want: ft, what: "field '" ++ fields[pi].name ++ "'")
        end if
      end if
    end for
    add_call(c: inout c, e: e, ci: CallInfo(kind: "variant", name: tn, variant: vi, order: order))
  case None then
  end match
  return ty
end fn variant_ctor

fn typed_args(c: inout Checker, args: List<Arg>, order: List<Int>, params: List<FieldInfo>) do
  // Evaluate in written order, checking against the parameter each argument fills.
  for ai in 0..len(args) do
    var pi = -1
    for k in 0..len(order) do
      if order[k] == ai then
        set pi = k
      end if
    end for
    if (pi >= 0) and (pi < len(params)) then
      let p = params[pi]
      let a = args[ai]
      let got = check_expr(c: inout c, e: a.value, expected: Option.Some(value: p.rty.ty))
      expect_ty(c: inout c, pos: a.value.pos, got: got, want: p.rty.ty, what: "argument '" ++ p.name ++ "'")
    end if
  end for
end fn typed_args

fn check_call(c: inout Checker, e: Expr, callee: Expr, args: List<Arg>, expected: Option<Ty>) -> Ty do
  var name = ""
  match callee.kind
  case Var(name: n) then
    set name = n
  case Field(obj: obj, name: vn) then
    match obj.kind
    case Var(name: tn) then
      if is_enum_name(c: c, n: tn) then
        if spec_forbid(c: inout c, e: e, what: "constructing a value") then
          return Ty.TUnknown
        end if
        return variant_ctor(c: inout c, e: e, tn: tn, vn: vn, args: args, expected: expected, called: true)
      end if
    else
    end match
    err(c: inout c, pos: e.pos, msg: "only named functions can be called")
    return Ty.TUnknown
  else
    err(c: inout c, pos: e.pos, msg: "only named functions can be called")
    return Ty.TUnknown
  end match
  if name == "old" then
    return check_old(c: inout c, e: e, args: args)
  end if
  match builtin_params(name)
  case Some(value: params) then
    if c.spec and not spec_builtin(name) then
      err(c: inout c, pos: e.pos, msg: "'" ++ name ++ "' is not allowed in a specification (only len, value_or, is_some and is_none are)")
      return Ty.TUnknown
    end if
    let eff = builtin_effect(name)
    if len(eff) > 0 then
      need_effect(c: inout c, pos: e.pos, eff: eff, what: "'" ++ name ++ "'")
    end if
    match match_args(c: inout c, pos: e.pos, what: "'" ++ name ++ "'", params: params, args: args)
    case None then
      return Ty.TUnknown
    case Some(value: order) then
      add_call(c: inout c, e: e, ci: CallInfo(kind: "builtin", name: name, variant: 0, order: order))
      var a: List<Expr> = []
      for i in order do
        if (i >= 0) and (i < len(args)) then
          set a = push(list: a, item: args[i].value)
        end if
      end for
      if len(a) != len(params) then
        return Ty.TUnknown
      end if
      if len(a) == 0 then
        // The built-ins without parameters: args() and read_line().
        if name == "read_line" then
          return Ty.TOpt(inner: Ty.TStr)
        end if
        return Ty.TList(elem: Ty.TStr)
      end if
      return builtin_call(c: inout c, e: e, name: name, a: a, expected: expected)
    end match
  case None then
  end match
  match lookup(map: c.info.gfns, key: name)
  case Some(value: g) then
    return generic_call(c: inout c, e: e, g: g, args: args, expected: expected)
  case None then
  end match
  match lookup(map: c.info.gstructs, key: name)
  case Some(value: s) then
    if spec_forbid(c: inout c, e: e, what: "constructing a value") then
      return Ty.TUnknown
    end if
    return generic_struct(c: inout c, e: e, s: s, args: args, expected: expected)
  case None then
  end match
  match get_fn(info: c.info, name: name)
  case Some(value: fi) then
    if c.spec then
      if not spec_fn_ok(c: inout c, e: e, name: name) then
        return Ty.TUnknown
      end if
    end if
    for u in fi.effects do
      need_effect(c: inout c, pos: e.pos, eff: u, what: "'" ++ name ++ "'")
    end for
    var names: List<String> = []
    for p in fi.params do
      set names = push(list: names, item: p.name)
    end for
    set c = c with (inout_ok: true)
    match match_args(c: inout c, pos: e.pos, what: "'" ++ name ++ "'", params: names, args: args)
    case Some(value: order) then
      typed_args(c: inout c, args: args, order: order, params: fi.params)
      check_inout(c: inout c, fname: name, args: args, order: order, io: fi.io)
      add_call(c: inout c, e: e, ci: CallInfo(kind: "user", name: name, variant: 0, order: order))
    case None then
    end match
    return fi.ret.ty
  case None then
  end match
  if has(map: c.info.structs, key: name) then
    if spec_forbid(c: inout c, e: e, what: "constructing a value") then
      return Ty.TUnknown
    end if
    let fields = struct_fields(info: c.info, name: name)
    var names: List<String> = []
    for f in fields do
      set names = push(list: names, item: f.name)
    end for
    match match_args(c: inout c, pos: e.pos, what: "struct '" ++ name ++ "'", params: names, args: args)
    case Some(value: order) then
      typed_args(c: inout c, args: args, order: order, params: fields)
      add_call(c: inout c, e: e, ci: CallInfo(kind: "struct", name: name, variant: 0, order: order))
    case None then
    end match
    return Ty.TStruct(name: name)
  end if
  if has(map: c.info.enums, key: name) then
    err(c: inout c, pos: e.pos, msg: "'" ++ name ++ "' is an enum; construct a variant with " ++ name ++ ".Variant(...)")
  else
    err(c: inout c, pos: e.pos, msg: "unknown function '" ++ name ++ "'")
  end if
  for a in args do
    let _ = check_expr(c: inout c, e: a.value, expected: Option.None)
  end for
  return Ty.TUnknown
end fn check_call

// ---- generic calls and constructors ----

// Values whose type comes from where they are used: [], {} and variants without
// fields, such as Option.None.
fn needs_context(c: Checker, e: Expr) -> Bool do
  match e.kind
  case ListLit(items: items) then
    return len(items) == 0
  case EmptyMap then
    return true
  case Field(obj: o, name: n) then
    match o.kind
    case Var(name: tn) then
      return is_enum_name(c: c, n: tn)
    else
      return false
    end match
  else
    return false
  end match
end fn needs_context

// Checks the arguments of a call to something generic, binding type parameters as
// their types become known: first the arguments that have a type of their own, then
// those that take it from the parameter. Returns each argument's type, by position.
fn infer_args(c: inout Checker, args: List<Arg>, order: List<Int>, params: List<Param>, tps: List<String>,
    subst: inout Map<String, Ty>) -> List<Ty> do
  var got: List<Ty> = []
  for a in args do
    set got = push(list: got, item: Ty.TUnknown)
  end for
  for ai in 0..len(args) do
    if not needs_context(c: c, e: args[ai].value) then
      let t = infer_arg(c: inout c, args: args, ai: ai, order: order, params: params, tps: tps, subst: inout subst)
      if ai < len(got) then
        set got = set_at(list: got, at: ai, value: t)
      end if
    end if
  end for
  for ai in 0..len(args) do
    if needs_context(c: c, e: args[ai].value) then
      let t = infer_arg(c: inout c, args: args, ai: ai, order: order, params: params, tps: tps, subst: inout subst)
      if ai < len(got) then
        set got = set_at(list: got, at: ai, value: t)
      end if
    end if
  end for
  return got
end fn infer_args

fn infer_arg(c: inout Checker, args: List<Arg>, ai: Int where (0 <= it) and (it < len(args)), order: List<Int>,
    params: List<Param>, tps: List<String>, subst: inout Map<String, Ty>) -> Ty do
  var pi = -1
  for k in 0..len(order) do
    if order[k] == ai then
      set pi = k
    end if
  end for
  var exp: Option<Ty> = Option.None
  if (pi >= 0) and (pi < len(params)) then
    let te = params[pi].ty
    if bound_in(te: te, tps: tps, subst: subst) then
      let saved = c.info.tenv
      set_tenv(c: inout c, env: subst)
      var errs: List<Diag> = []
      var info = c.info
      let r = resolve_type(info: inout info, te: te, errs: inout errs)
      set c = c with (info: info with (tenv: saved))
      set exp = Option.Some(value: r.ty)
    end if
  end if
  let t = check_expr(c: inout c, e: args[ai].value, expected: exp)
  if (pi >= 0) and (pi < len(params)) then
    unify(info: c.info, te: params[pi].ty, t: t, tps: tps, subst: inout subst)
  end if
  return t
end fn infer_arg

// The type arguments, in declaration order, or None after reporting the first that
// could not be inferred.
fn type_args(c: inout Checker, pos: Pos, tps: List<String>, subst: Map<String, Ty>, what: String) -> Option<List<Ty>> do
  var out: List<Ty> = []
  for t in tps do
    match lookup(map: subst, key: t)
    case Some(value: x) then
      set out = push(list: out, item: x)
    case None then
      let d = diag(pos: pos, msg: "cannot infer the type parameter " ++ t ++ " of " ++ what)
      err_d(c: inout c, d: with_note(d: d, note: "add a type annotation to the variable this value is bound to"))
      return Option.None
    end match
  end for
  return Option.Some(value: out)
end fn type_args

fn expect_args(c: inout Checker, args: List<Arg>, order: List<Int>, got: List<Ty>, params: List<FieldInfo>, what: String) do
  for pi in 0..len(order) do
    let ai = order[pi]
    if (ai >= 0) and (ai < len(args)) and (ai < len(got)) and (pi < len(params)) then
      let a = args[ai]
      var msg = what ++ " '" ++ params[pi].name ++ "'"
      match a.value.kind
      case Var(name: n) then
        if (len(n) > 0) and is_digit(n[0]) then
          set msg = "the error passed on by 'try' (the function's error type)"
        end if
      else
      end match
      expect_ty(c: inout c, pos: a.value.pos, got: got[ai], want: params[pi].rty.ty, what: msg)
    end if
  end for
end fn expect_args

// True if the function name (a generic one by its own name) may be called in a
// specification; otherwise reports why not.
fn spec_fn_ok(c: inout Checker, e: Expr, name: String) -> Bool do
  match get_fn(info: c.info, name: name)
  case Some(value: fi) then
    if is_some(fi.inline) or is_some(fi.spec_body) then
      return true
    end if
  case None then
  end match
  match lookup(map: c.info.spec_notes, key: name)
  case Some(value: why) then
    err(c: inout c, pos: e.pos, msg: "'" ++ name ++ "' cannot be used in a specification: " ++ why)
  case None then
    err(c: inout c, pos: e.pos, msg: "'" ++ name ++ "' cannot be used in a specification: only pure functions whose bodies use just let, if, match, assert and return over specification expressions can")
  end match
  return false
end fn spec_fn_ok

// The value of a body that is exactly 'return e'.
fn return_expr(body: List<Stmt>) -> Option<Expr> do
  if len(body) == 1 then
    match body[0].kind
    case Return(value: rv) then
      return rv
    else
    end match
  end if
  return Option.None
end fn return_expr

fn generic_call(c: inout Checker, e: Expr, g: FnDecl, args: List<Arg>, expected: Option<Ty>) -> Ty do
  if c.spec then
    if not spec_fn_ok(c: inout c, e: e, name: g.name) then
      return Ty.TUnknown
    end if
  end if
  for u in g.effects do
    need_effect(c: inout c, pos: e.pos, eff: u.name, what: "'" ++ g.name ++ "'")
  end for
  var names: List<String> = []
  for p in g.params do
    set names = push(list: names, item: p.name)
  end for
  set c = c with (inout_ok: true)
  match match_args(c: inout c, pos: e.pos, what: "'" ++ g.name ++ "'", params: names, args: args)
  case None then
    return Ty.TUnknown
  case Some(value: order) then
    var subst: Map<String, Ty> = {}
    match expected
    case Some(value: t) then
      match g.ret
      case Some(value: rt) then
        unify(info: c.info, te: rt, t: t, tps: g.tparams, subst: inout subst)
      case None then
      end match
    case None then
    end match
    let got = infer_args(c: inout c, args: args, order: order, params: g.params, tps: g.tparams, subst: inout subst)
    match type_args(c: inout c, pos: e.pos, tps: g.tparams, subst: subst, what: "'" ++ g.name ++ "'")
    case None then
      return Ty.TUnknown
    case Some(value: targs) then
      let inst = instantiate_fn(c: inout c, g: g, args: targs, pos: e.pos)
      match get_fn(info: c.info, name: inst)
      case Some(value: fi) then
        expect_args(c: inout c, args: args, order: order, got: got, params: fi.params, what: "argument")
        check_inout(c: inout c, fname: g.name, args: args, order: order, io: fi.io)
        add_call(c: inout c, e: e, ci: CallInfo(kind: "user", name: inst, variant: 0, order: order))
        return fi.ret.ty
      case None then
        return Ty.TUnknown
      end match
    end match
  end match
end fn generic_call

fn generic_struct(c: inout Checker, e: Expr, s: StructDecl, args: List<Arg>, expected: Option<Ty>) -> Ty do
  var names: List<String> = []
  for f in s.fields do
    set names = push(list: names, item: f.name)
  end for
  match match_args(c: inout c, pos: e.pos, what: "struct '" ++ s.name ++ "'", params: names, args: args)
  case None then
    return Ty.TUnknown
  case Some(value: order) then
    var subst: Map<String, Ty> = {}
    match expected
    case Some(value: t) then
      unify(info: c.info, te: self_type(name: s.name, tps: s.tparams, pos: e.pos), t: t, tps: s.tparams, subst: inout subst)
    case None then
    end match
    let got = infer_args(c: inout c, args: args, order: order, params: s.fields, tps: s.tparams, subst: inout subst)
    match type_args(c: inout c, pos: e.pos, tps: s.tparams, subst: subst, what: "struct '" ++ s.name ++ "'")
    case None then
      return Ty.TUnknown
    case Some(value: targs) then
      let t = instantiate(c: inout c, name: s.name, args: targs, pos: e.pos)
      let inst = ty_show(t)
      expect_args(c: inout c, args: args, order: order, got: got, params: struct_fields(info: c.info, name: inst), what: "field")
      add_call(c: inout c, e: e, ci: CallInfo(kind: "struct", name: inst, variant: 0, order: order))
      return t
    end match
  end match
end fn generic_struct

fn instantiate(c: inout Checker, name: String, args: List<Ty>, pos: Pos) -> Ty do
  var info = c.info
  var errs = c.errs
  let t = instantiate_type(info: inout info, name: name, args: args, pos: pos, errs: inout errs)
  set c = c with (info: info, errs: errs)
  check_pending(inout c)
  return t
end fn instantiate

fn generic_variant(c: inout Checker, e: Expr, ge: EnumDecl, vn: String, args: List<Arg>, expected: Option<Ty>,
    called: Bool) -> Ty do
  var vi = -1
  for i in 0..len(ge.variants) do
    if ge.variants[i].name == vn then
      set vi = i
    end if
  end for
  if (vi < 0) or (vi >= len(ge.variants)) then
    err(c: inout c, pos: e.pos, msg: ge.name ++ " has no variant '" ++ vn ++ "'")
    return Ty.TUnknown
  end if
  let vd = ge.variants[vi]
  let fields_msg = "variant '" ++ vn ++ "' has fields; construct it with " ++ ge.name ++ "." ++ vn ++ "(...)"
  if (not called) and (len(vd.fields) > 0) then
    // Allowed only when the expected type makes every field Unit.
    match expected
    case Some(value: t) then
      match lookup(map: c.info.enums, key: ty_show(t))
      case Some(value: vs) then
        if (generic_base(ty_show(t)) == ge.name) and (vi < len(vs)) and all_unit(vs[vi].fields) then
          add_call(c: inout c, e: e, ci: CallInfo(kind: "variant", name: ty_show(t), variant: vi, order: []))
          return t
        end if
      case None then
      end match
    case None then
    end match
    err(c: inout c, pos: e.pos, msg: fields_msg)
    return Ty.TUnknown
  end if
  if called and (len(vd.fields) == 0) then
    err(c: inout c, pos: e.pos, msg: "variant '" ++ vn ++ "' has no fields; write " ++ ge.name ++ "." ++ vn ++ " without parentheses")
    return Ty.TUnknown
  end if
  var names: List<String> = []
  for f in vd.fields do
    set names = push(list: names, item: f.name)
  end for
  match match_args(c: inout c, pos: e.pos, what: "variant '" ++ vn ++ "'", params: names, args: args)
  case None then
    return Ty.TUnknown
  case Some(value: order) then
    var subst: Map<String, Ty> = {}
    match expected
    case Some(value: t) then
      unify(info: c.info, te: self_type(name: ge.name, tps: ge.tparams, pos: e.pos), t: t, tps: ge.tparams, subst: inout subst)
    case None then
    end match
    let got = infer_args(c: inout c, args: args, order: order, params: vd.fields, tps: ge.tparams, subst: inout subst)
    match type_args(c: inout c, pos: e.pos, tps: ge.tparams, subst: subst, what: ge.name)
    case None then
      return Ty.TUnknown
    case Some(value: targs) then
      let t = instantiate(c: inout c, name: ge.name, args: targs, pos: e.pos)
      let inst = ty_show(t)
      match lookup(map: c.info.enums, key: inst)
      case Some(value: vs) then
        if vi < len(vs) then
          expect_args(c: inout c, args: args, order: order, got: got, params: vs[vi].fields, what: "field")
        end if
      case None then
      end match
      add_call(c: inout c, e: e, ci: CallInfo(kind: "variant", name: inst, variant: vi, order: order))
      return t
    end match
  end match
end fn generic_variant

fn want(c: inout Checker, x: Expr, t: Ty, what: String) do
  let got = check_expr(c: inout c, e: x, expected: Option.Some(value: t))
  expect_ty(c: inout c, pos: x.pos, got: got, want: t, what: what)
end fn want

fn builtin_call(c: inout Checker, e: Expr, name: String, a: List<Expr> where len(it) > 0, expected: Option<Ty>) -> Ty do
  let strs = Ty.TList(elem: Ty.TStr)
  match name
  case "len" then
    let t = check_expr(c: inout c, e: a[0], expected: Option.None)
    match t
    case TList(elem: x) then
    case TStr then
    case TMap(key: k, val: v) then
    case THashMap(key: k, val: v) then
    case TUnknown then
    else
      err(c: inout c, pos: a[0].pos, msg: "'len' needs a List, String or Map, not " ++ ty_show(t))
    end match
    return Ty.TInt
  case "push" then
    let lt = check_expr(c: inout c, e: a[0], expected: expected)
    if len(a) < 2 then
      return Ty.TUnknown
    end if
    match lt
    case TList(elem: t) then
      want(c: inout c, x: a[1], t: t, what: "the pushed item")
      return lt
    case TUnknown then
      let t = check_expr(c: inout c, e: a[1], expected: Option.None)
      return Ty.TUnknown
    else
      err(c: inout c, pos: a[0].pos, msg: "'push' needs a List, not " ++ ty_show(lt))
      return Ty.TUnknown
    end match
  case "set_at" then
    let lt = check_expr(c: inout c, e: a[0], expected: expected)
    if len(a) < 3 then
      return Ty.TUnknown
    end if
    want(c: inout c, x: a[1], t: Ty.TInt, what: "'at'")
    match lt
    case TList(elem: t) then
      want(c: inout c, x: a[2], t: t, what: "the new element")
      return lt
    case TUnknown then
      let _ = check_expr(c: inout c, e: a[2], expected: Option.None)
      return Ty.TUnknown
    else
      err(c: inout c, pos: a[0].pos, msg: "'set_at' needs a List, not " ++ ty_show(lt))
      return Ty.TUnknown
    end match
  case "slice" then
    let t = check_expr(c: inout c, e: a[0], expected: expected)
    if len(a) < 3 then
      return Ty.TUnknown
    end if
    want(c: inout c, x: a[1], t: Ty.TInt, what: "'from'")
    want(c: inout c, x: a[2], t: Ty.TInt, what: "'to'")
    match t
    case TList(elem: x) then
      return t
    case TStr then
      return t
    case TUnknown then
      return t
    else
      err(c: inout c, pos: a[0].pos, msg: "'slice' needs a List or String, not " ++ ty_show(t))
      return Ty.TUnknown
    end match
  case "join" then
    if len(a) < 2 then
      return Ty.TUnknown
    end if
    want(c: inout c, x: a[0], t: strs, what: "'parts'")
    want(c: inout c, x: a[1], t: Ty.TStr, what: "'sep'")
    return Ty.TStr
  case "int_to_str" then
    want(c: inout c, x: a[0], t: Ty.TInt, what: "the argument")
    return Ty.TStr
  case "str_to_int" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the argument")
    return Ty.TOpt(inner: Ty.TInt)
  case "int_to_float" then
    want(c: inout c, x: a[0], t: Ty.TInt, what: "the argument")
    return Ty.TFloat
  case "str_to_float" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the argument")
    return Ty.TOpt(inner: Ty.TFloat)
  case "float_to_int" then
    want(c: inout c, x: a[0], t: Ty.TFloat, what: "the argument")
    return Ty.TOpt(inner: Ty.TInt)
  case "float_to_str" then
    want(c: inout c, x: a[0], t: Ty.TFloat, what: "the argument")
    return Ty.TStr
  case "float_to_fixed" then
    if len(a) < 2 then
      return Ty.TUnknown
    end if
    want(c: inout c, x: a[0], t: Ty.TFloat, what: "the number")
    want(c: inout c, x: a[1], t: Ty.TInt, what: "the number of digits")
    return Ty.TStr
  case "is_nan" then
    want(c: inout c, x: a[0], t: Ty.TFloat, what: "the argument")
    return Ty.TBool
  case "char" then
    want(c: inout c, x: a[0], t: Ty.TInt, what: "the character code")
    return Ty.TStr
  case "hash" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the argument")
    return Ty.TStr
  case "panic" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the message")
    return Ty.TUnit
  case "print" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the message")
    return Ty.TUnit
  case "eprint" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the message")
    return Ty.TUnit
  case "read_file" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the path")
    return Ty.TOpt(inner: Ty.TStr)
  case "write_file" then
    if len(a) < 2 then
      return Ty.TUnknown
    end if
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the path")
    want(c: inout c, x: a[1], t: Ty.TStr, what: "the contents")
    return Ty.TBool
  case "getenv" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the variable name")
    return Ty.TOpt(inner: Ty.TStr)
  case "read_bytes" then
    want(c: inout c, x: a[0], t: Ty.TInt, what: "the number of bytes")
    return Ty.TStr
  case "make_dir" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the path")
    return Ty.TBool
  case "list_dir" then
    want(c: inout c, x: a[0], t: Ty.TStr, what: "the path")
    return Ty.TOpt(inner: Ty.TList(elem: Ty.TStr))
  case "run" then
    if len(a) < 2 then
      return Ty.TUnknown
    end if
    want(c: inout c, x: a[0], t: strs, what: "'argv'")
    want(c: inout c, x: a[1], t: Ty.TStr, what: "'input'")
    return Ty.TStruct(name: "Output")
  case "exit" then
    want(c: inout c, x: a[0], t: Ty.TInt, what: "the exit code")
    return Ty.TUnit
  case "is_some" then
    return option_test(c: inout c, name: name, x: a[0])
  case "is_none" then
    return option_test(c: inout c, name: name, x: a[0])
  case "value_or" then
    let t = check_expr(c: inout c, e: a[0], expected: Option.None)
    if len(a) < 2 then
      return Ty.TUnknown
    end if
    match t
    case TOpt(inner: inner) then
      want(c: inout c, x: a[1], t: inner, what: "the default")
      return inner
    case TUnknown then
      let _ = check_expr(c: inout c, e: a[1], expected: Option.None)
      return Ty.TUnknown
    else
      err(c: inout c, pos: a[0].pos, msg: "'value_or' needs an Option, not " ++ ty_show(t))
      return Ty.TUnknown
    end match
  else
    if contains_str(xs: ["floor", "ceil", "round", "sqrt", "abs_float"], x: name) then
      want(c: inout c, x: a[0], t: Ty.TFloat, what: "the argument")
      return Ty.TFloat
    end if
    return map_builtin(c: inout c, e: e, name: name, a: a, expected: expected)
  end match
end fn builtin_call

fn option_test(c: inout Checker, name: String, x: Expr) -> Ty do
  let t = check_expr(c: inout c, e: x, expected: Option.None)
  match t
  case TOpt(inner: i) then
  case TUnknown then
  else
    err(c: inout c, pos: x.pos, msg: "'" ++ name ++ "' needs an Option, not " ++ ty_show(t))
  end match
  return Ty.TBool
end fn option_test

fn map_builtin(c: inout Checker, e: Expr, name: String, a: List<Expr> where len(it) > 0, expected: Option<Ty>) -> Ty do
  var mt = Ty.TUnknown
  if name == "insert" then
    set mt = check_expr(c: inout c, e: a[0], expected: expected)
  else
    set mt = check_expr(c: inout c, e: a[0], expected: Option.None)
  end if
  var k = Ty.TUnknown
  var v = Ty.TUnknown
  match mt
  case TMap(key: kk, val: vv) then
    set k = kk
    set v = vv
  case THashMap(key: kk, val: vv) then
    set k = kk
    set v = vv
  case TUnknown then
    for i in 1..len(a) do
      let t = check_expr(c: inout c, e: a[i], expected: Option.None)
    end for
    return Ty.TUnknown
  else
    err(c: inout c, pos: a[0].pos, msg: "'" ++ name ++ "' needs a Map, not " ++ ty_show(mt))
    return Ty.TUnknown
  end match
  if (name != "keys") and (len(a) > 1) then
    want(c: inout c, x: a[1], t: k, what: "the key")
  end if
  match name
  case "insert" then
    if len(a) > 2 then
      want(c: inout c, x: a[2], t: v, what: "the value")
    end if
    return mt
  case "lookup" then
    return Ty.TOpt(inner: v)
  case "has" then
    return Ty.TBool
  else
    return Ty.TList(elem: k)
  end match
end fn map_builtin
