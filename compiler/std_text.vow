    "  return slice(of: s, from: 0, to: b)\n" ++
    "end fn trim_end\n" ++
    "\n" ++
    "fn trim(s: String) -> String\n" ++
    "  ensures len(result) <= len(s)\n" ++
    "  ensures (len(result) > 0) implies not is_space(result[0])\n" ++
    "  ensures (len(result) > 0) implies not is_space(result[len(result) - 1])\n" ++
