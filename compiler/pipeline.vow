// The checking and verification pipeline shared by vowc and the language server: from
// loaded source to the diagnostics a user sees.

import "load.vow"
import "verify.vow"
import "total.vow"

// The sort declaration must come first; declarations before assertions.
fn order_preamble(pre: Map<String, Bool>) -> List<String> do
  var sorts: List<String> = []
  var decls: List<String> = []
  var rest: List<String> = []
  for k in keys(pre) do
    if starts_with(s: k, p: "(declare-sort") then
      set sorts = push(list: sorts, item: k)
    elif starts_with(s: k, p: "(declare") then
      set decls = push(list: decls, item: k)
    else
      set rest = push(list: rest, item: k)
    end if
  end for
  return sorts ++ decls ++ rest
end fn order_preamble

fn pos_key(p: Pos) -> String do
  return int_to_str(p.file) ++ ":" ++ int_to_str(p.line) ++ ":" ++ int_to_str(p.col)
end fn pos_key

struct Checked
  c: Checker,
  rec: Recursion,
  // Type, effect and measure errors; when there are any, the rest is not meaningful.
  errs: List<Diag>,
end struct Checked

// Type-checks a loaded program and analyses its recursion. Without need_main the
// program may lack a main; with tests (vowc test, or an editor's file of tests) each
// function named test_... must have the shape of a test.
fn check_source(src: Source, need_main: Bool, tests: Bool) -> Checked do
  var c = check_program(items: src.items, files: src.files, next_id: src.next_id)
  var errs = src.errs
  var at: List<String> = []
  for d in src.errs do
    set at = push(list: at, item: pos_key(d.pos))
  end for
  for d in c.errs do
    // A name the loader already reported (as private, say) is also unknown to the
    // checker; one error is enough.
    if contains_str(xs: at, x: pos_key(d.pos)) then
      continue
    end if
    if need_main or (d.msg != "the program has no 'fn main()'") then
      set errs = push(list: errs, item: d)
    end if
  end for
  if tests then
    set errs = errs ++ test_shape_errors(src.items)
  end if
  let rec = recursion(items: src.items, info: c.info)
  if len(errs) == 0 then
    set errs = measure_errors(items: src.items, r: rec, info: c.info)
  end if
  let info0 = c.info
  set c = c with (info: info0 with (scc: rec.scc, recursive: rec.recursive))
  return Checked(c: c, rec: rec, errs: errs)
end fn check_source

struct Verified
  // Holes (with the facts known at each) or failed proofs.
  diags: List<Diag>,
  // Trouble running Z3, or "", and where: the function it was proving, or the start
  // of the program.
  error: String,
  error_pos: Pos,
  // Whether Z3 left some proof undecided.
  undecided: Bool,
end struct Verified

// A function's verification key: a hash of the verifier version and of exactly what
// its proof sends to Z3 (the shared declarations it names, and its part of the script).
// So the key changes when anything the proof depends on does, wherever in the program
// that is, and only then. Keys from every program share one store, so a key is two
// 64-bit hashes of the text, begun differently: 128 bits.
fn query_key(vc: FnVc) -> String do
  let globals = join(parts: vc.globals, sep: "\n")
  let none: Option<Ob> = Option.None
  let block = join(parts: fn_block(vc: vc, model: none, legacy: false), sep: "\n")
  let text = verifier_version() ++ "\n" ++ globals ++ "\n\n" ++ block
  return hash("a\n" ++ text) ++ hash("b\n" ++ text)
end fn query_key

fn env_or_empty(name: String) -> String uses proc do
  match getenv(name)
  case Some(value: x) then
    return x
  case None then
    return ""
  end match
end fn env_or_empty

// The directory that holds this verifier version's proofs, shared by every program the
// user checks: $VOW_CACHE, or else vow/ in $XDG_CACHE_HOME, or else ~/.cache/vow. ""
// when none of those is set: then nothing is kept.
fn proof_store() -> String uses proc do
  var base = env_or_empty("VOW_CACHE")
  if len(base) == 0 then
    let xdg = env_or_empty("XDG_CACHE_HOME")
    let home = env_or_empty("HOME")
    if len(xdg) > 0 then
      set base = xdg ++ "/vow"
    elif len(home) > 0 then
      set base = home ++ "/.cache/vow"
    else
      return ""
    end if
  end if
  return base ++ "/proofs/" ++ verifier_version()
end fn proof_store

// A proof is an empty file named by its key, in a directory named by the key's first
// two characters. A file is made only after Z3 proved every obligation of the query,
// and never changed, so programs running at once need no lock.
fn proof_dir(store: String, key: String) -> String do
  if len(key) < 2 then
    return store ++ "/00"
  end if
  return store ++ "/" ++ slice(of: key, from: 0, to: 2)
end fn proof_dir

struct FnKey
  name: String,
  key: String,
end struct FnKey

// Each function's verification key, for `vowc hash`.
fn query_keys(src: Source, c: Checker) -> List<FnKey> do
  var v = new_verifier(c.info)
  var out: List<FnKey> = []
  for item in src.items do
    match item
    case FnItem(decl: f) then
      let vc = verify_fn(v: inout v, f: f)
      set out = push(list: out, item: FnKey(name: f.name, key: query_key(vc)))
    else
    end match
  end for
  return out
end fn query_keys

// A verification in progress: what verify_source does, in steps, for a caller that has
// other work to do between them (the language server answers requests).
struct Proving
  // The proof store, or "" to keep nothing.
  store: String,
  pre: List<String>,
  // Every function with something to send to Z3, and how many have been sent.
  vcs: List<FnVc>,
  next: Int,
  // Those of vcs whose proofs can be kept.
  asked: List<FnKey>,
  // v03: one script, with every function in it.
  every: Bool,
  // The holes, if the program has any: then nothing is proved.
  holes: List<Diag>,
  failures: List<Failure>,
  // Trouble running Z3 ("" if none), and the function it was proving.
  error: String,
  fn_name: String,
  done: Bool,
end struct Proving

// Begins to verify a checked program. Every function's queries are generated, which is
// quick; those whose verification key is in the proof store are not sent to Z3, and the
// keys of those proved are added to it. v03 (VOW_SMT_V03, for tests/differential.sh)
// proves with the v0.3 encoding, which lacks facts later found to be needed: such a run
// neither reads the store nor adds to it.
fn begin_proof(src: Source, c: Checker, no_cache: Bool, v03: Bool) -> Proving uses fs, proc do
  let none: List<Failure> = []
  var store = ""
  if not (no_cache or v03) then
    set store = proof_store()
  end if
  var v = new_verifier(c.info)
  if v03 then
    set v = v with (hyps: false)
  end if
  var vcs: List<FnVc> = []
  // The functions sent to Z3 whose proofs can be kept.
  var asked: List<FnKey> = []
  for item in src.items do
    match item
    case FnItem(decl: f) then
      let vc = verify_fn(v: inout v, f: f)
      if (len(store) == 0) or (len(vc.obs) == 0) then
        set vcs = push(list: vcs, item: vc)
      else
        let key = query_key(vc)
        if is_none(read_file(proof_dir(store: store, key: key) ++ "/" ++ key)) then
          set vcs = push(list: vcs, item: vc)
          set asked = push(list: asked, item: FnKey(name: f.name, key: key))
        end if
      end if
    else
    end match
  end for
  var holes: List<Diag> = []
  var done = false
  if len(c.info.holes) > 0 then
    set holes = hole_diags(c: c, v: v)
    set done = true
  end if
  return Proving(store: store, pre: order_preamble(v.preamble), vcs: vcs, next: 0, asked: asked, every: v03, holes: holes,
    failures: none, error: "", fn_name: "", done: done)
end fn begin_proof

// Sends Z3 the next functions: as many as have `queries` queries between them (one
// function at least), or with queries <= 0 all that are left. The proofs made are
// added to the store, so a verification that is abandoned keeps those it made.
fn prove_step(p: Proving, queries: Int) -> Proving uses fs, proc do
  if p.done then
    return p
  end if
  var part: List<FnVc> = []
  var names: Map<String, Bool> = {}
  var count = 0
  var i = p.next
  if i < 0 then
    set i = 0
  end if
  let n = len(p.vcs)
  while (i < n) and ((queries <= 0) or (count < queries)) invariant i >= 0 decreases n - i do
    let vc = p.vcs[i]
    set part = push(list: part, item: vc)
    set names = insert(map: names, key: vc.name, value: true)
    set count = count + (len(vc.obs) + 1)
    set i = i + 1
  end while
  let r = discharge(pre: p.pre, vcs: part, every: p.every)
  if len(r.error) > 0 then
    return p with (next: i, error: r.error, fn_name: r.fn_name, done: true)
  end if
  var failed: Map<String, Bool> = {}
  for f in r.failures do
    set failed = insert(map: failed, key: f.fn_name, value: true)
  end for
  for h in p.asked do
    if has(map: names, key: h.name) and not has(map: failed, key: h.name) then
      // Failing to write is no error: the proof is made again next time.
      let dir = proof_dir(store: p.store, key: h.key)
      let made = make_dir(dir)
      let written = write_file(path: dir ++ "/" ++ h.key, contents: "")
    end if
  end for
  return p with (next: i, failures: p.failures ++ r.failures, done: i >= n)
end fn prove_step

// What a finished verification found.
fn proof_result(src: Source, p: Proving) -> Verified do
  let none: List<Diag> = []
  let nowhere = Pos(file: 0, line: 0, col: 0)
  if len(p.holes) > 0 then
    return Verified(diags: p.holes, error: "", error_pos: nowhere, undecided: false)
  end if
  if len(p.error) > 0 then
    var at = nowhere
    for item in src.items do
      match item
      case FnItem(decl: f) then
        if f.name == p.fn_name then
          set at = f.pos
        end if
      else
      end match
    end for
    // The function named as its file names it.
    var msg = p.error
    let named = shown(src: src, diags: [diag(pos: at, msg: p.error)])
    if len(named) > 0 then
      set msg = named[0].msg
    end if
    return Verified(diags: none, error: msg, error_pos: at, undecided: false)
  end if
  var diags: List<Diag> = []
  var undecided = false
  for f in p.failures do
    set diags = push(list: diags, item: failure_diag(f))
    // Z3 gave up; not "unknown-unfolded", which no Z3 decides.
    if f.verdict == "unknown" then
      set undecided = true
    end if
  end for
  return Verified(diags: diags, error: "", error_pos: nowhere, undecided: undecided)
end fn proof_result

// Verifies a checked program (begin_proof, in one step).
fn verify_source(src: Source, c: Checker, no_cache: Bool, v03: Bool) -> Verified uses fs, proc do
  let p = begin_proof(src: src, c: c, no_cache: no_cache, v03: v03)
  return proof_result(src: src, p: prove_step(p: p, queries: 0))
end fn verify_source

fn hole_diags(c: Checker, v: Verifier) -> List<Diag> do
  var out: List<Diag> = []
  for h in c.info.holes do
    var d = diag(pos: h.pos, msg: "?" ++ h.name ++ " needs a value of type " ++ ty_show(h.expected))
    set d = d with (kind: "hole")
    var locals: List<String> = []
    for l in h.locals do
      set locals = push(list: locals, item: l.name ++ ": " ++ ty_show(l.ty))
    end for
    if len(locals) == 0 then
      set d = with_note(d: d, note: "in scope: (nothing)")
    else
      set d = with_note(d: d, note: "in scope: " ++ join(parts: locals, sep: ", "))
    end if
    match lookup(map: v.hole_facts, key: h.id)
    case Some(value: facts) then
      if len(facts) > 0 then
        set d = with_note(d: d, note: "known facts: " ++ join(parts: facts, sep: "; "))
      end if
    case None then
    end match
    set out = push(list: out, item: d)
  end for
  return out
end fn hole_diags

// Whether the root file is a file of tests: it has no main, and a function named
// test_... that takes no parameters and returns nothing. (A function named test_bit
// in a program or a library is an ordinary function.)
fn is_test_file(items: List<Item>) -> Bool do
  var some = false
  for item in items do
    match item
    case FnItem(decl: f) then
      if f.pos.file == 0 then
        if f.name == "main" then
          return false
        end if
        if starts_with(s: f.name, p: "test_") and (len(f.params) == 0) and is_none(f.ret) and (len(f.tparams) == 0) then
          set some = true
        end if
      end if
    else
    end match
  end for
  return some
end fn is_test_file

fn test_shape_errors(items: List<Item>) -> List<Diag> do
  var out: List<Diag> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      if starts_with(s: f.name, p: "test_") and (f.pos.file == 0) then
        if (len(f.params) > 0) or is_some(f.ret) or (len(f.tparams) > 0) then
          let msg = "test function '" ++ f.name ++ "' must take no parameters and return nothing"
          set out = push(list: out, item: diag(pos: f.pos, msg: msg))
        end if
      end if
    else
    end match
  end for
  return out
end fn test_shape_errors
