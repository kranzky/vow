// Loading source files and their imports.

import "modules.vow"
import "packages.vow"
import "std_text.vow"
import "std_json.vow"

// Standard library modules, embedded in the compiler. `import "std/text.vow"` names
// the module "<std>/text.vow", wherever the importing file is.
fn std_source(name: String) -> Option<String> do
  if name == "text.vow" then
    return Option.Some(value: std_text())
  elif name == "json.vow" then
    return Option.Some(value: std_json())
  end if
  return Option.None
end fn std_source

// Lexical path normalisation, identical to the bootstrap compiler's.
fn normalize(path: String) -> String do
  let absolute = starts_with(s: path, p: "/")
  var parts: List<String> = []
  for p in split(s: path, sep: '/') do
    if (len(p) == 0) or (p == ".") then
      continue
    end if
    let n = len(parts)
    if (p == "..") and (n > 0) and (parts[n - 1] != "..") then
      set parts = slice(of: parts, from: 0, to: n - 1)
      continue
    end if
    if (p == "..") and absolute then
      continue
    end if
    set parts = push(list: parts, item: p)
  end for
  let j = join(parts: parts, sep: "/")
  if absolute then
    return "/" ++ j
  end if
  if len(j) == 0 then
    return "."
  end if
  return j
end fn normalize

fn dirname(path: String) -> String do
  let i = find_last_byte(s: path, c: '/')
  if i == 0 then
    return "/"
  end if
  if i < 0 then
    return ""
  end if
  return slice(of: path, from: 0, to: i)
end fn dirname

fn join_path(dir: String, rel: String) -> String do
  if starts_with(s: rel, p: "std/") then
    return "<std>/" ++ slice(of: rel, from: 4, to: len(rel))
  end if
  if starts_with(s: rel, p: "/") or (len(dir) == 0) then
    return normalize(rel)
  end if
  return normalize(dir ++ "/" ++ rel)
end fn join_path

struct Source
  files: List<String>,
  items: List<Item>,
  errs: List<Diag>,
  // The first expression id not used by any loaded file.
  next_id: Int,
end struct Source

// Declarations every program gets, unless it declares a type of the same name.
fn prelude_source() -> String do
  return "enum Result<T, E>\n  Ok(value: T),\n  Err(error: E),\nend enum Result\n"
end fn prelude_source

struct Pending
  path: String,
  from: Pos,
end struct Pending

// An import as loaded: the normalised path of the imported file.
struct RawImport
  path: String,
  imp: Import,
end struct RawImport

fn load(root: String) -> Source uses fs do
  return load_with(root: root, overrides: {})
end fn load

// As load, but a file whose (normalised) path is a key of overrides has that text
// instead of what is on disk: an editor's unsaved buffer.
fn load_with(root: String, overrides: Map<String, String>) -> Source uses fs do
  var files: List<String> = []
  var mods: List<ModFile> = []
  var raws: List<List<RawImport>> = []
  var errs: List<Diag> = []
  var next_id = 0
  var queue: List<Pending> = [Pending(path: normalize(root), from: no_pos())]
  while len(queue) > 0 do
    let top = queue[len(queue) - 1]
    set queue = slice(of: queue, from: 0, to: len(queue) - 1)
    if contains_str(xs: files, x: top.path) then
      continue
    end if
    let file_id = len(files)
    set files = push(list: files, item: top.path)
    var mf = ModFile(path: top.path, items: [], imports: [], privates: [], loaded: false)
    var raw: List<RawImport> = []
    var source: Option<String> = Option.None
    var missing = "cannot open '" ++ top.path ++ "'"
    if starts_with(s: top.path, p: "<std>/") then
      let m = slice(of: top.path, from: 6, to: len(top.path))
      set source = std_source(m)
      set missing = "there is no standard module 'std/" ++ m ++ "'"
    elif has(map: overrides, key: top.path) then
      set source = lookup(map: overrides, key: top.path)
    else
      set source = read_file(top.path)
    end if
    match source
    case None then
      set errs = push(list: errs, item: diag(pos: top.from, msg: missing))
    case Some(value: src) then
      let lx = lex(src: src, file: file_id)
      match lx.err
      case Some(value: d) then
        set errs = push(list: errs, item: d)
      case None then
        if len(lx.toks) > 0 then
          var p = new_parser(toks: lx.toks, first_id: next_id)
          let parsed = parse_file(inout p)
          match p.err
          case Some(value: d) then
            set errs = push(list: errs, item: d)
          case None then
            set next_id = p.next_id
            let dir = dirname(top.path)
            for imp in parsed.imports do
              if starts_with(s: imp.path, p: "@") then
                let pp = resolve_package(file: top.path, rel: imp.path, pos: imp.pos)
                match pp.err
                case Some(value: d) then
                  set errs = push(list: errs, item: d)
                case None then
                  set raw = push(list: raw, item: RawImport(path: pp.path, imp: imp))
                end match
              else
                set raw = push(list: raw, item: RawImport(path: join_path(dir: dir, rel: imp.path), imp: imp))
              end if
            end for
            // Push in reverse so imports are processed in source order.
            var k = len(raw) - 1
            while k >= 0 invariant k < len(raw) do
              set queue = push(list: queue, item: Pending(path: raw[k].path, from: raw[k].imp.pos))
              set k = k - 1
            end while
            set mf = mf with (items: parsed.items, privates: parsed.privates, loaded: true)
          end match
        end if
      end match
    end match
    set mods = push(list: mods, item: mf)
    set raws = push(list: raws, item: raw)
  end while
  // Each import, with the index of the file it names.
  var linked: List<ModFile> = []
  for i in 0..len(mods) do
    var imps: List<ModImport> = []
    if i < len(raws) then
      for ri in raws[i] do
        let t = index_of_str(xs: files, x: ri.path)
        set imps = push(list: imps, item: ModImport(target: t, alias: ri.imp.alias, names: ri.imp.names, pos: ri.imp.pos))
      end for
    end if
    set linked = push(list: linked, item: mods[i] with (imports: imps))
  end for
  // The prelude, unless the program's global namespace declares Result.
  var declared = false
  for f in merge_closure(files: linked, start: 0) do
    if (f >= 0) and (f < len(linked)) then
      for item in linked[f].items do
        if item_name(item) == "Result" then
          set declared = true
        end if
      end for
    end if
  end for
  var shared: List<Int> = []
  if (len(errs) == 0) and not declared then
    let lx = lex(src: prelude_source(), file: len(files))
    if len(lx.toks) > 0 then
      var p = new_parser(toks: lx.toks, first_id: next_id)
      let parsed = parse_file(inout p)
      set shared = [len(files)]
      set files = push(list: files, item: "<std>/prelude.vow")
      set linked = push(list: linked, item: ModFile(path: "<std>/prelude.vow", items: parsed.items, imports: [], privates: [], loaded: true))
      set next_id = p.next_id
    end if
  end if
  let res = resolve_modules(files: linked, shared: shared)
  return Source(files: files, items: res.items, errs: errs ++ res.errs, next_id: next_id)
end fn load_with

fn render_diag(d: Diag, files: List<String>) -> String do
  var file = "?"
  if (d.pos.file >= 0) and (d.pos.file < len(files)) then
    set file = files[d.pos.file]
  end if
  var s = file ++ ":" ++ int_to_str(d.pos.line) ++ ":" ++ int_to_str(d.pos.col) ++ ": " ++ d.kind ++ ": " ++ d.msg ++ "\n"
  for n in d.notes do
    set s = s ++ "    " ++ n ++ "\n"
  end for
  return s
end fn render_diag
