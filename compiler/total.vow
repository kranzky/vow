// Recursion and termination. The call graph covers calls anywhere a function's proof
// looks (its body and its contracts); its strongly connected components are the
// groups of mutually recursive functions. A call within a group must decrease the
// caller's measure, so when one member of a group has a measure, all must.

import "hash.vow"

// The functions f's proof refers to: calls in its body and contracts, and in the
// refinements of its parameters, result and annotated locals (written directly or
// through a type alias); and, as "type T" nodes, the structs and enums whose field
// refinements it may assume (the types of its expressions and parameters).
fn proof_callees(f: FnDecl, info: Info) -> List<String> do
  var out: List<String> = []
  calls_in_block(stmts: f.body, info: info, out: inout out)
  calls_in_all(es: f.pre, info: info, out: inout out)
  calls_in_all(es: f.post, info: info, out: inout out)
  match get_fn(info: info, name: f.name)
  case Some(value: fi) then
    for p in fi.params do
      calls_in_all(es: p.rty.preds, info: info, out: inout out)
      type_nodes(t: p.rty.ty, out: inout out)
    end for
    calls_in_all(es: fi.ret.preds, info: info, out: inout out)
    type_nodes(t: fi.ret.ty, out: inout out)
  case None then
  end match
  for p in f.params do
    calls_in_opt_expr(e: p.ty.refine, info: info, out: inout out)
  end for
  match f.ret
  case Some(value: t) then
    calls_in_opt_expr(e: t.refine, info: info, out: inout out)
  case None then
  end match
  calls_in_opt_expr(e: f.dec, info: info, out: inout out)
  types_in_block(stmts: f.body, info: info, out: inout out)
  types_in_all(es: f.pre, info: info, out: inout out)
  types_in_all(es: f.post, info: info, out: inout out)
  return out
end fn proof_callees

// "type T" for each struct and enum T in t.
fn type_nodes(t: Ty, out: inout List<String>) do
  match t
  case TStruct(name: n) then
    add_name(out: inout out, n: "type " ++ n)
  case TEnum(name: n) then
    add_name(out: inout out, n: "type " ++ n)
  case TList(elem: x) then
    type_nodes(t: x, out: inout out)
  case TOpt(inner: x) then
    type_nodes(t: x, out: inout out)
  case TMap(key: k, val: x) then
    type_nodes(t: k, out: inout out)
    type_nodes(t: x, out: inout out)
  case THashMap(key: k, val: x) then
    type_nodes(t: k, out: inout out)
    type_nodes(t: x, out: inout out)
  else
  end match
end fn type_nodes

// The type nodes of every expression in e, and the calls in the refinement of a local's
// annotation.
fn types_in_expr(e: Expr, info: Info, out: inout List<String>) do
  type_nodes(t: type_of(info: info, e: e), out: inout out)
  match e.kind
  case Call(callee: c, args: args) then
    types_in_expr(e: c, info: info, out: inout out)
    for a in args do
      types_in_expr(e: a.value, info: info, out: inout out)
    end for
  case With(obj: c, args: args) then
    types_in_expr(e: c, info: info, out: inout out)
    for a in args do
      types_in_expr(e: a.value, info: info, out: inout out)
    end for
  case ListLit(items: items) then
    types_in_all(es: items, info: info, out: inout out)
  case Index(obj: a, idx: b) then
    types_in_expr(e: a, info: info, out: inout out)
    types_in_expr(e: b, info: info, out: inout out)
  case Binary(op: op, l: a, r: b) then
    types_in_expr(e: a, info: info, out: inout out)
    types_in_expr(e: b, info: info, out: inout out)
  case Field(obj: a, name: n) then
    types_in_expr(e: a, info: info, out: inout out)
  case Unary(op: op, x: a) then
    types_in_expr(e: a, info: info, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    types_in_expr(e: lo, info: info, out: inout out)
    types_in_expr(e: hi, info: info, out: inout out)
    types_in_expr(e: b, info: info, out: inout out)
  else
  end match
end fn types_in_expr

fn types_in_all(es: List<Expr>, info: Info, out: inout List<String>) do
  for e in es do
    types_in_expr(e: e, info: info, out: inout out)
  end for
end fn types_in_all

fn types_in_opt(b: Option<List<Stmt>>, info: Info, out: inout List<String>) do
  match b
  case Some(value: s) then
    types_in_block(stmts: s, info: info, out: inout out)
  case None then
  end match
end fn types_in_opt

fn types_in_block(stmts: List<Stmt>, info: Info, out: inout List<String>) do
  for s in stmts do
    match s.kind
    case Let(name: n, ty: t, value: value, mutable: m) then
      types_in_expr(e: value, info: info, out: inout out)
      match t
      case Some(value: te) then
        calls_in_opt_expr(e: te.refine, info: info, out: inout out)
        match lookup(map: info.aliases, key: te.name)
        case Some(value: a) then
          calls_in_all(es: a.preds, info: info, out: inout out)
        case None then
        end match
      case None then
      end match
    case Set(name: n, value: value) then
      types_in_expr(e: value, info: info, out: inout out)
    case Return(value: v) then
      match v
      case Some(value: e) then
        types_in_expr(e: e, info: info, out: inout out)
      case None then
      end match
    case Assert(e: e) then
      types_in_expr(e: e, info: info, out: inout out)
    case Check(e: e) then
      types_in_expr(e: e, info: info, out: inout out)
    case ExprStmt(e: e) then
      types_in_expr(e: e, info: info, out: inout out)
    case If(arms: arms, els: els) then
      for a in arms do
        types_in_expr(e: a.cond, info: info, out: inout out)
        types_in_block(stmts: a.body, info: info, out: inout out)
      end for
      types_in_opt(b: els, info: info, out: inout out)
    case While(cond: c, invs: invs, dec: dec, body: body) then
      types_in_expr(e: c, info: info, out: inout out)
      types_in_all(es: invs, info: info, out: inout out)
      types_in_block(stmts: body, info: info, out: inout out)
    case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
      types_in_expr(e: lo, info: info, out: inout out)
      types_in_expr(e: hi, info: info, out: inout out)
      types_in_all(es: invs, info: info, out: inout out)
      types_in_block(stmts: body, info: info, out: inout out)
    case ForEach(name: v, list: l, invs: invs, body: body) then
      types_in_expr(e: l, info: info, out: inout out)
      types_in_all(es: invs, info: info, out: inout out)
      types_in_block(stmts: body, info: info, out: inout out)
    case Match(scrut: sc, cases: cases, els: els) then
      types_in_expr(e: sc, info: info, out: inout out)
      for cs in cases do
        types_in_block(stmts: cs.body, info: info, out: inout out)
      end for
      types_in_opt(b: els, info: info, out: inout out)
    else
    end match
  end for
end fn types_in_block

// The edges of a struct or enum's node: the calls in its field refinements and the
// types of its fields.
fn type_edges(fields: List<FieldInfo>, info: Info, out: inout List<String>) do
  for fl in fields do
    calls_in_all(es: fl.rty.preds, info: info, out: inout out)
    type_nodes(t: fl.rty.ty, out: inout out)
  end for
end fn type_edges

fn out_edges(edges: Map<String, List<String>>, n: String) -> List<String> do
  match lookup(map: edges, key: n)
  case Some(value: es) then
    return es
  case None then
    let none: List<String> = []
    return none
  end match
end fn out_edges

// The strongly connected components (Kosaraju): each name's component number.
fn components(names: List<String>, edges: Map<String, List<String>>) -> Map<String, Int> do
  // Pass 1: the order in which depth-first searches finish.
  var visited: Map<String, Bool> = {}
  var order: List<String> = []
  for root in names do
    if has(map: visited, key: root) then
      continue
    end if
    set visited = insert(map: visited, key: root, value: true)
    var stack = [root]
    var pos = [0]
    while len(stack) > 0 invariant len(pos) == len(stack) do
      let k = len(stack) - 1
      let n = stack[k]
      let es = out_edges(edges: edges, n: n)
      let p = pos[k]
      if (p >= 0) and (p < len(es)) then
        set pos = set_at(list: pos, at: k, value: p + 1)
        let m = es[p]
        if not has(map: visited, key: m) then
          set visited = insert(map: visited, key: m, value: true)
          set stack = push(list: stack, item: m)
          set pos = push(list: pos, item: 0)
        end if
      else
        set order = push(list: order, item: n)
        set stack = slice(of: stack, from: 0, to: k)
        set pos = slice(of: pos, from: 0, to: k)
      end if
    end while
  end for
  // Pass 2: search the reversed graph in reverse finishing order.
  var rev: Map<String, List<String>> = {}
  for n in names do
    for m in out_edges(edges: edges, n: n) do
      set rev = insert(map: rev, key: m, value: push(list: out_edges(edges: rev, n: m), item: n))
    end for
  end for
  var comp: Map<String, Int> = {}
  var next = 0
  var i = len(order)
  while i > 0 invariant i <= len(order) do
    set i = i - 1
    let root = order[i]
    if has(map: comp, key: root) then
      continue
    end if
    set comp = insert(map: comp, key: root, value: next)
    var stack = [root]
    while len(stack) > 0 do
      let n = stack[len(stack) - 1]
      set stack = slice(of: stack, from: 0, to: len(stack) - 1)
      for m in out_edges(edges: rev, n: n) do
        if not has(map: comp, key: m) then
          set comp = insert(map: comp, key: m, value: next)
          set stack = push(list: stack, item: m)
        end if
      end for
    end while
    set next = next + 1
  end while
  return comp
end fn components

struct Recursion
  edges: Map<String, List<String>>,
  scc: Map<String, Int>,
  // Functions that can call themselves, directly or through others.
  recursive: Map<String, Bool>,
end struct Recursion

fn recursion(items: List<Item>, info: Info) -> Recursion do
  var names: List<String> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      set names = push(list: names, item: f.name)
    else
    end match
  end for
  // Struct and enum nodes: a proof that assumes a field refinement relies on the
  // functions it calls, so they belong to the proof's group if they rely on it in turn.
  var tedges: Map<String, List<String>> = {}
  for sn in keys(info.structs) do
    var es: List<String> = []
    type_edges(fields: struct_fields(info: info, name: sn), info: info, out: inout es)
    set tedges = insert(map: tedges, key: "type " ++ sn, value: es)
  end for
  for en in keys(info.enums) do
    var es: List<String> = []
    match lookup(map: info.enums, key: en)
    case Some(value: vs) then
      for vi in vs do
        type_edges(fields: vi.fields, info: info, out: inout es)
      end for
    case None then
    end match
    set tedges = insert(map: tedges, key: "type " ++ en, value: es)
  end for
  let tnames = keys(tedges)
  // Function-to-function edges decide which functions are recursive; the groups are
  // the components of the whole graph.
  var edges: Map<String, List<String>> = {}
  var all: Map<String, List<String>> = {}
  for item in items do
    match item
    case FnItem(decl: f) then
      var es: List<String> = []
      var fs: List<String> = []
      for g in proof_callees(f: f, info: info) do
        if contains_str(xs: names, x: g) then
          set es = push(list: es, item: g)
          set fs = push(list: fs, item: g)
        elif contains_str(xs: tnames, x: g) then
          set es = push(list: es, item: g)
        end if
      end for
      set edges = insert(map: edges, key: f.name, value: fs)
      set all = insert(map: all, key: f.name, value: es)
    else
    end match
  end for
  for tn in tnames do
    var es: List<String> = []
    for g in out_edges(edges: tedges, n: tn) do
      if contains_str(xs: names, x: g) or contains_str(xs: tnames, x: g) then
        set es = push(list: es, item: g)
      end if
    end for
    set all = insert(map: all, key: tn, value: es)
  end for
  let comp = components(names: names ++ tnames, edges: all)
  var scc: Map<String, Int> = {}
  for n in names do
    set scc = insert(map: scc, key: n, value: scc_of(scc: comp, n: n))
  end for
  let fcomp = components(names: names, edges: edges)
  var size: Map<Int, Int> = {}
  for n in names do
    let k = scc_of(scc: fcomp, n: n)
    set size = insert(map: size, key: k, value: value_or(opt: lookup(map: size, key: k), default: 0) + 1)
  end for
  var recursive: Map<String, Bool> = {}
  for n in names do
    let k = scc_of(scc: fcomp, n: n)
    let es = out_edges(edges: edges, n: n)
    if (value_or(opt: lookup(map: size, key: k), default: 0) > 1) or contains_str(xs: es, x: n) then
      set recursive = insert(map: recursive, key: n, value: true)
    end if
  end for
  return Recursion(edges: edges, scc: scc, recursive: recursive)
end fn recursion

fn scc_of(scc: Map<String, Int>, n: String) -> Int do
  return value_or(opt: lookup(map: scc, key: n), default: -1)
end fn scc_of

// When one function of a recursive group has a measure, every member needs one. A
// measure may not call a function of its own group: within the group's proofs such a
// function is known only through what the group assumes of its calls, so a measure made
// of it would be justified by the termination it is meant to prove.
fn measure_errors(items: List<Item>, r: Recursion, info: Info) -> List<Diag> do
  var measured: Map<Int, String> = {}
  for item in items do
    match item
    case FnItem(decl: f) then
      if has(map: r.recursive, key: f.name) and is_some(f.dec) then
        set measured = insert(map: measured, key: scc_of(scc: r.scc, n: f.name), value: f.name)
      end if
    else
    end match
  end for
  var out: List<Diag> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      if has(map: r.recursive, key: f.name) then
        match f.dec
        case Some(value: d) then
          var called: List<String> = []
          calls_in_expr(e: d, info: info, out: inout called)
          for g in called do
            if scc_of(scc: r.scc, n: g) == scc_of(scc: r.scc, n: f.name) then
              let msg = "the measure of '" ++ f.name ++ "' calls '" ++ g ++ "', which is recursive with '" ++ f.name ++ "'"
              let dg = diag(pos: d.pos, msg: msg)
              set out = push(list: out, item: with_note(d: dg, note: "a measure must be defined without the functions whose termination it proves"))
            end if
          end for
        case None then
        end match
      end if
      if has(map: r.recursive, key: f.name) and not is_some(f.dec) then
        match lookup(map: measured, key: scc_of(scc: r.scc, n: f.name))
        case Some(value: g) then
          let msg = "'" ++ f.name ++ "' is mutually recursive with '" ++ g ++ "', which has a 'decreases' measure; give '" ++ f.name ++ "' one too"
          set out = push(list: out, item: diag(pos: f.pos, msg: msg))
        case None then
        end match
      end if
    else
    end match
  end for
  return out
end fn measure_errors

// ---- totality ----

// The position of the first 'while' loop without a measure, if any.
fn unmeasured_loop(stmts: List<Stmt>) -> Option<Pos> do
  for s in stmts do
    var inner: List<List<Stmt>> = []
    match s.kind
    case While(cond: c, invs: invs, dec: dec, body: body) then
      if not is_some(dec) then
        return Option.Some(value: s.pos)
      end if
      set inner = [body]
    case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
      set inner = [body]
    case ForEach(name: v, list: l, invs: invs, body: body) then
      set inner = [body]
    case If(arms: arms, els: els) then
      for a in arms do
        set inner = push(list: inner, item: a.body)
      end for
      match els
      case Some(value: b) then
        set inner = push(list: inner, item: b)
      case None then
      end match
    case Match(scrut: sc, cases: cases, els: els) then
      for cs in cases do
        set inner = push(list: inner, item: cs.body)
      end for
      match els
      case Some(value: b) then
        set inner = push(list: inner, item: b)
      case None then
      end match
    else
    end match
    for b in inner do
      match unmeasured_loop(b)
      case Some(value: p) then
        return Option.Some(value: p)
      case None then
      end match
    end for
  end for
  return Option.None
end fn unmeasured_loop

struct Totality
  name: String,
  // "" when the function is proved to terminate.
  reason: String,
end struct Totality

// Which functions are proved to terminate (given that verification succeeds): every
// 'while' loop has a measure, recursion is measured, and every function called is
// proved to terminate too. Built-in functions are taken to terminate.
fn totality(items: List<Item>, info: Info, r: Recursion, files: List<String>) -> List<Totality> do
  var names: List<String> = []
  var reason: Map<String, String> = {}
  var calls: Map<String, List<String>> = {}
  for item in items do
    match item
    case FnItem(decl: f) then
      set names = push(list: names, item: f.name)
      var why = ""
      match unmeasured_loop(f.body)
      case Some(value: p) then
        set why = "has a 'while' loop without 'decreases' at " ++ pos_text(p: p, files: files)
      case None then
        if has(map: r.recursive, key: f.name) and not is_some(f.dec) then
          set why = "is recursive and has no 'decreases' measure"
        end if
      end match
      set reason = insert(map: reason, key: f.name, value: why)
      var cs: List<String> = []
      calls_in_block(stmts: f.body, info: info, out: inout cs)
      set calls = insert(map: calls, key: f.name, value: cs)
    else
    end match
  end for
  var changed = true
  while changed do
    set changed = false
    for n in names do
      if len(value_or(opt: lookup(map: reason, key: n), default: "")) == 0 then
        for g in out_edges(edges: calls, n: n) do
          let gr = value_or(opt: lookup(map: reason, key: g), default: "")
          let mine = value_or(opt: lookup(map: reason, key: n), default: "")
          if (len(gr) > 0) and (len(mine) == 0) then
            set reason = insert(map: reason, key: n, value: "calls '" ++ g ++ "', which is not proved to terminate")
            set changed = true
          end if
        end for
      end if
    end for
  end while
  var out: List<Totality> = []
  for n in names do
    set out = push(list: out, item: Totality(name: n, reason: value_or(opt: lookup(map: reason, key: n), default: "")))
  end for
  return out
end fn totality

fn pos_text(p: Pos, files: List<String>) -> String do
  var f = "?"
  if (p.file >= 0) and (p.file < len(files)) then
    set f = files[p.file]
  end if
  return f ++ ":" ++ int_to_str(p.line) ++ ":" ++ int_to_str(p.col)
end fn pos_text
