// vowc: the self-hosted Vow compiler.

import "codegen.vow"
import "pipeline.vow"
import "fmt.vow"
import "runtime_h.vow"

fn vow_version() -> String do
  return "0.9.7"
end fn vow_version

fn usage() -> String do
  return "usage: vowc <command> <file.vow> [options]\n\n" ++
    "New to Vow? Read the guide for LLMs before writing any code:\n" ++
    "  https://vow.kranzky.com/llms.html (Markdown: https://vow.kranzky.com/md/VOW_FOR_LLMS.md)\n\n" ++
    "commands:\n" ++
    "  check   type-check and verify\n" ++
    "  build   check, verify and compile to an executable (-o <path>)\n" ++
    "  run     build and run (remaining arguments after -- go to the program)\n" ++
    "  emit-c  print the generated C\n" ++
    "  hash    print each function's body hash and verification key\n" ++
    "  test    check, verify, then run each test_... function in the file, each in its\n" ++
    "          own process (a failed check or panic fails only that test)\n" ++
    "  fmt     rewrite the file in the canonical layout (--check: only report)\n" ++
    "  add     vowc add <name> <git URL> [branch, tag or commit]: pin a package in\n" ++
    "          vow.pkg and fetch it; import its files as \"@name/file.vow\"\n" ++
    "  fetch   fetch the packages vow.pkg lists, and theirs, into .vow/pkg/\n" ++
    "  version print the compiler version (no file needed)\n" ++
    "  help    print this message\n\n" ++
    "options:\n" ++
    "  --json        machine-readable diagnostics (one JSON object per line)\n" ++
    "  --no-verify   skip the Z3 verifier (unsafe: contracts are not checked)\n" ++
    "  --check-contracts  with build, run and test: also check contracts, refinements,\n" ++
    "                loop invariants, measures and bounds while the program runs\n" ++
    "  --no-cache    ignore and do not update the verification cache\n" ++
    "  --totality    with check: also report which functions are proved to terminate\n" ++
    "  --no-line-directives  emit C without #line directives (errors, debuggers and\n" ++
    "                panics then refer to the C rather than the .vow source)\n" ++
    "  -o <path>     output executable for build\n"
end fn usage

fn json_str(s: String) -> String do
  var parts: List<String> = ["\""]
  for i in 0..len(s) do
    let c = s[i]
    if c == '"' then
      set parts = push(list: parts, item: "\\\"")
    elif c == '\\' then
      set parts = push(list: parts, item: "\\\\")
    elif c == '\n' then
      set parts = push(list: parts, item: "\\n")
    elif c == '\t' then
      set parts = push(list: parts, item: "\\t")
    elif c < 32 then
      set parts = push(list: parts, item: "\\u00" ++ hex_digit(c / 16) ++ hex_digit(c % 16))
    else
      set parts = push(list: parts, item: char(c))
    end if
  end for
  set parts = push(list: parts, item: "\"")
  return join(parts: parts, sep: "")
end fn json_str

fn render(d: Diag, files: List<String>, json: Bool) -> String do
  if not json then
    return render_diag(d: d, files: files)
  end if
  var file = "?"
  if (d.pos.file >= 0) and (d.pos.file < len(files)) then
    set file = files[d.pos.file]
  end if
  var notes: List<String> = []
  for n in d.notes do
    set notes = push(list: notes, item: json_str(n))
  end for
  return "{\"kind\":" ++ json_str(d.kind) ++ ",\"file\":" ++ json_str(file) ++ ",\"line\":" ++
    int_to_str(d.pos.line) ++ ",\"col\":" ++ int_to_str(d.pos.col) ++ ",\"message\":" ++
    json_str(d.msg) ++ ",\"notes\":[" ++ join(parts: notes, sep: ",") ++ "]}\n"
end fn render

fn report(diags: List<Diag>, files: List<String>, json: Bool) uses console do
  for d in diags do
    eprint(render(d: d, files: files, json: json))
  end for
end fn report

fn print_totality(ts: List<Totality>, json: Bool) uses console do
  var n = 0
  for t in ts do
    if len(t.reason) == 0 then
      set n = n + 1
    end if
  end for
  if json then
    for t in ts do
      var total = "true"
      if len(t.reason) > 0 then
        set total = "false"
      end if
      print("{\"kind\":\"totality\",\"function\":" ++ json_str(t.name) ++ ",\"total\":" ++ total ++ ",\"reason\":" ++ json_str(t.reason) ++ "}\n")
    end for
    return
  end if
  print("proved to terminate: " ++ int_to_str(n) ++ " of " ++ int_to_str(len(ts)) ++ " functions\n")
  for t in ts do
    if len(t.reason) > 0 then
      print("  " ++ t.name ++ " " ++ t.reason ++ "\n")
    end if
  end for
end fn print_totality

// vowc fmt: the file must lex and parse; the result must have the same tokens and
// comments, or nothing is written.
fn format_file(file: String, only_report: Bool, json: Bool) uses console, fs, proc do
  match read_file(file)
  case None then
    eprint("vowc: cannot read '" ++ file ++ "'\n")
    exit(1)
  case Some(value: src) then
    let lx = lex(src: src, file: 0)
    match lx.err
    case Some(value: d) then
      report(diags: [d], files: [file], json: json)
      exit(1)
    case None then
    end match
    if len(lx.toks) > 0 then
      var p = new_parser(toks: lx.toks, first_id: 0)
      let _ = parse_file(inout p)
      match p.err
      case Some(value: d) then
        report(diags: [d], files: [file], json: json)
        exit(1)
      case None then
      end match
    end if
    let out = format_source(src)
    if out == src then
      return
    end if
    if (not same_tokens(a: src, b: out)) or not same_strings(a: comments_of(src), b: comments_of(out)) then
      eprint("vowc: internal error: formatting '" ++ file ++ "' would change its tokens; nothing was written\n")
      exit(1)
    end if
    if only_report then
      print(file ++ ": not formatted (vowc fmt " ++ file ++ " rewrites it)\n")
      exit(1)
    end if
    if not write_file(path: file, contents: out) then
      eprint("vowc: cannot write '" ++ file ++ "'\n")
      exit(1)
    end if
    print(file ++ ": formatted\n")
  end match
end fn format_file

// ---- vowc test ----

// The test functions of the file named on the command line (not of the files it
// imports): those whose names start with 'test_'.
fn test_names(items: List<Item>) -> List<String> do
  var out: List<String> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      if starts_with(s: f.name, p: "test_") and (f.pos.file == 0) then
        set out = push(list: out, item: f.name)
      end if
    else
    end match
  end for
  return out
end fn test_names

// Builds the program once, then runs each test in its own process; the output of a
// failing test (including its panic message) is shown.
fn run_tests(code: String, tests: List<String>, json: Bool) uses console, fs, proc do
  if len(tests) == 0 then
    print("no tests: a test is a function named test_... with no parameters\n")
    return
  end if
  let tmp = make_temp_dir()
  let exe = tmp ++ "/tests"
  let e = compile_c(c: code, exe: exe)
  if len(e) > 0 then
    eprint("vowc: " ++ e ++ "\n")
    exit(1)
  end if
  var failed = 0
  for t in tests do
    let o = run(argv: ["sh", "-c", "exec \"$0\" --vow-test \"$1\" 2>&1", exe, t], input: "")
    let ok = o.code == 0
    if not ok then
      set failed = failed + 1
    end if
    if json then
      var status = "pass"
      if not ok then
        set status = "fail"
      end if
      print("{\"kind\":\"test\",\"name\":" ++ json_str(t) ++ ",\"status\":\"" ++ status ++ "\",\"output\":" ++ json_str(o.out) ++ "}\n")
    elif ok then
      print("ok    " ++ t ++ "\n")
    else
      print("FAIL  " ++ t ++ "\n")
      for l in split(s: trim(o.out), sep: '\n') do
        print("      " ++ l ++ "\n")
      end for
    end if
  end for
  let _ = run(argv: ["rm", "-rf", tmp], input: "")
  if not json then
    print(int_to_str(len(tests) - failed) ++ " passed, " ++ int_to_str(failed) ++ " failed\n")
  end if
  if failed > 0 then
    exit(1)
  end if
end fn run_tests

fn basename_stem(path: String) -> String do
  var base = path
  let slash = find_last_byte(s: path, c: '/')
  if (slash >= 0) and ((slash + 1) <= len(path)) then
    set base = slice(of: path, from: slash + 1, to: len(path))
  end if
  let dot = find_last_byte(s: base, c: '.')
  if dot > 0 then
    return slice(of: base, from: 0, to: dot)
  end if
  return base
end fn basename_stem

fn make_temp_dir() -> String uses proc do
  let o = run(argv: ["mktemp", "-d"], input: "")
  if o.code != 0 then
    return ""
  end if
  return trim(o.out)
end fn make_temp_dir

// Returns an error message, or "" on success.
fn compile_c(c: String, exe: String) -> String uses fs, proc do
  let dir = make_temp_dir()
  if len(dir) == 0 then
    return "cannot create a temporary directory"
  end if
  if not write_file(path: dir ++ "/vow_rt.h", contents: runtime_header()) then
    return "cannot write " ++ dir ++ "/vow_rt.h"
  end if
  let cfile = dir ++ "/program.c"
  if not write_file(path: cfile, contents: c) then
    return "cannot write " ++ cfile
  end if
  var cc = "cc"
  match getenv("CC")
  case Some(value: x) then
    set cc = x
  case None then
  end match
  var argv = [cc, "-O2", "-std=c11", "-w"]
  // VOW_CFLAGS adds C compiler flags, for example -DVOW_RC_DEBUG.
  match getenv("VOW_CFLAGS")
  case Some(value: flags) then
    for f in split(s: flags, sep: ' ') do
      if len(f) > 0 then
        set argv = push(list: argv, item: f)
      end if
    end for
  case None then
  end match
  let r = run(argv: argv ++ ["-o", exe, cfile, "-lm"], input: "")
  let _ = run(argv: ["rm", "-rf", dir], input: "")
  if r.code != 0 then
    return "C compiler '" ++ cc ++ "' failed"
  end if
  return ""
end fn compile_c

fn main() uses console, fs, proc do
  let argv = args()
  if (len(argv) >= 1) and (argv[0] == "version") then
    print("vowc " ++ vow_version() ++ " (" ++ verifier_version() ++ ")\n")
    let z = z3_version()
    if len(z) == 0 then
      print("z3 not found (tested with " ++ tested_z3_version() ++ "; tools/install-z3.sh installs it, VOW_Z3 selects it)\n")
    else
      print("z3 " ++ z ++ " (tested with " ++ tested_z3_version() ++ ")\n")
    end if
    return
  end if
  if (len(argv) >= 1) and contains_str(xs: ["help", "--help", "-h"], x: argv[0]) then
    print(usage())
    return
  end if
  if (len(argv) >= 1) and (argv[0] == "fetch") then
    let m = find_manifest(".")
    if len(m) == 0 then
      eprint("vowc: there is no vow.pkg here or in a directory above (vowc add creates one)\n")
      exit(1)
    end if
    if not fetch_packages(m) then
      exit(1)
    end if
    return
  end if
  if (len(argv) >= 1) and (argv[0] == "add") then
    if (len(argv) < 3) or (len(argv) > 4) then
      eprint("usage: vowc add <name> <git URL> [branch, tag or commit]\n")
      exit(2)
    end if
    var ref = "HEAD"
    if len(argv) == 4 then
      set ref = argv[3]
    end if
    if not add_package(name: argv[1], url: argv[2], ref: ref) then
      exit(1)
    end if
    return
  end if
  if len(argv) < 2 then
    eprint(usage())
    exit(2)
  end if
  let cmd = argv[0]
  let file = argv[1]
  var json = false
  var no_verify = false
  var check_contracts = false
  var no_cache = false
  var totality_report = false
  var line_directives = true
  var fmt_check = false
  var out = ""
  var run_args: List<String> = []
  var i = 2
  while i < len(argv) invariant i >= 2 do
    let a = argv[i]
    if a == "--json" then
      set json = true
    elif a == "--no-verify" then
      set no_verify = true
    elif a == "--no-cache" then
      set no_cache = true
    elif a == "--check-contracts" then
      set check_contracts = true
    elif a == "--totality" then
      set totality_report = true
    elif a == "--no-line-directives" then
      set line_directives = false
    elif a == "--check" then
      set fmt_check = true
    elif (a == "-o") and ((i + 1) < len(argv)) then
      set out = argv[i + 1]
      set i = i + 1
    elif a == "--" then
      set run_args = slice(of: argv, from: i + 1, to: len(argv))
      break
    else
      eprint("unknown option '" ++ a ++ "'\n\n" ++ usage())
      exit(2)
    end if
    set i = i + 1
  end while
  if cmd == "fmt" then
    format_file(file: file, only_report: fmt_check, json: json)
    return
  end if
  let src = load(file)
  if len(src.errs) > 0 then
    report(diags: src.errs, files: src.files, json: json)
    exit(1)
  end if
  if cmd == "pretty" then
    for item in src.items do
      print(pretty_item(item) ++ "\n\n")
    end for
    return
  end if
  let ck = check_source(src: src, test_mode: cmd == "test")
  if len(ck.errs) > 0 then
    report(diags: ck.errs, files: src.files, json: json)
    exit(1)
  end if
  let c = ck.c
  let rec = ck.rec
  if cmd == "hash" then
    for h in hash_program(items: src.items, info: c.info) do
      print(h.name ++ "  body=" ++ h.body ++ " contract=" ++ h.contract ++ " key=" ++ h.key ++ "\n")
    end for
    return
  end if
  // Holes are reported with the facts the verifier knows at that point, so the
  // verifier runs even when there are holes.
  var verified = false
  if (not no_verify) or (len(c.info.holes) > 0) then
    let vr = verify_source(src: src, c: c, file: file, no_cache: no_cache, v03: is_some(getenv("VOW_SMT_V03")))
    if len(vr.error) > 0 then
      eprint("vowc: " ++ vr.error ++ "\n")
      exit(1)
    end if
    if len(vr.diags) > 0 then
      report(diags: vr.diags, files: src.files, json: json)
      if vr.undecided and not json then
        let z = z3_version()
        if z != tested_z3_version() then
          eprint("note: Z3 " ++ z ++ " did not decide some proofs; vowc is tested with Z3 " ++ tested_z3_version() ++ ", which may (tools/install-z3.sh installs it)\n")
        end if
      end if
      exit(1)
    end if
    set verified = not no_verify
  end if
  var tests: List<String> = []
  if cmd == "test" then
    set tests = test_names(src.items)
  end if
  let code = generate(items: src.items, info: c.info, files: src.files, verified: verified, lines: line_directives,
    tests: tests, contracts: check_contracts)
  if cmd == "check" then
    print("ok\n")
    if totality_report then
      print_totality(ts: totality(items: src.items, info: c.info, r: rec, files: src.files), json: json)
    end if
  elif cmd == "emit-c" then
    print(code)
  elif (cmd == "build") or (cmd == "run") then
    var exe = out
    var tmp = ""
    if len(exe) == 0 then
      if cmd == "build" then
        set exe = basename_stem(file)
      else
        set tmp = make_temp_dir()
        set exe = tmp ++ "/program"
      end if
    end if
    let e = compile_c(c: code, exe: exe)
    if len(e) > 0 then
      eprint("vowc: " ++ e ++ "\n")
      exit(1)
    end if
    if cmd == "run" then
      let o = run(argv: [exe] ++ run_args, input: "")
      print(o.out)
      if len(tmp) > 0 then
        let _ = run(argv: ["rm", "-rf", tmp], input: "")
      end if
      exit(o.code)
    end if
  elif cmd == "test" then
    run_tests(code: code, tests: tests, json: json)
  else
    eprint("unknown command '" ++ cmd ++ "'\n\n" ++ usage())
    exit(2)
  end if
end fn main
