// Verification condition generation by symbolic execution, discharged with Z3.
//
// Every value gets an SMT term. Definitions of fresh constants are asserted
// unconditionally: a fresh constant can always be defined, so they cannot make
// anything inconsistent. A constraint on a fresh constant's properties is only global
// when it is satisfiable regardless of the path. Everything that is only true on some
// paths lives in the path's facts, and each obligation is checked as
// "facts and not goal".

import "check.vow"
import "pretty.vow"

struct Shown
  name: String,
  term: String,
end struct Shown

struct Ob
  pos: Pos,
  what: String,
  facts: List<String>,
  goal: String,
  show: List<Shown>,
end struct Ob

// qdefs are quantified content axioms about fresh constants. They are consistent by
// construction (each only describes a fresh constant's contents), and Z3 cannot cheaply
// show their satisfiability, so they come after the vacuity check.
struct FnVc
  name: String,
  decls: List<String>,
  defs: List<String>,
  qdefs: List<String>,
  obs: List<Ob>,
  // Whether the queries define recursive specification functions by axioms. Z3's
  // model-based instantiation then spends its whole timeout on a false claim, so it is
  // turned off: such a claim is reported as not proved at once.
  axioms: Bool,
end struct FnVc

// preds and args are the refinements assumed again where the variable may have changed
// (a var, an inout parameter), and those inside its type arguments.
struct VVar
  term: String,
  ty: Ty,
  preds: List<Expr>,
  args: List<RTy>,
end struct VVar

struct St
  env: Map<String, VVar>,
  facts: List<String>,
  src: List<String>,
  dead: Bool,
end struct St

// subj and res are "" when absent. While the definition of a recursive specification
// function is being built, scc is its group and fuel the layer that calls within the
// group use (see spec_fn_axioms); otherwise scc is -1 and fuel 2.
struct Spec
  binds: Map<String, String>,
  subj: String,
  res: String,
  fuel: Int,
  scc: Int,
end struct Spec

// A loop being verified: its invariants; for a range loop, the loop variable and its
// value in the next iteration (next_var is "" otherwise); and its 'decreases' measure
// with that measure's value at the top of the iteration.
struct LoopCtx
  invs: List<Expr>,
  next_var: String,
  next_term: String,
  dec: Option<Expr>,
  d0: String,
end struct LoopCtx

struct Verifier
  info: Info,
  n: Int,
  decls: List<String>,
  defs: List<String>,
  qdefs: List<String>,
  obs: List<Ob>,
  preamble: Map<String, Bool>,
  // The signature each global function was declared with (see global_fn).
  sigs: Map<String, String>,
  strs: Map<String, String>,
  loops: List<LoopCtx>,
  fname: String,
  ret: RTy,
  post: List<Expr>,
  dec: Option<Expr>,
  params: Map<String, String>,
  hole_facts: Map<Int, List<String>>,
  // Recursive specification functions whose definitions this query has, and the
  // structural equality predicates it defines.
  sf_done: List<String>,
  eq_done: List<String>,
  // Float literals defined in this function's queries, and whether it uses floats.
  flits: List<FloatLit>,
  floats: Bool,
  // For the language server: the line (in the root file) whose known facts to record
  // in probe when its first statement is reached, or -1.
  probe_line: Int,
  probe: List<String>,
  // Whether the encoding has what was added after v0.3: goals assuming the field
  // refinements of the struct values they name, constructions stated as path facts, and
  // proofs that specifications are well defined. Off only to compare the SMT with the
  // frozen bootstrap verifier (tests/differential.sh).
  hyps: Bool,
end struct Verifier

fn prelude() -> List<String> do
  return ["(declare-sort Val 0)",
    "(declare-fun len (Val) Int)",
    "(declare-fun byte (Val Int) Int)",
    "(declare-fun tag (Val) Int)",
    "(declare-fun elem_Int (Val Int) Int)",
    "(declare-fun elem_Bool (Val Int) Bool)",
    "(declare-fun elem_Val (Val Int) Val)",
    "(assert (forall ((x Val)) (! (>= (len x) 0) :pattern ((len x)))))",
    "(assert (forall ((s Val) (i Int)) (! (and (>= (byte s i) 0) (< (byte s i) 256)) :pattern ((byte s i)))))"]
end fn prelude

fn new_verifier(info: Info) -> Verifier do
  var pre: Map<String, Bool> = {}
  for p in prelude() do
    set pre = insert(map: pre, key: p, value: true)
  end for
  let loops: List<LoopCtx> = []
  return Verifier(info: info, n: 0, decls: [], defs: [], qdefs: [], obs: [], preamble: pre, sigs: {}, strs: {}, loops: loops,
    fname: "", ret: plain(Ty.TUnit), post: [], dec: Option.None, params: {}, hole_facts: {}, sf_done: [], eq_done: [], flits: [], floats: false, probe_line: -1, probe: [],
    hyps: true)
end fn new_verifier

fn sort_of(t: Ty) -> String do
  match t
  case TInt then
    return "Int"
  case TFloat then
    return "Flt"
  case TUnit then
    return "Int"
  case TBool then
    return "Bool"
  else
    return "Val"
  end match
end fn sort_of

fn and_all(v: List<String>) -> String do
  if len(v) == 0 then
    return "true"
  end if
  if len(v) == 1 then
    return v[0]
  end if
  return "(and " ++ join(parts: v, sep: " ") ++ ")"
end fn and_all

fn int_lit(n: Int) -> String do
  if n < 0 then
    if n == (-9223372036854775807 - 1) then
      return "(- 9223372036854775808)"
    end if
    return "(- " ++ int_to_str(-n) ++ ")"
  end if
  return int_to_str(n)
end fn int_lit

fn binop_term(op: String, a: String, b: String) -> String do
  var o = op
  match op
  case "/" then
    set o = "div"
  case "%" then
    set o = "mod"
  case "==" then
    set o = "="
  case "implies" then
    set o = "=>"
  case "!=" then
    return "(not (= " ++ a ++ " " ++ b ++ "))"
  else
  end match
  return "(" ++ o ++ " " ++ a ++ " " ++ b ++ ")"
end fn binop_term

// a == b (or a != b) for values of type t. Int, Bool, Unit and String values are equal
// when their terms are; other values when their terms are, or when they are equal
// part by part (eq_fn).
fn eq_term(v: inout Verifier, op: String, t: Ty, a: String, b: String) -> String do
  if ty_show(t) == "Float" then
    return float_op(v: inout v, op: op, a: a, b: b)
  end if
  if ty_show(t) == "Unit" then
    return binop_term(op: op, a: "0", b: "0")
  end if
  if simple_eq(t) then
    return binop_term(op: op, a: a, b: b)
  end if
  let term = val_eq(v: inout v, t: t, a: a, b: b)
  if op == "!=" then
    return "(not " ++ term ++ ")"
  end if
  return term
end fn eq_term

fn val_eq(v: inout Verifier, t: Ty, a: String, b: String) -> String do
  if ty_show(t) == "Unit" then
    return "true"
  end if
  if ty_show(t) == "Float" then
    return float_op(v: inout v, op: "==", a: a, b: b)
  end if
  if simple_eq(t) then
    return "(= " ++ a ++ " " ++ b ++ ")"
  end if
  let f = eq_fn(v: inout v, t: t)
  // A value holding a NaN is not equal to itself, so being the same value proves
  // equality only for types without floats.
  if contains_float(info: v.info, t: t) then
    return "(" ++ f ++ " " ++ a ++ " " ++ b ++ ")"
  end if
  return "(or (= " ++ a ++ " " ++ b ++ ") (" ++ f ++ " " ++ a ++ " " ++ b ++ "))"
end fn val_eq

// The predicate for structural equality on t, declared with its definition on first
// use. The definition is an axiom unfolded only when the predicate is applied; for a
// recursive type it has more than one solution, all of which agree on the finite
// values a program builds. A type parameter's equality is left unknown, which covers
// every type the parameter stands for.
fn eq_fn(v: inout Verifier, t: Ty) -> String do
  match t
  case TParam(name: n) then
    return global_fn(v: inout v, name: "peq_" ++ n, args: "Val Val", sort: "Bool")
  else
  end match
  let name = "eq_" ++ mangle(ty_show(t))
  if contains_str(xs: v.eq_done, x: name) then
    return name
  end if
  // Declared before the body is built, since a recursive type's body refers to it.
  set v = v with (eq_done: push(list: v.eq_done, item: name))
  let _ = global_fn(v: inout v, name: name, args: "Val Val", sort: "Bool")
  let body = eq_body(v: inout v, t: t)
  let app = "(" ++ name ++ " ea eb)"
  // Only in the queries of functions that compare such values, and after the check
  // that their definitions are consistent: a quantified axiom in that check would leave
  // Z3 searching for a model of it until the timeout.
  add_qdef(v: inout v, d: "(assert (forall ((ea Val) (eb Val)) (! (= " ++ app ++ " " ++ body ++ ") :pattern (" ++ app ++ "))))")
  return name
end fn eq_fn

// Structural equality of ea and eb, values of type t.
fn eq_body(v: inout Verifier, t: Ty) -> String do
  match t
  case TStruct(name: n) then
    var parts: List<String> = []
    for fl in struct_fields(info: v.info, name: n) do
      let f = field_fn(v: inout v, sname: n, field: fl.name, t: fl.rty.ty)
      set parts = push(list: parts, item: val_eq(v: inout v, t: fl.rty.ty, a: "(" ++ f ++ " ea)", b: "(" ++ f ++ " eb)"))
    end for
    return and_all(parts)
  case TList(elem: et) then
    let at = "(elem_" ++ sort_of(et) ++ " ea ei)"
    let bt = "(elem_" ++ sort_of(et) ++ " eb ei)"
    let each = "(=> (and (<= 0 ei) (< ei (len ea))) " ++ val_eq(v: inout v, t: et, a: at, b: bt) ++ ")"
    return "(and (= (len ea) (len eb)) (forall ((ei Int)) (! " ++ each ++ " :pattern (" ++ at ++ ") :pattern (" ++ bt ++ "))))"
  else
  end match
  var ename = ty_show(t)
  match t
  case TOpt(inner: x) then
    set ename = "Option"
  else
  end match
  match variants_of(info: v.info, t: t)
  case Some(value: vs) then
    var parts = ["(= (tag ea) (tag eb))"]
    for i in 0..len(vs) do
      var fs: List<String> = []
      for fl in vs[i].fields do
        let f = vfield_fn(v: inout v, ename: ename, vname: vs[i].name, field: fl.name, t: fl.rty.ty)
        set fs = push(list: fs, item: val_eq(v: inout v, t: fl.rty.ty, a: "(" ++ f ++ " ea)", b: "(" ++ f ++ " eb)"))
      end for
      if len(fs) > 0 then
        set parts = push(list: parts, item: "(=> (= (tag ea) " ++ int_to_str(i) ++ ") " ++ and_all(fs) ++ ")")
      end if
    end for
    return and_all(parts)
  case None then
    // Maps: never compared (the checker rejects it).
    return "false"
  end match
end fn eq_body

fn add_unique(out: inout List<String>, n: String) do
  if not contains_str(xs: out, x: n) then
    set out = push(list: out, item: n)
  end if
end fn add_unique

fn assigned_expr(e: Expr, out: inout List<String>) do
  match e.kind
  case Call(callee: c, args: args) then
    assigned_expr(e: c, out: inout out)
    assigned_args(args: args, out: inout out)
  case With(obj: c, args: args) then
    assigned_expr(e: c, out: inout out)
    assigned_args(args: args, out: inout out)
  case ListLit(items: items) then
    for x in items do
      assigned_expr(e: x, out: inout out)
    end for
  case Index(obj: a, idx: b) then
    assigned_expr(e: a, out: inout out)
    assigned_expr(e: b, out: inout out)
  case Binary(op: op, l: a, r: b) then
    assigned_expr(e: a, out: inout out)
    assigned_expr(e: b, out: inout out)
  case Field(obj: a, name: n) then
    assigned_expr(e: a, out: inout out)
  case Unary(op: op, x: a) then
    assigned_expr(e: a, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    assigned_expr(e: lo, out: inout out)
    assigned_expr(e: hi, out: inout out)
    assigned_expr(e: b, out: inout out)
  else
  end match
end fn assigned_expr

fn assigned_args(args: List<Arg>, out: inout List<String>) do
  for a in args do
    if a.is_inout then
      match a.value.kind
      case Var(name: n) then
        add_unique(out: inout out, n: n)
      else
      end match
    end if
    assigned_expr(e: a.value, out: inout out)
  end for
end fn assigned_args

fn assigned_opt(b: Option<List<Stmt>>, out: inout List<String>) do
  match b
  case Some(value: s) then
    assigned(stmts: s, out: inout out)
  case None then
  end match
end fn assigned_opt

// Variables assigned with 'set', or passed inout, anywhere in a block.
fn assigned(stmts: List<Stmt>, out: inout List<String>) do
  for s in stmts do
    match s.kind
    case Set(name: name, value: value) then
      add_unique(out: inout out, n: name)
      assigned_expr(e: value, out: inout out)
    case Let(name: name, ty: ty, value: value, mutable: m) then
      assigned_expr(e: value, out: inout out)
    case Return(value: v) then
      match v
      case Some(value: e) then
        assigned_expr(e: e, out: inout out)
      case None then
      end match
    case ExprStmt(e: e) then
      assigned_expr(e: e, out: inout out)
    case Check(e: e) then
      assigned_expr(e: e, out: inout out)
    case If(arms: arms, els: els) then
      for a in arms do
        assigned_expr(e: a.cond, out: inout out)
        assigned(stmts: a.body, out: inout out)
      end for
      assigned_opt(b: els, out: inout out)
    case While(cond: c, invs: invs, body: body) then
      assigned_expr(e: c, out: inout out)
      assigned(stmts: body, out: inout out)
    case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
      assigned_expr(e: lo, out: inout out)
      assigned_expr(e: hi, out: inout out)
      assigned(stmts: body, out: inout out)
    case ForEach(name: v, list: l, invs: invs, body: body) then
      assigned_expr(e: l, out: inout out)
      assigned(stmts: body, out: inout out)
    case Match(scrut: sc, cases: cases, els: els) then
      assigned_expr(e: sc, out: inout out)
      for cs in cases do
        assigned(stmts: cs.body, out: inout out)
      end for
      assigned_opt(b: els, out: inout out)
    else
    end match
  end for
end fn assigned

// ---- state helpers ----

fn fresh(v: inout Verifier, sort: String) -> String do
  if sort == "Flt" then
    use_floats(inout v)
  end if
  set v = v with (n: v.n + 1)
  let name = "v" ++ int_to_str(v.n)
  set v = v with (decls: push(list: v.decls, item: "(declare-const " ++ name ++ " " ++ sort ++ ")"))
  return name
end fn fresh

fn define(v: inout Verifier, sort: String, term: String) -> String do
  let c = fresh(v: inout v, sort: sort)
  add_def(v: inout v, d: "(assert (= " ++ c ++ " " ++ term ++ "))")
  return c
end fn define

fn add_def(v: inout Verifier, d: String) do
  set v = v with (defs: push(list: v.defs, item: d))
end fn add_def

fn add_qdef(v: inout Verifier, d: String) do
  set v = v with (qdefs: push(list: v.qdefs, item: d))
end fn add_qdef

fn global_fn(v: inout Verifier, name: String, args: String, sort: String) -> String do
  // One name, one signature: Z3 may accept a name declared twice with different sorts
  // and pick between them, which turns ill-sorted SMT into wrong proofs.
  let sig = "(" ++ args ++ ") " ++ sort
  match lookup(map: v.sigs, key: name)
  case Some(value: was) then
    if was != sig then
      panic("internal error: the SMT function " ++ name ++ " was declared as " ++ was ++ " and as " ++ sig)
    end if
  case None then
    set v = v with (sigs: insert(map: v.sigs, key: name, value: sig))
  end match
  if (sort == "Flt") or contains(s: args, p: "Flt") then
    use_floats(inout v)
  end if
  set v = v with (preamble: insert(map: v.preamble, key: "(declare-fun " ++ name ++ " (" ++ args ++ ") " ++ sort ++ ")", value: true))
  return name
end fn global_fn

// The SMT functions reading fields are named from the type, variant and field names,
// each mangled (which leaves no '.') and joined by '.', so no two fields share one:
// joined by '_', struct A_b's field c and struct A's field b_c did, and if their sorts
// differed Z3 rejected the query. VOW_SMT_V03 (hyps off) keeps the names the frozen
// bootstrap verifier writes.
fn field_fn(v: inout Verifier, sname: String, field: String, t: Ty) -> String do
  if not v.hyps then
    if is_instance_name(sname) then
      return global_fn(v: inout v, name: "gfld_" ++ mangle(sname) ++ "_" ++ field, args: "Val", sort: sort_of(t))
    end if
    return global_fn(v: inout v, name: "fld_" ++ sname ++ "_" ++ field, args: "Val", sort: sort_of(t))
  end if
  return global_fn(v: inout v, name: "fld." ++ mangle(sname) ++ "." ++ mangle(field), args: "Val", sort: sort_of(t))
end fn field_fn

fn vfield_fn(v: inout Verifier, ename: String, vname: String, field: String, t: Ty) -> String do
  if ename == "Option" then
    return global_fn(v: inout v, name: "opt_value_" ++ sort_of(t), args: "Val", sort: sort_of(t))
  end if
  if not v.hyps then
    if is_instance_name(ename) then
      return global_fn(v: inout v, name: "gvf_" ++ mangle(ename) ++ "_" ++ vname ++ "_" ++ field, args: "Val", sort: sort_of(t))
    end if
    return global_fn(v: inout v, name: "vf_" ++ ename ++ "_" ++ vname ++ "_" ++ field, args: "Val", sort: sort_of(t))
  end if
  return global_fn(v: inout v, name: "vf." ++ mangle(ename) ++ "." ++ mangle(vname) ++ "." ++ mangle(field), args: "Val",
    sort: sort_of(t))
end fn vfield_fn

fn add_fact(st: inout St, f: String) do
  set st = st with (facts: push(list: st.facts, item: f))
end fn add_fact

fn add_src(st: inout St, f: String) do
  set st = st with (src: push(list: st.src, item: f))
end fn add_src

fn env_term(st: St, n: String) -> String do
  match lookup(map: st.env, key: n)
  case Some(value: x) then
    return x.term
  case None then
    return "unbound_" ++ n
  end match
end fn env_term

fn obligation(v: inout Verifier, st: St, pos: Pos, what: String, goal: String) do
  if st.dead then
    return
  end if
  var show: List<Shown> = []
  for n in keys(st.env) do
    match lookup(map: st.env, key: n)
    case Some(value: x) then
      match x.ty
      case TInt then
        set show = push(list: show, item: Shown(name: n, term: x.term))
      case TBool then
        set show = push(list: show, item: Shown(name: n, term: x.term))
      case TList(elem: e) then
        set show = push(list: show, item: Shown(name: "len(" ++ n ++ ")", term: "(len " ++ x.term ++ ")"))
      case TStr then
        set show = push(list: show, item: Shown(name: "len(" ++ n ++ ")", term: "(len " ++ x.term ++ ")"))
      case TMap(key: k, val: vv) then
        set show = push(list: show, item: Shown(name: "len(" ++ n ++ ")", term: "(len " ++ x.term ++ ")"))
      case THashMap(key: k, val: vv) then
        set show = push(list: show, item: Shown(name: "len(" ++ n ++ ")", term: "(len " ++ x.term ++ ")"))
      else
      end match
    case None then
    end match
  end for
  set v = v with (obs: push(list: v.obs, item: Ob(pos: pos, what: what, facts: st.facts, goal: goal, show: show)))
end fn obligation

fn str_const(v: inout Verifier, s: String) -> String do
  match lookup(map: v.strs, key: s)
  case Some(value: c) then
    return c
  case None then
  end match
  let c = fresh(v: inout v, sort: "Val")
  add_def(v: inout v, d: "(assert (= (len " ++ c ++ ") " ++ int_to_str(len(s)) ++ "))")
  var k = len(s)
  if k > 64 then
    set k = 64
  end if
  for i in 0..k do
    if i < len(s) then
      add_def(v: inout v, d: "(assert (= (byte " ++ c ++ " " ++ int_to_str(i) ++ ") " ++ int_to_str(s[i]) ++ "))")
    end if
  end for
  set v = v with (strs: insert(map: v.strs, key: s, value: c))
  return c
end fn str_const

// ---- functions ----

fn verify_fn(v: inout Verifier, f: FnDecl) -> FnVc do
  let empty_loops: List<LoopCtx> = []
  // A generic function is verified once, with its type parameters as unknown types
  // (values of the uninterpreted sort Val), which covers every instance.
  let info = v.info
  set v = v with (n: 0, decls: [], defs: [], qdefs: [], obs: [], strs: {}, loops: empty_loops, fname: f.name, params: {}, sf_done: [], eq_done: [], flits: [], floats: false,
    info: info with (tenv: identity_env(f.tparams)))
  var fi = FnInfo(name: f.name, params: [], io: [], ret: plain(Ty.TUnit), effects: [], pre: [], post: [],
    dec: Option.None, inline: Option.None, spec_body: Option.None, spec_rec: false, pos: f.pos)
  match get_fn(info: v.info, name: f.name)
  case Some(value: x) then
    set fi = x
  case None then
  end match
  set v = v with (ret: fi.ret, post: fi.post, dec: fi.dec)
  var st = St(env: {}, facts: [], src: [], dead: false)
  for i in 0..len(fi.params) do
    let p = fi.params[i]
    let t = fresh(v: inout v, sort: sort_of(p.rty.ty))
    set v = v with (params: insert(map: v.params, key: p.name, value: t))
    for pr in p.rty.preds do
      check_wd(v: inout v, st: st, pos: pr.pos, e: pr, sp: state_spec(v: v, st: st, subj: t, res: ""))
      let fact = spec_term(v: inout v, e: pr, st: st, subj: t, res: "")
      add_fact(st: inout st, f: fact)
      add_src(st: inout st, f: p.name ++ " where " ++ pretty_expr(pr))
    end for
    // Proved by every caller, defined included.
    assume_inner(v: inout v, st: inout st, name: "'" ++ p.name ++ "'", r: p.rty, term: t)
    // A parameter that is not inout cannot be assigned, so its declared refinements
    // are kept only for known_rty.
    set st = st with (env: insert(map: st.env, key: p.name, value: VVar(term: t, ty: p.rty.ty, preds: p.rty.preds, args: p.rty.args)))
  end for
  for r in fi.pre do
    check_wd(v: inout v, st: st, pos: r.pos, e: r, sp: state_spec(v: v, st: st, subj: "", res: ""))
    let fact = spec_term(v: inout v, e: r, st: st, subj: "", res: "")
    add_fact(st: inout st, f: fact)
    add_src(st: inout st, f: pretty_expr(r))
  end for
  // The measure is a specification too, evaluated on entry by a checked build.
  match fi.dec
  case Some(value: d) then
    check_wd(v: inout v, st: st, pos: d.pos, e: d, sp: state_spec(v: v, st: st, subj: "", res: ""))
  case None then
  end match
  vblock(v: inout v, stmts: f.body, st: inout st)
  if (not st.dead) and (ty_show(fi.ret.ty) == "Unit") then
    check_post(v: inout v, st: st, pos: f.pos, val: "0")
  end if
  return FnVc(name: f.name, decls: v.decls, defs: v.defs, qdefs: v.qdefs, obs: v.obs, axioms: (len(v.sf_done) > 0) or v.floats)
end fn verify_fn

fn check_post(v: inout Verifier, st: St, pos: Pos, val: String) do
  let ret = v.ret
  for p in ret.preds do
    check_wd(v: inout v, st: st, pos: pos, e: p, sp: state_spec(v: v, st: st, subj: val, res: ""))
    let g = spec_goal(v: inout v, e: p, st: st, subj: val, res: "")
    obligation(v: inout v, st: st, pos: pos, what: "return value of '" ++ v.fname ++ "' satisfies " ++ pretty_expr(p), goal: g)
  end for
  check_inner(v: inout v, st: st, pos: pos, name: "the return value of '" ++ v.fname ++ "'", r: ret, term: val)
  let ens = v.post
  for e in ens do
    check_wd(v: inout v, st: st, pos: pos, e: e, sp: state_spec(v: v, st: st, subj: "", res: val))
    let g = spec_goal(v: inout v, e: e, st: st, subj: "", res: val)
    obligation(v: inout v, st: st, pos: pos, what: "postcondition of '" ++ v.fname ++ "': " ++ pretty_expr(e), goal: g)
  end for
end fn check_post

// ---- specification terms ----

// A specification evaluated in state st.
fn state_spec(v: Verifier, st: St, subj: String, res: String) -> Spec do
  return Spec(binds: spec_binds(v: v, st: st), subj: subj, res: res, fuel: 2, scc: -1)
end fn state_spec

// Names resolve through the current environment; parameters keep their entry values.
fn spec_term(v: inout Verifier, e: Expr, st: St, subj: String, res: String) -> String do
  let binds = spec_binds(v: v, st: st)
  return sexpr(v: inout v, e: e, sp: Spec(binds: binds, subj: subj, res: res, fuel: 2, scc: -1))
end fn spec_term

// A specification to prove at this point: as spec_term, assuming the field refinements
// of the struct values it names (see struct_hyps).
fn spec_goal(v: inout Verifier, e: Expr, st: St, subj: String, res: String) -> String do
  let sp = Spec(binds: spec_binds(v: v, st: st), subj: subj, res: res, fuel: 2, scc: -1)
  let g = sexpr(v: inout v, e: e, sp: sp)
  if not v.hyps then
    return g
  end if
  return with_hyps(hyps: struct_hyps(v: inout v, e: e, sp: sp), goal: g)
end fn spec_goal

fn goal_with(v: inout Verifier, e: Expr, binds: Map<String, String>, subj: String) -> String do
  let sp = Spec(binds: binds, subj: subj, res: "", fuel: 2, scc: -1)
  let g = sexpr(v: inout v, e: e, sp: sp)
  if not v.hyps then
    return g
  end if
  return with_hyps(hyps: struct_hyps(v: inout v, e: e, sp: sp), goal: g)
end fn goal_with

fn with_hyps(hyps: List<String>, goal: String) -> String do
  if len(hyps) == 0 then
    return goal
  end if
  return "(=> " ++ and_all(hyps) ++ " " ++ goal ++ ")"
end fn with_hyps

// The field refinements of the struct values a specification names: variables,
// parameters, it, result and old(x), their struct fields, and the elements of the
// lists among them (as one quantified hypothesis per list), recursively. A goal may
// assume them: wherever it is proved, those names hold real values of their types.
// They are not stated as facts, because a value built on a path that cannot happen is
// not constrained to be real.
fn struct_hyps(v: inout Verifier, e: Expr, sp: Spec) -> List<String> do
  var named: List<NamedTerm> = []
  named_values(v: v, e: e, sp: sp, out: inout named)
  var out: List<String> = []
  for n in named do
    struct_facts(v: inout v, t: n.ty, term: n.term, depth: 3, out: inout out)
  end for
  return out
end fn struct_hyps

struct NamedTerm
  ty: Ty,
  term: String,
end struct NamedTerm

fn named_values(v: Verifier, e: Expr, sp: Spec, out: inout List<NamedTerm>) do
  var term = ""
  match e.kind
  case Var(name: n) then
    match lookup(map: sp.binds, key: n)
    case Some(value: t) then
      set term = t
    case None then
    end match
  case It then
    set term = sp.subj
  case Result then
    set term = sp.res
  case Call(callee: c, args: args) then
    match call_info(info: v.info, e: e)
    case Some(value: ci) then
      if ci.kind == "old" then
        set term = bind_of(binds: sp.binds, n: "old(" ++ ci.name ++ ")")
      end if
    case None then
    end match
    for a in args do
      named_values(v: v, e: a.value, sp: sp, out: inout out)
    end for
  case Index(obj: o, idx: i) then
    named_values(v: v, e: o, sp: sp, out: inout out)
    named_values(v: v, e: i, sp: sp, out: inout out)
  case Field(obj: o, name: f) then
    named_values(v: v, e: o, sp: sp, out: inout out)
  case Unary(op: op, x: x) then
    named_values(v: v, e: x, sp: sp, out: inout out)
  case Binary(op: op, l: l, r: r) then
    named_values(v: v, e: l, sp: sp, out: inout out)
    named_values(v: v, e: r, sp: sp, out: inout out)
  case Quant(q: q, name: qn, lo: lo, hi: hi, body: b) then
    named_values(v: v, e: lo, sp: sp, out: inout out)
    named_values(v: v, e: hi, sp: sp, out: inout out)
    named_values(v: v, e: b, sp: sp with (binds: insert(map: sp.binds, key: qn, value: "")), out: inout out)
  else
  end match
  if len(term) == 0 then
    return
  end if
  let t = type_of(info: v.info, e: e)
  var keep = false
  match t
  case TStruct(name: sn) then
    set keep = true
  case TList(elem: et) then
    set keep = true
  else
  end match
  if keep then
    for x in out do
      if x.term == term then
        return
      end if
    end for
    set out = push(list: out, item: NamedTerm(ty: t, term: term))
  end if
end fn named_values

fn struct_facts(v: inout Verifier, t: Ty, term: String, depth: Int, out: inout List<String>) do
  match t
  case TStruct(name: sn) then
    let binds = struct_binds(v: inout v, sn: sn, ov: term)
    for fl in struct_fields(info: v.info, name: sn) do
      let ft = bind_of(binds: binds, n: fl.name)
      for p in fl.rty.preds do
        set out = push(list: out, item: spec_with(v: inout v, e: p, binds: binds, subj: ft))
      end for
      set out = out ++ inner_facts(v: inout v, r: fl.rty, term: ft)
      if depth > 0 then
        struct_facts(v: inout v, t: fl.rty.ty, term: ft, depth: depth - 1, out: inout out)
      end if
    end for
  case TList(elem: et) then
    // Every element in range is a real value: one quantified hypothesis covers them.
    if depth > 0 then
      let k = fresh_q(inout v)
      let el = "(elem_" ++ sort_of(et) ++ " " ++ term ++ " " ++ k ++ ")"
      var inner: List<String> = []
      struct_facts(v: inout v, t: et, term: el, depth: depth - 1, out: inout inner)
      if len(inner) > 0 then
        let range = "(and (<= 0 " ++ k ++ ") (< " ++ k ++ " (len " ++ term ++ ")))"
        set out = push(list: out, item: "(forall ((" ++ k ++ " Int)) (! (=> " ++ range ++ " " ++ and_all(inner) ++ ") :pattern (" ++ el ++ ")))")
      end if
    end if
  else
  end match
end fn struct_facts

fn spec_binds(v: Verifier, st: St) -> Map<String, String> do
  var binds: Map<String, String> = {}
  for k in keys(st.env) do
    set binds = insert(map: binds, key: k, value: env_term(st: st, n: k))
  end for
  for k in keys(v.params) do
    match lookup(map: v.params, key: k)
    case Some(value: t) then
      if not has(map: binds, key: k) then
        set binds = insert(map: binds, key: k, value: t)
      end if
      // old(x) is the parameter's entry value.
      set binds = insert(map: binds, key: "old(" ++ k ++ ")", value: t)
    case None then
    end match
  end for
  return binds
end fn spec_binds

fn spec_with(v: inout Verifier, e: Expr, binds: Map<String, String>, subj: String) -> String do
  return sexpr(v: inout v, e: e, sp: Spec(binds: binds, subj: subj, res: "", fuel: 2, scc: -1))
end fn spec_with

fn sexpr(v: inout Verifier, e: Expr, sp: Spec) -> String do
  match e.kind
  case IntLit(value: n) then
    return int_lit(n)
  case FloatLit(text: t) then
    return float_lit(v: inout v, text: t)
  case BoolLit(value: b) then
    if b then
      return "true"
    end if
    return "false"
  case StrLit(value: s) then
    return str_const(v: inout v, s: s)
  case Var(name: n) then
    match lookup(map: sp.binds, key: n)
    case Some(value: t) then
      return t
    case None then
      return "unbound_" ++ n
    end match
  case It then
    return sp.subj
  case Result then
    return sp.res
  case Call(callee: c, args: args) then
    var ci = CallInfo(kind: "", name: "", variant: 0, order: [])
    match call_info(info: v.info, e: e)
    case Some(value: x) then
      set ci = x
    case None then
    end match
    if ci.kind == "old" then
      return bind_of(binds: sp.binds, n: "old(" ++ ci.name ++ ")")
    end if
    var p: List<String> = []
    for i in ci.order do
      if (i >= 0) and (i < len(args)) then
        set p = push(list: p, item: sexpr(v: inout v, e: args[i].value, sp: sp))
      end if
    end for
    let a0 = arg_str(p: p, i: 0)
    if ci.kind == "user" then
      return spec_call(v: inout v, name: ci.name, args: p, sp: sp)
    end if
    if ci.name == "len" then
      return "(len " ++ a0 ++ ")"
    elif ci.name == "is_some" then
      return "(= (tag " ++ a0 ++ ") 1)"
    elif ci.name == "is_none" then
      return "(= (tag " ++ a0 ++ ") 0)"
    elif (ci.name == "is_nan") or (ci.name == "int_to_float") then
      return float_builtin(v: inout v, name: ci.name, a: a0)
    end if
    if (ci.kind != "builtin") or (ci.name != "value_or") then
      // The checker lets only these calls into a specification; anything else here is a
      // compiler bug, and translating it as something else would prove false facts.
      panic("internal error: the verifier cannot translate the call '" ++ pretty_expr(e) ++ "' in a specification")
    end if
    let f = vfield_fn(v: inout v, ename: "Option", vname: "Some", field: "value", t: type_of(info: v.info, e: e))
    return "(ite (= (tag " ++ a0 ++ ") 1) (" ++ f ++ " " ++ a0 ++ ") " ++ arg_str(p: p, i: 1) ++ ")"
  case Quant(q: q, name: qn, lo: lo, hi: hi, body: body) then
    let a = sexpr(v: inout v, e: lo, sp: sp)
    let b = sexpr(v: inout v, e: hi, sp: sp)
    let qv = fresh_q(inout v)
    let inner = sp with (binds: insert(map: sp.binds, key: qn, value: qv))
    let bt = sexpr(v: inout v, e: body, sp: inner)
    return quant_term(q: q, v: qv, lo: a, hi: b, body: bt)
  case Field(obj: o, name: f) then
    // A variant written without fields (Tree.Leaf): a value with its tag.
    match call_info(info: v.info, e: e)
    case Some(value: ci) then
      if ci.kind == "variant" then
        let r = fresh(v: inout v, sort: "Val")
        add_def(v: inout v, d: "(assert (= (tag " ++ r ++ ") " ++ int_to_str(ci.variant) ++ "))")
        return r
      end if
    case None then
    end match
    let ot = type_of(info: v.info, e: o)
    let ft = type_of(info: v.info, e: e)
    let ov = sexpr(v: inout v, e: o, sp: sp)
    match ot
    case TStruct(name: sn) then
      let fnn = field_fn(v: inout v, sname: sn, field: f, t: ft)
      return "(" ++ fnn ++ " " ++ ov ++ ")"
    else
      return ov
    end match
  case Index(obj: o, idx: i) then
    let ot = type_of(info: v.info, e: o)
    let ov = sexpr(v: inout v, e: o, sp: sp)
    let iv = sexpr(v: inout v, e: i, sp: sp)
    match ot
    case TStr then
      return "(byte " ++ ov ++ " " ++ iv ++ ")"
    case TList(elem: t) then
      return "(elem_" ++ sort_of(t) ++ " " ++ ov ++ " " ++ iv ++ ")"
    else
      return ov
    end match
  case Unary(op: op, x: x) then
    let a = sexpr(v: inout v, e: x, sp: sp)
    if op == "-" then
      if ty_show(type_of(info: v.info, e: x)) == "Float" then
        return float_neg(v: inout v, a: a)
      end if
      return "(- " ++ a ++ ")"
    end if
    return "(not " ++ a ++ ")"
  case Binary(op: op, l: l, r: r) then
    let a = sexpr(v: inout v, e: l, sp: sp)
    let b = sexpr(v: inout v, e: r, sp: sp)
    if ty_show(type_of(info: v.info, e: l)) == "Float" then
      return float_op(v: inout v, op: op, a: a, b: b)
    end if
    if (op == "==") or (op == "!=") then
      return eq_term(v: inout v, op: op, t: type_of(info: v.info, e: l), a: a, b: b)
    end if
    return binop_term(op: op, a: a, b: b)
  else
    return "false"
  end match
end fn sexpr

// When a specification can be evaluated: its indexes are in range, its Int divisors are
// not zero and the preconditions of the functions it calls hold. sexpr treats these
// operations as total, but a build with --check-contracts evaluates the specification,
// and must not fail. Only the parts that run count: the right operand of 'and', 'or' and
// 'implies' where the left one lets it run, and a quantifier's body for each value of
// its variable in range.
fn swd(v: inout Verifier, e: Expr, sp: Spec) -> String do
  match e.kind
  case Call(callee: c, args: args) then
    var ci = CallInfo(kind: "", name: "", variant: 0, order: [])
    match call_info(info: v.info, e: e)
    case Some(value: x) then
      set ci = x
    case None then
    end match
    if ci.kind == "old" then
      return "true"
    end if
    var conds: List<String> = []
    var p: List<String> = []
    for i in ci.order do
      if (i >= 0) and (i < len(args)) then
        set conds = push(list: conds, item: swd(v: inout v, e: args[i].value, sp: sp))
        set p = push(list: p, item: sexpr(v: inout v, e: args[i].value, sp: sp))
      end if
    end for
    if ci.kind == "user" then
      match get_fn(info: v.info, name: ci.name)
      case Some(value: fi) then
        var binds: Map<String, String> = {}
        for i in 0..len(fi.params) do
          set binds = insert(map: binds, key: fi.params[i].name, value: arg_str(p: p, i: i))
        end for
        let callee = Spec(binds: binds, subj: "", res: "", fuel: 2, scc: -1)
        for i in 0..len(fi.params) do
          for pr in fi.params[i].rty.preds do
            set conds = push(list: conds, item: sexpr(v: inout v, e: pr, sp: callee with (subj: arg_str(p: p, i: i))))
          end for
          var ins: List<Inner> = []
          inner_refs(v: inout v, r: fi.params[i].rty, term: arg_str(p: p, i: i), name: "", defined: true, out: inout ins)
          for x in ins do
            set conds = push(list: conds, item: x.fact)
          end for
        end for
        for r in fi.pre do
          set conds = push(list: conds, item: sexpr(v: inout v, e: r, sp: callee))
        end for
      case None then
      end match
    end if
    return wd_and(conds)
  case Quant(q: q, name: qn, lo: lo, hi: hi, body: body) then
    let a = sexpr(v: inout v, e: lo, sp: sp)
    let b = sexpr(v: inout v, e: hi, sp: sp)
    let qv = fresh_q(inout v)
    let inner = sp with (binds: insert(map: sp.binds, key: qn, value: qv))
    let w = swd(v: inout v, e: body, sp: inner)
    var all = "true"
    if w != "true" then
      set all = "(forall ((" ++ qv ++ " Int)) (=> (and (<= " ++ a ++ " " ++ qv ++ ") (< " ++ qv ++ " " ++ b ++ ")) " ++ w ++ "))"
    end if
    return wd_and([swd(v: inout v, e: lo, sp: sp), swd(v: inout v, e: hi, sp: sp), all])
  case Field(obj: o, name: f) then
    return swd(v: inout v, e: o, sp: sp)
  case Index(obj: o, idx: i) then
    let w = wd_and([swd(v: inout v, e: o, sp: sp), swd(v: inout v, e: i, sp: sp)])
    match type_of(info: v.info, e: o)
    case TStr then
    case TList(elem: t) then
    else
      return w
    end match
    let ov = sexpr(v: inout v, e: o, sp: sp)
    let iv = sexpr(v: inout v, e: i, sp: sp)
    return wd_and([w, "(<= 0 " ++ iv ++ ")", "(< " ++ iv ++ " (len " ++ ov ++ "))"])
  case Unary(op: op, x: x) then
    return swd(v: inout v, e: x, sp: sp)
  case Binary(op: op, l: l, r: r) then
    let wl = swd(v: inout v, e: l, sp: sp)
    let wr = swd(v: inout v, e: r, sp: sp)
    if ((op == "and") or (op == "implies")) and (wr != "true") then
      return wd_and([wl, "(=> " ++ sexpr(v: inout v, e: l, sp: sp) ++ " " ++ wr ++ ")"])
    end if
    if (op == "or") and (wr != "true") then
      return wd_and([wl, "(=> (not " ++ sexpr(v: inout v, e: l, sp: sp) ++ ") " ++ wr ++ ")"])
    end if
    if ((op == "/") or (op == "%")) and (ty_show(type_of(info: v.info, e: l)) == "Int") then
      return wd_and([wl, wr, "(not (= " ++ sexpr(v: inout v, e: r, sp: sp) ++ " 0))"])
    end if
    return wd_and([wl, wr])
  else
    return "true"
  end match
end fn swd

// The conjunction of conditions, leaving out the ones that are just "true", so that a
// specification with nothing to prove gives "true" and no obligation.
fn wd_and(conds: List<String>) -> String do
  var keep: List<String> = []
  for c in conds do
    if c != "true" then
      set keep = push(list: keep, item: c)
    end if
  end for
  return and_all(keep)
end fn wd_and

// An obligation that e, a specification that a build with --check-contracts evaluates
// at this point, is well defined (see swd).
fn check_wd(v: inout Verifier, st: St, pos: Pos, e: Expr, sp: Spec) do
  if not v.hyps then
    return
  end if
  let w = swd(v: inout v, e: e, sp: sp)
  if w == "true" then
    return
  end if
  let g = with_hyps(hyps: struct_hyps(v: inout v, e: e, sp: sp), goal: w)
  obligation(v: inout v, st: st, pos: pos, what: "'" ++ pretty_expr(e) ++ "' is defined (indexes in range, divisors not zero, calls' preconditions met)", goal: g)
end fn check_wd

// A call to a specification function in a specification (sp is the caller's). An
// expression function's body is inlined, as is the body of any other non-recursive
// one; a recursive one is an uninterpreted function defined by axioms.
fn spec_call(v: inout Verifier, name: String, args: List<String>, sp: Spec) -> String do
  match get_fn(info: v.info, name: name)
  case Some(value: fi) then
    var binds: Map<String, String> = {}
    for i in 0..len(fi.params) do
      set binds = insert(map: binds, key: fi.params[i].name, value: arg_str(p: args, i: i))
    end for
    match fi.inline
    case Some(value: body) then
      return sexpr(v: inout v, e: body, sp: sp with (binds: binds, subj: "", res: ""))
    case None then
    end match
    match fi.spec_body
    case Some(value: body) then
      if not fi.spec_rec then
        return tree_term(v: inout v, stmts: body, sp: sp with (binds: binds, subj: "", res: ""))
      end if
      var layer = 2
      let k = scc_of_fn(info: v.info, name: name)
      if (k >= 0) and (k == sp.scc) then
        set layer = sp.fuel
      end if
      spec_fn_axioms(v: inout v, fi: fi, body: body)
      if len(args) == 0 then
        return layer_name(name: name, layer: layer)
      end if
      return "(" ++ layer_name(name: name, layer: layer) ++ " " ++ join(parts: args, sep: " ") ++ ")"
    case None then
      return "false"
    end match
  case None then
    return "false"
  end match
end fn spec_call

fn layer_name(name: String, layer: Int) -> String do
  if layer >= 2 then
    return "sf_" ++ mangle(name)
  end if
  return "sf" ++ int_to_str(layer) ++ "_" ++ mangle(name)
end fn layer_name

// The term a specification function's body denotes: 'let' binds, 'if' and 'match'
// choose, 'return' gives the value. Statements after an 'if' or 'match' whose branch
// falls through follow that branch.
fn tree_term(v: inout Verifier, stmts: List<Stmt>, sp: Spec) -> String do
  var cur = sp
  for i in 0..len(stmts) do
    let rest = slice(of: stmts, from: i + 1, to: len(stmts))
    match stmts[i].kind
    case Let(name: n, ty: t, value: x, mutable: m) then
      let xt = sexpr(v: inout v, e: x, sp: cur)
      set cur = cur with (binds: insert(map: cur.binds, key: n, value: xt))
    case Return(value: rv) then
      match rv
      case Some(value: x) then
        return sexpr(v: inout v, e: x, sp: cur)
      case None then
        return "0"
      end match
    case If(arms: arms, els: els) then
      var t = ""
      match els
      case Some(value: b) then
        set t = tree_term(v: inout v, stmts: b ++ rest, sp: cur)
      case None then
        set t = tree_term(v: inout v, stmts: rest, sp: cur)
      end match
      var k = len(arms)
      while k > 0 invariant k <= len(arms) do
        set k = k - 1
        let c = sexpr(v: inout v, e: arms[k].cond, sp: cur)
        let a = tree_term(v: inout v, stmts: arms[k].body ++ rest, sp: cur)
        set t = "(ite " ++ c ++ " " ++ a ++ " " ++ t ++ ")"
      end while
      return t
    case Match(scrut: sc, cases: cases, els: els) then
      return match_term(v: inout v, sc: sc, cases: cases, els: els, rest: rest, sp: cur)
    else
    end match
  end for
  return "0"
end fn tree_term

fn match_term(v: inout Verifier, sc: Expr, cases: List<Case>, els: Option<List<Stmt>>, rest: List<Stmt>,
    sp: Spec) -> String do
  let sv = sexpr(v: inout v, e: sc, sp: sp)
  let stype = type_of(info: v.info, e: sc)
  var variants: List<VariantInfo> = []
  match variants_of(info: v.info, t: stype)
  case Some(value: vs) then
    set variants = vs
  case None then
  end match
  var ename = ty_show(stype)
  match stype
  case TOpt(inner: x) then
    set ename = "Option"
  else
  end match
  // The last arm is the default: with no 'else', the cases are exhaustive.
  var t = ""
  var k = len(cases)
  match els
  case Some(value: b) then
    set t = tree_term(v: inout v, stmts: b ++ rest, sp: sp)
  case None then
    if k > 0 then
      set k = k - 1
      set t = arm_term(v: inout v, cs: cases[k], sv: sv, variants: variants, ename: ename, rest: rest, sp: sp)
    end if
  end match
  while k > 0 invariant k <= len(cases) do
    set k = k - 1
    let cs = cases[k]
    var g = "false"
    match cs.pat
    case PInt(value: n) then
      set g = "(= " ++ sv ++ " " ++ int_lit(n) ++ ")"
    case PStr(value: x) then
      set g = "(= " ++ sv ++ " " ++ str_const(v: inout v, s: x) ++ ")"
    case PVariant(name: name, binds: bs) then
      set g = "(= (tag " ++ sv ++ ") " ++ int_to_str(find_variant(vs: variants, name: name)) ++ ")"
    end match
    let a = arm_term(v: inout v, cs: cs, sv: sv, variants: variants, ename: ename, rest: rest, sp: sp)
    set t = "(ite " ++ g ++ " " ++ a ++ " " ++ t ++ ")"
  end while
  return t
end fn match_term

fn arm_term(v: inout Verifier, cs: Case, sv: String, variants: List<VariantInfo>, ename: String,
    rest: List<Stmt>, sp: Spec) -> String do
  var cur = sp
  match cs.pat
  case PVariant(name: name, binds: bs) then
    let vi = find_variant(vs: variants, name: name)
    if vi >= 0 then
      for fl in variants[vi].fields do
        for b in bs do
          if b.field == fl.name then
            let f = vfield_fn(v: inout v, ename: ename, vname: name, field: fl.name, t: fl.rty.ty)
            set cur = cur with (binds: insert(map: cur.binds, key: b.binder, value: "(" ++ f ++ " " ++ sv ++ ")"))
          end if
        end for
      end for
    end if
  else
  end match
  return tree_term(v: inout v, stmts: cs.body ++ rest, sp: cur)
end fn arm_term

// The definition of a recursive specification function f, in three layers so that
// the solver unfolds it a bounded number of times: sf_f's body calls sf1_f, sf1_f's
// body calls sf0_f, and sf0_f has no definition; all three are the same function.
// Each layer also gets f's postconditions. The axioms hold where f's preconditions
// do. They are left out of the queries for f's own group: their consistency rests on
// f terminating, which those queries prove.
fn spec_fn_axioms(v: inout Verifier, fi: FnInfo, body: List<Stmt>) do
  let rsort = sort_of(fi.ret.ty)
  var sorts: List<String> = []
  var vars: List<String> = []
  var decl: List<String> = []
  var binds: Map<String, String> = {}
  for i in 0..len(fi.params) do
    let s = sort_of(fi.params[i].rty.ty)
    let x = "sa" ++ int_to_str(i)
    set sorts = push(list: sorts, item: s)
    set vars = push(list: vars, item: x)
    set decl = push(list: decl, item: "(" ++ x ++ " " ++ s ++ ")")
    set binds = insert(map: binds, key: fi.params[i].name, value: x)
  end for
  for layer in [0, 1, 2] do
    let _ = global_fn(v: inout v, name: layer_name(name: fi.name, layer: layer), args: join(parts: sorts, sep: " "), sort: rsort)
  end for
  let k = scc_of_fn(info: v.info, name: fi.name)
  if (k == scc_of_fn(info: v.info, name: v.fname)) or contains_str(xs: v.sf_done, x: fi.name) or (len(vars) == 0) then
    return
  end if
  set v = v with (sf_done: push(list: v.sf_done, item: fi.name))
  let top = Spec(binds: binds, subj: "", res: "", fuel: 2, scc: -1)
  var pre: List<String> = []
  for i in 0..len(fi.params) do
    for p in fi.params[i].rty.preds do
      set pre = push(list: pre, item: sexpr(v: inout v, e: p, sp: top with (subj: "sa" ++ int_to_str(i))))
    end for
    // The refinements inside its parameters' types, which the body assumed too.
    set pre = pre ++ inner_facts(v: inout v, r: fi.params[i].rty, term: "sa" ++ int_to_str(i))
  end for
  for r in fi.pre do
    set pre = push(list: pre, item: sexpr(v: inout v, e: r, sp: top))
  end for
  // f's body was proved assuming that its struct parameters hold real values (their
  // field refinements, see struct_hyps), so the axioms hold only of such values. A
  // struct no value can satisfy would otherwise make them false of every argument.
  if v.hyps then
    for i in 0..len(fi.params) do
      struct_facts(v: inout v, t: fi.params[i].rty.ty, term: "sa" ++ int_to_str(i), depth: 3, out: inout pre)
    end for
  end if
  let guard = and_all(pre)
  let args = join(parts: vars, sep: " ")
  let q = "(forall (" ++ join(parts: decl, sep: " ") ++ ") (! "
  for layer in [2, 1] do
    let app = "(" ++ layer_name(name: fi.name, layer: layer) ++ " " ++ args ++ ")"
    let def = tree_term(v: inout v, stmts: body, sp: top with (fuel: layer - 1, scc: k))
    add_qdef(v: inout v, d: "(assert " ++ q ++ "(=> " ++ guard ++ " (= " ++ app ++ " " ++ def ++ ")) :pattern (" ++ app ++ "))))")
    let lower = "(" ++ layer_name(name: fi.name, layer: layer - 1) ++ " " ++ args ++ ")"
    add_qdef(v: inout v, d: "(assert " ++ q ++ "(= " ++ app ++ " " ++ lower ++ ") :pattern (" ++ app ++ "))))")
  end for
  for layer in [2, 1, 0] do
    let app = "(" ++ layer_name(name: fi.name, layer: layer) ++ " " ++ args ++ ")"
    var post: List<String> = []
    for p in fi.ret.preds do
      set post = push(list: post, item: sexpr(v: inout v, e: p, sp: top with (subj: app)))
    end for
    set post = post ++ inner_facts(v: inout v, r: fi.ret, term: app)
    for en in fi.post do
      set post = push(list: post, item: sexpr(v: inout v, e: en, sp: top with (res: app)))
    end for
    if len(post) > 0 then
      // The postconditions were proved assuming the result is real too.
      var rpre = pre
      if v.hyps then
        struct_facts(v: inout v, t: fi.ret.ty, term: app, depth: 3, out: inout rpre)
      end if
      add_qdef(v: inout v, d: "(assert " ++ q ++ "(=> " ++ and_all(rpre) ++ " " ++ and_all(post) ++ ") :pattern (" ++ app ++ "))))")
    end if
  end for
end fn spec_fn_axioms

// The SMT function giving the contents of a String or List ("" for other types).
fn content_fn(t: Ty) -> String do
  match t
  case TStr then
    return "byte"
  case TList(elem: e) then
    return "elem_" ++ sort_of(e)
  else
    return ""
  end match
end fn content_fn

fn fresh_q(v: inout Verifier) -> String do
  set v = v with (n: v.n + 1)
  return "q" ++ int_to_str(v.n)
end fn fresh_q

fn quant_term(q: String, v: String, lo: String, hi: String, body: String) -> String do
  if q == "forall" then
    return "(forall ((" ++ v ++ " Int)) (=> (and (<= " ++ lo ++ " " ++ v ++ ") (< " ++ v ++ " " ++ hi ++ ")) " ++ body ++ "))"
  end if
  return "(exists ((" ++ v ++ " Int)) (and (<= " ++ lo ++ " " ++ v ++ ") (< " ++ v ++ " " ++ hi ++ ") " ++ body ++ "))"
end fn quant_term

// True if e can be translated as a specification term (see spec_safe in check.vow).
fn translatable(v: Verifier, e: Expr) -> Bool do
  match e.kind
  case IntLit(value: x) then
    return true
  case BoolLit(value: x) then
    return true
  case StrLit(value: x) then
    return true
  case Var(name: n) then
    return true
  case Unary(op: op, x: x) then
    return translatable(v: v, e: x)
  case Binary(op: op, l: l, r: r) then
    return (op != "++") and translatable(v: v, e: l) and translatable(v: v, e: r)
  case Index(obj: o, idx: i) then
    return translatable(v: v, e: o) and translatable(v: v, e: i)
  case Field(obj: o, name: f) then
    match type_of(info: v.info, e: o)
    case TStruct(name: n) then
      return translatable(v: v, e: o)
    else
      return false
    end match
  case Call(callee: c, args: args) then
    var ok = false
    match call_info(info: v.info, e: e)
    case Some(value: ci) then
      if ci.kind == "builtin" then
        set ok = spec_builtin(ci.name)
      elif ci.kind == "old" then
        set ok = true
      elif ci.kind == "user" then
        match get_fn(info: v.info, name: ci.name)
        case Some(value: fi) then
          set ok = is_some(fi.inline) or is_some(fi.spec_body)
        case None then
        end match
      end if
    case None then
    end match
    if not ok then
      return false
    end if
    for a in args do
      if not translatable(v: v, e: a.value) then
        return false
      end if
    end for
    return true
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    return translatable(v: v, e: lo) and translatable(v: v, e: hi) and translatable(v: v, e: b)
  else
    return false
  end match
end fn translatable

fn map_without(m: Map<String, VVar>, k: String) -> Map<String, VVar> do
  var out: Map<String, VVar> = {}
  for key in keys(m) do
    if key != k then
      match lookup(map: m, key: key)
      case Some(value: x) then
        set out = insert(map: out, key: key, value: x)
      case None then
      end match
    end if
  end for
  return out
end fn map_without

fn set_term(st: St, name: String, term: String) -> St do
  match lookup(map: st.env, key: name)
  case Some(value: x) then
    return st with (env: insert(map: st.env, key: name, value: x with (term: term)))
  case None then
    return st
  end match
end fn set_term

// ---- statements ----

fn vblock(v: inout Verifier, stmts: List<Stmt>, st: inout St) do
  for s in stmts do
    if st.dead then
      return
    end if
    vstmt(v: inout v, s: s, st: inout st)
  end for
end fn vblock

fn assume_preds(v: inout Verifier, st: inout St, name: String, preds: List<Expr>, term: String) do
  for p in preds do
    let t = spec_term(v: inout v, e: p, st: st, subj: term, res: "")
    add_fact(st: inout st, f: t)
    add_src(st: inout st, f: name ++ " where " ++ pretty_expr(p))
  end for
end fn assume_preds

fn check_preds(v: inout Verifier, st: St, pos: Pos, name: String, preds: List<Expr>, term: String) do
  for p in preds do
    check_wd(v: inout v, st: st, pos: pos, e: p, sp: state_spec(v: v, st: st, subj: term, res: ""))
    let g = spec_term(v: inout v, e: p, st: st, subj: term, res: "")
    obligation(v: inout v, st: st, pos: pos, what: "'" ++ name ++ "' satisfies " ++ pretty_expr(p), goal: g)
  end for
end fn check_preds

// ---- refinements inside type arguments (List<Nat>, Option<Int where it > 0>) ----

// What the refinements inside r's type arguments say of term, a value of type r.ty:
// each element of a list (one quantified formula per refinement) or the value in an
// option (when there is one) satisfies its own refinements, and so on inside it. With
// defined, each formula also says the refinement is defined there (for an obligation; a
// checked build evaluates it). desc says what each formula states, for messages.
struct Inner
  fact: String,
  desc: String,
end struct Inner

fn inner_refs(v: inout Verifier, r: RTy, term: String, name: String, defined: Bool, out: inout List<Inner>) do
  if len(r.args) == 0 then
    return
  end if
  let a = r.args[0]
  match r.ty
  case TList(elem: et) then
    let k = fresh_q(inout v)
    let el = "(elem_" ++ sort_of(et) ++ " " ++ term ++ " " ++ k ++ ")"
    var sub: List<Inner> = []
    value_refs(v: inout v, r: a, term: el, name: "every element of " ++ name, defined: defined, out: inout sub)
    let range = "(and (<= 0 " ++ k ++ ") (< " ++ k ++ " (len " ++ term ++ ")))"
    for x in sub do
      set out = push(list: out, item: Inner(fact: "(forall ((" ++ k ++ " Int)) (! (=> " ++ range ++ " " ++ x.fact ++ ") :pattern (" ++ el ++ ")))", desc: x.desc))
    end for
  case TOpt(inner: ot) then
    let f = vfield_fn(v: inout v, ename: "Option", vname: "Some", field: "value", t: ot)
    var sub: List<Inner> = []
    value_refs(v: inout v, r: a, term: "(" ++ f ++ " " ++ term ++ ")", name: "the value in " ++ name, defined: defined, out: inout sub)
    for x in sub do
      set out = push(list: out, item: Inner(fact: "(=> (= (tag " ++ term ++ ") 1) " ++ x.fact ++ ")", desc: x.desc))
    end for
  case TStruct(name: sn) then
    // An instance of a generic struct: its fields of a refined type parameter.
    let fields = struct_fields(info: v.info, name: sn)
    let refs = struct_field_refs(info: v.info, name: sn, args: r.args)
    for i in 0..len(fields) do
      if (i < len(refs)) and not is_plain(refs[i]) then
        let f = field_fn(v: inout v, sname: sn, field: fields[i].name, t: fields[i].rty.ty)
        value_refs(v: inout v, r: refs[i], term: "(" ++ f ++ " " ++ term ++ ")", name: "field '" ++ fields[i].name ++ "' of " ++ name,
          defined: defined, out: inout out)
      end if
    end for
  case TEnum(name: en) then
    // An instance of a generic enum: the fields of each variant, when it is that one.
    match variants_of(info: v.info, t: r.ty)
    case Some(value: vs) then
      let refs = variant_field_refs(info: v.info, name: en, args: r.args)
      for vi in 0..len(vs) do
        if vi < len(refs) then
          for fi in 0..len(vs[vi].fields) do
            if (fi < len(refs[vi])) and not is_plain(refs[vi][fi]) then
              let fl = vs[vi].fields[fi]
              let f = vfield_fn(v: inout v, ename: en, vname: vs[vi].name, field: fl.name, t: fl.rty.ty)
              var sub: List<Inner> = []
              value_refs(v: inout v, r: refs[vi][fi], term: "(" ++ f ++ " " ++ term ++ ")",
                name: "field '" ++ fl.name ++ "' of " ++ name ++ " (when " ++ vs[vi].name ++ ")", defined: defined, out: inout sub)
              for x in sub do
                set out = push(list: out, item: Inner(fact: "(=> (= (tag " ++ term ++ ") " ++ int_to_str(vi) ++ ") " ++ x.fact ++ ")", desc: x.desc))
              end for
            end if
          end for
        end if
      end for
    case None then
    end match
  else
  end match
end fn inner_refs

// r's own refinements of term, and those inside it.
fn value_refs(v: inout Verifier, r: RTy, term: String, name: String, defined: Bool, out: inout List<Inner>) do
  let sp = Spec(binds: {}, subj: term, res: "", fuel: 2, scc: -1)
  for p in r.preds do
    var f = sexpr(v: inout v, e: p, sp: sp)
    if defined then
      let w = swd(v: inout v, e: p, sp: sp)
      if w != "true" then
        set f = "(and " ++ w ++ " " ++ f ++ ")"
      end if
    end if
    set out = push(list: out, item: Inner(fact: f, desc: name ++ " satisfies " ++ pretty_expr(p)))
  end for
  inner_refs(v: inout v, r: r, term: term, name: name, defined: defined, out: inout out)
end fn value_refs

// The inner refinements of r as facts about term.
fn inner_facts(v: inout Verifier, r: RTy, term: String) -> List<String> do
  var parts: List<Inner> = []
  inner_refs(v: inout v, r: r, term: term, name: "", defined: false, out: inout parts)
  var out: List<String> = []
  for x in parts do
    set out = push(list: out, item: x.fact)
  end for
  return out
end fn inner_facts

fn assume_inner(v: inout Verifier, st: inout St, name: String, r: RTy, term: String) do
  var parts: List<Inner> = []
  inner_refs(v: inout v, r: r, term: term, name: name, defined: false, out: inout parts)
  for x in parts do
    add_fact(st: inout st, f: x.fact)
    add_src(st: inout st, f: x.desc)
  end for
end fn assume_inner

// The obligations that term, about to be stored where r is declared, satisfies r's
// inner refinements; name says where ("'xs'", "the result of 'f'").
fn check_inner(v: inout Verifier, st: St, pos: Pos, name: String, r: RTy, term: String) do
  var parts: List<Inner> = []
  inner_refs(v: inout v, r: r, term: term, name: name, defined: true, out: inout parts)
  for x in parts do
    obligation(v: inout v, st: st, pos: pos, what: x.desc, goal: x.fact)
  end for
end fn check_inner

// ---- refined type arguments through generic functions ----

// A generic function is verified for every type T, so the values of type T in what it
// returns (or leaves in an inout argument) are values of type T it was given: it has no
// other way to make one. So for any property R, if every T in the arguments satisfies
// R, every T in the results does. At a call, each refinement that the arguments' own
// types give T (last(xs) with xs a List<Nat>: R is Nat) becomes that implication. It
// adds facts and no obligations: a call whose arguments do not satisfy R is unaffected.
// A T reached only through a map, or through a recursive type, is not covered by the
// formulas inner_refs writes, so such a T is left out.

// True if te mentions the type parameter x.
fn te_mentions(te: TypeExpr, x: String) -> Bool do
  if te.name == x then
    return true
  end if
  for a in te.args do
    if te_mentions(te: a, x: x) then
      return true
    end if
  end for
  return false
end fn te_mentions

// The types of the fields of the generic struct or enum name, as declared.
fn generic_field_types(info: Info, name: String) -> List<TypeExpr> do
  var out: List<TypeExpr> = []
  match lookup(map: info.gstructs, key: name)
  case Some(value: s) then
    for f in s.fields do
      set out = push(list: out, item: f.ty)
    end for
  case None then
  end match
  match lookup(map: info.genums, key: name)
  case Some(value: e) then
    for vd in e.variants do
      for f in vd.fields do
        set out = push(list: out, item: f.ty)
      end for
    end for
  case None then
  end match
  return out
end fn generic_field_types

// True if inner_refs reaches every value of the type parameter x inside a value of type
// te: through lists, options and the fields of generic types, not through maps or a
// type that contains itself. visiting holds the generic types being looked inside.
fn te_covers(info: Info, te: TypeExpr, x: String, visiting: List<String>) -> Bool do
  if (te.name == x) or not te_mentions(te: te, x: x) then
    return true
  end if
  if (te.name == "List") or (te.name == "Option") then
    return (len(te.args) == 1) and te_covers(info: info, te: te.args[0], x: x, visiting: visiting)
  end if
  if contains_str(xs: visiting, x: te.name) then
    return false
  end if
  let tps = generic_tparams(info: info, name: te.name)
  if (len(tps) == 0) or (len(tps) != len(te.args)) then
    return false
  end if
  let inside = push(list: visiting, item: te.name)
  for k in 0..len(te.args) do
    if (k < len(tps)) and te_mentions(te: te.args[k], x: x) then
      if not te_covers(info: info, te: te.args[k], x: x, visiting: visiting) then
        return false
      end if
      for ft in generic_field_types(info: info, name: te.name) do
        if not te_covers(info: info, te: ft, x: tps[k], visiting: inside) then
          return false
        end if
      end for
    end if
  end for
  return true
end fn te_covers

// The refinement e is known to have from the types it was declared with: a variable's,
// a field's, a list's elements, a function's result. Only a source of candidates for R
// above; nothing is assumed from it.
fn known_rty(v: Verifier, st: St, e: Expr) -> RTy do
  match e.kind
  case Var(name: n) then
    match lookup(map: st.env, key: n)
    case Some(value: x) then
      return RTy(ty: x.ty, preds: x.preds, args: x.args)
    case None then
    end match
  case Index(obj: o, idx: i) then
    let r = known_rty(v: v, st: st, e: o)
    match r.ty
    case TList(elem: et) then
      if len(r.args) > 0 then
        return r.args[0]
      end if
    else
    end match
  case Field(obj: o, name: n) then
    let r = known_rty(v: v, st: st, e: o)
    match r.ty
    case TStruct(name: sn) then
      let fields = struct_fields(info: v.info, name: sn)
      let refs = struct_field_refs(info: v.info, name: sn, args: r.args)
      for i in 0..len(fields) do
        if fields[i].name == n then
          if (len(r.args) > 0) and (i < len(refs)) and not is_plain(refs[i]) then
            return refs[i] with (preds: fields[i].rty.preds ++ refs[i].preds)
          end if
          return fields[i].rty
        end if
      end for
    else
    end match
  case Call(callee: c, args: args) then
    match call_info(info: v.info, e: e)
    case Some(value: ci) then
      if ci.kind == "user" then
        match get_fn(info: v.info, name: ci.name)
        case Some(value: fi) then
          match generic_decl(info: v.info, name: ci.name)
          case Some(value: gd) then
            match gd.ret
            case Some(value: rt) then
              let pe = ordered_args(args: args, order: ci.order)
              let cands = generic_cands(v: v, st: st, gd: gd, pe: pe)
              var targs: List<RTy> = []
              for tp in gd.tparams do
                var a = plain(Ty.TUnknown)
                let cs = value_or(opt: lookup(map: cands, key: tp), default: [])
                if len(cs) > 0 then
                  set a = cs[0]
                end if
                set targs = push(list: targs, item: a)
              end for
              let r = refine_like(info: v.info, t: fi.ret.ty, te: rt, tps: gd.tparams, args: targs)
              return r with (preds: fi.ret.preds ++ r.preds)
            case None then
            end match
          case None then
          end match
          return fi.ret
        case None then
        end match
      end if
    case None then
    end match
  else
  end match
  return plain(type_of(info: v.info, e: e))
end fn known_rty

// The generic function an instance (such as "last<Int>") was made from.
fn generic_decl(info: Info, name: String) -> Option<FnDecl> do
  match lookup(map: info.origins, key: name)
  case Some(value: g) then
    return lookup(map: info.gfns, key: g)
  case None then
    return Option.None
  end match
end fn generic_decl

fn ordered_args(args: List<Arg>, order: List<Int>) -> List<Expr> do
  var out: List<Expr> = []
  for i in order do
    if (i >= 0) and (i < len(args)) then
      set out = push(list: out, item: args[i].value)
    end if
  end for
  return out
end fn ordered_args

// A key telling refinements apart, to list each candidate once.
fn rty_key(r: RTy) -> String do
  var k = "("
  for p in r.preds do
    set k = k ++ pretty_expr(p) ++ ";"
  end for
  for a in r.args do
    set k = k ++ rty_key(a)
  end for
  return k ++ ")"
end fn rty_key

// True if e mentions no variable but it and the names in bound: a refinement that
// can be stated of any value. Function names and enum names are not variables.
fn closed_expr(info: Info, e: Expr, bound: List<String>) -> Bool do
  match e.kind
  case Var(name: n) then
    return contains_str(xs: bound, x: n)
  case Result then
    return false
  case Hole(name: n) then
    return false
  case Call(callee: c, args: args) then
    for a in args do
      if not closed_expr(info: info, e: a.value, bound: bound) then
        return false
      end if
    end for
    return true
  case ListLit(items: items) then
    for x in items do
      if not closed_expr(info: info, e: x, bound: bound) then
        return false
      end if
    end for
    return true
  case Index(obj: o, idx: i) then
    return closed_expr(info: info, e: o, bound: bound) and closed_expr(info: info, e: i, bound: bound)
  case Field(obj: o, name: n) then
    match o.kind
    case Var(name: en) then
      if has(map: info.enums, key: en) or (en == "Option") then
        return true
      end if
    else
    end match
    return closed_expr(info: info, e: o, bound: bound)
  case With(obj: o, args: args) then
    for a in args do
      if not closed_expr(info: info, e: a.value, bound: bound) then
        return false
      end if
    end for
    return closed_expr(info: info, e: o, bound: bound)
  case Unary(op: op, x: x) then
    return closed_expr(info: info, e: x, bound: bound)
  case Binary(op: op, l: l, r: r) then
    return closed_expr(info: info, e: l, bound: bound) and closed_expr(info: info, e: r, bound: bound)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    return closed_expr(info: info, e: lo, bound: bound) and closed_expr(info: info, e: hi, bound: bound)
    and closed_expr(info: info, e: b, bound: push(list: bound, item: n))
  else
    return true
  end match
end fn closed_expr

fn closed_rty(info: Info, r: RTy) -> Bool do
  let none: List<String> = []
  for p in r.preds do
    if not closed_expr(info: info, e: p, bound: none) then
      return false
    end if
  end for
  for a in r.args do
    if not closed_rty(info: info, r: a) then
      return false
    end if
  end for
  return true
end fn closed_rty

// The refinements the arguments' types give each type parameter: where the parameter's
// declared type has a type parameter, the refinement at the same place in the argument's.
// Only refinements that mention no variables (it < n says nothing of another T).
fn collect_cands(info: Info, te: TypeExpr, r: RTy, tps: List<String>, keys: inout List<String>, out: inout Map<String, List<RTy>>) do
  if contains_str(xs: tps, x: te.name) then
    // Not a refined recursive type (Tree<Nat>), which no formula covers; the checker
    // refuses one written, but one can be inferred (leaf(n) with n a Nat).
    let none: List<String> = []
    if (not is_plain(r)) and closed_rty(info: info, r: r) and (len(refined_cycle(info: info, r: r, seen: none)) == 0) then
      let k = te.name ++ " " ++ rty_key(r)
      let have = value_or(opt: lookup(map: out, key: te.name), default: [])
      if (len(have) < 4) and not contains_str(xs: keys, x: k) then
        set keys = push(list: keys, item: k)
        set out = insert(map: out, key: te.name, value: push(list: have, item: r))
      end if
    end if
    return
  end if
  for k in 0..len(te.args) do
    if k < len(r.args) then
      collect_cands(info: info, te: te.args[k], r: r.args[k], tps: tps, keys: inout keys, out: inout out)
    end if
  end for
end fn collect_cands

fn generic_cands(v: Verifier, st: St, gd: FnDecl, pe: List<Expr>) -> Map<String, List<RTy>> do
  var keys: List<String> = []
  var out: Map<String, List<RTy>> = {}
  for i in 0..len(gd.params) do
    if i < len(pe) then
      collect_cands(info: v.info, te: gd.params[i].ty, r: known_rty(v: v, st: st, e: pe[i]), tps: gd.tparams, keys: inout keys, out: inout out)
    end if
  end for
  return out
end fn generic_cands

// The implications above, for a call to the instance fi of gd: arguments p (as passed
// in, by parameter), the new values of inout parameters in post, the result res.
fn generic_facts(v: inout Verifier, st: inout St, gd: FnDecl, fi: FnInfo, pe: List<Expr>, p: List<String>,
    post: Map<String, String>, res: String) do
  let cands = generic_cands(v: v, st: st, gd: gd, pe: pe)
  let none: List<String> = []
  for ti in 0..len(gd.tparams) do
    let x = gd.tparams[ti]
    var covered = true
    for gp in gd.params do
      if not te_covers(info: v.info, te: gp.ty, x: x, visiting: none) then
        set covered = false
      end if
    end for
    match gd.ret
    case Some(value: rt) then
      if not te_covers(info: v.info, te: rt, x: x, visiting: none) then
        set covered = false
      end if
    case None then
    end match
    let cs = value_or(opt: lookup(map: cands, key: x), default: [])
    if covered and (len(cs) > 0) then
      for cand in cs do
        var targs: List<RTy> = []
        for k in 0..len(gd.tparams) do
          if k == ti then
            set targs = push(list: targs, item: cand)
          else
            set targs = push(list: targs, item: plain(Ty.TUnknown))
          end if
        end for
        var ante: List<Inner> = []
        var concl: List<Inner> = []
        for i in 0..len(gd.params) do
          if (i < len(fi.params)) and (i < len(p)) and te_mentions(te: gd.params[i].ty, x: x) then
            let r = refine_like(info: v.info, t: fi.params[i].rty.ty, te: gd.params[i].ty, tps: gd.tparams, args: targs)
            value_refs(v: inout v, r: r, term: p[i], name: "'" ++ gd.params[i].name ++ "'", defined: false, out: inout ante)
            if (i < len(fi.io)) and fi.io[i] then
              let nv = bind_of(binds: post, n: fi.params[i].name)
              value_refs(v: inout v, r: r, term: nv, name: "'" ++ gd.params[i].name ++ "' after the call to '" ++ gd.name ++ "'",
                defined: false, out: inout concl)
            end if
          end if
        end for
        match gd.ret
        case Some(value: rt) then
          if te_mentions(te: rt, x: x) then
            let r = refine_like(info: v.info, t: fi.ret.ty, te: rt, tps: gd.tparams, args: targs)
            value_refs(v: inout v, r: r, term: res, name: "the result of '" ++ gd.name ++ "'", defined: false, out: inout concl)
          end if
        case None then
        end match
        if len(ante) > 0 then
          var a = "(and"
          for f in ante do
            set a = a ++ " " ++ f.fact
          end for
          set a = a ++ ")"
          for c in concl do
            add_fact(st: inout st, f: "(=> " ++ a ++ " " ++ c.fact ++ ")")
            add_src(st: inout st, f: c.desc ++ ", if the arguments' values of " ++ x ++ " do")
          end for
        end if
      end for
    end if
  end for
end fn generic_facts

fn check_entry(v: inout Verifier, st: St, invs: List<Expr>) do
  for i in invs do
    check_wd(v: inout v, st: st, pos: i.pos, e: i, sp: state_spec(v: v, st: st, subj: "", res: ""))
    let g = spec_goal(v: inout v, e: i, st: st, subj: "", res: "")
    obligation(v: inout v, st: st, pos: i.pos, what: "loop invariant holds on entry: " ++ pretty_expr(i), goal: g)
  end for
end fn check_entry

fn check_invs(v: inout Verifier, st: St, invs: List<Expr>, what: String) do
  for i in invs do
    check_wd(v: inout v, st: st, pos: i.pos, e: i, sp: state_spec(v: v, st: st, subj: "", res: ""))
    let g = spec_goal(v: inout v, e: i, st: st, subj: "", res: "")
    obligation(v: inout v, st: st, pos: i.pos, what: "loop invariant " ++ what ++ ": " ++ pretty_expr(i), goal: g)
  end for
end fn check_invs

fn push_loop(v: inout Verifier, l: LoopCtx) do
  set v = v with (loops: push(list: v.loops, item: l))
end fn push_loop

fn plain_loop(invs: List<Expr>) -> LoopCtx do
  return LoopCtx(invs: invs, next_var: "", next_term: "", dec: Option.None, d0: "")
end fn plain_loop

// ---- floats ----
// A Float is a value of the sort Flt about which the verifier knows only two things:
// whether it is a NaN (fnan) and, if not, its place in the order of doubles, as a real
// key (fkey) that is the double's value (with -0 and +0 at 0, and the infinities beyond
// every finite double). Comparisons are defined through these, so the usual facts about
// order hold with no axioms. Arithmetic results are otherwise unknown: rounding makes
// most algebraic laws false, so the program states what it needs (check, contracts).

struct FloatLit
  key: String,
  term: String,
  dec: Decimal,
end struct FloatLit

fn use_floats(v: inout Verifier) do
  if not has(map: v.preamble, key: "(declare-sort Flt 0)") then
    var pre = v.preamble
    for d in ["(declare-sort Flt 0)", "(declare-fun fkey (Flt) Real)", "(declare-fun fnan (Flt) Bool)",
        "(declare-fun elem_Flt (Val Int) Flt)"] do
      set pre = insert(map: pre, key: d, value: true)
    end for
    set v = v with (preamble: pre)
  end if
  if v.floats then
    return
  end if
  set v = v with (floats: true)
  // Sound facts about the operations that are exact or monotone, as axioms that fire
  // only on the operations a function uses.
  var ax: List<String> = []
  for d in ["(declare-fun fneg (Flt) Flt)", "(declare-fun i2f (Int) Flt)", "(declare-fun fabs_ (Flt) Flt)",
      "(declare-fun ffloor (Flt) Flt)", "(declare-fun fceil (Flt) Flt)", "(declare-fun fsqrt (Flt) Flt)"] do
    set v = v with (preamble: insert(map: v.preamble, key: d, value: true))
  end for
  let n = "(not (fnan x))"
  set ax = push(list: ax, item: "(forall ((x Flt)) (! (and (= (fnan (fneg x)) (fnan x)) (=> " ++ n ++ " (= (fkey (fneg x)) (- (fkey x))))) :pattern ((fneg x))))")
  set ax = push(list: ax, item: "(forall ((i Int)) (! (and (not (fnan (i2f i))) (=> (and (<= (- 9007199254740992) i) (<= i 9007199254740992)) (= (fkey (i2f i)) (to_real i)))) :pattern ((i2f i))))")
  set ax = push(list: ax, item: "(forall ((x Flt)) (! (and (= (fnan (fabs_ x)) (fnan x)) (=> " ++ n ++ " (= (fkey (fabs_ x)) (ite (>= (fkey x) 0.0) (fkey x) (- (fkey x)))))) :pattern ((fabs_ x))))")
  set ax = push(list: ax, item: "(forall ((x Flt)) (! (and (= (fnan (ffloor x)) (fnan x)) (=> " ++ n ++ " (<= (fkey (ffloor x)) (fkey x)))) :pattern ((ffloor x))))")
  set ax = push(list: ax, item: "(forall ((x Flt)) (! (and (= (fnan (fceil x)) (fnan x)) (=> " ++ n ++ " (>= (fkey (fceil x)) (fkey x)))) :pattern ((fceil x))))")
  set ax = push(list: ax, item: "(forall ((x Flt)) (! (=> (and " ++ n ++ " (>= (fkey x) 0.0)) (and (not (fnan (fsqrt x))) (>= (fkey (fsqrt x)) 0.0))) :pattern ((fsqrt x))))")
  for a in ax do
    add_qdef(v: inout v, d: "(assert " ++ a ++ ")")
  end for
end fn use_floats

// The term for a Float built-in the logic knows something about (see use_floats), or "".
// round has no facts; float_to_int, float_to_str and str_to_float are unknown values.
fn float_builtin(v: inout Verifier, name: String, a: String) -> String do
  var f = ""
  match name
  case "int_to_float" then
    set f = "i2f"
  case "is_nan" then
    set f = "fnan"
  case "abs_float" then
    set f = "fabs_"
  case "floor" then
    set f = "ffloor"
  case "ceil" then
    set f = "fceil"
  case "sqrt" then
    set f = "fsqrt"
  case "round" then
    let _ = global_fn(v: inout v, name: "fround", args: "Flt", sort: "Flt")
    set f = "fround"
  else
    return ""
  end match
  use_floats(inout v)
  return "(" ++ f ++ " " ++ a ++ ")"
end fn float_builtin

fn float_neg(v: inout Verifier, a: String) -> String do
  use_floats(inout v)
  return "(fneg " ++ a ++ ")"
end fn float_neg

// a op b on Floats: arithmetic gives an (unknown) Float; comparisons follow IEEE, so
// any comparison with a NaN is false (and != true).
fn float_op(v: inout Verifier, op: String, a: String, b: String) -> String do
  use_floats(inout v)
  let ok = "(not (fnan " ++ a ++ ")) (not (fnan " ++ b ++ "))"
  let ka = "(fkey " ++ a ++ ")"
  let kb = "(fkey " ++ b ++ ")"
  match op
  case "+" then
    return "(" ++ global_fn(v: inout v, name: "fadd", args: "Flt Flt", sort: "Flt") ++ " " ++ a ++ " " ++ b ++ ")"
  case "-" then
    return "(" ++ global_fn(v: inout v, name: "fsub", args: "Flt Flt", sort: "Flt") ++ " " ++ a ++ " " ++ b ++ ")"
  case "*" then
    return "(" ++ global_fn(v: inout v, name: "fmul", args: "Flt Flt", sort: "Flt") ++ " " ++ a ++ " " ++ b ++ ")"
  case "/" then
    return "(" ++ global_fn(v: inout v, name: "fdiv", args: "Flt Flt", sort: "Flt") ++ " " ++ a ++ " " ++ b ++ ")"
  case "==" then
    return "(and " ++ ok ++ " (= " ++ ka ++ " " ++ kb ++ "))"
  case "!=" then
    return "(not (and " ++ ok ++ " (= " ++ ka ++ " " ++ kb ++ ")))"
  case "<" then
    return "(and " ++ ok ++ " (< " ++ ka ++ " " ++ kb ++ "))"
  case "<=" then
    return "(and " ++ ok ++ " (<= " ++ ka ++ " " ++ kb ++ "))"
  case ">" then
    return "(and " ++ ok ++ " (> " ++ ka ++ " " ++ kb ++ "))"
  case ">=" then
    return "(and " ++ ok ++ " (>= " ++ ka ++ " " ++ kb ++ "))"
  else
    return "false"
  end match
end fn float_op

// A Float literal: a constant that is not NaN. A whole number below 10^15 has its exact
// key; any two literals are ordered as their decimal values are, strictly when both
// have at most 15 significant digits and are well inside the double range (then they
// are distinct doubles), and otherwise not strictly, since rounding to the nearest
// double can only merge neighbours. Literals with the same value share a constant.
fn float_lit(v: inout Verifier, text: String) -> String do
  use_floats(inout v)
  let d = decimal_of(text)
  let key = d.digits ++ "e" ++ int_to_str(d.exp)
  for f in v.flits do
    if f.key == key then
      return f.term
    end if
  end for
  let c = fresh(v: inout v, sort: "Flt")
  add_def(v: inout v, d: "(assert (not (fnan " ++ c ++ ")))")
  if len(d.digits) == 0 then
    add_def(v: inout v, d: "(assert (= (fkey " ++ c ++ ") 0.0))")
  elif (d.exp >= 0) and ((len(d.digits) + d.exp) <= 15) then
    add_def(v: inout v, d: "(assert (= (fkey " ++ c ++ ") " ++ d.digits ++ repeat(s: "0", n: d.exp) ++ ".0))")
  end if
  for f in v.flits do
    let r = decimal_cmp(a: d, b: f.dec)
    var op = "<="
    if exact_decimal(d) and exact_decimal(f.dec) then
      set op = "<"
    end if
    if r < 0 then
      add_def(v: inout v, d: "(assert (" ++ op ++ " (fkey " ++ c ++ ") (fkey " ++ f.term ++ ")))")
    elif r > 0 then
      add_def(v: inout v, d: "(assert (" ++ op ++ " (fkey " ++ f.term ++ ") (fkey " ++ c ++ ")))")
    end if
  end for
  set v = v with (flits: push(list: v.flits, item: FloatLit(key: key, term: c, dec: d)))
  return c
end fn float_lit

// A decimal value as digits D, without leading or trailing zeros ("" for zero), and an
// exponent E: the value is D * 10^E.
struct Decimal
  digits: String,
  exp: Int,
end struct Decimal

fn decimal_of(text: String) -> Decimal do
  var mant = text
  var e = 0
  let cut = find_byte(s: text, c: 'e', from: 0)
  var cut2 = find_byte(s: text, c: 'E', from: 0)
  var at = cut
  if (at < 0) or ((cut2 >= 0) and (cut2 < at)) then
    set at = cut2
  end if
  if (at >= 0) and (at < len(text)) then
    set mant = slice(of: text, from: 0, to: at)
    var digits = slice(of: text, from: at + 1, to: len(text))
    var neg = false
    if starts_with(s: digits, p: "-") or starts_with(s: digits, p: "+") then
      set neg = starts_with(s: digits, p: "-")
      set digits = slice(of: digits, from: 1, to: len(digits))
    end if
    // The exponent's value, not its length: leading zeros don't count. One beyond 18
    // digits is capped at 10^18, which keeps the value far outside the range of doubles
    // (no source file has 10^17 mantissa digits), where it is only ordered non-strictly.
    var z = 0
    while (z < len(digits)) and (digits[z] == '0') invariant (0 <= z) and (z <= len(digits)) do
      set z = z + 1
    end while
    set digits = slice(of: digits, from: z, to: len(digits))
    if len(digits) > 18 then
      set e = 1000000000000000000
    else
      set e = value_or(opt: str_to_int(digits), default: 0)
    end if
    if neg then
      set e = -e
    end if
  end if
  var parts: List<String> = []
  var frac = 0
  var point = false
  for i in 0..len(mant) do
    let ch = mant[i]
    if ch == '.' then
      set point = true
    elif is_digit(ch) then
      set parts = push(list: parts, item: char(ch))
      if point then
        set frac = frac + 1
      end if
    end if
  end for
  var ds = join(parts: parts, sep: "")
  var exp = e - frac
  var a = 0
  while (a < len(ds)) and (ds[a] == '0') invariant (0 <= a) and (a <= len(ds)) do
    set a = a + 1
  end while
  set ds = slice(of: ds, from: a, to: len(ds))
  if len(ds) == 0 then
    return Decimal(digits: "", exp: 0)
  end if
  var b = len(ds)
  while (b > 0) and (ds[b - 1] == '0') invariant (0 <= b) and (b <= len(ds)) do
    set b = b - 1
    set exp = exp + 1
  end while
  return Decimal(digits: slice(of: ds, from: 0, to: b), exp: exp)
end fn decimal_of

// At most 15 significant digits and well inside the range of normal doubles: two such
// decimals that differ are different doubles.
fn exact_decimal(d: Decimal) -> Bool do
  if len(d.digits) == 0 then
    return true
  end if
  let mag = len(d.digits) + d.exp
  return (len(d.digits) <= 15) and (mag > -300) and (mag < 300)
end fn exact_decimal

// -1, 0 or 1 as a is less than, equal to or greater than b (both non-negative).
fn decimal_cmp(a: Decimal, b: Decimal) -> Int do
  if (len(a.digits) == 0) or (len(b.digits) == 0) then
    if len(a.digits) == len(b.digits) then
      return 0
    elif len(a.digits) == 0 then
      return -1
    end if
    return 1
  end if
  let ma = len(a.digits) + a.exp
  let mb = len(b.digits) + b.exp
  if ma != mb then
    if ma < mb then
      return -1
    end if
    return 1
  end if
  var n = len(a.digits)
  if len(b.digits) > n then
    set n = len(b.digits)
  end if
  for i in 0..n do
    // A missing digit is a trailing zero.
    var x = '0'
    if i < len(a.digits) then
      set x = a.digits[i]
    end if
    var y = '0'
    if i < len(b.digits) then
      set y = b.digits[i]
    end if
    if x != y then
      if x < y then
        return -1
      end if
      return 1
    end if
  end for
  return 0
end fn decimal_cmp

// ---- measures ----

// A measure's value as an Int: an Int measure is itself; any other value is measured by
// its rank, which is smaller for each part of it (rank_axioms).
fn as_measure(v: inout Verifier, d: Expr, t: String) -> String do
  if ty_show(type_of(info: v.info, e: d)) == "Int" then
    return t
  end if
  rank_axioms(inout v)
  let r = "(rank " ++ t ++ ")"
  add_def(v: inout v, d: "(assert (>= " ++ r ++ " 0))")
  return r
end fn as_measure

// rank is a non-negative size: an enum's or option's fields have smaller ranks than the
// value, a list's elements smaller ranks than the list, and a struct's fields ranks no
// larger than the struct (a struct has no tag to say it is one, so a value whose field
// function led back to itself must be allowed). Real values are finite, so a value's
// height is such a rank. When a program has structural measures, these facts are
// stated for each part the code reads (rank_part), not as quantified axioms, which
// would leave Z3 searching for a model when a proof fails.
fn rank_axioms(v: inout Verifier) do
  let _ = global_fn(v: inout v, name: "rank", args: "Val", sort: "Int")
end fn rank_axioms

// The fact relating the rank of part (of type t) to the rank of whole: strictly
// smaller, or for a struct field no larger; "" when there is nothing to say.
fn rank_part(v: inout Verifier, t: Ty, part: String, whole: String, strict: Bool) -> String do
  if (not v.info.structural) or (sort_of(t) != "Val") then
    return ""
  end if
  rank_axioms(inout v)
  var op = "<="
  if strict then
    set op = "<"
  end if
  return "(" ++ op ++ " (rank " ++ part ++ ") (rank " ++ whole ++ "))"
end fn rank_part

// The group of mutually recursive functions a function (or an instance of a generic
// function) belongs to; -1 if unknown.
fn scc_of_fn(info: Info, name: String) -> Int do
  var n = name
  match lookup(map: info.origins, key: name)
  case Some(value: g) then
    set n = g
  case None then
  end match
  return value_or(opt: lookup(map: info.scc, key: n), default: -1)
end fn scc_of_fn

fn check_loop_measure(v: inout Verifier, st: St, l: LoopCtx) do
  match l.dec
  case Some(value: d) then
    check_wd(v: inout v, st: st, pos: d.pos, e: d, sp: state_spec(v: v, st: st, subj: "", res: ""))
    let t = spec_term(v: inout v, e: d, st: st, subj: "", res: "")
    let now = as_measure(v: inout v, d: d, t: t)
    obligation(v: inout v, st: st, pos: d.pos, what: "loop measure decreases: " ++ pretty_expr(d), goal: "(< " ++ now ++ " " ++ l.d0 ++ ")")
  case None then
  end match
end fn check_loop_measure

fn pop_loop(v: inout Verifier) do
  let n = len(v.loops)
  if n > 0 then
    set v = v with (loops: slice(of: v.loops, from: 0, to: n - 1))
  end if
end fn pop_loop

struct Branch
  guard: String,
  st: St,
end struct Branch

fn vstmt(v: inout Verifier, s: Stmt, st: inout St) do
  if (s.pos.file == 0) and (s.pos.line == v.probe_line) and (len(v.probe) == 0) then
    var facts = ["(reached)"]
    for f in st.src do
      if not contains_str(xs: facts, x: f) then
        set facts = push(list: facts, item: f)
      end if
    end for
    set v = v with (probe: facts)
  end if
  match s.kind
  case Let(name: name, ty: ty, value: value, mutable: m) then
    let t = vexpr(v: inout v, e: value, st: inout st)
    if name == "_" then
      return
    end if
    var r = plain(type_of(info: v.info, e: value))
    match ty
    case Some(value: te) then
      set r = resolve_quiet(info: v.info, te: te)
    case None then
    end match
    check_preds(v: inout v, st: st, pos: s.pos, name: name, preds: r.preds, term: t)
    // The refinements inside its type (List<Nat>): proved, then known.
    check_inner(v: inout v, st: st, pos: s.pos, name: "'" ++ name ++ "'", r: r, term: t)
    assume_inner(v: inout v, st: inout st, name: "'" ++ name ++ "'", r: r, term: t)
    // A let without a type keeps the refinement its value is known to have, for
    // known_rty (it cannot be assigned, so nothing else uses it).
    var kr = r
    match ty
    case None then
      if not m then
        set kr = known_rty(v: v, st: st, e: value)
      end if
    case Some(value: te) then
    end match
    set st = st with (env: insert(map: st.env, key: name, value: VVar(term: t, ty: r.ty, preds: kr.preds, args: kr.args)))
  case Set(name: name, value: value) then
    let t = vexpr(v: inout v, e: value, st: inout st)
    match lookup(map: st.env, key: name)
    case Some(value: x) then
      check_preds(v: inout v, st: st, pos: s.pos, name: name, preds: x.preds, term: t)
      let xr = RTy(ty: x.ty, preds: [], args: x.args)
      check_inner(v: inout v, st: st, pos: s.pos, name: "'" ++ name ++ "'", r: xr, term: t)
      assume_inner(v: inout v, st: inout st, name: "'" ++ name ++ "'", r: xr, term: t)
      set st = st with (env: insert(map: st.env, key: name, value: x with (term: t)))
    case None then
    end match
  case Return(value: rv) then
    var t = "0"
    match rv
    case Some(value: e) then
      set t = vexpr(v: inout v, e: e, st: inout st)
    case None then
    end match
    check_post(v: inout v, st: st, pos: s.pos, val: t)
    set st = st with (dead: true)
  case If(arms: arms, els: els) then
    let base = st
    var cur = st
    var results: List<Branch> = []
    var negs: List<String> = []
    for a in arms do
      let ct = vexpr(v: inout v, e: a.cond, st: inout cur)
      var arm = cur
      add_fact(st: inout arm, f: ct)
      add_src(st: inout arm, f: pretty_expr(a.cond))
      vblock(v: inout v, stmts: a.body, st: inout arm)
      set results = push(list: results, item: Branch(guard: and_all(push(list: negs, item: ct)), st: arm))
      add_fact(st: inout cur, f: "(not " ++ ct ++ ")")
      add_src(st: inout cur, f: "not (" ++ pretty_expr(a.cond) ++ ")")
      set negs = push(list: negs, item: "(not " ++ ct ++ ")")
    end for
    match els
    case Some(value: b) then
      vblock(v: inout v, stmts: b, st: inout cur)
    case None then
    end match
    set results = push(list: results, item: Branch(guard: and_all(negs), st: cur))
    set st = merge(v: inout v, base: base, results: results)
  case Match(scrut: scrut, cases: cases, els: els) then
    vmatch(v: inout v, scrut: scrut, cases: cases, els: els, st: inout st)
  case While(cond: cond, invs: invs, dec: dec, body: body) then
    check_entry(v: inout v, st: st, invs: invs)
    var head = havoc(v: inout v, body: body, st: st, invs: invs)
    let c = vexpr(v: inout v, e: cond, st: inout head)
    var inner = head
    add_fact(st: inout inner, f: c)
    add_src(st: inout inner, f: pretty_expr(cond))
    var lc = plain_loop(invs)
    match dec
    case Some(value: d) then
      check_wd(v: inout v, st: inner, pos: d.pos, e: d, sp: state_spec(v: v, st: inner, subj: "", res: ""))
      let t = spec_term(v: inout v, e: d, st: inner, subj: "", res: "")
      let mt = as_measure(v: inout v, d: d, t: t)
      let d0 = define(v: inout v, sort: "Int", term: mt)
      obligation(v: inout v, st: inner, pos: d.pos, what: "loop measure is non-negative: " ++ pretty_expr(d), goal: "(>= " ++ d0 ++ " 0)")
      set lc = lc with (dec: dec, d0: d0)
    case None then
    end match
    push_loop(v: inout v, l: lc)
    vblock(v: inout v, stmts: body, st: inout inner)
    pop_loop(inout v)
    check_invs(v: inout v, st: inner, invs: invs, what: "is preserved")
    check_loop_measure(v: inout v, st: inner, l: lc)
    var after = head
    if not has_break(body) then
      add_fact(st: inout after, f: "(not " ++ c ++ ")")
      add_src(st: inout after, f: "not (" ++ pretty_expr(cond) ++ ")")
    end if
    set st = after
  case ForRange(name: var_name, lo: lo, hi: hi, invs: invs, body: body) then
    // Verified like the counted while loop it is: invariants may mention the loop
    // variable, which is lo on entry and one more after each iteration.
    let a = vexpr(v: inout v, e: lo, st: inout st)
    let b = vexpr(v: inout v, e: hi, st: inout st)
    let entry = st with (env: insert(map: st.env, key: var_name, value: VVar(term: a, ty: Ty.TInt, preds: [], args: [])))
    check_entry(v: inout v, st: entry, invs: invs)
    let no_invs: List<Expr> = []
    var head = havoc(v: inout v, body: body, st: st, invs: no_invs)
    let iv = fresh(v: inout v, sort: "Int")
    add_fact(st: inout head, f: "(<= " ++ a ++ " " ++ iv ++ ")")
    add_fact(st: inout head, f: "(or (<= " ++ iv ++ " " ++ b ++ ") (= " ++ iv ++ " " ++ a ++ "))")
    set head = head with (env: insert(map: head.env, key: var_name, value: VVar(term: iv, ty: Ty.TInt, preds: [], args: [])))
    for i in invs do
      let t = spec_term(v: inout v, e: i, st: head, subj: "", res: "")
      add_fact(st: inout head, f: t)
      add_src(st: inout head, f: pretty_expr(i))
    end for
    var inner = head
    add_fact(st: inout inner, f: "(< " ++ iv ++ " " ++ b ++ ")")
    add_src(st: inout inner, f: pretty_expr(lo) ++ " <= " ++ var_name)
    add_src(st: inout inner, f: var_name ++ " < " ++ pretty_expr(hi))
    let next = define(v: inout v, sort: "Int", term: "(+ " ++ iv ++ " 1)")
    push_loop(v: inout v, l: LoopCtx(invs: invs, next_var: var_name, next_term: next, dec: Option.None, d0: ""))
    vblock(v: inout v, stmts: body, st: inout inner)
    pop_loop(inout v)
    check_invs(v: inout v, st: set_term(st: inner, name: var_name, term: next), invs: invs, what: "is preserved")
    var after = head
    if not has_break(body) then
      add_fact(st: inout after, f: "(<= " ++ b ++ " " ++ iv ++ ")")
    end if
    set st = after with (env: map_without(m: after.env, k: var_name))
  case ForEach(name: var_name, list: l, invs: invs, body: body) then
    let lt = vexpr(v: inout v, e: l, st: inout st)
    var et = Ty.TUnknown
    match type_of(info: v.info, e: l)
    case TList(elem: t) then
      set et = t
    else
    end match
    check_entry(v: inout v, st: st, invs: invs)
    let head = havoc(v: inout v, body: body, st: st, invs: invs)
    var inner = head
    let k = fresh(v: inout v, sort: "Int")
    add_fact(st: inout inner, f: "(<= 0 " ++ k ++ ")")
    add_fact(st: inout inner, f: "(< " ++ k ++ " (len " ++ lt ++ "))")
    let x = define(v: inout v, sort: sort_of(et), term: "(elem_" ++ sort_of(et) ++ " " ++ lt ++ " " ++ k ++ ")")
    let rk = rank_part(v: inout v, t: et, part: x, whole: lt, strict: true)
    if len(rk) > 0 then
      add_fact(st: inout inner, f: rk)
    end if
    // The element's refinement, if the list's type has one (it cannot be assigned, so
    // only known_rty uses it).
    var er = plain(et)
    let lr = known_rty(v: v, st: st, e: l)
    if len(lr.args) > 0 then
      set er = lr.args[0]
    end if
    set inner = inner with (env: insert(map: inner.env, key: var_name, value: VVar(term: x, ty: et, preds: er.preds, args: er.args)))
    add_src(st: inout inner, f: var_name ++ " is an element of " ++ pretty_expr(l))
    push_loop(v: inout v, l: plain_loop(invs))
    vblock(v: inout v, stmts: body, st: inout inner)
    pop_loop(inout v)
    check_invs(v: inout v, st: inner, invs: invs, what: "is preserved")
    set st = head
  case Assert(e: e) then
    let sp = Spec(binds: spec_binds(v: v, st: st), subj: "", res: "", fuel: 2, scc: -1)
    check_wd(v: inout v, st: st, pos: s.pos, e: e, sp: sp)
    let g = sexpr(v: inout v, e: e, sp: sp)
    var goal = g
    if v.hyps then
      set goal = with_hyps(hyps: struct_hyps(v: inout v, e: e, sp: sp), goal: g)
    end if
    obligation(v: inout v, st: st, pos: s.pos, what: "assertion: " ++ pretty_expr(e), goal: goal)
    add_fact(st: inout st, f: g)
    add_src(st: inout st, f: pretty_expr(e))
  case Check(e: e) then
    let g = vexpr(v: inout v, e: e, st: inout st)
    add_fact(st: inout st, f: g)
    add_src(st: inout st, f: pretty_expr(e))
  case Break then
    var lc = plain_loop([])
    let n = len(v.loops)
    if n > 0 then
      set lc = v.loops[n - 1]
    end if
    check_invs(v: inout v, st: st, invs: lc.invs, what: "holds at 'break'")
    set st = st with (dead: true)
  case Continue then
    var lc = plain_loop([])
    let n = len(v.loops)
    if n > 0 then
      set lc = v.loops[n - 1]
    end if
    var at = st
    if len(lc.next_var) > 0 then
      set at = set_term(st: st, name: lc.next_var, term: lc.next_term)
    end if
    check_invs(v: inout v, st: at, invs: lc.invs, what: "holds at 'continue'")
    check_loop_measure(v: inout v, st: st, l: lc)
    set st = st with (dead: true)
  case ExprStmt(e: e) then
    let _ = vexpr(v: inout v, e: e, st: inout st)
    if is_noreturn_call(e) then
      set st = st with (dead: true)
    end if
  end match
end fn vstmt

fn vmatch(v: inout Verifier, scrut: Expr, cases: List<Case>, els: Option<List<Stmt>>, st: inout St) do
  let sv = vexpr(v: inout v, e: scrut, st: inout st)
  let stype = type_of(info: v.info, e: scrut)
  let base = st
  var variants: List<VariantInfo> = []
  var is_enum = false
  match variants_of(info: v.info, t: stype)
  case Some(value: vs) then
    set variants = vs
    set is_enum = true
  case None then
  end match
  var ename = ""
  match stype
  case TOpt(inner: x) then
    set ename = "Option"
  case TEnum(name: n) then
    set ename = n
  else
  end match
  var results: List<Branch> = []
  var guards: List<String> = []
  for cs in cases do
    var arm = st
    var g = "false"
    match cs.pat
    case PInt(value: n) then
      set g = "(= " ++ sv ++ " " ++ int_lit(n) ++ ")"
    case PStr(value: s) then
      let k = str_const(v: inout v, s: s)
      set g = "(= " ++ sv ++ " " ++ k ++ ")"
    case PVariant(name: name, binds: binds) then
      let vi = find_variant(vs: variants, name: name)
      if vi >= 0 then
        let vinfo = variants[vi]
        var fbinds: Map<String, String> = {}
        for fl in vinfo.fields do
          let fnn = vfield_fn(v: inout v, ename: ename, vname: name, field: fl.name, t: fl.rty.ty)
          set fbinds = insert(map: fbinds, key: fl.name, value: "(" ++ fnn ++ " " ++ sv ++ ")")
        end for
        add_src(st: inout arm, f: pretty_expr(scrut) ++ " is " ++ name)
        for fl in vinfo.fields do
          var ft = ""
          match lookup(map: fbinds, key: fl.name)
          case Some(value: x) then
            set ft = x
          case None then
          end match
          for p in fl.rty.preds do
            let t = spec_with(v: inout v, e: p, binds: fbinds, subj: ft)
            add_fact(st: inout arm, f: t)
          end for
          for f in inner_facts(v: inout v, r: fl.rty, term: ft) do
            add_fact(st: inout arm, f: f)
          end for
          let rk = rank_part(v: inout v, t: fl.rty.ty, part: ft, whole: sv, strict: true)
          if len(rk) > 0 then
            add_fact(st: inout arm, f: rk)
          end if
          for b in binds do
            if b.field == fl.name then
              set arm = arm with (env: insert(map: arm.env, key: b.binder, value: VVar(term: ft, ty: fl.rty.ty, preds: [], args: [])))
            end if
          end for
        end for
        set g = "(= (tag " ++ sv ++ ") " ++ int_to_str(vi) ++ ")"
      end if
    end match
    add_fact(st: inout arm, f: g)
    vblock(v: inout v, stmts: cs.body, st: inout arm)
    set guards = push(list: guards, item: g)
    set results = push(list: results, item: Branch(guard: g, st: arm))
  end for
  var all_neg: List<String> = []
  for g in guards do
    set all_neg = push(list: all_neg, item: "(not " ++ g ++ ")")
  end for
  match els
  case Some(value: b) then
    var arm = st
    for f in all_neg do
      add_fact(st: inout arm, f: f)
    end for
    vblock(v: inout v, stmts: b, st: inout arm)
    set results = push(list: results, item: Branch(guard: and_all(all_neg), st: arm))
  case None then
    if is_enum then
      // Exhaustive: the tag is one of the variants.
      let range = "(and (<= 0 (tag " ++ sv ++ ")) (< (tag " ++ sv ++ ") " ++ int_to_str(len(variants)) ++ "))"
      var rs: List<Branch> = []
      for r in results do
        var x = r.st
        add_fact(st: inout x, f: range)
        set rs = push(list: rs, item: r with (st: x))
      end for
      var f = base
      add_fact(st: inout f, f: range)
      set st = merge(v: inout v, base: f, results: rs)
      return
    end if
  end match
  set st = merge(v: inout v, base: base, results: results)
end fn vmatch

fn mentions(text: String, name: String) -> Bool do
  let n = len(name)
  if n == 0 then
    return false
  end if
  var i = 0
  while (i + n) <= len(text) invariant i >= 0 do
    if starts_at(s: text, at: i, p: name) then
      let before = (i == 0) or not is_alnum(text[i - 1])
      let after = ((i + n) >= len(text)) or not is_alnum(text[i + n])
      if before and after then
        return true
      end if
    end if
    set i = i + 1
  end while
  return false
end fn mentions

// The state at a loop head: variables assigned in the body get fresh values
// constrained only by their declared refinements and the loop invariants.
fn havoc(v: inout Verifier, body: List<Stmt>, st: St, invs: List<Expr>) -> St do
  var names: List<String> = []
  assigned(stmts: body, out: inout names)
  var h = st
  for n in names do
    match lookup(map: st.env, key: n)
    case Some(value: x) then
      let t = fresh(v: inout v, sort: sort_of(x.ty))
      set h = h with (env: insert(map: h.env, key: n, value: x with (term: t)))
      assume_preds(v: inout v, st: inout h, name: n, preds: x.preds, term: t)
      assume_inner(v: inout v, st: inout h, name: "'" ++ n ++ "'", r: RTy(ty: x.ty, preds: [], args: x.args), term: t)
    case None then
    end match
  end for
  var kept: List<String> = []
  for f in h.src do
    var stale = false
    for n in names do
      if mentions(text: f, name: n) then
        set stale = true
      end if
    end for
    if not stale then
      set kept = push(list: kept, item: f)
    end if
  end for
  set h = h with (src: kept)
  for i in invs do
    let t = spec_term(v: inout v, e: i, st: h, subj: "", res: "")
    add_fact(st: inout h, f: t)
    add_src(st: inout h, f: pretty_expr(i))
  end for
  return h
end fn havoc

fn merge(v: inout Verifier, base: St, results: List<Branch>) -> St do
  var live: List<Branch> = []
  for r in results do
    if not r.st.dead then
      set live = push(list: live, item: r)
    end if
  end for
  var out = base
  if len(live) == 0 then
    return out with (dead: true)
  end if
  let k = len(base.facts)
  var guards: List<String> = []
  for r in live do
    set guards = push(list: guards, item: r.guard)
  end for
  if len(guards) == 1 then
    add_fact(st: inout out, f: guards[0])
  else
    add_fact(st: inout out, f: "(or " ++ join(parts: guards, sep: " ") ++ ")")
  end if
  for r in live do
    let fs = r.st.facts
    if k <= len(fs) then
      let fresh_facts = slice(of: fs, from: k, to: len(fs))
      if len(fresh_facts) > 0 then
        add_fact(st: inout out, f: "(=> " ++ r.guard ++ " " ++ and_all(fresh_facts) ++ ")")
      end if
    end if
  end for
  if len(live) == 1 then
    set out = out with (src: live[0].st.src)
  end if
  for n in keys(base.env) do
    var terms: List<String> = []
    for r in live do
      set terms = push(list: terms, item: env_term(st: r.st, n: n))
    end for
    let m = len(terms)
    if m == 0 then
      continue
    end if
    var same = true
    for t in terms do
      if t != terms[0] then
        set same = false
      end if
    end for
    match lookup(map: base.env, key: n)
    case Some(value: x) then
      if same then
        set out = out with (env: insert(map: out.env, key: n, value: x with (term: terms[0])))
      else
        var t = terms[m - 1]
        var i = m - 2
        while i >= 0 invariant i < (m - 1) do
          if (i < len(live)) and (i < len(terms)) then
            set t = "(ite " ++ live[i].guard ++ " " ++ terms[i] ++ " " ++ t ++ ")"
          end if
          set i = i - 1
        end while
        let d = define(v: inout v, sort: sort_of(x.ty), term: t)
        set out = out with (env: insert(map: out.env, key: n, value: x with (term: d)))
      end if
    case None then
    end match
  end for
  return out
end fn merge

// ---- expressions ----

fn struct_binds(v: inout Verifier, sn: String, ov: String) -> Map<String, String> do
  var binds: Map<String, String> = {}
  for fl in struct_fields(info: v.info, name: sn) do
    let fnn = field_fn(v: inout v, sname: sn, field: fl.name, t: fl.rty.ty)
    set binds = insert(map: binds, key: fl.name, value: "(" ++ fnn ++ " " ++ ov ++ ")")
  end for
  return binds
end fn struct_binds

fn bind_of(binds: Map<String, String>, n: String) -> String do
  match lookup(map: binds, key: n)
  case Some(value: t) then
    return t
  case None then
    return "unbound_" ++ n
  end match
end fn bind_of

fn vexpr(v: inout Verifier, e: Expr, st: inout St) -> String do
  match e.kind
  case IntLit(value: n) then
    return int_lit(n)
  case FloatLit(text: t) then
    return float_lit(v: inout v, text: t)
  case BoolLit(value: b) then
    if b then
      return "true"
    end if
    return "false"
  case StrLit(value: s) then
    return str_const(v: inout v, s: s)
  case Var(name: n) then
    return env_term(st: st, n: n)
  case It then
    return "0"
  case Result then
    return "0"
  case Hole(name: n) then
    var facts: List<String> = []
    for f in st.src do
      let m = len(facts)
      if (m == 0) or (facts[m - 1] != f) then
        set facts = push(list: facts, item: f)
      end if
    end for
    set v = v with (hole_facts: insert(map: v.hole_facts, key: e.id, value: facts))
    return fresh(v: inout v, sort: sort_of(type_of(info: v.info, e: e)))
  case Call(callee: c, args: args) then
    return vcall(v: inout v, e: e, args: args, st: inout st)
  case ListLit(items: items) then
    var vals: List<String> = []
    for x in items do
      set vals = push(list: vals, item: vexpr(v: inout v, e: x, st: inout st))
    end for
    var et = Ty.TUnknown
    match type_of(info: v.info, e: e)
    case TList(elem: t) then
      set et = t
    else
    end match
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") " ++ int_to_str(len(vals)) ++ "))")
    for i in 0..len(vals) do
      add_def(v: inout v, d: "(assert (= (elem_" ++ sort_of(et) ++ " " ++ r ++ " " ++ int_to_str(i) ++ ") " ++ vals[i] ++ "))")
    end for
    return r
  case EmptyMap then
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") 0))")
    return r
  case Index(obj: o, idx: i) then
    let ov = vexpr(v: inout v, e: o, st: inout st)
    let iv = vexpr(v: inout v, e: i, st: inout st)
    let goal = "(and (<= 0 " ++ iv ++ ") (< " ++ iv ++ " (len " ++ ov ++ ")))"
    let what = "index in bounds: 0 <= " ++ pretty_expr(i) ++ " < len(" ++ pretty_expr(o) ++ ")"
    obligation(v: inout v, st: st, pos: e.pos, what: what, goal: goal)
    match type_of(info: v.info, e: o)
    case TStr then
      return "(byte " ++ ov ++ " " ++ iv ++ ")"
    case TList(elem: t) then
      let el = "(elem_" ++ sort_of(t) ++ " " ++ ov ++ " " ++ iv ++ ")"
      let rk = rank_part(v: inout v, t: t, part: el, whole: ov, strict: true)
      if len(rk) > 0 then
        add_fact(st: inout st, f: "(=> " ++ goal ++ " " ++ rk ++ ")")
      end if
      return el
    else
      return fresh(v: inout v, sort: "Val")
    end match
  case Field(obj: o, name: f) then
    match call_info(info: v.info, e: e)
    case Some(value: ci) then
      if ci.kind == "variant" then
        let r = fresh(v: inout v, sort: "Val")
        add_def(v: inout v, d: "(assert (= (tag " ++ r ++ ") " ++ int_to_str(ci.variant) ++ "))")
        return r
      end if
    case None then
    end match
    let ov = vexpr(v: inout v, e: o, st: inout st)
    var sn = ""
    match type_of(info: v.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
      return fresh(v: inout v, sort: "Val")
    end match
    let fields = struct_fields(info: v.info, name: sn)
    let binds = struct_binds(v: inout v, sn: sn, ov: ov)
    let term = bind_of(binds: binds, n: f)
    let fi = find_field(fields: fields, name: f)
    if fi >= 0 then
      for p in fields[fi].rty.preds do
        let t = spec_with(v: inout v, e: p, binds: binds, subj: term)
        add_fact(st: inout st, f: t)
      end for
      for x in inner_facts(v: inout v, r: fields[fi].rty, term: term) do
        add_fact(st: inout st, f: x)
      end for
      let rk = rank_part(v: inout v, t: fields[fi].rty.ty, part: term, whole: ov, strict: false)
      if len(rk) > 0 then
        add_fact(st: inout st, f: rk)
      end if
    end if
    return term
  case With(obj: o, args: args) then
    let ov = vexpr(v: inout v, e: o, st: inout st)
    var sn = ""
    match type_of(info: v.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fields = struct_fields(info: v.info, name: sn)
    if len(sn) > 0 then
      // The original value satisfies its struct's field refinements, so the fields
      // that 'with' leaves unchanged still satisfy them.
      let obinds = struct_binds(v: inout v, sn: sn, ov: ov)
      for fl in fields do
        for p in fl.rty.preds do
          let t = spec_with(v: inout v, e: p, binds: obinds, subj: bind_of(binds: obinds, n: fl.name))
          add_fact(st: inout st, f: t)
        end for
        for x in inner_facts(v: inout v, r: fl.rty, term: bind_of(binds: obinds, n: fl.name)) do
          add_fact(st: inout st, f: x)
        end for
      end for
    end if
    var vals: Map<String, String> = {}
    for a in args do
      let t = vexpr(v: inout v, e: a.value, st: inout st)
      set vals = insert(map: vals, key: a.name, value: t)
    end for
    if len(sn) == 0 then
      return fresh(v: inout v, sort: "Val")
    end if
    var binds: Map<String, String> = {}
    for fl in fields do
      match lookup(map: vals, key: fl.name)
      case Some(value: t) then
        set binds = insert(map: binds, key: fl.name, value: t)
      case None then
        let fnn = field_fn(v: inout v, sname: sn, field: fl.name, t: fl.rty.ty)
        set binds = insert(map: binds, key: fl.name, value: "(" ++ fnn ++ " " ++ ov ++ ")")
      end match
    end for
    return construct_struct(v: inout v, st: inout st, pos: e.pos, sn: sn, binds: binds)
  case Unary(op: op, x: x) then
    let a = vexpr(v: inout v, e: x, st: inout st)
    if op == "-" then
      if ty_show(type_of(info: v.info, e: x)) == "Float" then
        let nt = float_neg(v: inout v, a: a)
        return define(v: inout v, sort: "Flt", term: nt)
      end if
      return "(- " ++ a ++ ")"
    end if
    return "(not " ++ a ++ ")"
  case Quant(q: q, name: qn, lo: lo, hi: hi, body: body) then
    let a = vexpr(v: inout v, e: lo, st: inout st)
    let b = vexpr(v: inout v, e: hi, st: inout st)
    // Obligations of the body, for every value of the bound variable.
    var sub = st
    let iv = fresh(v: inout v, sort: "Int")
    add_fact(st: inout sub, f: "(<= " ++ a ++ " " ++ iv ++ ")")
    add_fact(st: inout sub, f: "(< " ++ iv ++ " " ++ b ++ ")")
    set sub = sub with (env: insert(map: sub.env, key: qn, value: VVar(term: iv, ty: Ty.TInt, preds: [], args: [])))
    let _ = vexpr(v: inout v, e: body, st: inout sub)
    if not translatable(v: v, e: body) then
      return fresh(v: inout v, sort: "Bool")
    end if
    // The value: the quantified formula over the current environment.
    var binds: Map<String, String> = {}
    for k in keys(st.env) do
      set binds = insert(map: binds, key: k, value: env_term(st: st, n: k))
    end for
    let qv = fresh_q(inout v)
    set binds = insert(map: binds, key: qn, value: qv)
    let bt = sexpr(v: inout v, e: body, sp: Spec(binds: binds, subj: "", res: "", fuel: 2, scc: -1))
    return define(v: inout v, sort: "Bool", term: quant_term(q: q, v: qv, lo: a, hi: b, body: bt))
  case Binary(op: op, l: l, r: r) then
    if (op == "and") or (op == "or") or (op == "implies") then
      let a = vexpr(v: inout v, e: l, st: inout st)
      var guard = a
      if op == "or" then
        set guard = "(not " ++ a ++ ")"
      end if
      var sub = st
      add_fact(st: inout sub, f: guard)
      let b = vexpr(v: inout v, e: r, st: inout sub)
      let k = len(st.facts) + 1
      if k <= len(sub.facts) then
        let fresh_facts = slice(of: sub.facts, from: k, to: len(sub.facts))
        if len(fresh_facts) > 0 then
          add_fact(st: inout st, f: "(=> " ++ guard ++ " " ++ and_all(fresh_facts) ++ ")")
        end if
      end if
      // A variable the right operand changes (by passing it inout) has its new value
      // only if the right operand was evaluated.
      for n in keys(st.env) do
        let before = env_term(st: st, n: n)
        let after = env_term(st: sub, n: n)
        if after != before then
          match lookup(map: st.env, key: n)
          case Some(value: x) then
            let d = define(v: inout v, sort: sort_of(x.ty), term: "(ite " ++ guard ++ " " ++ after ++ " " ++ before ++ ")")
            set st = st with (env: insert(map: st.env, key: n, value: x with (term: d)))
          case None then
          end match
        end if
      end for
      return define(v: inout v, sort: "Bool", term: binop_term(op: op, a: a, b: b))
    end if
    let a = vexpr(v: inout v, e: l, st: inout st)
    let b = vexpr(v: inout v, e: r, st: inout st)
    if ty_show(type_of(info: v.info, e: l)) == "Float" then
      // IEEE arithmetic never fails, so there is nothing to prove.
      var fsort = "Flt"
      if contains_str(xs: ["<", "<=", ">", ">=", "==", "!="], x: op) then
        set fsort = "Bool"
      end if
      let ft = float_op(v: inout v, op: op, a: a, b: b)
      return define(v: inout v, sort: fsort, term: ft)
    end if
    if (op == "/") or (op == "%") then
      obligation(v: inout v, st: st, pos: e.pos, what: "divisor is not zero: " ++ pretty_expr(r), goal: "(not (= " ++ b ++ " 0))")
      return define(v: inout v, sort: "Int", term: binop_term(op: op, a: a, b: b))
    end if
    if op == "++" then
      let res = fresh(v: inout v, sort: "Val")
      add_def(v: inout v, d: "(assert (= (len " ++ res ++ ") (+ (len " ++ a ++ ") (len " ++ b ++ "))))")
      // Triggered only when the result's contents are inspected.
      let f = content_fn(type_of(info: v.info, e: l))
      if len(f) > 0 then
        let q = fresh_q(inout v)
        let at_r = "(" ++ f ++ " " ++ res ++ " " ++ q ++ ")"
        let pick = "(ite (< " ++ q ++ " (len " ++ a ++ ")) (" ++ f ++ " " ++ a ++ " " ++ q ++ ") (" ++ f ++ " " ++ b ++ " (- " ++ q ++ " (len " ++ a ++ "))))"
        add_qdef(v: inout v, d: "(assert (forall ((" ++ q ++ " Int)) (! (=> (and (<= 0 " ++ q ++ ") (< " ++ q ++ " (len " ++ res ++ "))) (= " ++ at_r ++ " " ++ pick ++ ")) :pattern (" ++ at_r ++ "))))")
      end if
      return res
    end if
    if (op == "==") or (op == "!=") then
      let eq = eq_term(v: inout v, op: op, t: type_of(info: v.info, e: l), a: a, b: b)
      return define(v: inout v, sort: "Bool", term: eq)
    end if
    if contains_str(xs: ["<", "<=", ">", ">="], x: op) then
      return define(v: inout v, sort: "Bool", term: binop_term(op: op, a: a, b: b))
    end if
    return define(v: inout v, sort: "Int", term: binop_term(op: op, a: a, b: b))
  end match
end fn vexpr

fn construct_struct(v: inout Verifier, st: inout St, pos: Pos, sn: String, binds: Map<String, String>) -> String do
  let fields = struct_fields(info: v.info, name: sn)
  for fl in fields do
    for p in fl.rty.preds do
      check_wd(v: inout v, st: st, pos: pos, e: p, sp: Spec(binds: binds, subj: bind_of(binds: binds, n: fl.name), res: "", fuel: 2, scc: -1))
      let g = spec_with(v: inout v, e: p, binds: binds, subj: bind_of(binds: binds, n: fl.name))
      let what = "field '" ++ fl.name ++ "' of " ++ sn ++ " satisfies " ++ pretty_expr(p)
      obligation(v: inout v, st: st, pos: pos, what: what, goal: g)
    end for
    check_inner(v: inout v, st: st, pos: pos, name: "field '" ++ fl.name ++ "' of " ++ sn, r: fl.rty, term: bind_of(binds: binds, n: fl.name))
  end for
  // The fields are path facts, stated after the refinements are proved: as global
  // facts they would describe a value that breaks them wherever the construction cannot
  // run, and the axioms of specification functions hold only for real values.
  let r = fresh(v: inout v, sort: "Val")
  for fl in fields do
    let fnn = field_fn(v: inout v, sname: sn, field: fl.name, t: fl.rty.ty)
    construct_fact(v: inout v, st: inout st, f: "(= (" ++ fnn ++ " " ++ r ++ ") " ++ bind_of(binds: binds, n: fl.name) ++ ")")
  end for
  return r
end fn construct_struct

fn construct_fact(v: inout Verifier, st: inout St, f: String) do
  if v.hyps then
    add_fact(st: inout st, f: f)
  else
    add_def(v: inout v, d: "(assert " ++ f ++ ")")
  end if
end fn construct_fact

fn vcall(v: inout Verifier, e: Expr, args: List<Arg>, st: inout St) -> String do
  var ci = CallInfo(kind: "", name: "", variant: 0, order: [])
  match call_info(info: v.info, e: e)
  case Some(value: x) then
    set ci = x
  case None then
  end match
  var vals: List<String> = []
  for a in args do
    set vals = push(list: vals, item: vexpr(v: inout v, e: a.value, st: inout st))
  end for
  var p: List<String> = []
  var pe: List<Expr> = []
  for i in ci.order do
    if (i >= 0) and (i < len(vals)) and (i < len(args)) then
      set p = push(list: p, item: vals[i])
      set pe = push(list: pe, item: args[i].value)
    end if
  end for
  if ci.kind == "user" then
    return vcall_user(v: inout v, e: e, name: ci.name, p: p, pe: pe, st: inout st)
  end if
  if ci.kind == "struct" then
    let fields = struct_fields(info: v.info, name: ci.name)
    var binds: Map<String, String> = {}
    for i in 0..len(fields) do
      if i < len(p) then
        set binds = insert(map: binds, key: fields[i].name, value: p[i])
      end if
    end for
    return construct_struct(v: inout v, st: inout st, pos: e.pos, sn: ci.name, binds: binds)
  end if
  if ci.kind == "variant" then
    let ty = type_of(info: v.info, e: e)
    var vinfo = VariantInfo(name: "", fields: [])
    match variants_of(info: v.info, t: ty)
    case Some(value: vs) then
      if (ci.variant >= 0) and (ci.variant < len(vs)) then
        set vinfo = vs[ci.variant]
      end if
    case None then
    end match
    var binds: Map<String, String> = {}
    for i in 0..len(vinfo.fields) do
      if i < len(p) then
        set binds = insert(map: binds, key: vinfo.fields[i].name, value: p[i])
      end if
    end for
    for fl in vinfo.fields do
      for pr in fl.rty.preds do
        check_wd(v: inout v, st: st, pos: e.pos, e: pr, sp: Spec(binds: binds, subj: bind_of(binds: binds, n: fl.name), res: "", fuel: 2, scc: -1))
        let g = spec_with(v: inout v, e: pr, binds: binds, subj: bind_of(binds: binds, n: fl.name))
        let what = "field '" ++ fl.name ++ "' of " ++ ci.name ++ "." ++ vinfo.name ++ " satisfies " ++ pretty_expr(pr)
        obligation(v: inout v, st: st, pos: e.pos, what: what, goal: g)
      end for
      check_inner(v: inout v, st: st, pos: e.pos, name: "field '" ++ fl.name ++ "' of " ++ ci.name ++ "." ++ vinfo.name, r: fl.rty,
        term: bind_of(binds: binds, n: fl.name))
    end for
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (tag " ++ r ++ ") " ++ int_to_str(ci.variant) ++ "))")
    // Path facts, as in construct_struct.
    for fl in vinfo.fields do
      let fnn = vfield_fn(v: inout v, ename: ci.name, vname: vinfo.name, field: fl.name, t: fl.rty.ty)
      construct_fact(v: inout v, st: inout st, f: "(= (" ++ fnn ++ " " ++ r ++ ") " ++ bind_of(binds: binds, n: fl.name) ++ ")")
    end for
    return r
  end if
  return vbuiltin(v: inout v, e: e, name: ci.name, p: p, pe: pe, st: inout st)
end fn vcall

struct Update
  var_name: String,
  term: String,
end struct Update

fn vcall_user(v: inout Verifier, e: Expr, name: String, p: List<String>, pe: List<Expr>, st: inout St) -> String do
  var fi = FnInfo(name: name, params: [], io: [], ret: plain(Ty.TUnknown), effects: [], pre: [], post: [],
    dec: Option.None, inline: Option.None, spec_body: Option.None, spec_rec: false, pos: e.pos)
  match get_fn(info: v.info, name: name)
  case Some(value: x) then
    set fi = x
  case None then
  end match
  var binds: Map<String, String> = {}
  for i in 0..len(fi.params) do
    if (i < len(p)) and (i < len(pe)) then
      let fp = fi.params[i]
      for pr in fp.rty.preds do
        let g = goal_with(v: inout v, e: pr, binds: binds, subj: p[i])
        let what = "argument '" ++ fp.name ++ "' of '" ++ name ++ "' satisfies " ++ pretty_expr(pr)
        obligation(v: inout v, st: st, pos: pe[i].pos, what: what, goal: g)
      end for
      check_inner(v: inout v, st: st, pos: pe[i].pos, name: "argument '" ++ fp.name ++ "' of '" ++ name ++ "'", r: fp.rty, term: p[i])
      set binds = insert(map: binds, key: fp.name, value: p[i])
    end if
  end for
  for r in fi.pre do
    let g = goal_with(v: inout v, e: r, binds: binds, subj: "")
    obligation(v: inout v, st: st, pos: e.pos, what: "precondition of '" ++ name ++ "': " ++ pretty_expr(r), goal: g)
  end for
  // A call within the caller's group of mutually recursive functions decreases the
  // caller's measure: the callee's measure, on the arguments as passed in, is smaller.
  let same = name == v.fname
  let k = scc_of_fn(info: v.info, name: v.fname)
  if same or ((k >= 0) and (scc_of_fn(info: v.info, name: name) == k)) then
    match v.dec
    case Some(value: d) then
      var cd = d
      match fi.dec
      case Some(value: x) then
        set cd = x
      case None then
      end match
      let e0 = spec_with(v: inout v, e: d, binds: v.params, subj: "")
      let entry = as_measure(v: inout v, d: d, t: e0)
      let n0 = spec_with(v: inout v, e: cd, binds: binds, subj: "")
      let now = as_measure(v: inout v, d: cd, t: n0)
      var what = "recursive call to '" ++ name ++ "' decreases its measure: " ++ pretty_expr(d)
      if not same then
        set what = "call to '" ++ name ++ "' decreases the measure of '" ++ v.fname ++ "': " ++ pretty_expr(cd) ++ " < " ++ pretty_expr(d)
      end if
      obligation(v: inout v, st: st, pos: e.pos, what: what, goal: "(and (>= " ++ entry ++ " 0) (< " ++ now ++ " " ++ entry ++ "))")
    case None then
    end match
  end if
  // Each inout argument's var receives a new value.
  var post = binds
  var updated: List<Update> = []
  for i in 0..len(fi.params) do
    if (i < len(fi.io)) and fi.io[i] and (i < len(pe)) then
      let fp = fi.params[i]
      let nv = fresh(v: inout v, sort: sort_of(fp.rty.ty))
      set post = insert(map: post, key: "old(" ++ fp.name ++ ")", value: bind_of(binds: binds, n: fp.name))
      set post = insert(map: post, key: fp.name, value: nv)
      match pe[i].kind
      case Var(name: vn) then
        set updated = push(list: updated, item: Update(var_name: vn, term: nv))
      else
      end match
    end if
  end for
  for i in 0..len(fi.params) do
    if (i < len(fi.io)) and fi.io[i] then
      let fp = fi.params[i]
      let nv = bind_of(binds: post, n: fp.name)
      for pr in fp.rty.preds do
        let t = spec_with(v: inout v, e: pr, binds: post, subj: nv)
        add_fact(st: inout st, f: t)
      end for
      for f in inner_facts(v: inout v, r: fp.rty, term: nv) do
        add_fact(st: inout st, f: f)
      end for
    end if
  end for
  let res = fresh(v: inout v, sort: sort_of(fi.ret.ty))
  if is_some(fi.inline) or is_some(fi.spec_body) then
    // Specification functions are transparent: the result is what the body denotes.
    let t = spec_call(v: inout v, name: name, args: p, sp: Spec(binds: {}, subj: "", res: "", fuel: 2, scc: -1))
    add_fact(st: inout st, f: "(= " ++ res ++ " " ++ t ++ ")")
  end if
  for pr in fi.ret.preds do
    let t = spec_with(v: inout v, e: pr, binds: post, subj: res)
    add_fact(st: inout st, f: t)
  end for
  for f in inner_facts(v: inout v, r: fi.ret, term: res) do
    add_fact(st: inout st, f: f)
  end for
  for en in fi.post do
    let t = sexpr(v: inout v, e: en, sp: Spec(binds: post, subj: "", res: res, fuel: 2, scc: -1))
    add_fact(st: inout st, f: t)
  end for
  match generic_decl(info: v.info, name: name)
  case Some(value: gd) then
    generic_facts(v: inout v, st: inout st, gd: gd, fi: fi, pe: pe, p: p, post: post, res: res)
  case None then
  end match
  for u in updated do
    match lookup(map: st.env, key: u.var_name)
    case Some(value: x) then
      check_preds(v: inout v, st: st, pos: e.pos, name: u.var_name, preds: x.preds, term: u.term)
      let xr = RTy(ty: x.ty, preds: [], args: x.args)
      check_inner(v: inout v, st: st, pos: e.pos, name: "'" ++ u.var_name ++ "'", r: xr, term: u.term)
      assume_inner(v: inout v, st: inout st, name: "'" ++ u.var_name ++ "'", r: xr, term: u.term)
      set st = st with (env: insert(map: st.env, key: u.var_name, value: x with (term: u.term)))
    case None then
    end match
  end for
  return res
end fn vcall_user

fn vbuiltin(v: inout Verifier, e: Expr, name: String, p: List<String>, pe: List<Expr>, st: inout St) -> String do
  let rty = type_of(info: v.info, e: e)
  let a0 = arg_str(p: p, i: 0)
  let a1 = arg_str(p: p, i: 1)
  let a2 = arg_str(p: p, i: 2)
  let ft = float_builtin(v: inout v, name: name, a: a0)
  if len(ft) > 0 then
    return define(v: inout v, sort: sort_of(rty), term: ft)
  end if
  match name
  case "len" then
    return define(v: inout v, sort: "Int", term: "(len " ++ a0 ++ ")")
  case "push" then
    var et = Ty.TUnknown
    match rty
    case TList(elem: t) then
      set et = t
    else
    end match
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") (+ (len " ++ a0 ++ ") 1)))")
    add_def(v: inout v, d: "(assert (= (elem_" ++ sort_of(et) ++ " " ++ r ++ " (len " ++ a0 ++ ")) " ++ a1 ++ "))")
    let q = fresh_q(inout v)
    let s = sort_of(et)
    let at_r = "(elem_" ++ s ++ " " ++ r ++ " " ++ q ++ ")"
    add_qdef(v: inout v, d: "(assert (forall ((" ++ q ++ " Int)) (! (=> (and (<= 0 " ++ q ++ ") (< " ++ q ++ " (len " ++ a0 ++ "))) (= " ++ at_r ++ " (elem_" ++ s ++ " " ++ a0 ++ " " ++ q ++ "))) :pattern (" ++ at_r ++ "))))")
    return r
  case "set_at" then
    let goal = "(and (<= 0 " ++ a1 ++ ") (< " ++ a1 ++ " (len " ++ a0 ++ ")))"
    var what = "set_at index in bounds"
    if len(pe) >= 2 then
      set what = "set_at index in bounds: 0 <= " ++ pretty_expr(pe[1]) ++ " < len(" ++ pretty_expr(pe[0]) ++ ")"
    end if
    obligation(v: inout v, st: st, pos: e.pos, what: what, goal: goal)
    var et = Ty.TUnknown
    match rty
    case TList(elem: t) then
      set et = t
    else
    end match
    let s = sort_of(et)
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") (len " ++ a0 ++ ")))")
    add_def(v: inout v, d: "(assert (= (elem_" ++ s ++ " " ++ r ++ " " ++ a1 ++ ") " ++ a2 ++ "))")
    let q = fresh_q(inout v)
    let at_r = "(elem_" ++ s ++ " " ++ r ++ " " ++ q ++ ")"
    add_qdef(v: inout v, d: "(assert (forall ((" ++ q ++ " Int)) (! (=> (and (<= 0 " ++ q ++ ") (< " ++ q ++ " (len " ++ a0 ++ ")) (not (= " ++ q ++ " " ++ a1 ++ "))) (= " ++ at_r ++ " (elem_" ++ s ++ " " ++ a0 ++ " " ++ q ++ "))) :pattern (" ++ at_r ++ "))))")
    return r
  case "slice" then
    let goal = "(and (<= 0 " ++ a1 ++ ") (<= " ++ a1 ++ " " ++ a2 ++ ") (<= " ++ a2 ++ " (len " ++ a0 ++ ")))"
    var what = "slice bounds"
    if len(pe) >= 3 then
      set what = "slice bounds: 0 <= " ++ pretty_expr(pe[1]) ++ " <= " ++ pretty_expr(pe[2]) ++ " <= len(" ++ pretty_expr(pe[0]) ++ ")"
    end if
    obligation(v: inout v, st: st, pos: e.pos, what: what, goal: goal)
    // Only meaningful once the bounds hold, so it is a path fact, not a definition.
    let r = fresh(v: inout v, sort: "Val")
    add_fact(st: inout st, f: "(= (len " ++ r ++ ") (- " ++ a2 ++ " " ++ a1 ++ "))")
    let f = content_fn(rty)
    if len(f) > 0 then
      let q = fresh_q(inout v)
      let at_r = "(" ++ f ++ " " ++ r ++ " " ++ q ++ ")"
      add_fact(st: inout st, f: "(forall ((" ++ q ++ " Int)) (! (=> (and (<= 0 " ++ q ++ ") (< " ++ q ++ " (- " ++ a2 ++ " " ++ a1 ++ "))) (= " ++ at_r ++ " (" ++ f ++ " " ++ a0 ++ " (+ " ++ a1 ++ " " ++ q ++ ")))) :pattern (" ++ at_r ++ ")))")
    end if
    return r
  case "char" then
    let goal = "(and (<= 0 " ++ a0 ++ ") (< " ++ a0 ++ " 256))"
    var what = "char code in range"
    if len(pe) >= 1 then
      set what = "char code in range: 0 <= " ++ pretty_expr(pe[0]) ++ " < 256"
    end if
    obligation(v: inout v, st: st, pos: e.pos, what: what, goal: goal)
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") 1))")
    add_fact(st: inout st, f: "(= (byte " ++ r ++ " 0) " ++ a0 ++ ")")
    return r
  case "int_to_str" then
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (>= (len " ++ r ++ ") 1))")
    return r
  case "hash" then
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") 16))")
    return r
  case "keys" then
    let r = fresh(v: inout v, sort: "Val")
    add_def(v: inout v, d: "(assert (= (len " ++ r ++ ") (len " ++ a0 ++ ")))")
    return r
  case "panic" then
    return "0"
  case "exit" then
    return "0"
  case "print" then
    return "0"
  case "eprint" then
    return "0"
  case "is_some" then
    return define(v: inout v, sort: "Bool", term: "(= (tag " ++ a0 ++ ") 1)")
  case "is_none" then
    return define(v: inout v, sort: "Bool", term: "(= (tag " ++ a0 ++ ") 0)")
  case "value_or" then
    let f = vfield_fn(v: inout v, ename: "Option", vname: "Some", field: "value", t: rty)
    return define(v: inout v, sort: sort_of(rty), term: "(ite (= (tag " ++ a0 ++ ") 1) (" ++ f ++ " " ++ a0 ++ ") " ++ a1 ++ ")")
  else
    return fresh(v: inout v, sort: sort_of(rty))
  end match
end fn vbuiltin

fn arg_str(p: List<String>, i: Int) -> String do
  if (i >= 0) and (i < len(p)) then
    return p[i]
  end if
  return "0"
end fn arg_str

// ---- running Z3 ----

struct Failure
  fn_name: String,
  ob: Ob,
  verdict: String,
  model: List<Shown>,
end struct Failure

struct Discharged
  error: String,
  failures: List<Failure>,
end struct Discharged

// The Z3 release Vow is tested with (tools/install-z3.sh installs it). Whether a hard
// query times out can differ between versions.
fn tested_z3_version() -> String do
  return "5.3.2"
end fn tested_z3_version

fn z3_path() -> String uses proc do
  match getenv("VOW_Z3")
  case Some(value: x) then
    return x
  case None then
    return "z3"
  end match
end fn z3_path

fn run_z3(script: String) -> Output uses proc do
  return run(argv: [z3_path(), "-in", "-smt2"], input: script)
end fn run_z3

// The version of the Z3 that run_z3 uses ("5.3.2"), or "" if it cannot be run.
fn z3_version() -> String uses proc do
  let o = run(argv: [z3_path(), "--version"], input: "")
  let parts = split(s: trim(o.out), sep: ' ')
  if (o.code == 0) and (len(parts) >= 3) and (parts[1] == "version") then
    return parts[2]
  end if
  return ""
end fn z3_version

fn script_for(pre: List<String>, vcs: List<FnVc>, model: Option<Ob>) -> String do
  var s: List<String> = ["(set-option :produce-models true)", "(set-option :timeout 10000)"]
  set s = s ++ pre
  for vc in vcs do
    set s = push(list: s, item: "(push 1) ; fn " ++ vc.name)
    if vc.axioms then
      set s = push(list: s, item: "(set-option :smt.mbqi false)")
    end if
    set s = s ++ vc.decls
    set s = s ++ vc.defs
    var obs: List<Ob> = vc.obs
    var is_model = false
    match model
    case Some(value: o) then
      set obs = [o]
      set is_model = true
    case None then
      // Sanity check: the definitions alone must be satisfiable, or every
      // obligation in this function would be proved vacuously.
      set s = push(list: s, item: "(check-sat)")
    end match
    set s = s ++ vc.qdefs
    for ob in obs do
      set s = push(list: s, item: "(push 1)")
      for f in ob.facts do
        set s = push(list: s, item: "(assert " ++ f ++ ")")
      end for
      set s = push(list: s, item: "(assert (not " ++ ob.goal ++ "))")
      set s = push(list: s, item: "(check-sat)")
      if is_model and (len(ob.show) > 0) then
        var terms: List<String> = []
        for x in ob.show do
          set terms = push(list: terms, item: x.term)
        end for
        set s = push(list: s, item: "(get-value (" ++ join(parts: terms, sep: " ") ++ "))")
      end if
      set s = push(list: s, item: "(pop 1)")
    end for
    set s = push(list: s, item: "(pop 1)")
    if vc.axioms then
      set s = push(list: s, item: "(set-option :smt.mbqi true)")
    end if
  end for
  return join(parts: s, sep: "\n") ++ "\n"
end fn script_for

// The values printed by (get-value ...), in order.
fn parse_values(out: String) -> List<String> do
  var vals: List<String> = []
  let start = find(s: out, p: "((", from: 0)
  if start < 0 then
    return vals
  end if
  var i = start + 1
  while i < len(out) invariant i >= 0 do
    let c = out[i]
    if c == '(' then
      var depth = 0
      var j = i
      var closed = false
      while j < len(out) invariant j >= i invariant j <= len(out) do
        if out[j] == '(' then
          set depth = depth + 1
        elif out[j] == ')' then
          set depth = depth - 1
          if depth == 0 then
            set closed = true
            break
          end if
        end if
        set j = j + 1
      end while
      if not closed then
        return vals
      end if
      if (i + 1) <= j then
        set vals = push(list: vals, item: split_pair(slice(of: out, from: i + 1, to: j)))
      end if
      set i = j + 1
    elif c == ')' then
      break
    else
      set i = i + 1
    end if
  end while
  return vals
end fn parse_values

// "term value": the term is an atom or a parenthesised expression.
fn split_pair(pair: String) -> String do
  let p = trim(pair)
  var i = 0
  if (len(p) > 0) and (p[0] == '(') then
    var d = 0
    while i < len(p) invariant i >= 0 do
      if p[i] == '(' then
        set d = d + 1
      elif p[i] == ')' then
        set d = d - 1
        if d == 0 then
          set i = i + 1
          break
        end if
      end if
      set i = i + 1
    end while
  else
    while (i < len(p)) and not is_space(p[i]) invariant i >= 0 do
      set i = i + 1
    end while
  end if
  if i > len(p) then
    return ""
  end if
  let val = trim(slice(of: p, from: i, to: len(p)))
  // Render (- 5) as -5.
  if starts_with(s: val, p: "(- ") and ends_with(s: val, p: ")") and (len(val) >= 4) then
    return "-" ++ trim(slice(of: val, from: 3, to: len(val) - 1))
  end if
  return val
end fn split_pair

fn discharge(pre: List<String>, vcs: List<FnVc>) -> Discharged uses proc, fs do
  let script = script_for(pre: pre, vcs: vcs, model: Option.None)
  match getenv("VOW_SMT_DUMP")
  case Some(value: path) then
    let _ = write_file(path: path, contents: script)
  case None then
  end match
  let o = run_z3(script)
  var answers: List<String> = []
  for l0 in split(s: o.out, sep: '\n') do
    let l = trim(l0)
    if (l == "sat") or (l == "unsat") or (l == "unknown") or starts_with(s: l, p: "(error") then
      set answers = push(list: answers, item: l)
    end if
  end for
  let none: List<Failure> = []
  for a in answers do
    if starts_with(s: a, p: "(error") then
      return Discharged(error: "Z3 rejected the generated query: " ++ a, failures: none)
    end if
  end for
  var total = 0
  for vc in vcs do
    set total = total + (len(vc.obs) + 1)
  end for
  if len(answers) != total then
    let msg = "Z3 answered " ++ int_to_str(len(answers)) ++ " of " ++ int_to_str(total) ++ " queries"
    if o.code != 0 then
      return Discharged(error: msg ++ " (is Z3 installed? set VOW_Z3 to its path)", failures: none)
    end if
    return Discharged(error: msg, failures: none)
  end if
  var failures: List<Failure> = []
  var k = 0
  for vc in vcs invariant k >= 0 do
    if (k < len(answers)) and (answers[k] == "unsat") then
      return Discharged(error: "internal verifier error: the definitions for '" ++ vc.name ++ "' are inconsistent", failures: none)
    end if
    set k = k + 1
    for ob in vc.obs invariant k >= 0 do
      var a = "unknown"
      if k < len(answers) then
        set a = answers[k]
      end if
      set k = k + 1
      if a == "unsat" then
        continue
      end if
      var model: List<Shown> = []
      if (a == "sat") and (len(ob.show) > 0) then
        let mo = run_z3(script_for(pre: pre, vcs: [vc], model: Option.Some(value: ob)))
        let vals = parse_values(mo.out)
        for i in 0..len(ob.show) do
          if i < len(vals) then
            set model = push(list: model, item: Shown(name: ob.show[i].name, term: vals[i]))
          end if
        end for
      end if
      var verdict = a
      if vc.axioms and (a == "unknown") then
        set verdict = "unknown-unfolded"
      end if
      set failures = push(list: failures, item: Failure(fn_name: vc.name, ob: ob, verdict: verdict, model: model))
    end for
  end for
  return Discharged(error: "", failures: failures)
end fn discharge

fn failure_diag(f: Failure) -> Diag do
  var d = diag(pos: f.ob.pos, msg: "cannot prove " ++ f.ob.what)
  if f.verdict == "unknown-unfolded" then
    set d = with_note(d: d, note: "not proved: it may be false, or need facts the verifier does not have (it knows only order and NaN-ness of Float values, and unfolds a recursive specification function at most twice per use); state them with check, assert or a contract")
  elif f.verdict == "unknown" then
    set d = with_note(d: d, note: "Z3 gave up (timeout or incomplete theory); add an assertion, invariant or check to help it")
  elif len(f.model) > 0 then
    var parts: List<String> = []
    for m in f.model do
      set parts = push(list: parts, item: m.name ++ " = " ++ m.term)
    end for
    set d = with_note(d: d, note: "counterexample: " ++ join(parts: parts, sep: ", "))
  end if
  return with_note(d: d, note: "in function '" ++ f.fn_name ++ "'")
end fn failure_diag
