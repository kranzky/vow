// Generated by tools/embed.vow from runtime/vow_rt.h. Do not edit.

fn runtime_header() -> String do
  return "// Vow runtime, reference counted.\n" ++
    "//\n" ++
    "// Every Vow value is one 64-bit word (V). Integers and booleans are unboxed; everything\n" ++
    "// else is a pointer to a heap object, preceded by a 16-byte header holding its\n" ++
    "// reference count and layout. Objects are freed when their count reaches zero, and an\n" ++
    "// object with a count of one is updated in place by `with`, `push`, `set_at` and\n" ++
    "// `insert`, which preserves value semantics because nothing else can see it.\n" ++
    "//\n" ++
    "// Ownership conventions (the code generator relies on these):\n" ++
    "// - A function \"consumes\" an argument when it takes over the caller's reference, and\n" ++
    "//   \"borrows\" it otherwise. Results are always owned by the caller.\n" ++
    "// - Consumed: vlist_push(list, item), vlist_set_at(list, _, value), vlist_cat(list, _),\n" ++
    "//   vmap_insert(map, key, value), vow_with(base), vsome(value),\n" ++
    "//   vvalue_or(_, default).\n" ++
    "// - Everything else borrows its arguments.\n" ++
    "// - vlist_get and field reads return borrowed references.\n" ++
    "//\n" ++
    "// Define VOW_VERIFIED when every proof obligation was discharged: bounds and divisor\n" ++
    "// checks then compile to nothing. Overflow checks always stay. Define VOW_RC_DEBUG to\n" ++
    "// keep freed memory poisoned (never reused) and panic on any use after free; with\n" ++
    "// VOW_LEAKS=1 in the environment, the program reports objects still live at exit.\n" ++
    "#ifndef VOW_RT_H\n" ++
    "#define VOW_RT_H\n" ++
    "\n" ++
    "#ifndef _GNU_SOURCE\n" ++
    "#define _GNU_SOURCE\n" ++
    "#endif\n" ++
    "#include <dirent.h>\n" ++
    "#include <fcntl.h>\n" ++
    "#include <stdint.h>\n" ++
    "#include <stdio.h>\n" ++
    "#include <stdlib.h>\n" ++
    "#include <string.h>\n" ++
    "#include <sys/stat.h>\n" ++
    "#include <sys/wait.h>\n" ++
    "#include <unistd.h>\n" ++
    "\n" ++
    "typedef uint64_t V;\n" ++
    "\n" ++
    "#define VI(x) ((int64_t)(x))\n" ++
    "#define VP(x) ((V *)(uintptr_t)(x))\n" ++
    "\n" ++
    "static __attribute__((noreturn)) void vow_panic(const char *msg) {\n" ++
    "    fflush(stdout);\n" ++
    "    fprintf(stderr, \"vow: panic: %s\\n\", msg);\n" ++
    "    exit(101);\n" ++
    "}\n" ++
    "\n" ++
    "// Generated code carries #line directives, so __FILE__ and __LINE__ where it calls a\n" ++
    "// checked operation name the .vow source line. Each checked operation is a macro that\n" ++
    "// passes them on (vadd(a, b) is vadd_at(a, b, __FILE__, __LINE__)); they are used only\n" ++
    "// when the check fails.\n" ++
    "static __attribute__((noreturn, cold)) void vow_panic_at(const char *file, int line, const char *msg) {\n" ++
    "    fflush(stdout);\n" ++
    "    fprintf(stderr, \"vow: panic at %s:%d: %s\\n\", file, line, msg);\n" ++
    "    exit(101);\n" ++
    "}\n" ++
    "\n" ++
    "#define VOW_PANIC(msg) vow_panic_at(__FILE__, __LINE__, (msg))\n" ++
    "#define VOW_AT const char *vow_f, int vow_l\n" ++
    "\n" ++
    "#ifdef VOW_VERIFIED\n" ++
    "#define VOW_REQUIRE(cond, msg) ((void)0)\n" ++
    "#else\n" ++
    "#define VOW_REQUIRE(cond, msg) \\\n" ++
    "    do {                       \\\n" ++
    "        if (!(cond)) vow_panic_at(vow_f, vow_l, msg); \\\n" ++
    "    } while (0)\n" ++
    "#endif\n" ++
    "\n" ++
    "// ---- objects ----\n" ++
    "\n" ++
    "enum { VK_FIELDS, VK_STR, VK_LIST, VK_BUF, VK_NODE, VK_HASH };\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int32_t rc;     // reference count; -1 for immortal objects (literals, None)\n" ++
    "    uint8_t kind;   // VK_*\n" ++
    "    uint8_t flags;  // lists and buffers: elements are heap values; nodes: see below\n" ++
    "    uint16_t words; // VK_FIELDS: number of payload words\n" ++
    "    uint64_t mask;  // VK_FIELDS: bit i set when payload word i is a heap value\n" ++
    "} VHdr;\n" ++
    "\n" ++
    "#define VH(x) ((VHdr *)((char *)(uintptr_t)(x) - sizeof(VHdr)))\n" ++
    "\n" ++
    "// ---- allocation: size classes of 16 bytes with free lists, carved from chunks ----\n" ++
    "\n" ++
    "#define VOW_CLASSES 64\n" ++
    "static void *vow_freelist[VOW_CLASSES + 1];\n" ++
    "static char *vow_chunk;\n" ++
    "static size_t vow_chunk_left;\n" ++
    "static int64_t vow_live, vow_immortals;\n" ++
    "\n" ++
    "static void *vow_raw_alloc(size_t n) {\n" ++
    "    size_t c = n / 16;\n" ++
    "    if (c <= VOW_CLASSES) {\n" ++
    "        void *p = vow_freelist[c];\n" ++
    "        if (p) {\n" ++
    "            vow_freelist[c] = *(void **)p;\n" ++
    "            return p;\n" ++
    "        }\n" ++
    "        if (n > vow_chunk_left) {\n" ++
    "            vow_chunk_left = (size_t)1 << 20;\n" ++
    "            vow_chunk = (char *)malloc(vow_chunk_left);\n" ++
    "            if (!vow_chunk) vow_panic(\"out of memory\");\n" ++
    "        }\n" ++
    "        p = vow_chunk;\n" ++
    "        vow_chunk += n;\n" ++
    "        vow_chunk_left -= n;\n" ++
    "        return p;\n" ++
    "    }\n" ++
    "    void *p = malloc(n);\n" ++
    "    if (!p) vow_panic(\"out of memory\");\n" ++
    "    return p;\n" ++
    "}\n" ++
    "\n" ++
    "static void vow_raw_free(void *p, size_t n) {\n" ++
    "#ifdef VOW_RC_DEBUG\n" ++
    "    VHdr *h = (VHdr *)p;\n" ++
    "    memset((char *)p + sizeof(VHdr), 0xdd, n - sizeof(VHdr));\n" ++
    "    h->rc = 0; // a freed object: any later use panics\n" ++
    "#else\n" ++
    "    size_t c = n / 16;\n" ++
    "    if (c <= VOW_CLASSES) {\n" ++
    "        *(void **)p = vow_freelist[c];\n" ++
    "        vow_freelist[c] = p;\n" ++
    "    } else {\n" ++
    "        free(p);\n" ++
    "    }\n" ++
    "#endif\n" ++
    "}\n" ++
    "\n" ++
    "static inline size_t vow_round(size_t n) { return (n + 15) & ~(size_t)15; }\n" ++
    "\n" ++
    "static V vow_obj(uint8_t kind, uint8_t flags, uint16_t words, uint64_t mask, size_t payload) {\n" ++
    "    VHdr *h = (VHdr *)vow_raw_alloc(vow_round(sizeof(VHdr) + payload));\n" ++
    "    h->rc = 1;\n" ++
    "    h->kind = kind;\n" ++
    "    h->flags = flags;\n" ++
    "    h->words = words;\n" ++
    "    h->mask = mask;\n" ++
    "    vow_live++;\n" ++
    "    return (V)(uintptr_t)((char *)h + sizeof(VHdr));\n" ++
    "}\n" ++
    "\n" ++
    "static V vow_immortal(V x) {\n" ++
    "    VH(x)->rc = -1;\n" ++
    "    vow_immortals++;\n" ++
    "    return x;\n" ++
    "}\n" ++
    "\n" ++
    "#ifdef VOW_RC_DEBUG\n" ++
    "#define VOW_ALIVE(h) \\\n" ++
    "    do {             \\\n" ++
    "        if ((h)->rc == 0) vow_panic(\"use after free (reference counting bug)\"); \\\n" ++
    "    } while (0)\n" ++
    "#else\n" ++
    "#define VOW_ALIVE(h) ((void)0)\n" ++
    "#endif\n" ++
    "\n" ++
    "static inline V vdup(V x) {\n" ++
    "    if (x) {\n" ++
    "        VHdr *h = VH(x);\n" ++
    "        VOW_ALIVE(h);\n" ++
    "        if (h->rc > 0) h->rc++;\n" ++
    "    }\n" ++
    "    return x;\n" ++
    "}\n" ++
    "\n" ++
    "static void vow_destroy(V x);\n" ++
    "\n" ++
    "static inline void vdrop(V x) {\n" ++
    "    if (x) {\n" ++
    "        VHdr *h = VH(x);\n" ++
    "        VOW_ALIVE(h);\n" ++
    "        if (h->rc > 0 && --h->rc == 0) vow_destroy(x);\n" ++
    "    }\n" ++
    "}\n" ++
    "\n" ++
    "// ---- strings ----\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t len;\n" ++
    "    char data[];\n" ++
    "} VStr;\n" ++
    "\n" ++
    "#define VS(x) ((VStr *)(uintptr_t)(x))\n" ++
    "\n" ++
    "// ---- lists: a header (length, buffer) sharing a buffer of elements ----\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t len;\n" ++
    "    V buf;\n" ++
    "} VList;\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t cap;\n" ++
    "    int64_t used;\n" ++
    "    V items[];\n" ++
    "} VBuf;\n" ++
    "\n" ++
    "#define VL(x) ((VList *)(uintptr_t)(x))\n" ++
    "#define VB(x) ((VBuf *)(uintptr_t)(x))\n" ++
    "\n" ++
    "// ---- maps: persistent AVL trees, updated in place where unshared ----\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    V key, val, left, right;\n" ++
    "    int64_t height, size;\n" ++
    "} VNode;\n" ++
    "\n" ++
    "#define VN(x) ((VNode *)(uintptr_t)(x))\n" ++
    "#define VN_KEY_HEAP 1\n" ++
    "#define VN_VAL_HEAP 2\n" ++
    "#define VN_STR_KEYS 4\n" ++
    "\n" ++
    "// ---- hash maps: open addressing; the header is followed by the hashes (0 marks an\n" ++
    "// empty slot), the keys and the values, each `cap` long ----\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t count;\n" ++
    "    int64_t cap;\n" ++
    "} VHash;\n" ++
    "\n" ++
    "#define VHM(x) ((VHash *)(uintptr_t)(x))\n" ++
    "static inline uint64_t *vhm_hashes(V h) { return (uint64_t *)((char *)(uintptr_t)h + sizeof(VHash)); }\n" ++
    "static inline V *vhm_keyarr(V h) { return (V *)(vhm_hashes(h) + VHM(h)->cap); }\n" ++
    "static inline V *vhm_valarr(V h) { return vhm_keyarr(h) + VHM(h)->cap; }\n" ++
    "\n" ++
    "static size_t vow_size(VHdr *h, V x) {\n" ++
    "    switch (h->kind) {\n" ++
    "    case VK_FIELDS: return vow_round(sizeof(VHdr) + (size_t)(h->words > 0 ? h->words : 1) * sizeof(V));\n" ++
    "    case VK_STR: return vow_round(sizeof(VHdr) + sizeof(VStr) + (size_t)VS(x)->len + 1);\n" ++
    "    case VK_LIST: return vow_round(sizeof(VHdr) + sizeof(VList));\n" ++
    "    case VK_BUF: return vow_round(sizeof(VHdr) + sizeof(VBuf) + (size_t)VB(x)->cap * sizeof(V));\n" ++
    "    case VK_HASH: return vow_round(sizeof(VHdr) + sizeof(VHash) + (size_t)VHM(x)->cap * 3 * sizeof(V));\n" ++
    "    default: return vow_round(sizeof(VHdr) + sizeof(VNode));\n" ++
    "    }\n" ++
    "}\n" ++
    "\n" ++
    "// Frees an object and, iteratively, everything only it referenced (no recursion, so\n" ++
    "// long chains cannot overflow the C stack).\n" ++
    "static V *vow_dstack;\n" ++
    "static size_t vow_dcap, vow_dlen;\n" ++
    "\n" ++
    "static void vow_dpush(V c) {\n" ++
    "    if (vow_dlen == vow_dcap) {\n" ++
    "        vow_dcap = vow_dcap ? vow_dcap * 2 : 256;\n" ++
    "        vow_dstack = (V *)realloc(vow_dstack, vow_dcap * sizeof(V));\n" ++
    "        if (!vow_dstack) vow_panic(\"out of memory\");\n" ++
    "    }\n" ++
    "    vow_dstack[vow_dlen++] = c;\n" ++
    "}\n" ++
    "\n" ++
    "static inline void vow_release(V c) {\n" ++
    "    if (!c) return;\n" ++
    "    VHdr *h = VH(c);\n" ++
    "    VOW_ALIVE(h);\n" ++
    "    if (h->rc > 0 && --h->rc == 0) vow_dpush(c);\n" ++
    "}\n" ++
    "\n" ++
    "static void vow_free_shell(V x) {\n" ++
    "    VHdr *h = VH(x);\n" ++
    "    vow_live--;\n" ++
    "    vow_raw_free(h, vow_size(h, x));\n" ++
    "}\n" ++
    "\n" ++
    "static void vow_destroy(V x) {\n" ++
    "    size_t base = vow_dlen;\n" ++
    "    vow_dpush(x);\n" ++
    "    while (vow_dlen > base) {\n" ++
    "        V y = vow_dstack[--vow_dlen];\n" ++
    "        VHdr *h = VH(y);\n" ++
    "        switch (h->kind) {\n" ++
    "        case VK_FIELDS:\n" ++
    "            for (int i = 0; i < h->words; i++)\n" ++
    "                if (h->mask & ((uint64_t)1 << i)) vow_release(VP(y)[i]);\n" ++
    "            break;\n" ++
    "        case VK_LIST: vow_release(VL(y)->buf); break;\n" ++
    "        case VK_BUF:\n" ++
    "            if (h->flags)\n" ++
    "                for (int64_t i = 0; i < VB(y)->used; i++) vow_release(VB(y)->items[i]);\n" ++
    "            break;\n" ++
    "        case VK_NODE:\n" ++
    "            if (h->flags & VN_KEY_HEAP) vow_release(VN(y)->key);\n" ++
    "            if (h->flags & VN_VAL_HEAP) vow_release(VN(y)->val);\n" ++
    "            vow_release(VN(y)->left);\n" ++
    "            vow_release(VN(y)->right);\n" ++
    "            break;\n" ++
    "        case VK_HASH:\n" ++
    "            for (int64_t i = 0; i < VHM(y)->cap; i++) {\n" ++
    "                if (!vhm_hashes(y)[i]) continue;\n" ++
    "                if (h->flags & VN_KEY_HEAP) vow_release(vhm_keyarr(y)[i]);\n" ++
    "                if (h->flags & VN_VAL_HEAP) vow_release(vhm_valarr(y)[i]);\n" ++
    "            }\n" ++
    "            break;\n" ++
    "        default: break;\n" ++
    "        }\n" ++
    "        vow_free_shell(y);\n" ++
    "    }\n" ++
    "}\n" ++
    "\n" ++
    "static void vow_report_leaks(void) {\n" ++
    "    const char *e = getenv(\"VOW_LEAKS\");\n" ++
    "    if (e && *e == '1') fprintf(stderr, \"vow: %lld objects live at exit\\n\", (long long)(vow_live - vow_immortals));\n" ++
    "}\n" ++
    "\n" ++
    "// ---- integers ----\n" ++
    "\n" ++
    "static inline V vadd_at(V a, V b, VOW_AT) {\n" ++
    "    int64_t r;\n" ++
    "    if (__builtin_add_overflow(VI(a), VI(b), &r)) vow_panic_at(vow_f, vow_l, \"integer overflow in '+'\");\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "static inline V vsub_at(V a, V b, VOW_AT) {\n" ++
    "    int64_t r;\n" ++
    "    if (__builtin_sub_overflow(VI(a), VI(b), &r)) vow_panic_at(vow_f, vow_l, \"integer overflow in '-'\");\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "static inline V vmul_at(V a, V b, VOW_AT) {\n" ++
    "    int64_t r;\n" ++
    "    if (__builtin_mul_overflow(VI(a), VI(b), &r)) vow_panic_at(vow_f, vow_l, \"integer overflow in '*'\");\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "static inline V vneg_at(V a, VOW_AT) {\n" ++
    "    if (VI(a) == INT64_MIN) vow_panic_at(vow_f, vow_l, \"integer overflow in unary '-'\");\n" ++
    "    return (V)(-VI(a));\n" ++
    "}\n" ++
    "// Euclidean division: the remainder is always non-negative (matches SMT-LIB).\n" ++
    "static inline V vdiv_at(V a, V b, VOW_AT) {\n" ++
    "    VOW_REQUIRE(VI(b) != 0, \"division by zero\");\n" ++
    "    if (VI(a) == INT64_MIN && VI(b) == -1) vow_panic_at(vow_f, vow_l, \"integer overflow in '/'\");\n" ++
    "    int64_t q = VI(a) / VI(b), r = VI(a) % VI(b);\n" ++
    "    if (r < 0) q = VI(b) > 0 ? q - 1 : q + 1;\n" ++
    "    return (V)q;\n" ++
    "}\n" ++
    "static inline V vmod_at(V a, V b, VOW_AT) {\n" ++
    "    VOW_REQUIRE(VI(b) != 0, \"division by zero\");\n" ++
    "    if (VI(b) == -1) return 0;\n" ++
    "    int64_t r = VI(a) % VI(b);\n" ++
    "    if (r < 0) r = VI(b) > 0 ? r + VI(b) : r - VI(b);\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "\n" ++
    "#define vadd(a, b) vadd_at((a), (b), __FILE__, __LINE__)\n" ++
    "#define vsub(a, b) vsub_at((a), (b), __FILE__, __LINE__)\n" ++
    "#define vmul(a, b) vmul_at((a), (b), __FILE__, __LINE__)\n" ++
    "#define vneg(a) vneg_at((a), __FILE__, __LINE__)\n" ++
    "#define vdiv(a, b) vdiv_at((a), (b), __FILE__, __LINE__)\n" ++
    "#define vmod(a, b) vmod_at((a), (b), __FILE__, __LINE__)\n" ++
    "\n" ++
    "// ---- strings (all functions borrow their arguments) ----\n" ++
    "\n" ++
    "static V vstr_new(const char *p, int64_t n) {\n" ++
    "    V s = vow_obj(VK_STR, 0, 0, 0, sizeof(VStr) + (size_t)n + 1);\n" ++
    "    VS(s)->len = n;\n" ++
    "    if (n) memcpy(VS(s)->data, p, (size_t)n);\n" ++
    "    VS(s)->data[n] = 0;\n" ++
    "    return s;\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vstr_len(V s) { return (V)VS(s)->len; }\n" ++
    "\n" ++
    "static V vstr_cat(V a, V b) {\n" ++
    "    int64_t n = VS(a)->len + VS(b)->len;\n" ++
    "    V s = vow_obj(VK_STR, 0, 0, 0, sizeof(VStr) + (size_t)n + 1);\n" ++
    "    VS(s)->len = n;\n" ++
    "    memcpy(VS(s)->data, VS(a)->data, (size_t)VS(a)->len);\n" ++
    "    memcpy(VS(s)->data + VS(a)->len, VS(b)->data, (size_t)VS(b)->len);\n" ++
    "    VS(s)->data[n] = 0;\n" ++
    "    return s;\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vstr_eq(V a, V b) {\n" ++
    "    return (V)(VS(a)->len == VS(b)->len && memcmp(VS(a)->data, VS(b)->data, (size_t)VS(a)->len) == 0);\n" ++
    "}\n" ++
    "\n" ++
    "static int vstr_cmp(V a, V b) {\n" ++
    "    int64_t n = VS(a)->len < VS(b)->len ? VS(a)->len : VS(b)->len;\n" ++
    "    int c = memcmp(VS(a)->data, VS(b)->data, (size_t)n);\n" ++
    "    if (c) return c;\n" ++
    "    return VS(a)->len < VS(b)->len ? -1 : (VS(a)->len > VS(b)->len ? 1 : 0);\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vstr_byte_at(V s, V i, VOW_AT) {\n" ++
    "    VOW_REQUIRE(VI(i) >= 0 && VI(i) < VS(s)->len, \"string index out of bounds\");\n" ++
    "    return (V)(unsigned char)VS(s)->data[VI(i)];\n" ++
    "}\n" ++
    "\n" ++
    "#define vstr_byte(s, i) vstr_byte_at((s), (i), __FILE__, __LINE__)\n" ++
    "\n" ++
    "static V vstr_slice_at(V s, V from, V to, VOW_AT) {\n" ++
    "    VOW_REQUIRE(0 <= VI(from) && VI(from) <= VI(to) && VI(to) <= VS(s)->len, \"string slice out of bounds\");\n" ++
    "    return vstr_new(VS(s)->data + VI(from), VI(to) - VI(from));\n" ++
    "}\n" ++
    "\n" ++
    "#define vstr_slice(s, from, to) vstr_slice_at((s), (from), (to), __FILE__, __LINE__)\n" ++
    "\n" ++
    "static V vchar_at(V code, VOW_AT) {\n" ++
    "    VOW_REQUIRE(VI(code) >= 0 && VI(code) < 256, \"char code out of range\");\n" ++
    "    char c = (char)VI(code);\n" ++
    "    return vstr_new(&c, 1);\n" ++
    "}\n" ++
    "\n" ++
    "#define vchar(code) vchar_at((code), __FILE__, __LINE__)\n" ++
    "\n" ++
    "static V vint_to_str(V n) {\n" ++
    "    char buf[32];\n" ++
    "    int k = snprintf(buf, sizeof buf, \"%lld\", (long long)VI(n));\n" ++
    "    return vstr_new(buf, k);\n" ++
    "}\n" ++
    "\n" ++
    "static V vhash(V s) {\n" ++
    "    uint64_t h = 14695981039346656037ull;\n" ++
    "    for (int64_t i = 0; i < VS(s)->len; i++) {\n" ++
    "        h ^= (unsigned char)VS(s)->data[i];\n" ++
    "        h *= 1099511628211ull;\n" ++
    "    }\n" ++
    "    char buf[17];\n" ++
    "    snprintf(buf, sizeof buf, \"%016llx\", (unsigned long long)h);\n" ++
    "    return vstr_new(buf, 16);\n" ++
    "}\n" ++
    "\n" ++
    "// ---- structs, enums and options ----\n" ++
    "\n" ++
    "static V vow_fields(int64_t words, uint64_t mask) {\n" ++
    "    size_t n = (size_t)(words > 0 ? words : 1) * sizeof(V);\n" ++
    "    V r = vow_obj(VK_FIELDS, 0, (uint16_t)words, mask, n);\n" ++
    "    memset(VP(r), 0, n);\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes base; returns an object the caller owns exclusively: base itself when it was\n" ++
    "// unshared, otherwise a copy. The caller then replaces fields (dropping the old ones).\n" ++
    "static V vow_with(V base) {\n" ++
    "    VHdr *h = VH(base);\n" ++
    "    if (h->rc == 1) return base;\n" ++
    "    V r = vow_fields(h->words, h->mask);\n" ++
    "    memcpy(VP(r), VP(base), (size_t)h->words * sizeof(V));\n" ++
    "    for (int i = 0; i < h->words; i++)\n" ++
    "        if (h->mask & ((uint64_t)1 << i)) vdup(VP(r)[i]);\n" ++
    "    vdrop(base);\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "// Takes field i out of base for an update that `with` will write back: when base is\n" ++
    "// unshared the field is moved out (its slot left empty), otherwise duplicated.\n" ++
    "static V vow_steal(V base, int64_t i) {\n" ++
    "    if (VH(base)->rc == 1) {\n" ++
    "        V x = VP(base)[i];\n" ++
    "        VP(base)[i] = 0;\n" ++
    "        return x;\n" ++
    "    }\n" ++
    "    return vdup(VP(base)[i]);\n" ++
    "}\n" ++
    "\n" ++
    "static V vow_variant0(int64_t tag) {\n" ++
    "    V r = vow_fields(1, 0);\n" ++
    "    VP(r)[0] = (V)tag;\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "static V vow_none_obj;\n" ++
    "\n" ++
    "static V vnone(void) {\n" ++
    "    if (!vow_none_obj) vow_none_obj = vow_immortal(vow_fields(1, 0));\n" ++
    "    return vow_none_obj;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes x.\n" ++
    "static V vsome(V x, int heap) {\n" ++
    "    V r = vow_fields(2, heap ? 2 : 0);\n" ++
    "    VP(r)[0] = 1;\n" ++
    "    VP(r)[1] = x;\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "// Borrows o, consumes d.\n" ++
    "static V vvalue_or(V o, V d, int heap) {\n" ++
    "    if (VP(o)[0] == 1) {\n" ++
    "        V r = VP(o)[1];\n" ++
    "        if (heap) {\n" ++
    "            vdup(r);\n" ++
    "            vdrop(d);\n" ++
    "        }\n" ++
    "        return r;\n" ++
    "    }\n" ++
    "    return d;\n" ++
    "}\n" ++
    "\n" ++
    "static V vstr_to_int(V s) {\n" ++
    "    int64_t n = VS(s)->len, i = 0, v = 0;\n" ++
    "    int neg = 0;\n" ++
    "    if (n == 0) return vnone();\n" ++
    "    if (VS(s)->data[0] == '-') {\n" ++
    "        neg = 1;\n" ++
    "        i = 1;\n" ++
    "        if (n == 1) return vnone();\n" ++
    "    }\n" ++
    "    for (; i < n; i++) {\n" ++
    "        char c = VS(s)->data[i];\n" ++
    "        if (c < '0' || c > '9') return vnone();\n" ++
    "        if (__builtin_mul_overflow(v, 10, &v)) return vnone();\n" ++
    "        if (__builtin_add_overflow(v, (int64_t)(neg ? -(c - '0') : (c - '0')), &v)) return vnone();\n" ++
    "    }\n" ++
    "    return vsome((V)v, 0);\n" ++
    "}\n" ++
    "\n" ++
    "// ---- lists ----\n" ++
    "\n" ++
    "static V vbuf_new(int64_t cap, int heap) {\n" ++
    "    if (cap < 4) cap = 4;\n" ++
    "    V b = vow_obj(VK_BUF, (uint8_t)heap, 0, 0, sizeof(VBuf) + (size_t)cap * sizeof(V));\n" ++
    "    VB(b)->cap = cap;\n" ++
    "    VB(b)->used = 0;\n" ++
    "    return b;\n" ++
    "}\n" ++
    "\n" ++
    "static V vlist_make(int64_t len, V buf, int heap) {\n" ++
    "    V l = vow_obj(VK_LIST, (uint8_t)heap, 0, 0, sizeof(VList));\n" ++
    "    VL(l)->len = len;\n" ++
    "    VL(l)->buf = buf;\n" ++
    "    return l;\n" ++
    "}\n" ++
    "\n" ++
    "static V vlist_empty(int heap) { return vlist_make(0, 0, heap); }\n" ++
    "\n" ++
    "static inline V vlist_len(V l) { return (V)VL(l)->len; }\n" ++
    "\n" ++
    "// Borrowed.\n" ++
    "static inline V vlist_get_at(V l, V i, VOW_AT) {\n" ++
    "    VOW_REQUIRE(VI(i) >= 0 && VI(i) < VL(l)->len, \"list index out of bounds\");\n" ++
    "    return VB(VL(l)->buf)->items[VI(i)];\n" ++
    "}\n" ++
    "\n" ++
    "#define vlist_get(l, i) vlist_get_at((l), (i), __FILE__, __LINE__)\n" ++
    "\n" ++
    "// Consumes l and x. Appends in place when the buffer has room just past this list's\n" ++
    "// end (no other list can see that slot); reuses the header when it is unshared.\n" ++
    "static V vlist_push(V l, V x) {\n" ++
    "    VList *L = VL(l);\n" ++
    "    int heap = VH(l)->flags;\n" ++
    "    V b = L->buf;\n" ++
    "    int64_t n = L->len;\n" ++
    "    if (b && VB(b)->used == n && n < VB(b)->cap) {\n" ++
    "        VB(b)->items[n] = x;\n" ++
    "        VB(b)->used = n + 1;\n" ++
    "        if (VH(l)->rc == 1) {\n" ++
    "            L->len = n + 1;\n" ++
    "            return l;\n" ++
    "        }\n" ++
    "        V r = vlist_make(n + 1, vdup(b), heap);\n" ++
    "        vdrop(l);\n" ++
    "        return r;\n" ++
    "    }\n" ++
    "    V nb = vbuf_new(n * 2, heap);\n" ++
    "    if (n) {\n" ++
    "        memcpy(VB(nb)->items, VB(b)->items, (size_t)n * sizeof(V));\n" ++
    "        if (VH(l)->rc == 1 && VH(b)->rc == 1) {\n" ++
    "            // Sole owner of both: move the elements; release any beyond this list's end.\n" ++
    "            if (heap)\n" ++
    "                for (int64_t i = n; i < VB(b)->used; i++) vdrop(VB(b)->items[i]);\n" ++
    "            VB(b)->used = 0;\n" ++
    "        } else if (heap) {\n" ++
    "            for (int64_t i = 0; i < n; i++) vdup(VB(b)->items[i]);\n" ++
    "        }\n" ++
    "    }\n" ++
    "    VB(nb)->items[n] = x;\n" ++
    "    VB(nb)->used = n + 1;\n" ++
    "    if (VH(l)->rc == 1) {\n" ++
    "        vdrop(L->buf);\n" ++
    "        L->buf = nb;\n" ++
    "        L->len = n + 1;\n" ++
    "        return l;\n" ++
    "    }\n" ++
    "    V r = vlist_make(n + 1, nb, heap);\n" ++
    "    vdrop(l);\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes l and x: element i replaced, in place when l and its buffer are unshared.\n" ++
    "static V vlist_set_at_at(V l, V i, V x, VOW_AT) {\n" ++
    "    VOW_REQUIRE(VI(i) >= 0 && VI(i) < VL(l)->len, \"set_at index out of bounds\");\n" ++
    "    VList *L = VL(l);\n" ++
    "    int heap = VH(l)->flags;\n" ++
    "    V b = L->buf;\n" ++
    "    if (VH(l)->rc == 1 && VH(b)->rc == 1) {\n" ++
    "        V old = VB(b)->items[VI(i)];\n" ++
    "        VB(b)->items[VI(i)] = x;\n" ++
    "        if (heap) vdrop(old);\n" ++
    "        return l;\n" ++
    "    }\n" ++
    "    int64_t n = L->len;\n" ++
    "    V nb = vbuf_new(n, heap);\n" ++
    "    memcpy(VB(nb)->items, VB(b)->items, (size_t)n * sizeof(V));\n" ++
    "    if (heap)\n" ++
    "        for (int64_t j = 0; j < n; j++)\n" ++
    "            if (j != VI(i)) vdup(VB(nb)->items[j]);\n" ++
    "    VB(nb)->items[VI(i)] = x;\n" ++
    "    VB(nb)->used = n;\n" ++
    "    V r = vlist_make(n, nb, heap);\n" ++
    "    vdrop(l);\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "#define vlist_set_at(l, i, x) vlist_set_at_at((l), (i), (x), __FILE__, __LINE__)\n" ++
    "\n" ++
    "// Borrows l.\n" ++
    "static V vlist_slice_at(V l, V from, V to, VOW_AT) {\n" ++
    "    VOW_REQUIRE(0 <= VI(from) && VI(from) <= VI(to) && VI(to) <= VL(l)->len, \"list slice out of bounds\");\n" ++
    "    int heap = VH(l)->flags;\n" ++
    "    int64_t n = VI(to) - VI(from);\n" ++
    "    V nb = vbuf_new(n, heap);\n" ++
    "    if (n) {\n" ++
    "        memcpy(VB(nb)->items, VB(VL(l)->buf)->items + VI(from), (size_t)n * sizeof(V));\n" ++
    "        if (heap)\n" ++
    "            for (int64_t j = 0; j < n; j++) vdup(VB(nb)->items[j]);\n" ++
    "    }\n" ++
    "    VB(nb)->used = n;\n" ++
    "    return vlist_make(n, nb, heap);\n" ++
    "}\n" ++
    "\n" ++
    "#define vlist_slice(l, from, to) vlist_slice_at((l), (from), (to), __FILE__, __LINE__)\n" ++
    "\n" ++
    "// Consumes a, borrows b.\n" ++
    "static V vlist_cat(V a, V b) {\n" ++
    "    int heap = VH(a)->flags;\n" ++
    "    for (int64_t i = 0; i < VL(b)->len; i++) {\n" ++
    "        V x = VB(VL(b)->buf)->items[i];\n" ++
    "        a = vlist_push(a, heap ? vdup(x) : x);\n" ++
    "    }\n" ++
    "    return a;\n" ++
    "}\n" ++
    "\n" ++
    "// Borrows both.\n" ++
    "static V vjoin(V parts, V sep) {\n" ++
    "    int64_t n = 0, k = VL(parts)->len;\n" ++
    "    for (int64_t i = 0; i < k; i++) n += VS(VB(VL(parts)->buf)->items[i])->len;\n" ++
    "    if (k > 1) n += (k - 1) * VS(sep)->len;\n" ++
    "    V s = vow_obj(VK_STR, 0, 0, 0, sizeof(VStr) + (size_t)n + 1);\n" ++
    "    VS(s)->len = n;\n" ++
    "    char *p = VS(s)->data;\n" ++
    "    for (int64_t i = 0; i < k; i++) {\n" ++
    "        if (i) {\n" ++
    "            memcpy(p, VS(sep)->data, (size_t)VS(sep)->len);\n" ++
    "            p += VS(sep)->len;\n" ++
    "        }\n" ++
    "        V x = VB(VL(parts)->buf)->items[i];\n" ++
    "        memcpy(p, VS(x)->data, (size_t)VS(x)->len);\n" ++
    "        p += VS(x)->len;\n" ++
    "    }\n" ++
    "    *p = 0;\n" ++
    "    return s;\n" ++
    "}\n" ++
    "\n" ++
    "// ---- maps ----\n" ++
    "\n" ++
    "static inline int64_t vn_h(V n) { return n ? VN(n)->height : 0; }\n" ++
    "static inline int64_t vn_s(V n) { return n ? VN(n)->size : 0; }\n" ++
    "\n" ++
    "static int vkey_cmp(V a, V b, int flags) {\n" ++
    "    if (flags & VN_STR_KEYS) return vstr_cmp(a, b);\n" ++
    "    return VI(a) < VI(b) ? -1 : (VI(a) > VI(b) ? 1 : 0);\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes all four parts.\n" ++
    "static V vn_make(V k, V v, V l, V r, int flags) {\n" ++
    "    V n = vow_obj(VK_NODE, (uint8_t)flags, 0, 0, sizeof(VNode));\n" ++
    "    VN(n)->key = k;\n" ++
    "    VN(n)->val = v;\n" ++
    "    VN(n)->left = l;\n" ++
    "    VN(n)->right = r;\n" ++
    "    int64_t hl = vn_h(l), hr = vn_h(r);\n" ++
    "    VN(n)->height = (hl > hr ? hl : hr) + 1;\n" ++
    "    VN(n)->size = vn_s(l) + vn_s(r) + 1;\n" ++
    "    return n;\n" ++
    "}\n" ++
    "\n" ++
    "static void vn_fix(V n) {\n" ++
    "    VNode *x = VN(n);\n" ++
    "    int64_t hl = vn_h(x->left), hr = vn_h(x->right);\n" ++
    "    x->height = (hl > hr ? hl : hr) + 1;\n" ++
    "    x->size = vn_s(x->left) + vn_s(x->right) + 1;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes n; returns a node with the same contents that the caller owns exclusively:\n" ++
    "// n itself when unshared, otherwise a copy (so updates copy only the path they touch).\n" ++
    "static V vn_unshare(V n) {\n" ++
    "    if (VH(n)->rc == 1) return n;\n" ++
    "    int f = VH(n)->flags;\n" ++
    "    VNode *x = VN(n);\n" ++
    "    V m = vn_make((f & VN_KEY_HEAP) ? vdup(x->key) : x->key, (f & VN_VAL_HEAP) ? vdup(x->val) : x->val,\n" ++
    "                  vdup(x->left), vdup(x->right), f);\n" ++
    "    vdrop(n);\n" ++
    "    return m;\n" ++
    "}\n" ++
    "\n" ++
    "// Rotations relink nodes in place; n must be exclusively owned.\n" ++
    "static V vn_rot_right(V n) {\n" ++
    "    V l = vn_unshare(VN(n)->left);\n" ++
    "    VN(n)->left = VN(l)->right;\n" ++
    "    vn_fix(n);\n" ++
    "    VN(l)->right = n;\n" ++
    "    vn_fix(l);\n" ++
    "    return l;\n" ++
    "}\n" ++
    "\n" ++
    "static V vn_rot_left(V n) {\n" ++
    "    V r = vn_unshare(VN(n)->right);\n" ++
    "    VN(n)->right = VN(r)->left;\n" ++
    "    vn_fix(n);\n" ++
    "    VN(r)->left = n;\n" ++
    "    vn_fix(r);\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "static V vn_rebalance(V n) {\n" ++
    "    VNode *x = VN(n);\n" ++
    "    int64_t hl = vn_h(x->left), hr = vn_h(x->right);\n" ++
    "    if (hl > hr + 1) {\n" ++
    "        if (vn_h(VN(x->left)->left) < vn_h(VN(x->left)->right)) x->left = vn_rot_left(vn_unshare(x->left));\n" ++
    "        return vn_rot_right(n);\n" ++
    "    }\n" ++
    "    if (hr > hl + 1) {\n" ++
    "        if (vn_h(VN(x->right)->right) < vn_h(VN(x->right)->left)) x->right = vn_rot_right(vn_unshare(x->right));\n" ++
    "        return vn_rot_left(n);\n" ++
    "    }\n" ++
    "    vn_fix(n);\n" ++
    "    return n;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes n, k and v. Unshared nodes on the path are updated in place; shared ones\n" ++
    "// are copied first.\n" ++
    "static V vn_insert(V n, V k, V v, int flags) {\n" ++
    "    if (!n) return vn_make(k, v, 0, 0, flags);\n" ++
    "    int c = vkey_cmp(k, VN(n)->key, flags);\n" ++
    "    n = vn_unshare(n);\n" ++
    "    VNode *x = VN(n);\n" ++
    "    if (c == 0) {\n" ++
    "        if (flags & VN_KEY_HEAP) vdrop(x->key);\n" ++
    "        if (flags & VN_VAL_HEAP) vdrop(x->val);\n" ++
    "        x->key = k;\n" ++
    "        x->val = v;\n" ++
    "        return n;\n" ++
    "    }\n" ++
    "    if (c < 0)\n" ++
    "        x->left = vn_insert(x->left, k, v, flags);\n" ++
    "    else\n" ++
    "        x->right = vn_insert(x->right, k, v, flags);\n" ++
    "    return vn_rebalance(n);\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_empty(void) { return 0; }\n" ++
    "static inline V vmap_len(V m) { return (V)vn_s(m); }\n" ++
    "\n" ++
    "static V vmap_insert(V m, V k, V v, int flags) { return vn_insert(m, k, v, flags); }\n" ++
    "\n" ++
    "static V vn_find(V m, V k, int flags) {\n" ++
    "    V n = m;\n" ++
    "    while (n) {\n" ++
    "        int c = vkey_cmp(k, VN(n)->key, flags);\n" ++
    "        if (c == 0) return n;\n" ++
    "        n = c < 0 ? VN(n)->left : VN(n)->right;\n" ++
    "    }\n" ++
    "    return 0;\n" ++
    "}\n" ++
    "\n" ++
    "// Borrows m and k; the result owns a reference to the value.\n" ++
    "static V vmap_lookup(V m, V k, int flags) {\n" ++
    "    V n = vn_find(m, k, flags);\n" ++
    "    if (!n) return vnone();\n" ++
    "    V v = VN(n)->val;\n" ++
    "    if (flags & VN_VAL_HEAP) vdup(v);\n" ++
    "    return vsome(v, flags & VN_VAL_HEAP);\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_has(V m, V k, int flags) { return (V)(vn_find(m, k, flags) != 0); }\n" ++
    "\n" ++
    "static V vn_keys(V n, V acc, int flags) {\n" ++
    "    if (!n) return acc;\n" ++
    "    acc = vn_keys(VN(n)->left, acc, flags);\n" ++
    "    V k = VN(n)->key;\n" ++
    "    acc = vlist_push(acc, (flags & VN_KEY_HEAP) ? vdup(k) : k);\n" ++
    "    return vn_keys(VN(n)->right, acc, flags);\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_keys(V m, int flags) { return vn_keys(m, vlist_empty(flags & VN_KEY_HEAP), flags); }\n" ++
    "\n" ++
    "// ---- hash maps ----\n" ++
    "\n" ++
    "static int vow_name_cmp(const void *a, const void *b);\n" ++
    "\n" ++
    "static uint64_t vhm_hash(V k, int flags) {\n" ++
    "    uint64_t h;\n" ++
    "    if (flags & VN_STR_KEYS) {\n" ++
    "        h = 14695981039346656037ull;\n" ++
    "        for (int64_t i = 0; i < VS(k)->len; i++) {\n" ++
    "            h ^= (unsigned char)VS(k)->data[i];\n" ++
    "            h *= 1099511628211ull;\n" ++
    "        }\n" ++
    "    } else {\n" ++
    "        h = k;\n" ++
    "        h ^= h >> 30;\n" ++
    "        h *= 0xbf58476d1ce4e5b9ull;\n" ++
    "        h ^= h >> 27;\n" ++
    "        h *= 0x94d049bb133111ebull;\n" ++
    "        h ^= h >> 31;\n" ++
    "    }\n" ++
    "    return h ? h : 1;\n" ++
    "}\n" ++
    "\n" ++
    "static inline int vhm_eq(V a, V b, int flags) { return (flags & VN_STR_KEYS) ? (int)vstr_eq(a, b) : a == b; }\n" ++
    "\n" ++
    "static V vhm_new(int64_t cap, int flags) {\n" ++
    "    V h = vow_obj(VK_HASH, (uint8_t)flags, 0, 0, sizeof(VHash) + (size_t)cap * 3 * sizeof(V));\n" ++
    "    VHM(h)->count = 0;\n" ++
    "    VHM(h)->cap = cap;\n" ++
    "    memset(vhm_hashes(h), 0, (size_t)cap * sizeof(uint64_t));\n" ++
    "    return h;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes k and v; h must be exclusively owned and have a free slot.\n" ++
    "static void vhm_place(V h, uint64_t hh, V k, V v, int flags) {\n" ++
    "    int64_t cap = VHM(h)->cap, i = (int64_t)(hh & (uint64_t)(cap - 1));\n" ++
    "    uint64_t *hs = vhm_hashes(h);\n" ++
    "    V *ks = vhm_keyarr(h), *vs = vhm_valarr(h);\n" ++
    "    while (hs[i]) {\n" ++
    "        if (hs[i] == hh && vhm_eq(ks[i], k, flags)) {\n" ++
    "            if (flags & VN_KEY_HEAP) vdrop(k);\n" ++
    "            if (flags & VN_VAL_HEAP) vdrop(vs[i]);\n" ++
    "            vs[i] = v;\n" ++
    "            return;\n" ++
    "        }\n" ++
    "        i = (i + 1) & (cap - 1);\n" ++
    "    }\n" ++
    "    hs[i] = hh;\n" ++
    "    ks[i] = k;\n" ++
    "    vs[i] = v;\n" ++
    "    VHM(h)->count++;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes h (exclusively owned): moves its entries into a table of capacity cap.\n" ++
    "static V vhm_grow(V h, int64_t cap, int flags) {\n" ++
    "    V n = vhm_new(cap, flags);\n" ++
    "    for (int64_t i = 0; i < VHM(h)->cap; i++)\n" ++
    "        if (vhm_hashes(h)[i]) vhm_place(n, vhm_hashes(h)[i], vhm_keyarr(h)[i], vhm_valarr(h)[i], flags);\n" ++
    "    vow_free_shell(h);\n" ++
    "    return n;\n" ++
    "}\n" ++
    "\n" ++
    "// Consumes h, k and v. An unshared table is updated in place; a shared one is copied\n" ++
    "// first (so value semantics hold).\n" ++
    "static V vhm_insert(V h, V k, V v, int flags) {\n" ++
    "    uint64_t hh = vhm_hash(k, flags);\n" ++
    "    if (!h) {\n" ++
    "        h = vhm_new(8, flags);\n" ++
    "    } else if (VH(h)->rc != 1) {\n" ++
    "        int64_t cap = VHM(h)->cap;\n" ++
    "        V c = vhm_new(cap, flags);\n" ++
    "        memcpy(vhm_hashes(c), vhm_hashes(h), (size_t)cap * 3 * sizeof(V));\n" ++
    "        VHM(c)->count = VHM(h)->count;\n" ++
    "        for (int64_t i = 0; i < cap; i++) {\n" ++
    "            if (!vhm_hashes(c)[i]) continue;\n" ++
    "            if (flags & VN_KEY_HEAP) vdup(vhm_keyarr(c)[i]);\n" ++
    "            if (flags & VN_VAL_HEAP) vdup(vhm_valarr(c)[i]);\n" ++
    "        }\n" ++
    "        vdrop(h);\n" ++
    "        h = c;\n" ++
    "    }\n" ++
    "    if ((VHM(h)->count + 1) * 4 > VHM(h)->cap * 3) h = vhm_grow(h, VHM(h)->cap * 2, flags);\n" ++
    "    vhm_place(h, hh, k, v, flags);\n" ++
    "    return h;\n" ++
    "}\n" ++
    "\n" ++
    "static int64_t vhm_find(V h, V k, int flags) {\n" ++
    "    if (!h) return -1;\n" ++
    "    uint64_t hh = vhm_hash(k, flags);\n" ++
    "    int64_t cap = VHM(h)->cap, i = (int64_t)(hh & (uint64_t)(cap - 1));\n" ++
    "    while (vhm_hashes(h)[i]) {\n" ++
    "        if (vhm_hashes(h)[i] == hh && vhm_eq(vhm_keyarr(h)[i], k, flags)) return i;\n" ++
    "        i = (i + 1) & (cap - 1);\n" ++
    "    }\n" ++
    "    return -1;\n" ++
    "}\n" ++
    "\n" ++
    "// Borrows h and k; the result owns a reference to the value.\n" ++
    "static V vhm_lookup(V h, V k, int flags) {\n" ++
    "    int64_t i = vhm_find(h, k, flags);\n" ++
    "    if (i < 0) return vnone();\n" ++
    "    V v = vhm_valarr(h)[i];\n" ++
    "    if (flags & VN_VAL_HEAP) vdup(v);\n" ++
    "    return vsome(v, flags & VN_VAL_HEAP);\n" ++
    "}\n" ++
    "\n" ++
    "static V vhm_has(V h, V k, int flags) { return (V)(vhm_find(h, k, flags) >= 0); }\n" ++
    "static inline V vhm_len(V h) { return h ? (V)VHM(h)->count : 0; }\n" ++
    "\n" ++
    "static int vow_int_cmp(const void *a, const void *b) {\n" ++
    "    int64_t x = VI(*(const V *)a), y = VI(*(const V *)b);\n" ++
    "    return x < y ? -1 : (x > y ? 1 : 0);\n" ++
    "}\n" ++
    "\n" ++
    "// The keys in ascending order, so programs stay deterministic.\n" ++
    "static V vhm_keys(V h, int flags) {\n" ++
    "    V l = vlist_empty(flags & VN_KEY_HEAP);\n" ++
    "    if (!h) return l;\n" ++
    "    int64_t n = 0;\n" ++
    "    V *ks = (V *)malloc(sizeof(V) * (size_t)(VHM(h)->count + 1));\n" ++
    "    for (int64_t i = 0; i < VHM(h)->cap; i++)\n" ++
    "        if (vhm_hashes(h)[i]) ks[n++] = vhm_keyarr(h)[i];\n" ++
    "    qsort(ks, (size_t)n, sizeof(V), (flags & VN_STR_KEYS) ? vow_name_cmp : vow_int_cmp);\n" ++
    "    for (int64_t i = 0; i < n; i++) l = vlist_push(l, (flags & VN_KEY_HEAP) ? vdup(ks[i]) : ks[i]);\n" ++
    "    free(ks);\n" ++
    "    return l;\n" ++
    "}\n" ++
    "\n" ++
    "// ---- effects (all borrow their arguments) ----\n" ++
    "\n" ++
    "static int vow_argc;\n" ++
    "static char **vow_argv;\n" ++
    "\n" ++
    "static V vprint(V s) {\n" ++
    "    fwrite(VS(s)->data, 1, (size_t)VS(s)->len, stdout);\n" ++
    "    return 0;\n" ++
    "}\n" ++
    "\n" ++
    "static V veprint(V s) {\n" ++
    "    fflush(stdout);\n" ++
    "    fwrite(VS(s)->data, 1, (size_t)VS(s)->len, stderr);\n" ++
    "    return 0;\n" ++
    "}\n" ++
    "\n" ++
    "static V vread_file(V path) {\n" ++
    "    FILE *f = fopen(VS(path)->data, \"rb\");\n" ++
    "    if (!f) return vnone();\n" ++
    "    fseek(f, 0, SEEK_END);\n" ++
    "    long n = ftell(f);\n" ++
    "    fseek(f, 0, SEEK_SET);\n" ++
    "    V s = vow_obj(VK_STR, 0, 0, 0, sizeof(VStr) + (size_t)n + 1);\n" ++
    "    VS(s)->len = (int64_t)fread(VS(s)->data, 1, (size_t)n, f);\n" ++
    "    VS(s)->data[VS(s)->len] = 0;\n" ++
    "    fclose(f);\n" ++
    "    return vsome(s, 1);\n" ++
    "}\n" ++
    "\n" ++
    "static V vwrite_file(V path, V contents) {\n" ++
    "    FILE *f = fopen(VS(path)->data, \"wb\");\n" ++
    "    if (!f) return 0;\n" ++
    "    size_t w = fwrite(VS(contents)->data, 1, (size_t)VS(contents)->len, f);\n" ++
    "    int ok = fclose(f) == 0 && w == (size_t)VS(contents)->len;\n" ++
    "    return (V)ok;\n" ++
    "}\n" ++
    "\n" ++
    "// make_dir(path): create the directory and any missing parents, like `mkdir -p`.\n" ++
    "static V vmake_dir(V path) {\n" ++
    "    int64_t n = VS(path)->len;\n" ++
    "    if (n == 0) return 0;\n" ++
    "    char *p = (char *)malloc((size_t)n + 1);\n" ++
    "    memcpy(p, VS(path)->data, (size_t)n + 1);\n" ++
    "    for (int64_t i = 1; i < n; i++) {\n" ++
    "        if (p[i] == '/') {\n" ++
    "            p[i] = 0;\n" ++
    "            mkdir(p, 0777);\n" ++
    "            p[i] = '/';\n" ++
    "        }\n" ++
    "    }\n" ++
    "    mkdir(p, 0777);\n" ++
    "    struct stat st;\n" ++
    "    int ok = stat(p, &st) == 0 && S_ISDIR(st.st_mode);\n" ++
    "    free(p);\n" ++
    "    return (V)ok;\n" ++
    "}\n" ++
    "\n" ++
    "static int vow_name_cmp(const void *a, const void *b) { return vstr_cmp(*(const V *)a, *(const V *)b); }\n" ++
    "\n" ++
    "// list_dir(path): the names in a directory, sorted, without \".\" and \"..\".\n" ++
    "static V vlist_dir(V path) {\n" ++
    "    DIR *d = opendir(VS(path)->data);\n" ++
    "    if (!d) return vnone();\n" ++
    "    int64_t cap = 16, n = 0;\n" ++
    "    V *names = (V *)malloc(sizeof(V) * (size_t)cap);\n" ++
    "    struct dirent *e;\n" ++
    "    while ((e = readdir(d)) != 0) {\n" ++
    "        if (strcmp(e->d_name, \".\") == 0 || strcmp(e->d_name, \"..\") == 0) continue;\n" ++
    "        if (n == cap) names = (V *)realloc(names, sizeof(V) * (size_t)(cap *= 2));\n" ++
    "        names[n++] = vstr_new(e->d_name, (int64_t)strlen(e->d_name));\n" ++
    "    }\n" ++
    "    closedir(d);\n" ++
    "    qsort(names, (size_t)n, sizeof(V), vow_name_cmp);\n" ++
    "    V l = vlist_empty(1);\n" ++
    "    for (int64_t i = 0; i < n; i++) l = vlist_push(l, names[i]);\n" ++
    "    free(names);\n" ++
    "    return vsome(l, 1);\n" ++
    "}\n" ++
    "\n" ++
    "static V vargs(void) {\n" ++
    "    V l = vlist_empty(1);\n" ++
    "    for (int i = 1; i < vow_argc; i++) l = vlist_push(l, vstr_new(vow_argv[i], (int64_t)strlen(vow_argv[i])));\n" ++
    "    return l;\n" ++
    "}\n" ++
    "\n" ++
    "// Standard input. Both flush stdout first, so a prompt or a response is out before the\n" ++
    "// program waits.\n" ++
    "static V vread_line(void) {\n" ++
    "    fflush(stdout);\n" ++
    "    size_t cap = 0;\n" ++
    "    char *buf = NULL;\n" ++
    "    ssize_t n = getline(&buf, &cap, stdin);\n" ++
    "    if (n < 0) {\n" ++
    "        free(buf);\n" ++
    "        return vnone();\n" ++
    "    }\n" ++
    "    if (n > 0 && buf[n - 1] == '\\n') n--;\n" ++
    "    V s = vstr_new(buf, (int64_t)n);\n" ++
    "    free(buf);\n" ++
    "    return vsome(s, 1);\n" ++
    "}\n" ++
    "\n" ++
    "// Up to n bytes (fewer at the end of input). The string is allocated at the length read,\n" ++
    "// since an object's size class is computed from its length when it is freed.\n" ++
    "static V vread_bytes(V n) {\n" ++
    "    fflush(stdout);\n" ++
    "    size_t want = VI(n) > 0 ? (size_t)VI(n) : 0;\n" ++
    "    char *buf = malloc(want > 0 ? want : 1);\n" ++
    "    if (!buf) vow_panic(\"out of memory\");\n" ++
    "    size_t got = fread(buf, 1, want, stdin);\n" ++
    "    V s = vstr_new(buf, (int64_t)got);\n" ++
    "    free(buf);\n" ++
    "    return s;\n" ++
    "}\n" ++
    "\n" ++
    "static V vgetenv(V name) {\n" ++
    "    const char *v = getenv(VS(name)->data);\n" ++
    "    if (!v) return vnone();\n" ++
    "    return vsome(vstr_new(v, (int64_t)strlen(v)), 1);\n" ++
    "}\n" ++
    "\n" ++
    "static __attribute__((noreturn)) void vexit(V code) {\n" ++
    "    fflush(stdout);\n" ++
    "    exit((int)VI(code));\n" ++
    "}\n" ++
    "\n" ++
    "// run(argv, input): stdin comes from a temporary file so that large inputs and outputs\n" ++
    "// cannot deadlock on full pipes; stdout is captured, stderr is inherited.\n" ++
    "static V vrun(V argv, V input) {\n" ++
    "    int64_t n = VL(argv)->len;\n" ++
    "    V out = vow_fields(2, 2);\n" ++
    "    VP(out)[0] = (V)(int64_t)-1;\n" ++
    "    char tmpl[] = \"/tmp/vow-run-XXXXXX\";\n" ++
    "    int in_fd = n == 0 ? -1 : mkstemp(tmpl);\n" ++
    "    if (in_fd < 0) {\n" ++
    "        VP(out)[1] = vstr_new(\"\", 0);\n" ++
    "        return out;\n" ++
    "    }\n" ++
    "    unlink(tmpl);\n" ++
    "    int pfd[2];\n" ++
    "    if (write(in_fd, VS(input)->data, (size_t)VS(input)->len) != (ssize_t)VS(input)->len || pipe(pfd) != 0) {\n" ++
    "        close(in_fd);\n" ++
    "        VP(out)[1] = vstr_new(\"\", 0);\n" ++
    "        return out;\n" ++
    "    }\n" ++
    "    lseek(in_fd, 0, SEEK_SET);\n" ++
    "    fflush(stdout);\n" ++
    "    pid_t pid = fork();\n" ++
    "    if (pid == 0) {\n" ++
    "        dup2(in_fd, 0);\n" ++
    "        dup2(pfd[1], 1);\n" ++
    "        close(pfd[0]);\n" ++
    "        close(pfd[1]);\n" ++
    "        close(in_fd);\n" ++
    "        char **av = (char **)malloc(sizeof(char *) * (size_t)(n + 1));\n" ++
    "        for (int64_t i = 0; i < n; i++) av[i] = VS(VB(VL(argv)->buf)->items[i])->data;\n" ++
    "        av[n] = 0;\n" ++
    "        execvp(av[0], av);\n" ++
    "        _exit(127);\n" ++
    "    }\n" ++
    "    close(pfd[1]);\n" ++
    "    close(in_fd);\n" ++
    "    size_t cap = 4096, len = 0;\n" ++
    "    char *buf = (char *)malloc(cap);\n" ++
    "    for (;;) {\n" ++
    "        if (len == cap) buf = (char *)realloc(buf, cap *= 2);\n" ++
    "        ssize_t k = read(pfd[0], buf + len, cap - len);\n" ++
    "        if (k <= 0) break;\n" ++
    "        len += (size_t)k;\n" ++
    "    }\n" ++
    "    close(pfd[0]);\n" ++
    "    int status = 0;\n" ++
    "    waitpid(pid, &status, 0);\n" ++
    "    VP(out)[0] = (V)(int64_t)(WIFEXITED(status) ? WEXITSTATUS(status) : -1);\n" ++
    "    VP(out)[1] = vstr_new(buf, (int64_t)len);\n" ++
    "    free(buf);\n" ++
    "    return out;\n" ++
    "}\n" ++
    "\n" ++
    "#endif\n" ++
    ""
end fn runtime_header
