// Generated by tools/embed.vow from runtime/vow_rt.h. Do not edit.

fn runtime_header() -> String do
  return "// Vow runtime. Every Vow value is one 64-bit word (V). Integers and booleans are\n" ++
    "// unboxed; everything else is a pointer to an immutable heap object. Memory comes\n" ++
    "// from a bump allocator and is never freed.\n" ++
    "//\n" ++
    "// Define VOW_VERIFIED before including this header when every proof obligation was\n" ++
    "// discharged; bounds and divisor checks then compile to nothing. Overflow checks always\n" ++
    "// stay, because the verifier models Int as mathematical integers and relies on\n" ++
    "// overflow trapping.\n" ++
    "#ifndef VOW_RT_H\n" ++
    "#define VOW_RT_H\n" ++
    "\n" ++
    "#ifndef _GNU_SOURCE\n" ++
    "#define _GNU_SOURCE\n" ++
    "#endif\n" ++
    "#include <fcntl.h>\n" ++
    "#include <stdint.h>\n" ++
    "#include <stdio.h>\n" ++
    "#include <stdlib.h>\n" ++
    "#include <string.h>\n" ++
    "#include <sys/wait.h>\n" ++
    "#include <unistd.h>\n" ++
    "\n" ++
    "typedef uint64_t V;\n" ++
    "\n" ++
    "#define VI(x) ((int64_t)(x))\n" ++
    "#define VP(x) ((V *)(uintptr_t)(x))\n" ++
    "\n" ++
    "static __attribute__((noreturn)) void vow_panic(const char *msg) {\n" ++
    "    fflush(stdout);\n" ++
    "    fprintf(stderr, \"vow: panic: %s\\n\", msg);\n" ++
    "    exit(101);\n" ++
    "}\n" ++
    "\n" ++
    "#ifdef VOW_VERIFIED\n" ++
    "#define VOW_REQUIRE(cond, msg) ((void)0)\n" ++
    "#else\n" ++
    "#define VOW_REQUIRE(cond, msg) \\\n" ++
    "    do {                       \\\n" ++
    "        if (!(cond)) vow_panic(msg); \\\n" ++
    "    } while (0)\n" ++
    "#endif\n" ++
    "\n" ++
    "// ---- allocation ----\n" ++
    "\n" ++
    "static char *vow_heap_ptr = 0;\n" ++
    "static size_t vow_heap_left = 0;\n" ++
    "\n" ++
    "static void *vow_alloc(size_t n) {\n" ++
    "    n = (n + 15) & ~(size_t)15;\n" ++
    "    if (n > vow_heap_left) {\n" ++
    "        size_t chunk = n > (64u << 20) ? n : (64u << 20);\n" ++
    "        vow_heap_ptr = (char *)malloc(chunk);\n" ++
    "        if (!vow_heap_ptr) vow_panic(\"out of memory\");\n" ++
    "        vow_heap_left = chunk;\n" ++
    "    }\n" ++
    "    void *p = vow_heap_ptr;\n" ++
    "    vow_heap_ptr += n;\n" ++
    "    vow_heap_left -= n;\n" ++
    "    return p;\n" ++
    "}\n" ++
    "\n" ++
    "static V vow_new(int64_t words) {\n" ++
    "    return (V)(uintptr_t)vow_alloc((size_t)(words > 0 ? words : 1) * sizeof(V));\n" ++
    "}\n" ++
    "\n" ++
    "static V vow_copy(V obj, int64_t words) {\n" ++
    "    V r = vow_new(words);\n" ++
    "    memcpy(VP(r), VP(obj), (size_t)words * sizeof(V));\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "// ---- integers ----\n" ++
    "\n" ++
    "static inline V vadd(V a, V b) {\n" ++
    "    int64_t r;\n" ++
    "    if (__builtin_add_overflow(VI(a), VI(b), &r)) vow_panic(\"integer overflow in '+'\");\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "static inline V vsub(V a, V b) {\n" ++
    "    int64_t r;\n" ++
    "    if (__builtin_sub_overflow(VI(a), VI(b), &r)) vow_panic(\"integer overflow in '-'\");\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "static inline V vmul(V a, V b) {\n" ++
    "    int64_t r;\n" ++
    "    if (__builtin_mul_overflow(VI(a), VI(b), &r)) vow_panic(\"integer overflow in '*'\");\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "static inline V vneg(V a) {\n" ++
    "    if (VI(a) == INT64_MIN) vow_panic(\"integer overflow in unary '-'\");\n" ++
    "    return (V)(-VI(a));\n" ++
    "}\n" ++
    "// Euclidean division: the remainder is always non-negative (matches SMT-LIB).\n" ++
    "static inline V vdiv(V a, V b) {\n" ++
    "    VOW_REQUIRE(VI(b) != 0, \"division by zero\");\n" ++
    "    if (VI(a) == INT64_MIN && VI(b) == -1) vow_panic(\"integer overflow in '/'\");\n" ++
    "    int64_t q = VI(a) / VI(b), r = VI(a) % VI(b);\n" ++
    "    if (r < 0) q = VI(b) > 0 ? q - 1 : q + 1;\n" ++
    "    return (V)q;\n" ++
    "}\n" ++
    "static inline V vmod(V a, V b) {\n" ++
    "    VOW_REQUIRE(VI(b) != 0, \"division by zero\");\n" ++
    "    if (VI(b) == -1) return 0;\n" ++
    "    int64_t r = VI(a) % VI(b);\n" ++
    "    if (r < 0) r = VI(b) > 0 ? r + VI(b) : r - VI(b);\n" ++
    "    return (V)r;\n" ++
    "}\n" ++
    "\n" ++
    "// ---- strings ----\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t len;\n" ++
    "    char data[];\n" ++
    "} VStr;\n" ++
    "\n" ++
    "#define VS(x) ((VStr *)(uintptr_t)(x))\n" ++
    "\n" ++
    "static V vstr_new(const char *p, int64_t n) {\n" ++
    "    VStr *s = (VStr *)vow_alloc(sizeof(VStr) + (size_t)n + 1);\n" ++
    "    s->len = n;\n" ++
    "    if (n) memcpy(s->data, p, (size_t)n);\n" ++
    "    s->data[n] = 0;\n" ++
    "    return (V)(uintptr_t)s;\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vstr_len(V s) { return (V)VS(s)->len; }\n" ++
    "\n" ++
    "static V vstr_cat(V a, V b) {\n" ++
    "    int64_t n = VS(a)->len + VS(b)->len;\n" ++
    "    VStr *s = (VStr *)vow_alloc(sizeof(VStr) + (size_t)n + 1);\n" ++
    "    s->len = n;\n" ++
    "    memcpy(s->data, VS(a)->data, (size_t)VS(a)->len);\n" ++
    "    memcpy(s->data + VS(a)->len, VS(b)->data, (size_t)VS(b)->len);\n" ++
    "    s->data[n] = 0;\n" ++
    "    return (V)(uintptr_t)s;\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vstr_eq(V a, V b) {\n" ++
    "    return (V)(VS(a)->len == VS(b)->len && memcmp(VS(a)->data, VS(b)->data, (size_t)VS(a)->len) == 0);\n" ++
    "}\n" ++
    "\n" ++
    "static int vstr_cmp(V a, V b) {\n" ++
    "    int64_t n = VS(a)->len < VS(b)->len ? VS(a)->len : VS(b)->len;\n" ++
    "    int c = memcmp(VS(a)->data, VS(b)->data, (size_t)n);\n" ++
    "    if (c) return c;\n" ++
    "    return VS(a)->len < VS(b)->len ? -1 : (VS(a)->len > VS(b)->len ? 1 : 0);\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vstr_byte(V s, V i) {\n" ++
    "    VOW_REQUIRE(VI(i) >= 0 && VI(i) < VS(s)->len, \"string index out of bounds\");\n" ++
    "    return (V)(unsigned char)VS(s)->data[VI(i)];\n" ++
    "}\n" ++
    "\n" ++
    "static V vstr_slice(V s, V from, V to) {\n" ++
    "    VOW_REQUIRE(0 <= VI(from) && VI(from) <= VI(to) && VI(to) <= VS(s)->len, \"string slice out of bounds\");\n" ++
    "    return vstr_new(VS(s)->data + VI(from), VI(to) - VI(from));\n" ++
    "}\n" ++
    "\n" ++
    "static V vchar(V code) {\n" ++
    "    VOW_REQUIRE(VI(code) >= 0 && VI(code) < 256, \"char code out of range\");\n" ++
    "    char c = (char)VI(code);\n" ++
    "    return vstr_new(&c, 1);\n" ++
    "}\n" ++
    "\n" ++
    "static V vint_to_str(V n) {\n" ++
    "    char buf[32];\n" ++
    "    int k = snprintf(buf, sizeof buf, \"%lld\", (long long)VI(n));\n" ++
    "    return vstr_new(buf, k);\n" ++
    "}\n" ++
    "\n" ++
    "static V vhash(V s) {\n" ++
    "    uint64_t h = 14695981039346656037ull;\n" ++
    "    for (int64_t i = 0; i < VS(s)->len; i++) {\n" ++
    "        h ^= (unsigned char)VS(s)->data[i];\n" ++
    "        h *= 1099511628211ull;\n" ++
    "    }\n" ++
    "    char buf[17];\n" ++
    "    snprintf(buf, sizeof buf, \"%016llx\", (unsigned long long)h);\n" ++
    "    return vstr_new(buf, 16);\n" ++
    "}\n" ++
    "\n" ++
    "// ---- enums and options ----\n" ++
    "\n" ++
    "static V vow_variant0(int64_t tag) {\n" ++
    "    V r = vow_new(1);\n" ++
    "    VP(r)[0] = (V)tag;\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "static V vsome(V x) {\n" ++
    "    V r = vow_new(2);\n" ++
    "    VP(r)[0] = 1;\n" ++
    "    VP(r)[1] = x;\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "static V vnone(void) { return vow_variant0(0); }\n" ++
    "\n" ++
    "static V vstr_to_int(V s) {\n" ++
    "    int64_t n = VS(s)->len, i = 0, v = 0;\n" ++
    "    int neg = 0;\n" ++
    "    if (n == 0) return vnone();\n" ++
    "    if (VS(s)->data[0] == '-') {\n" ++
    "        neg = 1;\n" ++
    "        i = 1;\n" ++
    "        if (n == 1) return vnone();\n" ++
    "    }\n" ++
    "    for (; i < n; i++) {\n" ++
    "        char c = VS(s)->data[i];\n" ++
    "        if (c < '0' || c > '9') return vnone();\n" ++
    "        if (__builtin_mul_overflow(v, 10, &v)) return vnone();\n" ++
    "        if (__builtin_add_overflow(v, (int64_t)(neg ? -(c - '0') : (c - '0')), &v)) return vnone();\n" ++
    "    }\n" ++
    "    return vsome((V)v);\n" ++
    "}\n" ++
    "\n" ++
    "// ---- lists ----\n" ++
    "// A list is (len, buf). Pushing onto a list whose length equals buf->used appends in\n" ++
    "// place; any older, shorter list sharing the buffer never sees the new slot, so the\n" ++
    "// value semantics are preserved and repeated pushes are amortised O(1).\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t cap;\n" ++
    "    int64_t used;\n" ++
    "    V items[];\n" ++
    "} VBuf;\n" ++
    "\n" ++
    "typedef struct {\n" ++
    "    int64_t len;\n" ++
    "    VBuf *buf;\n" ++
    "} VList;\n" ++
    "\n" ++
    "#define VL(x) ((VList *)(uintptr_t)(x))\n" ++
    "\n" ++
    "static VBuf *vbuf_new(int64_t cap) {\n" ++
    "    if (cap < 4) cap = 4;\n" ++
    "    VBuf *b = (VBuf *)vow_alloc(sizeof(VBuf) + (size_t)cap * sizeof(V));\n" ++
    "    b->cap = cap;\n" ++
    "    b->used = 0;\n" ++
    "    return b;\n" ++
    "}\n" ++
    "\n" ++
    "static V vlist_empty(void) {\n" ++
    "    VList *l = (VList *)vow_alloc(sizeof(VList));\n" ++
    "    l->len = 0;\n" ++
    "    l->buf = 0;\n" ++
    "    return (V)(uintptr_t)l;\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vlist_len(V l) { return (V)VL(l)->len; }\n" ++
    "\n" ++
    "static V vlist_push(V lv, V x) {\n" ++
    "    VList *l = VL(lv);\n" ++
    "    VBuf *b = l->buf;\n" ++
    "    if (!b || b->used != l->len || b->used == b->cap) {\n" ++
    "        VBuf *nb = vbuf_new(l->len * 2);\n" ++
    "        if (l->len) memcpy(nb->items, b->items, (size_t)l->len * sizeof(V));\n" ++
    "        nb->used = l->len;\n" ++
    "        b = nb;\n" ++
    "    }\n" ++
    "    b->items[b->used++] = x;\n" ++
    "    VList *r = (VList *)vow_alloc(sizeof(VList));\n" ++
    "    r->len = l->len + 1;\n" ++
    "    r->buf = b;\n" ++
    "    return (V)(uintptr_t)r;\n" ++
    "}\n" ++
    "\n" ++
    "static inline V vlist_get(V l, V i) {\n" ++
    "    VOW_REQUIRE(VI(i) >= 0 && VI(i) < VL(l)->len, \"list index out of bounds\");\n" ++
    "    return VL(l)->buf->items[VI(i)];\n" ++
    "}\n" ++
    "\n" ++
    "static V vlist_slice(V lv, V from, V to) {\n" ++
    "    VOW_REQUIRE(0 <= VI(from) && VI(from) <= VI(to) && VI(to) <= VL(lv)->len, \"list slice out of bounds\");\n" ++
    "    int64_t n = VI(to) - VI(from);\n" ++
    "    VBuf *b = vbuf_new(n);\n" ++
    "    if (n) memcpy(b->items, VL(lv)->buf->items + VI(from), (size_t)n * sizeof(V));\n" ++
    "    b->used = n;\n" ++
    "    VList *r = (VList *)vow_alloc(sizeof(VList));\n" ++
    "    r->len = n;\n" ++
    "    r->buf = b;\n" ++
    "    return (V)(uintptr_t)r;\n" ++
    "}\n" ++
    "\n" ++
    "static V vlist_cat(V a, V b) {\n" ++
    "    V r = a;\n" ++
    "    for (int64_t i = 0; i < VL(b)->len; i++) r = vlist_push(r, VL(b)->buf->items[i]);\n" ++
    "    return r;\n" ++
    "}\n" ++
    "\n" ++
    "static V vjoin(V parts, V sep) {\n" ++
    "    int64_t n = 0, k = VL(parts)->len;\n" ++
    "    for (int64_t i = 0; i < k; i++) n += VS(VL(parts)->buf->items[i])->len;\n" ++
    "    if (k > 1) n += (k - 1) * VS(sep)->len;\n" ++
    "    VStr *s = (VStr *)vow_alloc(sizeof(VStr) + (size_t)n + 1);\n" ++
    "    s->len = n;\n" ++
    "    char *p = s->data;\n" ++
    "    for (int64_t i = 0; i < k; i++) {\n" ++
    "        if (i) {\n" ++
    "            memcpy(p, VS(sep)->data, (size_t)VS(sep)->len);\n" ++
    "            p += VS(sep)->len;\n" ++
    "        }\n" ++
    "        VStr *x = VS(VL(parts)->buf->items[i]);\n" ++
    "        memcpy(p, x->data, (size_t)x->len);\n" ++
    "        p += x->len;\n" ++
    "    }\n" ++
    "    *p = 0;\n" ++
    "    return (V)(uintptr_t)s;\n" ++
    "}\n" ++
    "\n" ++
    "// ---- maps: persistent AVL trees with path copying ----\n" ++
    "\n" ++
    "typedef struct VNode {\n" ++
    "    V key, val;\n" ++
    "    struct VNode *l, *r;\n" ++
    "    int64_t height, size;\n" ++
    "} VNode;\n" ++
    "\n" ++
    "static inline int64_t vn_h(VNode *n) { return n ? n->height : 0; }\n" ++
    "static inline int64_t vn_s(VNode *n) { return n ? n->size : 0; }\n" ++
    "\n" ++
    "static int vkey_cmp(V a, V b, int str) {\n" ++
    "    if (str) return vstr_cmp(a, b);\n" ++
    "    return VI(a) < VI(b) ? -1 : (VI(a) > VI(b) ? 1 : 0);\n" ++
    "}\n" ++
    "\n" ++
    "static VNode *vn_make(V k, V v, VNode *l, VNode *r) {\n" ++
    "    VNode *n = (VNode *)vow_alloc(sizeof(VNode));\n" ++
    "    n->key = k;\n" ++
    "    n->val = v;\n" ++
    "    n->l = l;\n" ++
    "    n->r = r;\n" ++
    "    int64_t hl = vn_h(l), hr = vn_h(r);\n" ++
    "    n->height = (hl > hr ? hl : hr) + 1;\n" ++
    "    n->size = vn_s(l) + vn_s(r) + 1;\n" ++
    "    return n;\n" ++
    "}\n" ++
    "\n" ++
    "static VNode *vn_balance(V k, V v, VNode *l, VNode *r) {\n" ++
    "    int64_t hl = vn_h(l), hr = vn_h(r);\n" ++
    "    if (hl > hr + 1) {\n" ++
    "        if (vn_h(l->l) >= vn_h(l->r)) return vn_make(l->key, l->val, l->l, vn_make(k, v, l->r, r));\n" ++
    "        return vn_make(l->r->key, l->r->val, vn_make(l->key, l->val, l->l, l->r->l), vn_make(k, v, l->r->r, r));\n" ++
    "    }\n" ++
    "    if (hr > hl + 1) {\n" ++
    "        if (vn_h(r->r) >= vn_h(r->l)) return vn_make(r->key, r->val, vn_make(k, v, l, r->l), r->r);\n" ++
    "        return vn_make(r->l->key, r->l->val, vn_make(k, v, l, r->l->l), vn_make(r->key, r->val, r->l->r, r->r));\n" ++
    "    }\n" ++
    "    return vn_make(k, v, l, r);\n" ++
    "}\n" ++
    "\n" ++
    "static VNode *vn_insert(VNode *n, V k, V v, int str) {\n" ++
    "    if (!n) return vn_make(k, v, 0, 0);\n" ++
    "    int c = vkey_cmp(k, n->key, str);\n" ++
    "    if (c == 0) return vn_make(k, v, n->l, n->r);\n" ++
    "    if (c < 0) return vn_balance(n->key, n->val, vn_insert(n->l, k, v, str), n->r);\n" ++
    "    return vn_balance(n->key, n->val, n->l, vn_insert(n->r, k, v, str));\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_empty(void) { return 0; }\n" ++
    "static inline V vmap_len(V m) { return (V)vn_s((VNode *)(uintptr_t)m); }\n" ++
    "\n" ++
    "static V vmap_insert(V m, V k, V v, int str) {\n" ++
    "    return (V)(uintptr_t)vn_insert((VNode *)(uintptr_t)m, k, v, str);\n" ++
    "}\n" ++
    "\n" ++
    "static VNode *vn_find(V m, V k, int str) {\n" ++
    "    VNode *n = (VNode *)(uintptr_t)m;\n" ++
    "    while (n) {\n" ++
    "        int c = vkey_cmp(k, n->key, str);\n" ++
    "        if (c == 0) return n;\n" ++
    "        n = c < 0 ? n->l : n->r;\n" ++
    "    }\n" ++
    "    return 0;\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_lookup(V m, V k, int str) {\n" ++
    "    VNode *n = vn_find(m, k, str);\n" ++
    "    return n ? vsome(n->val) : vnone();\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_has(V m, V k, int str) { return (V)(vn_find(m, k, str) != 0); }\n" ++
    "\n" ++
    "static V vn_keys(VNode *n, V acc) {\n" ++
    "    if (!n) return acc;\n" ++
    "    acc = vn_keys(n->l, acc);\n" ++
    "    acc = vlist_push(acc, n->key);\n" ++
    "    return vn_keys(n->r, acc);\n" ++
    "}\n" ++
    "\n" ++
    "static V vmap_keys(V m) { return vn_keys((VNode *)(uintptr_t)m, vlist_empty()); }\n" ++
    "\n" ++
    "// ---- effects ----\n" ++
    "\n" ++
    "static int vow_argc;\n" ++
    "static char **vow_argv;\n" ++
    "\n" ++
    "static V vprint(V s) {\n" ++
    "    fwrite(VS(s)->data, 1, (size_t)VS(s)->len, stdout);\n" ++
    "    return 0;\n" ++
    "}\n" ++
    "\n" ++
    "static V veprint(V s) {\n" ++
    "    fflush(stdout);\n" ++
    "    fwrite(VS(s)->data, 1, (size_t)VS(s)->len, stderr);\n" ++
    "    return 0;\n" ++
    "}\n" ++
    "\n" ++
    "static V vread_file(V path) {\n" ++
    "    FILE *f = fopen(VS(path)->data, \"rb\");\n" ++
    "    if (!f) return vnone();\n" ++
    "    fseek(f, 0, SEEK_END);\n" ++
    "    long n = ftell(f);\n" ++
    "    fseek(f, 0, SEEK_SET);\n" ++
    "    VStr *s = (VStr *)vow_alloc(sizeof(VStr) + (size_t)n + 1);\n" ++
    "    s->len = (int64_t)fread(s->data, 1, (size_t)n, f);\n" ++
    "    s->data[s->len] = 0;\n" ++
    "    fclose(f);\n" ++
    "    return vsome((V)(uintptr_t)s);\n" ++
    "}\n" ++
    "\n" ++
    "static V vwrite_file(V path, V contents) {\n" ++
    "    FILE *f = fopen(VS(path)->data, \"wb\");\n" ++
    "    if (!f) return 0;\n" ++
    "    size_t w = fwrite(VS(contents)->data, 1, (size_t)VS(contents)->len, f);\n" ++
    "    int ok = fclose(f) == 0 && w == (size_t)VS(contents)->len;\n" ++
    "    return (V)ok;\n" ++
    "}\n" ++
    "\n" ++
    "static V vargs(void) {\n" ++
    "    V l = vlist_empty();\n" ++
    "    for (int i = 1; i < vow_argc; i++) l = vlist_push(l, vstr_new(vow_argv[i], (int64_t)strlen(vow_argv[i])));\n" ++
    "    return l;\n" ++
    "}\n" ++
    "\n" ++
    "static V vgetenv(V name) {\n" ++
    "    const char *v = getenv(VS(name)->data);\n" ++
    "    if (!v) return vnone();\n" ++
    "    return vsome(vstr_new(v, (int64_t)strlen(v)));\n" ++
    "}\n" ++
    "\n" ++
    "static __attribute__((noreturn)) void vexit(V code) {\n" ++
    "    fflush(stdout);\n" ++
    "    exit((int)VI(code));\n" ++
    "}\n" ++
    "\n" ++
    "// run(argv, input): stdin comes from a temporary file so that large inputs and outputs\n" ++
    "// cannot deadlock on full pipes; stdout is captured, stderr is inherited.\n" ++
    "static V vrun(V argv, V input) {\n" ++
    "    int64_t n = VL(argv)->len;\n" ++
    "    V out = vow_new(2);\n" ++
    "    VP(out)[0] = (V)(int64_t)-1;\n" ++
    "    VP(out)[1] = vstr_new(\"\", 0);\n" ++
    "    if (n == 0) return out;\n" ++
    "    char tmpl[] = \"/tmp/vow-run-XXXXXX\";\n" ++
    "    int in_fd = mkstemp(tmpl);\n" ++
    "    if (in_fd < 0) return out;\n" ++
    "    unlink(tmpl);\n" ++
    "    if (write(in_fd, VS(input)->data, (size_t)VS(input)->len) != (ssize_t)VS(input)->len) {\n" ++
    "        close(in_fd);\n" ++
    "        return out;\n" ++
    "    }\n" ++
    "    lseek(in_fd, 0, SEEK_SET);\n" ++
    "    int pfd[2];\n" ++
    "    if (pipe(pfd) != 0) {\n" ++
    "        close(in_fd);\n" ++
    "        return out;\n" ++
    "    }\n" ++
    "    fflush(stdout);\n" ++
    "    pid_t pid = fork();\n" ++
    "    if (pid == 0) {\n" ++
    "        dup2(in_fd, 0);\n" ++
    "        dup2(pfd[1], 1);\n" ++
    "        close(pfd[0]);\n" ++
    "        close(pfd[1]);\n" ++
    "        close(in_fd);\n" ++
    "        char **av = (char **)malloc(sizeof(char *) * (size_t)(n + 1));\n" ++
    "        for (int64_t i = 0; i < n; i++) av[i] = VS(VL(argv)->buf->items[i])->data;\n" ++
    "        av[n] = 0;\n" ++
    "        execvp(av[0], av);\n" ++
    "        _exit(127);\n" ++
    "    }\n" ++
    "    close(pfd[1]);\n" ++
    "    close(in_fd);\n" ++
    "    size_t cap = 4096, len = 0;\n" ++
    "    char *buf = (char *)malloc(cap);\n" ++
    "    for (;;) {\n" ++
    "        if (len == cap) buf = (char *)realloc(buf, cap *= 2);\n" ++
    "        ssize_t k = read(pfd[0], buf + len, cap - len);\n" ++
    "        if (k <= 0) break;\n" ++
    "        len += (size_t)k;\n" ++
    "    }\n" ++
    "    close(pfd[0]);\n" ++
    "    int status = 0;\n" ++
    "    waitpid(pid, &status, 0);\n" ++
    "    VP(out)[0] = (V)(int64_t)(WIFEXITED(status) ? WEXITSTATUS(status) : -1);\n" ++
    "    VP(out)[1] = vstr_new(buf, (int64_t)len);\n" ++
    "    free(buf);\n" ++
    "    return out;\n" ++
    "}\n" ++
    "\n" ++
    "#endif\n" ++
    ""
end fn runtime_header
