// C code generation with reference counting. Every expression is lowered to
// temporaries in written order, because C leaves argument evaluation order
// unspecified.
//
// Ownership: each value is either owned (the code holds a reference that must be
// consumed or dropped) or borrowed (valid while its owner lives). Owned temporaries not
// consumed by the end of a statement are dropped; owned locals are dropped when their
// scope ends, including on return, break and continue. Parameters are borrowed. In
// `set x = op(x, ...)`, when op consumes x (with, push, set_at, insert, list ++), the
// old value is moved into op instead of duplicated, so op can update it in place.
// See runtime/vow_rt.h for which runtime functions consume their arguments.

import "check.vow"
import "pretty.vow"

struct Val
  c: String,
  owned: Bool,
end struct Val

struct Gen
  info: Info,
  files: List<String>,
  out: List<String>,
  ind: Int,
  tmp: Int,
  strs: List<String>,
  str_index: Map<String, Int>,
  io_params: List<String>,
  // Owned locals (and scoped temporaries) in enclosing scopes, innermost last.
  owned_vars: List<String>,
  scope_marks: List<Int>,
  loop_marks: List<Int>,
  // Owned temporaries of the statement being generated; nested C blocks push marks.
  temps: List<String>,
  temp_marks: List<Int>,
  // The Var expression whose value `set` moves into a consuming operation, or -1.
  move_id: Int,
  moved: Bool,
  // Variables passed inout somewhere in the current statement.
  inout_vars: List<String>,
  // Field reads `x.f` whose value `set x = x with (f: op(x.f, ...))` moves out of x.
  steal_ids: List<Int>,
  // Types compared with '==' part by part, each needing a veq_ function.
  eqs: List<Ty>,
  // The source position of the code being generated, and the .vow line (and file) the
  // next C line is attributed to, given the #line directives so far (-1: none yet).
  src: Pos,
  mapped_file: Int,
  mapped_next: Int,
  // Whether to emit #line directives at all.
  lines: Bool,
end struct Gen

fn c_string(s: String) -> String do
  var parts: List<String> = ["\""]
  for i in 0..len(s) do
    let b = s[i]
    if b == '"' then
      set parts = push(list: parts, item: "\\\"")
    elif b == '\\' then
      set parts = push(list: parts, item: "\\\\")
    elif b == '?' then
      set parts = push(list: parts, item: "\\?")
    elif (b >= 32) and (b <= 126) then
      set parts = push(list: parts, item: char(b))
    else
      set parts = push(list: parts, item: "\\" ++ octal3(b))
    end if
  end for
  set parts = push(list: parts, item: "\"")
  return join(parts: parts, sep: "")
end fn c_string

fn c_params(f: FnDecl) -> String do
  if len(f.params) == 0 then
    return "void"
  end if
  var ps: List<String> = []
  for p in f.params do
    if p.is_inout then
      set ps = push(list: ps, item: "V * l_" ++ p.name)
    else
      set ps = push(list: ps, item: "V l_" ++ p.name)
    end if
  end for
  return join(parts: ps, sep: ", ")
end fn c_params

// tests: functions the program runs instead of main when started as
// `program --vow-test <name>` (vowc test).
fn generate(items: List<Item>, info: Info, files: List<String>, verified: Bool, lines: Bool,
    tests: List<String>) -> String do
  var g = Gen(info: info, files: files, out: [], ind: 0, tmp: 0, strs: [], str_index: {}, io_params: [],
    owned_vars: [], scope_marks: [], loop_marks: [], temps: [], temp_marks: [], move_id: -1,
    moved: false, inout_vars: [], steal_ids: [], eqs: [], src: no_pos(), mapped_file: -1, mapped_next: -1, lines: lines)
  // Generic functions are compiled through their instances.
  var fns: List<FnDecl> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      if len(f.tparams) == 0 then
        set fns = push(list: fns, item: f)
      end if
    else
    end match
  end for
  set fns = fns ++ info.instances
  var body: List<String> = []
  for f in fns do
    set g = g with (out: [], tmp: 0)
    gen_function(g: inout g, f: f)
    set body = body ++ g.out
  end for
  var c: List<String> = ["// Generated by vowc. Do not edit."]
  if verified then
    set c = push(list: c, item: "#define VOW_VERIFIED 1")
  end if
  set c = push(list: c, item: "#include \"vow_rt.h\"")
  set c = push(list: c, item: "")
  var n = len(g.strs)
  if n < 1 then
    set n = 1
  end if
  set c = push(list: c, item: "static V vow_s[" ++ int_to_str(n) ++ "];")
  for f in fns do
    set c = push(list: c, item: "static V " ++ c_fn(f.name) ++ "(" ++ c_params(f) ++ ");")
  end for
  // Equality functions; generating one can call for more.
  var eq_defs: List<String> = []
  var done = 0
  while done < len(g.eqs) invariant done >= 0 do
    let t = g.eqs[done]
    set done = done + 1
    set eq_defs = eq_defs ++ gen_eq_fn(g: inout g, t: t)
  end while
  for t in g.eqs do
    set c = push(list: c, item: "static V " ++ eq_c_name(t) ++ "(V a, V b);")
  end for
  set c = push(list: c, item: "")
  set c = c ++ eq_defs
  // The functions come last: from their first #line directive on, every C line is
  // attributed to Vow source.
  set c = push(list: c, item: "int main(int argc, char **argv) {")
  set c = push(list: c, item: "    vow_argc = argc;")
  set c = push(list: c, item: "    vow_argv = argv;")
  for i in 0..len(g.strs) do
    let s = g.strs[i]
    set c = push(list: c, item: "    vow_s[" ++ int_to_str(i) ++ "] = vow_immortal(vstr_new(" ++ c_string(s) ++ ", " ++ int_to_str(len(s)) ++ "));")
  end for
  if len(tests) > 0 then
    set c = push(list: c, item: "    if (argc == 3 && strcmp(argv[1], \"--vow-test\") == 0) {")
    set c = push(list: c, item: "        vow_argc = 1;")
    var kw = "if"
    for t in tests do
      set c = push(list: c, item: "        " ++ kw ++ " (strcmp(argv[2], " ++ c_string(t) ++ ") == 0) " ++ c_fn(t) ++ "();")
      set kw = "else if"
    end for
    set c = push(list: c, item: "        else return 2;")
    set c = push(list: c, item: "        fflush(stdout);")
    set c = push(list: c, item: "        vow_report_leaks();")
    set c = push(list: c, item: "        return 0;")
    set c = push(list: c, item: "    }")
  end if
  if is_some(get_fn(info: info, name: "main")) then
    set c = push(list: c, item: "    f_main();")
  end if
  set c = push(list: c, item: "    fflush(stdout);")
  set c = push(list: c, item: "    vow_report_leaks();")
  set c = push(list: c, item: "    return 0;")
  set c = push(list: c, item: "}")
  set c = push(list: c, item: "")
  set c = c ++ body
  return join(parts: c, sep: "\n") ++ "\n"
end fn generate

// ---- emitting ----

// Emits a C line, preceded by a #line directive when it would otherwise be attributed
// to the wrong .vow line, so that C compiler errors, debuggers and runtime panics point
// at the Vow source.
fn line(g: inout Gen, s: String) do
  let p = g.src
  if g.lines and (p.file >= 0) and (p.file < len(g.files)) and (p.line > 0) then
    if (p.file != g.mapped_file) or (p.line != g.mapped_next) then
      set g = g with (out: push(list: g.out, item: "#line " ++ int_to_str(p.line) ++ " " ++ c_string(g.files[p.file])),
        mapped_file: p.file, mapped_next: p.line)
    end if
  end if
  set g = g with (out: push(list: g.out, item: repeat(s: "    ", n: g.ind) ++ s))
  if g.mapped_file >= 0 then
    set g = g with (mapped_next: g.mapped_next + 1)
  end if
end fn line

fn fresh_tmp(g: inout Gen) -> String do
  set g = g with (tmp: g.tmp + 1)
  return "t" ++ int_to_str(g.tmp)
end fn fresh_tmp

fn bind(g: inout Gen, rhs: String) -> String do
  let t = fresh_tmp(inout g)
  line(g: inout g, s: "V " ++ t ++ " = " ++ rhs ++ ";")
  return t
end fn bind

fn str_lit(g: inout Gen, s: String) -> String do
  match lookup(map: g.str_index, key: s)
  case Some(value: i) then
    return "vow_s[" ++ int_to_str(i) ++ "]"
  case None then
    let i = len(g.strs)
    set g = g with (strs: push(list: g.strs, item: s), str_index: insert(map: g.str_index, key: s, value: i))
    return "vow_s[" ++ int_to_str(i) ++ "]"
  end match
end fn str_lit

fn loc(g: Gen, pos: Pos) -> String do
  var f = "?"
  if (pos.file >= 0) and (pos.file < len(g.files)) then
    set f = g.files[pos.file]
  end if
  return f ++ ":" ++ int_to_str(pos.line)
end fn loc

// A call that panics with message msg (a C expression), naming the source position
// explicitly, so that it does not depend on #line directives.
fn panic_at(g: Gen, pos: Pos, msg: String) -> String do
  var f = "?"
  if (pos.file >= 0) and (pos.file < len(g.files)) then
    set f = g.files[pos.file]
  end if
  return "vow_panic_at(" ++ c_string(f) ++ ", " ++ int_to_str(pos.line) ++ ", " ++ msg ++ ");"
end fn panic_at

// The C name of a function: f_name, or i_ and the mangled name for an instance of a
// generic function.
fn c_fn(name: String) -> String do
  if is_instance_name(name) then
    return "i_" ++ mangle(name)
  end if
  return "f_" ++ name
end fn c_fn

fn cvar(g: Gen, n: String) -> String do
  if contains_str(xs: g.io_params, x: n) then
    return "(*l_" ++ n ++ ")"
  end if
  return "l_" ++ n
end fn cvar

fn indent(g: inout Gen) do
  set g = g with (ind: g.ind + 1)
end fn indent

fn dedent(g: inout Gen) do
  set g = g with (ind: g.ind - 1)
end fn dedent

// ---- ownership ----

fn is_heap(t: Ty) -> Bool do
  match t
  case TInt then
    return false
  case TBool then
    return false
  case TUnit then
    return false
  case TUnknown then
    return false
  else
    return true
  end match
end fn is_heap

fn heap_of(g: Gen, e: Expr) -> Bool do
  return is_heap(type_of(info: g.info, e: e))
end fn heap_of

fn plain_val(c: String) -> Val do
  return Val(c: c, owned: false)
end fn plain_val

// A new owned temporary holding rhs (or a plain one, for non-heap values).
fn owned_tmp(g: inout Gen, rhs: String, heap: Bool) -> Val do
  let t = bind(g: inout g, rhs: rhs)
  if heap then
    set g = g with (temps: push(list: g.temps, item: t))
  end if
  return Val(c: t, owned: heap)
end fn owned_tmp

fn remove_last(xs: List<String>, x: String) -> List<String> do
  var i = len(xs) - 1
  while i >= 0 invariant i < len(xs) decreases i + 1 do
    if xs[i] == x then
      return slice(of: xs, from: 0, to: i) ++ slice(of: xs, from: i + 1, to: len(xs))
    end if
    set i = i - 1
  end while
  return xs
end fn remove_last

// An owned reference to v for a consuming position: an owned temporary is moved, a
// borrowed value is duplicated.
fn take(g: inout Gen, v: Val, heap: Bool) -> String do
  if not heap then
    return v.c
  end if
  if v.owned then
    set g = g with (temps: remove_last(xs: g.temps, x: v.c))
    return v.c
  end if
  line(g: inout g, s: "vdup(" ++ v.c ++ ");")
  return v.c
end fn take

// Drops the owned temporaries above the innermost mark.
fn flush(g: inout Gen) do
  var mark = 0
  let nm = len(g.temp_marks)
  if nm > 0 then
    set mark = g.temp_marks[nm - 1]
  end if
  let ts = g.temps
  var i = len(ts) - 1
  while (i >= mark) and (i >= 0) invariant i < len(ts) decreases i + 1 do
    line(g: inout g, s: "vdrop(" ++ ts[i] ++ ");")
    set i = i - 1
  end while
  if (mark >= 0) and (mark <= len(g.temps)) then
    set g = g with (temps: slice(of: g.temps, from: 0, to: mark))
  end if
end fn flush

fn push_frame(g: inout Gen) do
  set g = g with (temp_marks: push(list: g.temp_marks, item: len(g.temps)))
end fn push_frame

fn pop_frame(g: inout Gen) do
  flush(inout g)
  let n = len(g.temp_marks)
  if n > 0 then
    set g = g with (temp_marks: slice(of: g.temp_marks, from: 0, to: n - 1))
  end if
end fn pop_frame

fn declare_owned(g: inout Gen, c: String) do
  set g = g with (owned_vars: push(list: g.owned_vars, item: c))
end fn declare_owned

fn enter_scope(g: inout Gen) do
  set g = g with (scope_marks: push(list: g.scope_marks, item: len(g.owned_vars)))
end fn enter_scope

// Emits drops for the owned variables above mark, innermost first, without forgetting
// them (other paths still need them).
fn drop_to(g: inout Gen, mark: Int) do
  let vs = g.owned_vars
  var i = len(vs) - 1
  while (i >= mark) and (i >= 0) invariant i < len(vs) decreases i + 1 do
    line(g: inout g, s: "vdrop(" ++ vs[i] ++ ");")
    set i = i - 1
  end while
end fn drop_to

fn leave_scope(g: inout Gen) do
  let marks = g.scope_marks
  let n = len(marks)
  if n == 0 then
    return
  end if
  let mark = marks[n - 1]
  drop_to(g: inout g, mark: mark)
  if (mark >= 0) and (mark <= len(g.owned_vars)) then
    set g = g with (owned_vars: slice(of: g.owned_vars, from: 0, to: mark))
  end if
  set g = g with (scope_marks: slice(of: marks, from: 0, to: n - 1))
end fn leave_scope

// ---- which variables a statement passes inout ----

fn inout_in_expr(e: Expr, out: inout List<String>) do
  match e.kind
  case Call(callee: c, args: args) then
    for a in args do
      if a.is_inout then
        match a.value.kind
        case Var(name: n) then
          set out = push(list: out, item: n)
        else
        end match
      end if
      inout_in_expr(e: a.value, out: inout out)
    end for
  case With(obj: o, args: args) then
    inout_in_expr(e: o, out: inout out)
    for a in args do
      inout_in_expr(e: a.value, out: inout out)
    end for
  case ListLit(items: items) then
    for x in items do
      inout_in_expr(e: x, out: inout out)
    end for
  case Index(obj: a, idx: b) then
    inout_in_expr(e: a, out: inout out)
    inout_in_expr(e: b, out: inout out)
  case Binary(op: op, l: a, r: b) then
    inout_in_expr(e: a, out: inout out)
    inout_in_expr(e: b, out: inout out)
  case Field(obj: a, name: f) then
    inout_in_expr(e: a, out: inout out)
  case Unary(op: op, x: a) then
    inout_in_expr(e: a, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    inout_in_expr(e: lo, out: inout out)
    inout_in_expr(e: hi, out: inout out)
    inout_in_expr(e: b, out: inout out)
  else
  end match
end fn inout_in_expr

// Generates a statement-level expression.
fn gen_top(g: inout Gen, e: Expr) -> Val do
  var io: List<String> = []
  inout_in_expr(e: e, out: inout io)
  set g = g with (inout_vars: io)
  let v = gen_expr(g: inout g, e: e)
  set g = g with (inout_vars: [])
  return v
end fn gen_top

// In `set name = value`, the variable read that value's top-level operation consumes,
// when its old value can be moved there (-1 otherwise).
fn move_candidate(g: Gen, value: Expr, name: String) -> Int do
  var io: List<String> = []
  inout_in_expr(e: value, out: inout io)
  if contains_str(xs: io, x: name) then
    return -1
  end if
  match value.kind
  case With(obj: o, args: args) then
    return var_id(e: o, name: name)
  case Binary(op: op, l: l, r: r) then
    if (op == "++") and (ty_show(type_of(info: g.info, e: l)) != "String") then
      return var_id(e: l, name: name)
    end if
    return -1
  case Call(callee: c, args: args) then
    match call_info(info: g.info, e: value)
    case Some(value: ci) then
      if (ci.kind == "builtin") and contains_str(xs: ["push", "set_at", "insert"], x: ci.name) and (len(ci.order) > 0) then
        let i = ci.order[0]
        if (i >= 0) and (i < len(args)) then
          return var_id(e: args[i].value, name: name)
        end if
      end if
      return -1
    case None then
      return -1
    end match
  else
    return -1
  end match
end fn move_candidate

// The operand a consuming operation consumes (the list of push/set_at/++, the map of
// insert, the base of with), if e is such an operation.
fn consumed_operand(g: Gen, e: Expr) -> Option<Expr> do
  match e.kind
  case With(obj: o, args: args) then
    return Option.Some(value: o)
  case Binary(op: op, l: l, r: r) then
    if (op == "++") and (ty_show(type_of(info: g.info, e: l)) != "String") then
      return Option.Some(value: l)
    end if
    return Option.None
  case Call(callee: c, args: args) then
    match call_info(info: g.info, e: e)
    case Some(value: ci) then
      if (ci.kind == "builtin") and contains_str(xs: ["push", "set_at", "insert"], x: ci.name) and (len(ci.order) > 0) then
        let i = ci.order[0]
        if (i >= 0) and (i < len(args)) then
          return Option.Some(value: args[i].value)
        end if
      end if
      return Option.None
    case None then
      return Option.None
    end match
  else
    return Option.None
  end match
end fn consumed_operand

// Every use of variable name in e: "var" for a bare use, "field:f" for a read of name.f.
fn uses_of(e: Expr, name: String, out: inout List<String>) do
  match e.kind
  case Var(name: n) then
    if n == name then
      set out = push(list: out, item: "var")
    end if
  case Field(obj: o, name: f) then
    match o.kind
    case Var(name: n) then
      if n == name then
        set out = push(list: out, item: "field:" ++ f)
      end if
    else
      uses_of(e: o, name: name, out: inout out)
    end match
  case Call(callee: c, args: args) then
    uses_of(e: c, name: name, out: inout out)
    for a in args do
      uses_of(e: a.value, name: name, out: inout out)
    end for
  case With(obj: o, args: args) then
    uses_of(e: o, name: name, out: inout out)
    for a in args do
      uses_of(e: a.value, name: name, out: inout out)
    end for
  case ListLit(items: items) then
    for x in items do
      uses_of(e: x, name: name, out: inout out)
    end for
  case Index(obj: a, idx: b) then
    uses_of(e: a, name: name, out: inout out)
    uses_of(e: b, name: name, out: inout out)
  case Binary(op: op, l: a, r: b) then
    uses_of(e: a, name: name, out: inout out)
    uses_of(e: b, name: name, out: inout out)
  case Unary(op: op, x: a) then
    uses_of(e: a, name: name, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    uses_of(e: lo, name: name, out: inout out)
    uses_of(e: hi, name: name, out: inout out)
    uses_of(e: b, name: name, out: inout out)
  else
  end match
end fn uses_of

fn count_str(xs: List<String>, x: String) -> Int do
  var n = 0
  for y in xs do
    if y == x then
      set n = n + 1
    end if
  end for
  return n
end fn count_str

// In `set name = name with (f: op(name.f, ...), ...)`, the reads name.f that can be
// moved out of name: op consumes name.f and writes it back as field f, and the right
// side uses name nowhere else except reads of other fields.
fn steal_candidates(g: Gen, value: Expr, name: String) -> List<Int> do
  var ids: List<Int> = []
  match value.kind
  case With(obj: o, args: args) then
    var all_uses: List<String> = []
    for a in args do
      uses_of(e: a.value, name: name, out: inout all_uses)
    end for
    if contains_str(xs: all_uses, x: "var") then
      return ids
    end if
    for a in args do
      match consumed_operand(g: g, e: a.value)
      case Some(value: op) then
        match op.kind
        case Field(obj: fo, name: f) then
          if (f == a.name) and (var_id(e: fo, name: name) >= 0) and (count_str(xs: all_uses, x: "field:" ++ f) == 1) and heap_of(g: g, e: op) then
            set ids = push(list: ids, item: op.id)
          end if
        else
        end match
      case None then
      end match
    end for
    return ids
  else
    return ids
  end match
end fn steal_candidates

fn var_id(e: Expr, name: String) -> Int do
  match e.kind
  case Var(name: n) then
    if n == name then
      return e.id
    end if
    return -1
  else
    return -1
  end match
end fn var_id

// ---- functions and statements ----

fn gen_function(g: inout Gen, f: FnDecl) do
  var io: List<String> = []
  for p in f.params do
    if p.is_inout then
      set io = push(list: io, item: p.name)
    end if
  end for
  set g = g with (io_params: io, owned_vars: [], scope_marks: [], loop_marks: [], temps: [], temp_marks: [], src: f.pos)
  line(g: inout g, s: "static V " ++ c_fn(f.name) ++ "(" ++ c_params(f) ++ ") {")
  indent(inout g)
  gen_scoped(g: inout g, stmts: f.body)
  line(g: inout g, s: "return 0;")
  dedent(inout g)
  line(g: inout g, s: "}")
  line(g: inout g, s: "")
end fn gen_function

fn gen_block(g: inout Gen, stmts: List<Stmt>) do
  for s in stmts do
    gen_stmt(g: inout g, s: s)
  end for
end fn gen_block

// A block with its own scope: owned locals declared in it are dropped at its end.
fn gen_scoped(g: inout Gen, stmts: List<Stmt>) do
  enter_scope(inout g)
  gen_block(g: inout g, stmts: stmts)
  leave_scope(inout g)
end fn gen_scoped

fn braced(g: inout Gen, stmts: List<Stmt>) do
  indent(inout g)
  gen_scoped(g: inout g, stmts: stmts)
  dedent(inout g)
end fn braced

fn gen_loop_body(g: inout Gen, stmts: List<Stmt>) do
  set g = g with (loop_marks: push(list: g.loop_marks, item: len(g.owned_vars)))
  gen_scoped(g: inout g, stmts: stmts)
  let n = len(g.loop_marks)
  if n > 0 then
    set g = g with (loop_marks: slice(of: g.loop_marks, from: 0, to: n - 1))
  end if
end fn gen_loop_body

fn loop_mark(g: Gen) -> Int do
  let n = len(g.loop_marks)
  if n > 0 then
    return g.loop_marks[n - 1]
  end if
  return 0
end fn loop_mark

fn gen_stmt(g: inout Gen, s: Stmt) do
  set g = g with (src: s.pos)
  match s.kind
  case Let(name: name, ty: ty, value: value, mutable: m) then
    let v = gen_top(g: inout g, e: value)
    if name == "_" then
      line(g: inout g, s: "(void)" ++ v.c ++ ";")
      flush(inout g)
    else
      let heap = heap_of(g: g, e: value)
      let c = take(g: inout g, v: v, heap: heap)
      line(g: inout g, s: "V l_" ++ name ++ " = " ++ c ++ ";")
      flush(inout g)
      if heap then
        declare_owned(g: inout g, c: "l_" ++ name)
      end if
    end if
  case Set(name: name, value: value) then
    let lv = cvar(g: g, n: name)
    let heap = heap_of(g: g, e: value)
    if heap then
      let mid = move_candidate(g: g, value: value, name: name)
      set g = g with (move_id: mid, moved: false)
      if mid >= 0 then
        set g = g with (steal_ids: steal_candidates(g: g, value: value, name: name))
      end if
    end if
    let v = gen_top(g: inout g, e: value)
    let moved = g.moved
    set g = g with (move_id: -1, moved: false, steal_ids: [])
    let c = take(g: inout g, v: v, heap: heap)
    if heap and not moved then
      line(g: inout g, s: "vdrop(" ++ lv ++ ");")
    end if
    line(g: inout g, s: lv ++ " = " ++ c ++ ";")
    flush(inout g)
  case Return(value: rv) then
    match rv
    case None then
      drop_to(g: inout g, mark: 0)
      line(g: inout g, s: "return 0;")
    case Some(value: e) then
      let v = gen_top(g: inout g, e: e)
      let c = take(g: inout g, v: v, heap: heap_of(g: g, e: e))
      flush(inout g)
      drop_to(g: inout g, mark: 0)
      line(g: inout g, s: "return " ++ c ++ ";")
    end match
  case If(arms: arms, els: els) then
    if len(arms) > 0 then
      gen_if(g: inout g, arms: arms, els: els)
    end if
  case While(cond: cond, invs: invs, body: body) then
    line(g: inout g, s: "for (;;) {")
    indent(inout g)
    let c = gen_top(g: inout g, e: cond)
    flush(inout g)
    line(g: inout g, s: "if (!" ++ c.c ++ ") break;")
    gen_loop_body(g: inout g, stmts: body)
    dedent(inout g)
    line(g: inout g, s: "}")
  case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
    let a = gen_top(g: inout g, e: lo)
    let b = gen_top(g: inout g, e: hi)
    flush(inout g)
    let lv = "l_" ++ v
    line(g: inout g, s: "for (V " ++ lv ++ " = " ++ a.c ++ "; VI(" ++ lv ++ ") < VI(" ++ b.c ++ "); " ++ lv ++ " = (V)(VI(" ++ lv ++ ") + 1)) {")
    indent(inout g)
    gen_loop_body(g: inout g, stmts: body)
    dedent(inout g)
    line(g: inout g, s: "}")
  case ForEach(name: v, list: l, invs: invs, body: body) then
    // The loop owns the list it iterates, so the body may reassign the variable it came from.
    enter_scope(inout g)
    let lv = gen_top(g: inout g, e: l)
    let owned_list = take(g: inout g, v: lv, heap: true)
    let owner = bind(g: inout g, rhs: owned_list)
    flush(inout g)
    declare_owned(g: inout g, c: owner)
    let k = fresh_tmp(inout g)
    line(g: inout g, s: "for (int64_t " ++ k ++ " = 0; " ++ k ++ " < VL(" ++ owner ++ ")->len; " ++ k ++ "++) {")
    indent(inout g)
    line(g: inout g, s: "V l_" ++ v ++ " = VB(VL(" ++ owner ++ ")->buf)->items[" ++ k ++ "];")
    gen_loop_body(g: inout g, stmts: body)
    dedent(inout g)
    line(g: inout g, s: "}")
    leave_scope(inout g)
  case Match(scrut: scrut, cases: cases, els: els) then
    gen_match(g: inout g, scrut: scrut, cases: cases, els: els)
  case Assert(e: e) then
    line(g: inout g, s: "#ifndef VOW_VERIFIED")
    let c = gen_top(g: inout g, e: e)
    flush(inout g)
    let msg = "assertion failed: " ++ pretty_expr(e)
    line(g: inout g, s: "if (!" ++ c.c ++ ") " ++ panic_at(g: g, pos: s.pos, msg: c_string(msg)))
    line(g: inout g, s: "#endif")
  case Check(e: e) then
    let c = gen_top(g: inout g, e: e)
    flush(inout g)
    let msg = "check failed: " ++ pretty_expr(e)
    line(g: inout g, s: "if (!" ++ c.c ++ ") " ++ panic_at(g: g, pos: s.pos, msg: c_string(msg)))
  case Break then
    drop_to(g: inout g, mark: loop_mark(g))
    line(g: inout g, s: "break;")
  case Continue then
    drop_to(g: inout g, mark: loop_mark(g))
    line(g: inout g, s: "continue;")
  case ExprStmt(e: e) then
    let v = gen_top(g: inout g, e: e)
    line(g: inout g, s: "(void)" ++ v.c ++ ";")
    flush(inout g)
  end match
end fn gen_stmt

fn gen_if(g: inout Gen, arms: List<Arm> where len(it) > 0, els: Option<List<Stmt>>) do
  let a = arms[0]
  let cv = gen_top(g: inout g, e: a.cond)
  flush(inout g)
  line(g: inout g, s: "if (" ++ cv.c ++ ") {")
  braced(g: inout g, stmts: a.body)
  if len(arms) > 1 then
    line(g: inout g, s: "} else {")
    indent(inout g)
    gen_if(g: inout g, arms: slice(of: arms, from: 1, to: len(arms)), els: els)
    dedent(inout g)
    line(g: inout g, s: "}")
    return
  end if
  match els
  case Some(value: b) then
    line(g: inout g, s: "} else {")
    braced(g: inout g, stmts: b)
    line(g: inout g, s: "}")
  case None then
    line(g: inout g, s: "}")
  end match
end fn gen_if

fn gen_match(g: inout Gen, scrut: Expr, cases: List<Case>, els: Option<List<Stmt>>) do
  let st = type_of(info: g.info, e: scrut)
  enter_scope(inout g)
  let sv = gen_top(g: inout g, e: scrut)
  var v = sv.c
  if is_heap(st) then
    // The match owns its scrutinee, so binders stay valid even if the arm reassigns
    // the variable it came from.
    let owned_scrut = take(g: inout g, v: sv, heap: true)
    set v = bind(g: inout g, rhs: owned_scrut)
    declare_owned(g: inout g, c: v)
  end if
  flush(inout g)
  var variants: List<VariantInfo> = []
  var is_enum = false
  match variants_of(info: g.info, t: st)
  case Some(value: vs) then
    set variants = vs
    set is_enum = true
  case None then
  end match
  var tag = v
  if is_enum then
    set tag = bind(g: inout g, rhs: "VP(" ++ v ++ ")[0]")
  end if
  var first = true
  for cs in cases do
    var cond = ""
    match cs.pat
    case PInt(value: n) then
      set cond = "VI(" ++ tag ++ ") == INT64_C(" ++ int_to_str(n) ++ ")"
    case PStr(value: s) then
      let l = str_lit(g: inout g, s: s)
      set cond = "vstr_eq(" ++ tag ++ ", " ++ l ++ ")"
    case PVariant(name: name, binds: binds) then
      set cond = tag ++ " == " ++ int_to_str(find_variant(vs: variants, name: name))
    end match
    var kw = "} else if"
    if first then
      set kw = "if"
    end if
    set first = false
    line(g: inout g, s: kw ++ " (" ++ cond ++ ") {")
    indent(inout g)
    match cs.pat
    case PVariant(name: name, binds: binds) then
      let vi = find_variant(vs: variants, name: name)
      if vi >= 0 then
        let fields = variants[vi].fields
        for b in binds do
          let fi = find_field(fields: fields, name: b.field)
          line(g: inout g, s: "V l_" ++ b.binder ++ " = VP(" ++ v ++ ")[" ++ int_to_str(fi + 1) ++ "];")
        end for
      end if
    else
    end match
    gen_scoped(g: inout g, stmts: cs.body)
    dedent(inout g)
  end for
  match els
  case Some(value: b) then
    if first then
      line(g: inout g, s: "{")
    else
      line(g: inout g, s: "} else {")
    end if
    braced(g: inout g, stmts: b)
    line(g: inout g, s: "}")
  case None then
    if not first then
      line(g: inout g, s: "} else {")
      line(g: inout g, s: "    vow_panic(\"unreachable: corrupt enum tag\");")
      line(g: inout g, s: "}")
    end if
  end match
  leave_scope(inout g)
end fn gen_match

// ---- expressions ----

fn elem_heap(t: Ty) -> Bool do
  match t
  case TList(elem: e) then
    return is_heap(e)
  else
    return false
  end match
end fn elem_heap

// Runtime flags for a map type: 1 heap keys, 2 heap values, 4 string keys.
fn map_flags(t: Ty) -> String do
  var k = Ty.TUnknown
  var v = Ty.TUnknown
  match t
  case TMap(key: kk, val: vv) then
    set k = kk
    set v = vv
  case THashMap(key: kk, val: vv) then
    set k = kk
    set v = vv
  else
    return "0"
  end match
  var f = 0
  if ty_show(k) == "String" then
    set f = 5
  end if
  if is_heap(v) then
    set f = f + 2
  end if
  return int_to_str(f)
end fn map_flags

// The runtime function prefix for a map type: ordered trees or hash tables.
fn map_ops(t: Ty) -> String do
  match t
  case THashMap(key: k, val: v) then
    return "vhm"
  else
    return "vmap"
  end match
end fn map_ops

fn flag(b: Bool) -> String do
  if b then
    return "1"
  end if
  return "0"
end fn flag

// The pointer mask for an object whose payload word i + offset holds field i.
fn field_mask(fields: List<FieldInfo>, offset: Int where it >= 0) -> String do
  var mask = 0
  var bit = 1
  for i in 0..offset do
    if bit < 4611686018427387904 then
      set bit = bit * 2
    end if
  end for
  for f in fields do
    if is_heap(f.rty.ty) then
      set mask = mask + bit
    end if
    if bit < 4611686018427387904 then
      set bit = bit * 2
    end if
  end for
  return "UINT64_C(" ++ int_to_str(mask) ++ ")"
end fn field_mask

fn gen_expr(g: inout Gen, e: Expr) -> Val do
  match e.kind
  case IntLit(value: n) then
    return plain_val("(V)INT64_C(" ++ int_to_str(n) ++ ")")
  case StrLit(value: s) then
    return plain_val(str_lit(g: inout g, s: s))
  case BoolLit(value: b) then
    if b then
      return plain_val("1")
    end if
    return plain_val("0")
  case Var(name: n) then
    if e.id == g.move_id then
      // `set` moves the variable's old value into the operation consuming it.
      set g = g with (moved: true)
      return Val(c: cvar(g: g, n: n), owned: true)
    end if
    if heap_of(g: g, e: e) and contains_str(xs: g.inout_vars, x: n) then
      // The statement passes this variable inout, which may replace it: keep our own
      // reference so nothing borrowed from it can dangle.
      return owned_tmp(g: inout g, rhs: "vdup(" ++ cvar(g: g, n: n) ++ ")", heap: true)
    end if
    // Copied so that a later inout argument in the same call cannot change it.
    return plain_val(bind(g: inout g, rhs: cvar(g: g, n: n)))
  case It then
    return plain_val("0 /* spec-only */")
  case Result then
    return plain_val("0 /* spec-only */")
  case Hole(name: n) then
    return plain_val("0 /* spec-only */")
  case Call(callee: callee, args: args) then
    return gen_call(g: inout g, e: e, args: args)
  case ListLit(items: items) then
    let eh = elem_heap(type_of(info: g.info, e: e))
    let acc = owned_tmp(g: inout g, rhs: "vlist_empty(" ++ flag(eh) ++ ")", heap: true)
    for x in items do
      let v = gen_expr(g: inout g, e: x)
      let c = take(g: inout g, v: v, heap: eh)
      line(g: inout g, s: acc.c ++ " = vlist_push(" ++ acc.c ++ ", " ++ c ++ ");")
    end for
    return acc
  case EmptyMap then
    return plain_val("vmap_empty()")
  case Index(obj: o, idx: i) then
    let ov = gen_expr(g: inout g, e: o)
    let iv = gen_expr(g: inout g, e: i)
    match type_of(info: g.info, e: o)
    case TStr then
      return plain_val(bind(g: inout g, rhs: "vstr_byte(" ++ ov.c ++ ", " ++ iv.c ++ ")"))
    else
      return plain_val(bind(g: inout g, rhs: "vlist_get(" ++ ov.c ++ ", " ++ iv.c ++ ")"))
    end match
  case Field(obj: o, name: f) then
    match call_info(info: g.info, e: e)
    case Some(value: ci) then
      if ci.kind == "variant" then
        // A variant written without its fields has none, or only Unit ones (zero).
        var k = 0
        match variants_of(info: g.info, t: type_of(info: g.info, e: e))
        case Some(value: vs) then
          if (ci.variant >= 0) and (ci.variant < len(vs)) then
            set k = len(vs[ci.variant].fields)
          end if
        case None then
        end match
        if k == 0 then
          return owned_tmp(g: inout g, rhs: "vow_variant0(" ++ int_to_str(ci.variant) ++ ")", heap: true)
        end if
        let r = owned_tmp(g: inout g, rhs: "vow_fields(" ++ int_to_str(k + 1) ++ ", 0)", heap: true)
        line(g: inout g, s: "VP(" ++ r.c ++ ")[0] = " ++ int_to_str(ci.variant) ++ ";")
        return r
      end if
    case None then
    end match
    var sn = ""
    match type_of(info: g.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fi = find_field(fields: struct_fields(info: g.info, name: sn), name: f)
    if int_list_contains(xs: g.steal_ids, x: e.id) then
      match o.kind
      case Var(name: n) then
        // Moved out of the variable for an update that writes it back (see steal_candidates).
        return owned_tmp(g: inout g, rhs: "vow_steal(" ++ cvar(g: g, n: n) ++ ", " ++ int_to_str(fi) ++ ")", heap: true)
      else
      end match
    end if
    let ov = gen_expr(g: inout g, e: o)
    return plain_val(bind(g: inout g, rhs: "VP(" ++ ov.c ++ ")[" ++ int_to_str(fi) ++ "]"))
  case With(obj: o, args: args) then
    let ov = gen_expr(g: inout g, e: o)
    var sn = ""
    match type_of(info: g.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fields = struct_fields(info: g.info, name: sn)
    var vals: List<Val> = []
    for a in args do
      let v = gen_expr(g: inout g, e: a.value)
      set vals = push(list: vals, item: v)
    end for
    let base = take(g: inout g, v: ov, heap: true)
    var cs: List<String> = []
    for i in 0..len(args) do
      if i < len(vals) then
        let fi = find_field(fields: fields, name: args[i].name)
        var fh = false
        if (fi >= 0) and (fi < len(fields)) then
          set fh = is_heap(fields[fi].rty.ty)
        end if
        let c = take(g: inout g, v: vals[i], heap: fh)
        set cs = push(list: cs, item: c)
      end if
    end for
    let r = owned_tmp(g: inout g, rhs: "vow_with(" ++ base ++ ")", heap: true)
    for i in 0..len(args) do
      if i < len(cs) then
        let fi = find_field(fields: fields, name: args[i].name)
        if (fi >= 0) and (fi < len(fields)) and is_heap(fields[fi].rty.ty) then
          line(g: inout g, s: "vdrop(VP(" ++ r.c ++ ")[" ++ int_to_str(fi) ++ "]);")
        end if
        line(g: inout g, s: "VP(" ++ r.c ++ ")[" ++ int_to_str(fi) ++ "] = " ++ cs[i] ++ ";")
      end if
    end for
    return r
  case Unary(op: op, x: x) then
    let v = gen_expr(g: inout g, e: x)
    if op == "-" then
      return plain_val(bind(g: inout g, rhs: "vneg(" ++ v.c ++ ")"))
    end if
    return plain_val(bind(g: inout g, rhs: "(V)!" ++ v.c))
  case Binary(op: op, l: l, r: r) then
    return gen_binary(g: inout g, op: op, l: l, r: r)
  case Quant(q: q, name: v, lo: lo, hi: hi, body: body) then
    let a = gen_expr(g: inout g, e: lo)
    let b = gen_expr(g: inout g, e: hi)
    let is_forall = q == "forall"
    var init = "0"
    if is_forall then
      set init = "1"
    end if
    let t = bind(g: inout g, rhs: init)
    let lv = "l_" ++ v
    line(g: inout g, s: "for (V " ++ lv ++ " = " ++ a.c ++ "; VI(" ++ lv ++ ") < VI(" ++ b.c ++ "); " ++ lv ++ " = (V)(VI(" ++ lv ++ ") + 1)) {")
    indent(inout g)
    push_frame(inout g)
    let bv = gen_expr(g: inout g, e: body)
    pop_frame(inout g)
    if is_forall then
      line(g: inout g, s: "if (!" ++ bv.c ++ ") { " ++ t ++ " = 0; break; }")
    else
      line(g: inout g, s: "if (" ++ bv.c ++ ") { " ++ t ++ " = 1; break; }")
    end if
    dedent(inout g)
    line(g: inout g, s: "}")
    return plain_val(t)
  end match
end fn gen_expr

fn gen_binary(g: inout Gen, op: String, l: Expr, r: Expr) -> Val do
  if (op == "and") or (op == "or") or (op == "implies") then
    let a = gen_expr(g: inout g, e: l)
    var init = a.c
    if op == "implies" then
      set init = "1"
    end if
    let t = bind(g: inout g, rhs: init)
    var guard = a.c
    if op == "or" then
      set guard = "!" ++ t
    end if
    line(g: inout g, s: "if (" ++ guard ++ ") {")
    indent(inout g)
    push_frame(inout g)
    let b = gen_expr(g: inout g, e: r)
    line(g: inout g, s: t ++ " = " ++ b.c ++ ";")
    pop_frame(inout g)
    dedent(inout g)
    line(g: inout g, s: "}")
    return plain_val(t)
  end if
  let a = gen_expr(g: inout g, e: l)
  let b = gen_expr(g: inout g, e: r)
  let is_str = ty_show(type_of(info: g.info, e: l)) == "String"
  match op
  case "++" then
    if is_str then
      return owned_tmp(g: inout g, rhs: "vstr_cat(" ++ a.c ++ ", " ++ b.c ++ ")", heap: true)
    end if
    let ac = take(g: inout g, v: a, heap: true)
    return owned_tmp(g: inout g, rhs: "vlist_cat(" ++ ac ++ ", " ++ b.c ++ ")", heap: true)
  case "+" then
    return plain_val(bind(g: inout g, rhs: "vadd(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "-" then
    return plain_val(bind(g: inout g, rhs: "vsub(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "*" then
    return plain_val(bind(g: inout g, rhs: "vmul(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "/" then
    return plain_val(bind(g: inout g, rhs: "vdiv(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "%" then
    return plain_val(bind(g: inout g, rhs: "vmod(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "==" then
    let t = type_of(info: g.info, e: l)
    let cmp = c_eq(g: inout g, t: t, a: a.c, b: b.c)
    return plain_val(bind(g: inout g, rhs: "(V)" ++ cmp))
  case "!=" then
    let t = type_of(info: g.info, e: l)
    let cmp = c_eq(g: inout g, t: t, a: a.c, b: b.c)
    return plain_val(bind(g: inout g, rhs: "(V)!" ++ cmp))
  else
    return plain_val(bind(g: inout g, rhs: "(V)(VI(" ++ a.c ++ ") " ++ op ++ " VI(" ++ b.c ++ "))"))
  end match
end fn gen_binary

// ---- structural equality ----

fn eq_c_name(t: Ty) -> String do
  return "veq_" ++ mangle(ty_show(t))
end fn eq_c_name

// A C expression comparing a and b, values of type t (both borrowed).
fn c_eq(g: inout Gen, t: Ty, a: String, b: String) -> String do
  if ty_show(t) == "String" then
    return "vstr_eq(" ++ a ++ ", " ++ b ++ ")"
  end if
  if simple_eq(t) then
    return "(" ++ a ++ " == " ++ b ++ ")"
  end if
  let name = eq_c_name(t)
  var known = false
  for x in g.eqs do
    if eq_c_name(x) == name then
      set known = true
    end if
  end for
  if not known then
    set g = g with (eqs: push(list: g.eqs, item: t))
  end if
  return name ++ "(" ++ a ++ ", " ++ b ++ ")"
end fn c_eq

// The definition of the equality function for t: shared values are equal at once,
// otherwise the parts are compared in order.
fn gen_eq_fn(g: inout Gen, t: Ty) -> List<String> do
  var out = ["static V " ++ eq_c_name(t) ++ "(V a, V b) {", "    if (a == b) return 1;"]
  match t
  case TStruct(name: n) then
    let fields = struct_fields(info: g.info, name: n)
    for i in 0..len(fields) do
      let at = "VP(a)[" ++ int_to_str(i) ++ "]"
      let bt = "VP(b)[" ++ int_to_str(i) ++ "]"
      set out = push(list: out, item: "    if (!" ++ c_eq(g: inout g, t: fields[i].rty.ty, a: at, b: bt) ++ ") return 0;")
    end for
  case TList(elem: et) then
    set out = push(list: out, item: "    if (VL(a)->len != VL(b)->len) return 0;")
    set out = push(list: out, item: "    for (int64_t i = 0; i < VL(a)->len; i++) {")
    let at = "VB(VL(a)->buf)->items[i]"
    let bt = "VB(VL(b)->buf)->items[i]"
    set out = push(list: out, item: "        if (!" ++ c_eq(g: inout g, t: et, a: at, b: bt) ++ ") return 0;")
    set out = push(list: out, item: "    }")
  else
    match variants_of(info: g.info, t: t)
    case Some(value: vs) then
      set out = push(list: out, item: "    if (VP(a)[0] != VP(b)[0]) return 0;")
      set out = push(list: out, item: "    switch (VP(a)[0]) {")
      for i in 0..len(vs) do
        let fields = vs[i].fields
        if len(fields) > 0 then
          set out = push(list: out, item: "    case " ++ int_to_str(i) ++ ":")
          for k in 0..len(fields) do
            let at = "VP(a)[" ++ int_to_str(k + 1) ++ "]"
            let bt = "VP(b)[" ++ int_to_str(k + 1) ++ "]"
            set out = push(list: out, item: "        if (!" ++ c_eq(g: inout g, t: fields[k].rty.ty, a: at, b: bt) ++ ") return 0;")
          end for
          set out = push(list: out, item: "        break;")
        end if
      end for
      set out = push(list: out, item: "    }")
    case None then
    end match
  end match
  set out = push(list: out, item: "    return 1;")
  set out = push(list: out, item: "}")
  set out = push(list: out, item: "")
  return out
end fn gen_eq_fn

fn gen_call(g: inout Gen, e: Expr, args: List<Arg>) -> Val do
  var ci = CallInfo(kind: "", name: "", variant: 0, order: [])
  match call_info(info: g.info, e: e)
  case Some(value: x) then
    set ci = x
  case None then
  end match
  // Evaluate arguments in written order, then pass them in parameter order.
  var vals: List<Val> = []
  for a in args do
    var v = plain_val("0")
    var done = false
    if a.is_inout then
      match a.value.kind
      case Var(name: n) then
        if contains_str(xs: g.io_params, x: n) then
          set v = plain_val("l_" ++ n)
        else
          set v = plain_val("&l_" ++ n)
        end if
        set done = true
      else
      end match
    end if
    if not done then
      set v = gen_expr(g: inout g, e: a.value)
    end if
    set vals = push(list: vals, item: v)
  end for
  var p: List<Val> = []
  var pe: List<Expr> = []
  for i in ci.order do
    if (i >= 0) and (i < len(vals)) and (i < len(args)) then
      set p = push(list: p, item: vals[i])
      set pe = push(list: pe, item: args[i].value)
    end if
  end for
  let rh = heap_of(g: g, e: e)
  if ci.kind == "user" then
    // Parameters are borrowed: the arguments stay owned by this statement.
    var cs: List<String> = []
    for v in p do
      set cs = push(list: cs, item: v.c)
    end for
    return owned_tmp(g: inout g, rhs: c_fn(ci.name) ++ "(" ++ join(parts: cs, sep: ", ") ++ ")", heap: rh)
  end if
  if (ci.kind == "struct") or (ci.kind == "variant") then
    var fields: List<FieldInfo> = []
    var offset = 0
    if ci.kind == "struct" then
      set fields = struct_fields(info: g.info, name: ci.name)
    else
      set offset = 1
      match variants_of(info: g.info, t: type_of(info: g.info, e: e))
      case Some(value: vs) then
        if (ci.variant >= 0) and (ci.variant < len(vs)) then
          set fields = vs[ci.variant].fields
        end if
      case None then
      end match
    end if
    var cs: List<String> = []
    for i in 0..len(p) do
      var fh = false
      if i < len(fields) then
        set fh = is_heap(fields[i].rty.ty)
      end if
      let c = take(g: inout g, v: p[i], heap: fh)
      set cs = push(list: cs, item: c)
    end for
    let r = owned_tmp(g: inout g, rhs: "vow_fields(" ++ int_to_str(len(p) + offset) ++ ", " ++ field_mask(fields: fields, offset: offset) ++ ")", heap: true)
    if offset == 1 then
      line(g: inout g, s: "VP(" ++ r.c ++ ")[0] = " ++ int_to_str(ci.variant) ++ ";")
    end if
    for i in 0..len(cs) do
      line(g: inout g, s: "VP(" ++ r.c ++ ")[" ++ int_to_str(i + offset) ++ "] = " ++ cs[i] ++ ";")
    end for
    return r
  end if
  return gen_builtin(g: inout g, e: e, name: ci.name, p: p, pe: pe)
end fn gen_call

fn arg_val(p: List<Val>, i: Int) -> Val do
  if (i >= 0) and (i < len(p)) then
    return p[i]
  end if
  return plain_val("0")
end fn arg_val

fn gen_builtin(g: inout Gen, e: Expr, name: String, p: List<Val>, pe: List<Expr>) -> Val do
  let v0 = arg_val(p: p, i: 0)
  let v1 = arg_val(p: p, i: 1)
  let v2 = arg_val(p: p, i: 2)
  var t0 = Ty.TUnknown
  if len(pe) > 0 then
    set t0 = type_of(info: g.info, e: pe[0])
  end if
  let s0 = ty_show(t0)
  let rt = type_of(info: g.info, e: e)
  let rh = is_heap(rt)
  match name
  case "len" then
    if s0 == "String" then
      return plain_val(bind(g: inout g, rhs: "vstr_len(" ++ v0.c ++ ")"))
    elif starts_with(s: s0, p: "Map<") or starts_with(s: s0, p: "HashMap<") then
      return plain_val(bind(g: inout g, rhs: map_ops(t0) ++ "_len(" ++ v0.c ++ ")"))
    end if
    return plain_val(bind(g: inout g, rhs: "vlist_len(" ++ v0.c ++ ")"))
  case "push" then
    let l = take(g: inout g, v: v0, heap: true)
    let x = take(g: inout g, v: v1, heap: elem_heap(t0))
    return owned_tmp(g: inout g, rhs: "vlist_push(" ++ l ++ ", " ++ x ++ ")", heap: true)
  case "set_at" then
    let l = take(g: inout g, v: v0, heap: true)
    let x = take(g: inout g, v: v2, heap: elem_heap(t0))
    return owned_tmp(g: inout g, rhs: "vlist_set_at(" ++ l ++ ", " ++ v1.c ++ ", " ++ x ++ ")", heap: true)
  case "slice" then
    if s0 == "String" then
      return owned_tmp(g: inout g, rhs: "vstr_slice(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ v2.c ++ ")", heap: true)
    end if
    return owned_tmp(g: inout g, rhs: "vlist_slice(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ v2.c ++ ")", heap: true)
  case "join" then
    return owned_tmp(g: inout g, rhs: "vjoin(" ++ v0.c ++ ", " ++ v1.c ++ ")", heap: true)
  case "int_to_str" then
    return owned_tmp(g: inout g, rhs: "vint_to_str(" ++ v0.c ++ ")", heap: true)
  case "str_to_int" then
    return owned_tmp(g: inout g, rhs: "vstr_to_int(" ++ v0.c ++ ")", heap: true)
  case "char" then
    return owned_tmp(g: inout g, rhs: "vchar(" ++ v0.c ++ ")", heap: true)
  case "hash" then
    return owned_tmp(g: inout g, rhs: "vhash(" ++ v0.c ++ ")", heap: true)
  case "insert" then
    let f = map_flags(t0)
    var kh = false
    var vh = false
    match t0
    case TMap(key: k, val: v) then
      set kh = is_heap(k)
      set vh = is_heap(v)
    case THashMap(key: k, val: v) then
      set kh = is_heap(k)
      set vh = is_heap(v)
    else
    end match
    let m = take(g: inout g, v: v0, heap: true)
    let k = take(g: inout g, v: v1, heap: kh)
    let x = take(g: inout g, v: v2, heap: vh)
    return owned_tmp(g: inout g, rhs: map_ops(t0) ++ "_insert(" ++ m ++ ", " ++ k ++ ", " ++ x ++ ", " ++ f ++ ")", heap: true)
  case "lookup" then
    return owned_tmp(g: inout g, rhs: map_ops(t0) ++ "_lookup(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ map_flags(t0) ++ ")", heap: true)
  case "has" then
    return plain_val(bind(g: inout g, rhs: map_ops(t0) ++ "_has(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ map_flags(t0) ++ ")"))
  case "keys" then
    return owned_tmp(g: inout g, rhs: map_ops(t0) ++ "_keys(" ++ v0.c ++ ", " ++ map_flags(t0) ++ ")", heap: true)
  case "panic" then
    line(g: inout g, s: panic_at(g: g, pos: e.pos, msg: "VS(" ++ v0.c ++ ")->data"))
    return plain_val("0")
  case "exit" then
    line(g: inout g, s: "vexit(" ++ v0.c ++ ");")
    return plain_val("0")
  case "print" then
    return plain_val(bind(g: inout g, rhs: "vprint(" ++ v0.c ++ ")"))
  case "eprint" then
    return plain_val(bind(g: inout g, rhs: "veprint(" ++ v0.c ++ ")"))
  case "read_file" then
    return owned_tmp(g: inout g, rhs: "vread_file(" ++ v0.c ++ ")", heap: true)
  case "write_file" then
    return plain_val(bind(g: inout g, rhs: "vwrite_file(" ++ v0.c ++ ", " ++ v1.c ++ ")"))
  case "args" then
    return owned_tmp(g: inout g, rhs: "vargs()", heap: true)
  case "make_dir" then
    return plain_val(bind(g: inout g, rhs: "vmake_dir(" ++ v0.c ++ ")"))
  case "list_dir" then
    return owned_tmp(g: inout g, rhs: "vlist_dir(" ++ v0.c ++ ")", heap: true)
  case "getenv" then
    return owned_tmp(g: inout g, rhs: "vgetenv(" ++ v0.c ++ ")", heap: true)
  case "read_line" then
    return owned_tmp(g: inout g, rhs: "vread_line()", heap: true)
  case "read_bytes" then
    return owned_tmp(g: inout g, rhs: "vread_bytes(" ++ v0.c ++ ")", heap: true)
  case "run" then
    return owned_tmp(g: inout g, rhs: "vrun(" ++ v0.c ++ ", " ++ v1.c ++ ")", heap: true)
  case "is_some" then
    return plain_val(bind(g: inout g, rhs: "(V)(VP(" ++ v0.c ++ ")[0] == 1)"))
  case "is_none" then
    return plain_val(bind(g: inout g, rhs: "(V)(VP(" ++ v0.c ++ ")[0] == 0)"))
  case "value_or" then
    let d = take(g: inout g, v: v1, heap: rh)
    return owned_tmp(g: inout g, rhs: "vvalue_or(" ++ v0.c ++ ", " ++ d ++ ", " ++ flag(rh) ++ ")", heap: rh)
  else
    return plain_val("0")
  end match
end fn gen_builtin
