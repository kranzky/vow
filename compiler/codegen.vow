// C code generation with reference counting. Every expression is lowered to
// temporaries in written order, because C leaves argument evaluation order
// unspecified.
//
// Ownership: each value is either owned (the code holds a reference that must be
// consumed or dropped) or borrowed (valid while its owner lives). Owned temporaries not
// consumed by the end of a statement are dropped; owned locals are dropped when their
// scope ends, including on return, break and continue. Parameters are borrowed. In
// `set x = op(x, ...)`, when op consumes x (with, push, set_at, insert, list ++), the
// old value is moved into op instead of duplicated, so op can update it in place.
// See runtime/vow_rt.h for which runtime functions consume their arguments.

import "check.vow"
import "pretty.vow"
import "hash.vow"

struct Val
  c: String,
  owned: Bool,
end struct Val

struct Gen
  info: Info,
  files: List<String>,
  out: List<String>,
  ind: Int,
  tmp: Int,
  strs: List<String>,
  str_index: Map<String, Int>,
  io_params: List<String>,
  // The variables of the function being generated that it assigns or passes inout
  // (an inout parameter included): any other keeps its value while it is in scope.
  changed: List<String>,
  // Owned locals (and scoped temporaries) in enclosing scopes, innermost last.
  owned_vars: List<String>,
  scope_marks: List<Int>,
  loop_marks: List<Int>,
  // Owned temporaries of the statement being generated; nested C blocks push marks.
  temps: List<String>,
  temp_marks: List<Int>,
  // The Var expression whose value `set` moves into a consuming operation, or -1.
  move_id: Int,
  moved: Bool,
  // Variables passed inout somewhere in the current statement.
  inout_vars: List<String>,
  // Field reads `x.f` whose value `set x = x with (f: op(x.f, ...))` moves out of x.
  steal_ids: List<Int>,
  // Types compared with '==' part by part, each needing a veq_ function.
  eqs: List<Ty>,
  // The source position of the code being generated, and the .vow line (and file) the
  // next C line is attributed to, given the #line directives so far (-1: none yet).
  src: Pos,
  mapped_file: Int,
  mapped_next: Int,
  // Whether to emit #line directives at all.
  lines: Bool,
  // --check-contracts: contracts, refinements, invariants and measures are checked at
  // runtime too. fname is the function being generated; it_c and result_c the C values
  // of 'it' and 'result' while a check is generated; olds the entry values of inout
  // parameters; spec_binds C values for names in a field refinement (its sibling
  // fields); var_preds the refinements of vars and inout parameters; and for each
  // enclosing loop, innermost last, its invariants, its measure's parts and their
  // values when the iteration began (none if no measure); dec_c the C variables holding
  // the parts of the function's own measure on entry (none if none), and ranks the types whose values a structural
  // measure measures, each needing a vrank_ function.
  contracts: Bool,
  fname: String,
  it_c: String,
  result_c: String,
  olds: Map<String, String>,
  spec_binds: Map<String, String>,
  // While a specification is being generated: its integer arithmetic is exact (see
  // gen_wide), and when that cannot be done the panic names the specification, by
  // exact_what at exact_pos.
  exact: Bool,
  exact_pos: Pos,
  exact_what: String,
  var_preds: Map<String, RTy>,
  loop_invs: List<List<Expr>>,
  loop_dec: List<List<Expr>>,
  loop_m: List<List<String>>,
  dec_c: List<String>,
  // For each part of the function's measure: "" when dec_c holds its value on entry;
  // or, for a structural part that is a parameter, the parameter's C name. Its rank
  // is then computed only if a call needs it (dec_c keeps it; see vow_rank_cmp).
  dec_lazy: List<String>,
  ranks: List<Ty>,
  // The pointer bitmaps of wide objects (new_fields): bitmap i is the C array vow_wide_i.
  wide: List<String>,
end struct Gen

fn c_string(s: String) -> String do
  var parts: List<String> = ["\""]
  for i in 0..len(s) do
    let b = s[i]
    if b == '"' then
      set parts = push(list: parts, item: "\\\"")
    elif b == '\\' then
      set parts = push(list: parts, item: "\\\\")
    elif b == '?' then
      set parts = push(list: parts, item: "\\?")
    elif (b >= 32) and (b <= 126) then
      set parts = push(list: parts, item: char(b))
    else
      set parts = push(list: parts, item: "\\" ++ octal3(b))
    end if
  end for
  set parts = push(list: parts, item: "\"")
  return join(parts: parts, sep: "")
end fn c_string

// An Int as a C constant. The smallest has no literal in C either.
fn c_int(n: Int) -> String do
  if n == ((0 - 9223372036854775807) - 1) then
    return "INT64_MIN"
  end if
  return "INT64_C(" ++ int_to_str(n) ++ ")"
end fn c_int

fn c_params(f: FnDecl) -> String do
  if len(f.params) == 0 then
    return "void"
  end if
  var ps: List<String> = []
  for p in f.params do
    if p.is_inout then
      set ps = push(list: ps, item: "V * l_" ++ p.name)
    else
      set ps = push(list: ps, item: "V l_" ++ p.name)
    end if
  end for
  return join(parts: ps, sep: ", ")
end fn c_params

// tests: functions the program runs instead of main when started as
// `program --vow-test <name>` (vowc test).
fn generate(items: List<Item>, info: Info, files: List<String>, verified: Bool, lines: Bool,
    tests: List<String>, contracts: Bool) -> String do
  var g = Gen(info: info, files: files, out: [], ind: 0, tmp: 0, strs: [], str_index: {}, io_params: [], changed: [],
    owned_vars: [], scope_marks: [], loop_marks: [], temps: [], temp_marks: [], move_id: -1,
    moved: false, inout_vars: [], steal_ids: [], eqs: [], src: no_pos(), mapped_file: -1, mapped_next: -1, lines: lines,
    contracts: contracts, fname: "", it_c: "", result_c: "", olds: {}, spec_binds: {}, exact: false,
    exact_pos: no_pos(), exact_what: "", var_preds: {}, loop_invs: [], loop_dec: [], loop_m: [], dec_c: [], dec_lazy: [], ranks: [], wide: [])
  // Generic functions are compiled through their instances.
  var fns: List<FnDecl> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      if len(f.tparams) == 0 then
        set fns = push(list: fns, item: f)
      end if
    else
    end match
  end for
  set fns = fns ++ info.instances
  var body: List<String> = []
  for f in fns do
    set g = g with (out: [], tmp: 0)
    gen_function(g: inout g, f: f)
    set body = body ++ g.out
  end for
  var c: List<String> = ["// Generated by vowc. Do not edit."]
  // A build with contract checks keeps the runtime's own checks (bounds and the like)
  // too, which a verified build leaves out.
  if verified and not contracts then
    set c = push(list: c, item: "#define VOW_VERIFIED 1")
  end if
  set c = push(list: c, item: "#include \"vow_rt.h\"")
  if contracts then
    // How many specifications are being evaluated. The functions they call do not check
    // their own contracts: those are proved, and checking them could recurse forever
    // (a postcondition that calls its own function).
    set c = push(list: c, item: "static int vow_spec_depth = 0;")
  end if
  set c = push(list: c, item: "")
  var n = len(g.strs)
  if n < 1 then
    set n = 1
  end if
  set c = push(list: c, item: "static V vow_s[" ++ int_to_str(n) ++ "];")
  for f in fns do
    set c = push(list: c, item: "static V " ++ c_fn(f.name) ++ "(" ++ c_params(f) ++ ");")
  end for
  // Equality functions; generating one can call for more.
  var eq_defs: List<String> = []
  var done = 0
  while done < len(g.eqs) invariant done >= 0 do
    let t = g.eqs[done]
    set done = done + 1
    set eq_defs = eq_defs ++ gen_eq_fn(g: inout g, t: t)
  end while
  for t in g.eqs do
    set c = push(list: c, item: "static int " ++ eq_step_name(t) ++ "(V a, V b);")
  end for
  // Rank functions for structural measures (checked builds); likewise.
  var rank_defs: List<String> = []
  var rdone = 0
  while rdone < len(g.ranks) invariant rdone >= 0 do
    let t = g.ranks[rdone]
    set rdone = rdone + 1
    set rank_defs = rank_defs ++ gen_rank_fn(g: inout g, t: t)
  end while
  for t in g.ranks do
    set c = push(list: c, item: "static int " ++ rank_step_name(t) ++ "(V a, V d);")
  end for
  for i in 0..len(g.wide) do
    set c = push(list: c, item: "static const uint64_t vow_wide_" ++ int_to_str(i) ++ "[] = {" ++ g.wide[i] ++ "};")
  end for
  set c = push(list: c, item: "")
  set c = c ++ eq_defs ++ rank_defs
  // The functions come last: from their first #line directive on, every C line is
  // attributed to Vow source.
  // The string literals are made from a table, in a loop: with a statement for each
  // one, a C compiler takes time that grows with the square of their number.
  if len(g.strs) > 0 then
    set c = push(list: c, item: "static const struct { const char *text; int64_t len; } vow_lit[" ++ int_to_str(len(g.strs)) ++ "] = {")
    for s in g.strs do
      set c = push(list: c, item: "    {" ++ c_string(s) ++ ", " ++ int_to_str(len(s)) ++ "},")
    end for
    set c = push(list: c, item: "};")
    set c = push(list: c, item: "")
  end if
  set c = push(list: c, item: "int main(int argc, char **argv) {")
  set c = push(list: c, item: "    vow_guard_stack(&argc);")
  set c = push(list: c, item: "    vow_argc = argc;")
  set c = push(list: c, item: "    vow_argv = argv;")
  if len(g.strs) > 0 then
    set c = push(list: c, item: "    for (int64_t i = 0; i < " ++ int_to_str(len(g.strs)) ++ "; i++) vow_s[i] = vow_immortal(vstr_new(vow_lit[i].text, vow_lit[i].len));")
  end if
  if len(tests) > 0 then
    set c = push(list: c, item: "    if (argc == 3 && strcmp(argv[1], \"--vow-test\") == 0) {")
    set c = push(list: c, item: "        vow_argc = 1;")
    var kw = "if"
    for t in tests do
      set c = push(list: c, item: "        " ++ kw ++ " (strcmp(argv[2], " ++ c_string(t) ++ ") == 0) " ++ c_fn(t) ++ "();")
      set kw = "else if"
    end for
    set c = push(list: c, item: "        else return 2;")
    set c = push(list: c, item: "        vow_flush_stdout();")
    set c = push(list: c, item: "        vow_report_leaks();")
    set c = push(list: c, item: "        return 0;")
    set c = push(list: c, item: "    }")
  end if
  if is_some(get_fn(info: info, name: "main")) then
    set c = push(list: c, item: "    f_main();")
  end if
  set c = push(list: c, item: "    vow_flush_stdout();")
  set c = push(list: c, item: "    vow_report_leaks();")
  set c = push(list: c, item: "    return 0;")
  set c = push(list: c, item: "}")
  set c = push(list: c, item: "")
  set c = c ++ body
  return join(parts: c, sep: "\n") ++ "\n"
end fn generate

// ---- emitting ----

// Emits a C line, preceded by a #line directive when it would otherwise be attributed
// to the wrong .vow line, so that C compiler errors, debuggers and runtime panics point
// at the Vow source.
fn line(g: inout Gen, s: String) do
  let p = g.src
  if g.lines and (p.file >= 0) and (p.file < len(g.files)) and (p.line > 0) then
    if (p.file != g.mapped_file) or (p.line != g.mapped_next) then
      set g = g with (out: push(list: g.out, item: "#line " ++ int_to_str(p.line) ++ " " ++ c_string(g.files[p.file])),
        mapped_file: p.file, mapped_next: p.line)
    end if
  end if
  set g = g with (out: push(list: g.out, item: repeat(s: "    ", n: g.ind) ++ s))
  if g.mapped_file >= 0 then
    set g = g with (mapped_next: g.mapped_next + 1)
  end if
end fn line

fn fresh_tmp(g: inout Gen) -> String do
  set g = g with (tmp: g.tmp + 1)
  return "t" ++ int_to_str(g.tmp)
end fn fresh_tmp

fn bind(g: inout Gen, rhs: String) -> String do
  let t = fresh_tmp(inout g)
  line(g: inout g, s: "V " ++ t ++ " = " ++ rhs ++ ";")
  return t
end fn bind

fn str_lit(g: inout Gen, s: String) -> String do
  match lookup(map: g.str_index, key: s)
  case Some(value: i) then
    return "vow_s[" ++ int_to_str(i) ++ "]"
  case None then
    let i = len(g.strs)
    set g = g with (strs: push(list: g.strs, item: s), str_index: insert(map: g.str_index, key: s, value: i))
    return "vow_s[" ++ int_to_str(i) ++ "]"
  end match
end fn str_lit

fn loc(g: Gen, pos: Pos) -> String do
  var f = "?"
  if (pos.file >= 0) and (pos.file < len(g.files)) then
    set f = g.files[pos.file]
  end if
  return f ++ ":" ++ int_to_str(pos.line)
end fn loc

// A call that panics with message msg (a C expression), naming the source position
// explicitly, so that it does not depend on #line directives.
fn panic_at(g: Gen, pos: Pos, msg: String) -> String do
  var f = "?"
  if (pos.file >= 0) and (pos.file < len(g.files)) then
    set f = g.files[pos.file]
  end if
  return "vow_panic_at(" ++ c_string(f) ++ ", " ++ int_to_str(pos.line) ++ ", " ++ msg ++ ");"
end fn panic_at

// The C name of a function: f_name, i_ and the mangled name for an instance of a
// generic function, or m_ and the mangled name for a function in a module.
fn c_fn(name: String) -> String do
  if is_instance_name(name) then
    return "i_" ++ mangle(name)
  end if
  if find_byte(s: name, c: '.', from: 0) >= 0 then
    return "m_" ++ mangle(name)
  end if
  return "f_" ++ name
end fn c_fn

fn cvar(g: Gen, n: String) -> String do
  if contains_str(xs: g.io_params, x: n) then
    return "(*l_" ++ n ++ ")"
  end if
  return "l_" ++ n
end fn cvar

fn indent(g: inout Gen) do
  set g = g with (ind: g.ind + 1)
end fn indent

fn dedent(g: inout Gen) do
  set g = g with (ind: g.ind - 1)
end fn dedent

// ---- ownership ----

fn is_heap(t: Ty) -> Bool do
  match t
  case TInt then
    return false
  case TFloat then
    return false
  case TBool then
    return false
  case TUnit then
    return false
  case TUnknown then
    return false
  else
    return true
  end match
end fn is_heap

fn heap_of(g: Gen, e: Expr) -> Bool do
  return is_heap(type_of(info: g.info, e: e))
end fn heap_of

fn plain_val(c: String) -> Val do
  return Val(c: c, owned: false)
end fn plain_val

// A new owned temporary holding rhs (or a plain one, for non-heap values).
fn owned_tmp(g: inout Gen, rhs: String, heap: Bool) -> Val do
  let t = bind(g: inout g, rhs: rhs)
  if heap then
    set g = g with (temps: push(list: g.temps, item: t))
  end if
  return Val(c: t, owned: heap)
end fn owned_tmp

fn remove_last(xs: List<String>, x: String) -> List<String> do
  var i = len(xs) - 1
  while i >= 0 invariant i < len(xs) decreases i + 1 do
    if xs[i] == x then
      return slice(of: xs, from: 0, to: i) ++ slice(of: xs, from: i + 1, to: len(xs))
    end if
    set i = i - 1
  end while
  return xs
end fn remove_last

// An owned reference to v for a consuming position: an owned temporary is moved, a
// borrowed value is duplicated.
fn take(g: inout Gen, v: Val, heap: Bool) -> String do
  if not heap then
    return v.c
  end if
  if v.owned then
    set g = g with (temps: remove_last(xs: g.temps, x: v.c))
    return v.c
  end if
  line(g: inout g, s: "vdup(" ++ v.c ++ ");")
  return v.c
end fn take

// Drops the owned temporaries above the innermost mark.
fn flush(g: inout Gen) do
  var mark = 0
  let nm = len(g.temp_marks)
  if nm > 0 then
    set mark = g.temp_marks[nm - 1]
  end if
  let ts = g.temps
  var i = len(ts) - 1
  while (i >= mark) and (i >= 0) invariant i < len(ts) decreases i + 1 do
    line(g: inout g, s: "vdrop(" ++ ts[i] ++ ");")
    set i = i - 1
  end while
  if (mark >= 0) and (mark <= len(g.temps)) then
    set g = g with (temps: slice(of: g.temps, from: 0, to: mark))
  end if
end fn flush

fn push_frame(g: inout Gen) do
  set g = g with (temp_marks: push(list: g.temp_marks, item: len(g.temps)))
end fn push_frame

fn pop_frame(g: inout Gen) do
  flush(inout g)
  let n = len(g.temp_marks)
  if n > 0 then
    set g = g with (temp_marks: slice(of: g.temp_marks, from: 0, to: n - 1))
  end if
end fn pop_frame

fn declare_owned(g: inout Gen, c: String) do
  set g = g with (owned_vars: push(list: g.owned_vars, item: c))
end fn declare_owned

fn enter_scope(g: inout Gen) do
  set g = g with (scope_marks: push(list: g.scope_marks, item: len(g.owned_vars)))
end fn enter_scope

// Emits drops for the owned variables above mark, innermost first, without forgetting
// them (other paths still need them).
fn drop_to(g: inout Gen, mark: Int) do
  let vs = g.owned_vars
  var i = len(vs) - 1
  while (i >= mark) and (i >= 0) invariant i < len(vs) decreases i + 1 do
    line(g: inout g, s: "vdrop(" ++ vs[i] ++ ");")
    set i = i - 1
  end while
end fn drop_to

fn leave_scope(g: inout Gen) do
  let marks = g.scope_marks
  let n = len(marks)
  if n == 0 then
    return
  end if
  let mark = marks[n - 1]
  drop_to(g: inout g, mark: mark)
  if (mark >= 0) and (mark <= len(g.owned_vars)) then
    set g = g with (owned_vars: slice(of: g.owned_vars, from: 0, to: mark))
  end if
  set g = g with (scope_marks: slice(of: marks, from: 0, to: n - 1))
end fn leave_scope

// ---- which variables a statement passes inout ----

fn inout_in_expr(e: Expr, out: inout List<String>) do
  match e.kind
  case Call(callee: c, args: args) then
    for a in args do
      if a.is_inout then
        match a.value.kind
        case Var(name: n) then
          set out = push(list: out, item: n)
        else
        end match
      end if
      inout_in_expr(e: a.value, out: inout out)
    end for
  case With(obj: o, args: args) then
    inout_in_expr(e: o, out: inout out)
    for a in args do
      inout_in_expr(e: a.value, out: inout out)
    end for
  case ListLit(items: items) then
    for x in items do
      inout_in_expr(e: x, out: inout out)
    end for
  case Index(obj: a, idx: b) then
    inout_in_expr(e: a, out: inout out)
    inout_in_expr(e: b, out: inout out)
  case Binary(op: op, l: a, r: b) then
    inout_in_expr(e: a, out: inout out)
    inout_in_expr(e: b, out: inout out)
  case Field(obj: a, name: f) then
    inout_in_expr(e: a, out: inout out)
  case Unary(op: op, x: a) then
    inout_in_expr(e: a, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    inout_in_expr(e: lo, out: inout out)
    inout_in_expr(e: hi, out: inout out)
    inout_in_expr(e: b, out: inout out)
  else
  end match
end fn inout_in_expr

// Generates a statement-level expression.
fn gen_top(g: inout Gen, e: Expr) -> Val do
  var io: List<String> = []
  inout_in_expr(e: e, out: inout io)
  set g = g with (inout_vars: io)
  let v = gen_expr(g: inout g, e: e)
  set g = g with (inout_vars: [])
  return v
end fn gen_top

// Whether the built-in called name consumes its first parameter, given the argument
// for it: push, set_at and insert do, and slice does of a list (not of a string).
fn consumes_first(g: Gen, name: String, first: Expr) -> Bool do
  if name == "slice" then
    return starts_with(s: ty_show(type_of(info: g.info, e: first)), p: "List<")
  end if
  return contains_str(xs: ["push", "set_at", "insert"], x: name)
end fn consumes_first

// In `set name = value`, the variable read that value's top-level operation consumes,
// when its old value can be moved there (-1 otherwise).
fn move_candidate(g: Gen, value: Expr, name: String) -> Int do
  var io: List<String> = []
  inout_in_expr(e: value, out: inout io)
  if contains_str(xs: io, x: name) then
    return -1
  end if
  match value.kind
  case With(obj: o, args: args) then
    return var_id(e: o, name: name)
  case Binary(op: op, l: l, r: r) then
    if op == "++" then
      return var_id(e: cat_first(g: g, e: l), name: name)
    end if
    return -1
  case Call(callee: c, args: args) then
    match call_info(info: g.info, e: value)
    case Some(value: ci) then
      if (ci.kind == "builtin") and (len(ci.order) > 0) then
        let i = ci.order[0]
        if (i >= 0) and (i < len(args)) and consumes_first(g: g, name: ci.name, first: args[i].value) then
          return var_id(e: args[i].value, name: name)
        end if
      end if
      return -1
    case None then
      return -1
    end match
  else
    return -1
  end match
end fn move_candidate

// The first of the strings a chain of '++' joins, given the chain's left operand: the
// one the whole chain consumes (gen_str_cat). A list's '++' consumes its left operand.
fn cat_first(g: Gen, e: Expr) -> Expr do
  if ty_show(type_of(info: g.info, e: e)) != "String" then
    return e
  end if
  match e.kind
  case Binary(op: op, l: l, r: r) then
    if op == "++" then
      return cat_first(g: g, e: l)
    end if
    return e
  else
    return e
  end match
end fn cat_first

// The strings a chain of '++' joins, in order: a ++ (b ++ c) ++ d is a, b, c, d.
fn cat_parts(g: Gen, e: Expr, out: inout List<Expr>) do
  match e.kind
  case Binary(op: op, l: l, r: r) then
    if (op == "++") and (ty_show(type_of(info: g.info, e: l)) == "String") then
      cat_parts(g: g, e: l, out: inout out)
      cat_parts(g: g, e: r, out: inout out)
      return
    end if
  else
  end match
  set out = push(list: out, item: e)
end fn cat_parts

// l ++ r on strings. The whole chain is joined at once, so no string is built for a
// part of it, and the first string is consumed: one that nothing else refers to (the
// variable in `set s = s ++ x`, or a value just computed) is extended where it is.
fn gen_str_cat(g: inout Gen, l: Expr, r: Expr) -> Val do
  var parts: List<Expr> = []
  cat_parts(g: g, e: l, out: inout parts)
  cat_parts(g: g, e: r, out: inout parts)
  // Literals next to each other are joined here, into literals of at most 16,000
  // bytes (C compilers need not accept longer ones): a text written as a literal for
  // each line costs nothing to put together when the program runs.
  var vals: List<Val> = []
  var lit = ""
  var pending = false
  for x in parts do
    var text = ""
    var is_lit = false
    match x.kind
    case StrLit(value: sv) then
      set text = sv
      set is_lit = true
    else
    end match
    if is_lit and pending and ((len(lit) + len(text)) <= 16000) then
      set lit = lit ++ text
    else
      if pending then
        set vals = push(list: vals, item: plain_val(str_lit(g: inout g, s: lit)))
      end if
      set pending = is_lit
      set lit = text
      if not is_lit then
        let v = gen_expr(g: inout g, e: x)
        set vals = push(list: vals, item: v)
      end if
    end if
  end for
  if pending then
    set vals = push(list: vals, item: plain_val(str_lit(g: inout g, s: lit)))
  end if
  if len(vals) == 0 then
    return plain_val("0")
  end if
  if len(vals) == 1 then
    return vals[0]
  end if
  let first = take(g: inout g, v: vals[0], heap: true)
  if len(vals) == 2 then
    return owned_tmp(g: inout g, rhs: "vstr_append(" ++ first ++ ", " ++ vals[1].c ++ ")", heap: true)
  end if
  // At most 256 strings are appended by one call, each call consuming the result of
  // the one before: a C compiler takes time that grows with the square of the length
  // of one array.
  var acc = first
  var at = 1
  while (len(vals) - at) > 256 invariant at >= 1 do
    var some: List<String> = []
    for i in at..(at + 256) do
      set some = push(list: some, item: vals[i].c)
    end for
    set acc = bind(g: inout g, rhs: "vstr_append_n(" ++ acc ++ ", 256, (V[]){" ++ join(parts: some, sep: ", ") ++ "})")
    set at = at + 256
  end while
  var rest: List<String> = []
  for i in at..len(vals) do
    set rest = push(list: rest, item: vals[i].c)
  end for
  let call = "vstr_append_n(" ++ acc ++ ", " ++ int_to_str(len(rest)) ++ ", (V[]){" ++ join(parts: rest, sep: ", ") ++ "})"
  return owned_tmp(g: inout g, rhs: call, heap: true)
end fn gen_str_cat

// The operand a consuming operation consumes (the list of push/set_at/++, the map of
// insert, the base of with), if e is such an operation.
fn consumed_operand(g: Gen, e: Expr) -> Option<Expr> do
  match e.kind
  case With(obj: o, args: args) then
    return Option.Some(value: o)
  case Binary(op: op, l: l, r: r) then
    if op == "++" then
      return Option.Some(value: cat_first(g: g, e: l))
    end if
    return Option.None
  case Call(callee: c, args: args) then
    match call_info(info: g.info, e: e)
    case Some(value: ci) then
      if (ci.kind == "builtin") and (len(ci.order) > 0) then
        let i = ci.order[0]
        if (i >= 0) and (i < len(args)) and consumes_first(g: g, name: ci.name, first: args[i].value) then
          return Option.Some(value: args[i].value)
        end if
      end if
      return Option.None
    case None then
      return Option.None
    end match
  else
    return Option.None
  end match
end fn consumed_operand

// Every use of variable name in e: "var" for a bare use, "field:f" for a read of name.f.
fn uses_of(e: Expr, name: String, out: inout List<String>) do
  match e.kind
  case Var(name: n) then
    if n == name then
      set out = push(list: out, item: "var")
    end if
  case Field(obj: o, name: f) then
    match o.kind
    case Var(name: n) then
      if n == name then
        set out = push(list: out, item: "field:" ++ f)
      end if
    else
      uses_of(e: o, name: name, out: inout out)
    end match
  case Call(callee: c, args: args) then
    uses_of(e: c, name: name, out: inout out)
    for a in args do
      uses_of(e: a.value, name: name, out: inout out)
    end for
  case With(obj: o, args: args) then
    uses_of(e: o, name: name, out: inout out)
    for a in args do
      uses_of(e: a.value, name: name, out: inout out)
    end for
  case ListLit(items: items) then
    for x in items do
      uses_of(e: x, name: name, out: inout out)
    end for
  case Index(obj: a, idx: b) then
    uses_of(e: a, name: name, out: inout out)
    uses_of(e: b, name: name, out: inout out)
  case Binary(op: op, l: a, r: b) then
    uses_of(e: a, name: name, out: inout out)
    uses_of(e: b, name: name, out: inout out)
  case Unary(op: op, x: a) then
    uses_of(e: a, name: name, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    uses_of(e: lo, name: name, out: inout out)
    uses_of(e: hi, name: name, out: inout out)
    uses_of(e: b, name: name, out: inout out)
  else
  end match
end fn uses_of

fn count_str(xs: List<String>, x: String) -> Int do
  var n = 0
  for y in xs do
    if y == x then
      set n = n + 1
    end if
  end for
  return n
end fn count_str

// In `set name = name with (f: op(name.f, ...), ...)`, the reads name.f that can be
// moved out of name: op consumes name.f and writes it back as field f, and the right
// side uses name nowhere else except reads of other fields.
fn steal_candidates(g: Gen, value: Expr, name: String) -> List<Int> do
  var ids: List<Int> = []
  match value.kind
  case With(obj: o, args: args) then
    var all_uses: List<String> = []
    for a in args do
      uses_of(e: a.value, name: name, out: inout all_uses)
    end for
    if contains_str(xs: all_uses, x: "var") then
      return ids
    end if
    for a in args do
      match consumed_operand(g: g, e: a.value)
      case Some(value: op) then
        match op.kind
        case Field(obj: fo, name: f) then
          if (f == a.name) and (var_id(e: fo, name: name) >= 0) and (count_str(xs: all_uses, x: "field:" ++ f) == 1) and heap_of(g: g, e: op) then
            set ids = push(list: ids, item: op.id)
          end if
        else
        end match
      case None then
      end match
    end for
    return ids
  case Call(callee: c, args: args) then
    // set name = set_at(list: name, at: i, value: name[i] with (...)): the element is
    // moved out of the list, updated where it is and put back (see vlist_steal_at).
    // The index is a variable or a literal, written the same both times, and nothing
    // is passed inout, so it is the same element.
    var io: List<String> = []
    inout_in_expr(e: value, out: inout io)
    if len(io) > 0 then
      return ids
    end if
    match call_info(info: g.info, e: value)
    case Some(value: ci) then
      if (ci.kind != "builtin") or (ci.name != "set_at") or (len(ci.order) != 3) then
        return ids
      end if
      let li = ci.order[0]
      let ai = ci.order[1]
      let vi = ci.order[2]
      if (li < 0) or (li >= len(args)) or (ai < 0) or (ai >= len(args)) or (vi < 0) or (vi >= len(args)) then
        return ids
      end if
      if var_id(e: args[li].value, name: name) < 0 then
        return ids
      end if
      match args[vi].value.kind
      case With(obj: o, args: wargs) then
        match o.kind
        case Index(obj: lo, idx: ie) then
          if (var_id(e: lo, name: name) >= 0) and same_place(a: ie, b: args[ai].value) then
            set ids = push(list: ids, item: o.id)
          end if
        else
        end match
      else
      end match
      return ids
    case None then
      return ids
    end match
  else
    return ids
  end match
end fn steal_candidates

// Whether two index expressions are the same variable or the same literal.
fn same_place(a: Expr, b: Expr) -> Bool do
  match a.kind
  case Var(name: n) then
    return var_id(e: b, name: n) >= 0
  case IntLit(value: x) then
    match b.kind
    case IntLit(value: y) then
      return x == y
    else
      return false
    end match
  else
    return false
  end match
end fn same_place

fn var_id(e: Expr, name: String) -> Int do
  match e.kind
  case Var(name: n) then
    if n == name then
      return e.id
    end if
    return -1
  else
    return -1
  end match
end fn var_id

// The variables that statements assign or pass inout.
fn changed_in(stmts: List<Stmt>, out: inout List<String>) do
  for s in stmts do
    match s.kind
    case Let(name: n, ty: ty, value: v, mutable: m) then
      inout_in_expr(e: v, out: inout out)
    case Set(name: n, value: v) then
      set out = push(list: out, item: n)
      inout_in_expr(e: v, out: inout out)
    case Return(value: v) then
      match v
      case Some(value: x) then
        inout_in_expr(e: x, out: inout out)
      case None then
      end match
    case If(arms: arms, els: els) then
      for a in arms do
        inout_in_expr(e: a.cond, out: inout out)
        changed_in(stmts: a.body, out: inout out)
      end for
      match els
      case Some(value: b) then
        changed_in(stmts: b, out: inout out)
      case None then
      end match
    case While(cond: c, invs: invs, dec: d, body: b) then
      inout_in_expr(e: c, out: inout out)
      changed_in(stmts: b, out: inout out)
    case ForRange(name: n, lo: lo, hi: hi, invs: invs, body: b) then
      inout_in_expr(e: lo, out: inout out)
      inout_in_expr(e: hi, out: inout out)
      changed_in(stmts: b, out: inout out)
    case ForEach(name: n, list: l, invs: invs, body: b) then
      inout_in_expr(e: l, out: inout out)
      changed_in(stmts: b, out: inout out)
    case Match(scrut: sc, cases: cases, els: els) then
      inout_in_expr(e: sc, out: inout out)
      for c in cases do
        changed_in(stmts: c.body, out: inout out)
      end for
      match els
      case Some(value: b) then
        changed_in(stmts: b, out: inout out)
      case None then
      end match
    case ExprStmt(e: e) then
      inout_in_expr(e: e, out: inout out)
    else
    end match
  end for
end fn changed_in

// Whether the value of e stays as it is, and alive, for as long as the variable it is
// read from is in scope: a variable the function never assigns or passes inout, or a
// field of such a value. A match or a loop over it need not hold a reference of its
// own. (Nothing reachable from such a variable is changed in place either: that takes
// a sole owner, and the variable is one more.)
fn stays(g: Gen, e: Expr) -> Bool do
  match e.kind
  case Var(name: n) then
    return not contains_str(xs: g.changed, x: n)
  case Field(obj: o, name: f) then
    return stays(g: g, e: o)
  else
    return false
  end match
end fn stays

// ---- functions and statements ----

fn gen_function(g: inout Gen, f: FnDecl) do
  var io: List<String> = []
  for p in f.params do
    if p.is_inout then
      set io = push(list: io, item: p.name)
    end if
  end for
  var changed = io
  changed_in(stmts: f.body, out: inout changed)
  set g = g with (io_params: io, changed: changed, owned_vars: [], scope_marks: [], loop_marks: [], temps: [], temp_marks: [], src: f.pos,
    fname: f.name, olds: {}, var_preds: {}, loop_invs: [], loop_dec: [], loop_m: [], dec_c: [], dec_lazy: [])
  line(g: inout g, s: "static V " ++ c_fn(f.name) ++ "(" ++ c_params(f) ++ ") {")
  indent(inout g)
  if g.contracts then
    gen_entry_checks(g: inout g, f: f)
  end if
  gen_scoped(g: inout g, stmts: f.body)
  if g.contracts then
    gen_exit_checks(g: inout g, res: "0")
    drop_to(g: inout g, mark: 0)
  end if
  line(g: inout g, s: "return 0;")
  dedent(inout g)
  line(g: inout g, s: "}")
  line(g: inout g, s: "")
end fn gen_function

fn gen_block(g: inout Gen, stmts: List<Stmt>) do
  for s in stmts do
    gen_stmt(g: inout g, s: s)
  end for
end fn gen_block

// A block with its own scope: owned locals declared in it are dropped at its end.
fn gen_scoped(g: inout Gen, stmts: List<Stmt>) do
  enter_scope(inout g)
  gen_block(g: inout g, stmts: stmts)
  leave_scope(inout g)
end fn gen_scoped

fn braced(g: inout Gen, stmts: List<Stmt>) do
  indent(inout g)
  gen_scoped(g: inout g, stmts: stmts)
  dedent(inout g)
end fn braced

fn gen_loop_body(g: inout Gen, stmts: List<Stmt>) do
  set g = g with (loop_marks: push(list: g.loop_marks, item: len(g.owned_vars)))
  gen_scoped(g: inout g, stmts: stmts)
  let n = len(g.loop_marks)
  if n > 0 then
    set g = g with (loop_marks: slice(of: g.loop_marks, from: 0, to: n - 1))
  end if
end fn gen_loop_body

fn loop_mark(g: Gen) -> Int do
  let n = len(g.loop_marks)
  if n > 0 then
    return g.loop_marks[n - 1]
  end if
  return 0
end fn loop_mark

fn gen_stmt(g: inout Gen, s: Stmt) do
  set g = g with (src: s.pos)
  match s.kind
  case Let(name: name, ty: ty, value: value, mutable: m) then
    let v = gen_top(g: inout g, e: value)
    if name == "_" then
      line(g: inout g, s: "(void)" ++ v.c ++ ";")
      flush(inout g)
    else
      let heap = heap_of(g: g, e: value)
      let c = take(g: inout g, v: v, heap: heap)
      line(g: inout g, s: "V l_" ++ name ++ " = " ++ c ++ ";")
      flush(inout g)
      if heap then
        declare_owned(g: inout g, c: "l_" ++ name)
      end if
      if g.contracts then
        var r = plain(Ty.TUnknown)
        match ty
        case Some(value: te) then
          set r = resolve_quiet(info: g.info, te: te)
        case None then
        end match
        set g = g with (var_preds: insert(map: g.var_preds, key: name, value: r))
        gen_rty(g: inout g, r: r, subject: "l_" ++ name, desc: "'" ++ name ++ "'")
      end if
    end if
    gen_inout_checks(g: inout g, e: value)
  case Set(name: name, value: value) then
    let lv = cvar(g: g, n: name)
    let heap = heap_of(g: g, e: value)
    if heap then
      let mid = move_candidate(g: g, value: value, name: name)
      set g = g with (move_id: mid, moved: false)
      if mid >= 0 then
        set g = g with (steal_ids: steal_candidates(g: g, value: value, name: name))
      end if
    end if
    let v = gen_top(g: inout g, e: value)
    let moved = g.moved
    set g = g with (move_id: -1, moved: false, steal_ids: [])
    let c = take(g: inout g, v: v, heap: heap)
    if heap and not moved then
      line(g: inout g, s: "vdrop(" ++ lv ++ ");")
    end if
    line(g: inout g, s: lv ++ " = " ++ c ++ ";")
    flush(inout g)
    if g.contracts then
      let r = value_or(opt: lookup(map: g.var_preds, key: name), default: plain(Ty.TUnknown))
      if pushes_onto(g: g, value: value, name: name) and (len(r.args) > 0) then
        // `set xs = push(list: xs, item: x)`: the elements xs had were checked when
        // they were stored, so only the new one is checked, not all of them again.
        gen_preds(g: inout g, preds: r.preds, subject: lv, what: "refinement of '" ++ name ++ "' failed")
        gen_rty(g: inout g, r: r.args[0], subject: "VB(VL(" ++ lv ++ ")->buf)->items[VL(" ++ lv ++ ")->len - 1]",
          desc: "an element of '" ++ name ++ "'")
      else
        gen_rty(g: inout g, r: r, subject: lv, desc: "'" ++ name ++ "'")
      end if
    end if
    gen_inout_checks(g: inout g, e: value)
  case Return(value: rv) then
    match rv
    case None then
      if g.contracts then
        gen_exit_checks(g: inout g, res: "0")
      end if
      drop_to(g: inout g, mark: 0)
      line(g: inout g, s: "return 0;")
    case Some(value: e) then
      let v = gen_top(g: inout g, e: e)
      let c = take(g: inout g, v: v, heap: heap_of(g: g, e: e))
      flush(inout g)
      if g.contracts then
        gen_exit_checks(g: inout g, res: c)
      end if
      drop_to(g: inout g, mark: 0)
      line(g: inout g, s: "return " ++ c ++ ";")
    end match
  case If(arms: arms, els: els) then
    if len(arms) > 0 then
      gen_if(g: inout g, arms: arms, els: els)
    end if
  case While(cond: cond, invs: invs, dec: dec, body: body) then
    line(g: inout g, s: "for (;;) {")
    indent(inout g)
    // Checked: the invariants at the top of every iteration (on entry, after each
    // iteration and at each continue) and when the condition ends the loop.
    if g.contracts then
      gen_invs(g: inout g, invs: invs)
    end if
    let c = gen_top(g: inout g, e: cond)
    flush(inout g)
    line(g: inout g, s: "if (!" ++ c.c ++ ") break;")
    var m: List<String> = []
    var decs: List<Expr> = []
    if g.contracts then
      for d in dec do
        // An Int measure, or a structural one measured by its rank. A measure of one
        // part must stay non-negative; in a lexicographic one, only the part that
        // decreases must have been (c_lex_less).
        let mv = gen_top(g: inout g, e: d)
        let mc = c_measure(g: inout g, d: d, c: mv.c)
        let t = fresh_tmp(inout g)
        line(g: inout g, s: "int64_t " ++ t ++ " = " ++ mc ++ ";")
        flush(inout g)
        if len(dec) == 1 then
          line(g: inout g, s: "if (" ++ t ++ " < 0) " ++ panic_at(g: g, pos: d.pos, msg: c_string("loop measure is negative: " ++ pretty_expr(d))))
        end if
        set m = push(list: m, item: t)
      end for
      set decs = dec
    end if
    push_loop_ctx(g: inout g, invs: invs, decs: decs, m: m)
    gen_loop_body(g: inout g, stmts: body)
    gen_measure_check(inout g)
    pop_loop_ctx(inout g)
    dedent(inout g)
    line(g: inout g, s: "}")
  case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
    let a = gen_top(g: inout g, e: lo)
    let b = gen_top(g: inout g, e: hi)
    flush(inout g)
    let lv = "l_" ++ v
    if g.contracts then
      // The invariants are checked for every value of the variable, the last (hi) too.
      line(g: inout g, s: "for (V " ++ lv ++ " = " ++ a.c ++ ";; " ++ lv ++ " = (V)(VI(" ++ lv ++ ") + 1)) {")
      indent(inout g)
      gen_invs(g: inout g, invs: invs)
      line(g: inout g, s: "if (VI(" ++ lv ++ ") >= VI(" ++ b.c ++ ")) break;")
    else
      line(g: inout g, s: "for (V " ++ lv ++ " = " ++ a.c ++ "; VI(" ++ lv ++ ") < VI(" ++ b.c ++ "); " ++ lv ++ " = (V)(VI(" ++ lv ++ ") + 1)) {")
      indent(inout g)
    end if
    push_loop_ctx(g: inout g, invs: invs, decs: [], m: [])
    gen_loop_body(g: inout g, stmts: body)
    pop_loop_ctx(inout g)
    dedent(inout g)
    line(g: inout g, s: "}")
  case ForEach(name: v, list: l, invs: invs, body: body) then
    // The loop owns the list it iterates, so the body may reassign the variable it came
    // from. (A list that stays is only borrowed.)
    enter_scope(inout g)
    let lv = gen_top(g: inout g, e: l)
    var owner = lv.c
    if (not lv.owned) and stays(g: g, e: l) then
      flush(inout g)
    else
      let owned_list = take(g: inout g, v: lv, heap: true)
      set owner = bind(g: inout g, rhs: owned_list)
      flush(inout g)
      declare_owned(g: inout g, c: owner)
    end if
    let k = fresh_tmp(inout g)
    line(g: inout g, s: "for (int64_t " ++ k ++ " = 0; " ++ k ++ " < VL(" ++ owner ++ ")->len; " ++ k ++ "++) {")
    indent(inout g)
    line(g: inout g, s: "V l_" ++ v ++ " = VB(VL(" ++ owner ++ ")->buf)->items[" ++ k ++ "];")
    if g.contracts then
      gen_invs(g: inout g, invs: invs)
    end if
    push_loop_ctx(g: inout g, invs: invs, decs: [], m: [])
    gen_loop_body(g: inout g, stmts: body)
    pop_loop_ctx(inout g)
    dedent(inout g)
    line(g: inout g, s: "}")
    if g.contracts then
      gen_invs(g: inout g, invs: invs)
    end if
    leave_scope(inout g)
  case Match(scrut: scrut, cases: cases, els: els) then
    gen_match(g: inout g, scrut: scrut, cases: cases, els: els)
  case Assert(e: e) then
    let msg = "assertion failed: " ++ pretty_expr(e)
    if g.contracts then
      // A specification, like a contract (see gen_check).
      line(g: inout g, s: "if (vow_spec_depth == 0) {")
      indent(inout g)
      line(g: inout g, s: "vow_spec_depth++;")
      set g = g with (exact: true, exact_pos: s.pos, exact_what: "assertion: " ++ pretty_expr(e))
      let c = gen_top(g: inout g, e: e)
      set g = g with (exact: false)
      flush(inout g)
      line(g: inout g, s: "vow_spec_depth--;")
      line(g: inout g, s: "if (!" ++ c.c ++ ") " ++ panic_at(g: g, pos: s.pos, msg: c_string(msg)))
      dedent(inout g)
      line(g: inout g, s: "}")
    else
      line(g: inout g, s: "#ifndef VOW_VERIFIED")
      let c = gen_top(g: inout g, e: e)
      flush(inout g)
      line(g: inout g, s: "if (!" ++ c.c ++ ") " ++ panic_at(g: g, pos: s.pos, msg: c_string(msg)))
      line(g: inout g, s: "#endif")
    end if
  case Check(e: e) then
    let c = gen_top(g: inout g, e: e)
    flush(inout g)
    let msg = "check failed: " ++ pretty_expr(e)
    line(g: inout g, s: "if (!" ++ c.c ++ ") " ++ panic_at(g: g, pos: s.pos, msg: c_string(msg)))
  case Break then
    // Checked: the loop's invariants hold at a break.
    let n = len(g.loop_invs)
    if g.contracts and (n > 0) then
      gen_invs(g: inout g, invs: g.loop_invs[n - 1])
    end if
    drop_to(g: inout g, mark: loop_mark(g))
    line(g: inout g, s: "break;")
  case Continue then
    gen_measure_check(inout g)
    drop_to(g: inout g, mark: loop_mark(g))
    line(g: inout g, s: "continue;")
  case ExprStmt(e: e) then
    let v = gen_top(g: inout g, e: e)
    line(g: inout g, s: "(void)" ++ v.c ++ ";")
    flush(inout g)
    gen_inout_checks(g: inout g, e: e)
  end match
end fn gen_stmt

// ---- runtime contract checks (--check-contracts) ----

// Code that panics unless the specification e holds. It can be generated in the middle
// of an expression: it keeps its own temporaries and leaves the statement's state alone.
fn gen_check(g: inout Gen, e: Expr, what: String) do
  let io = g.inout_vars
  let mid = g.move_id
  let steals = g.steal_ids
  set g = g with (inout_vars: [], move_id: -1, steal_ids: [])
  line(g: inout g, s: "if (vow_spec_depth == 0) {")
  indent(inout g)
  line(g: inout g, s: "vow_spec_depth++;")
  push_frame(inout g)
  let was = g.exact
  let was_pos = g.exact_pos
  let was_what = g.exact_what
  var name = what
  if ends_with(s: name, p: " failed") then
    set name = slice(of: name, from: 0, to: len(name) - 7)
  end if
  set g = g with (exact: true, exact_pos: e.pos, exact_what: name ++ ": " ++ pretty_expr(e))
  let v = gen_expr(g: inout g, e: e)
  set g = g with (exact: was, exact_pos: was_pos, exact_what: was_what)
  line(g: inout g, s: "vow_spec_depth--;")
  line(g: inout g, s: "if (!" ++ v.c ++ ") " ++ panic_at(g: g, pos: e.pos, msg: c_string(what ++ ": " ++ pretty_expr(e))))
  pop_frame(inout g)
  dedent(inout g)
  line(g: inout g, s: "}")
  set g = g with (inout_vars: io, move_id: mid, steal_ids: steals)
end fn gen_check

// ---- exact arithmetic in specifications ----
//
// A specification is proved over the mathematical integers. A checked build evaluates
// the arithmetic written in one (with +, -, *, / and %) in 128 bits, so that a
// specification that holds is not reported as an overflow: `(result * 2) <= (lo + hi)`
// is true of a midpoint whatever lo and hi are. A function the specification calls
// still computes in 64 bits, as it does when the program calls it.

// Whether e is integer arithmetic written with an operator.
fn is_int_arith(g: Gen, e: Expr) -> Bool do
  match e.kind
  case Binary(op: op, l: l, r: r) then
    return contains_str(xs: ["+", "-", "*", "/", "%"], x: op) and (ty_show(type_of(info: g.info, e: l)) == "Int")
  case Unary(op: op, x: x) then
    return (op == "-") and (ty_show(type_of(info: g.info, e: x)) == "Int")
  else
    return false
  end match
end fn is_int_arith

// The panic for a specification that cannot be evaluated: its truth is unknown, which
// is not the same as false.
fn exact_panic(g: Gen, why: String) -> String do
  return panic_at(g: g, pos: g.exact_pos, msg: c_string("cannot check " ++ g.exact_what ++ " (" ++ why ++ ")"))
end fn exact_panic

// The Int expression e as a C value of type vow_wide.
fn gen_wide(g: inout Gen, e: Expr) -> String do
  var a = "0"
  var b = ""
  var f = ""
  match e.kind
  case Binary(op: op, l: l, r: r) then
    if is_int_arith(g: g, e: e) then
      set a = gen_wide(g: inout g, e: l)
      set b = gen_wide(g: inout g, e: r)
      match op
      case "+" then
        set f = "vow_wadd"
      case "-" then
        set f = "vow_wsub"
      case "*" then
        set f = "vow_wmul"
      case "/" then
        set f = "vow_wdiv"
      else
        set f = "vow_wmod"
      end match
      if (op == "/") or (op == "%") then
        line(g: inout g, s: "if (" ++ b ++ " == 0) " ++ panic_at(g: g, pos: e.pos, msg: c_string("division by zero")))
      end if
    end if
  case Unary(op: op, x: x) then
    if is_int_arith(g: g, e: e) then
      set b = gen_wide(g: inout g, e: x)
      set f = "vow_wsub"
    end if
  else
  end match
  if len(f) == 0 then
    let v = gen_expr(g: inout g, e: e)
    return "(vow_wide)VI(" ++ v.c ++ ")"
  end if
  let t = fresh_tmp(inout g)
  line(g: inout g, s: "vow_wide " ++ t ++ ";")
  let call = f ++ "(" ++ a ++ ", " ++ b ++ ", &" ++ t ++ ")"
  line(g: inout g, s: "if (" ++ call ++ ") " ++ exact_panic(g: g, why: "its arithmetic needs more than 128 bits"))
  return t
end fn gen_wide

// Integer arithmetic in a specification, where a value is needed (an argument, an
// index): computed exactly, the result must fit in 64 bits.
fn gen_narrow(g: inout Gen, e: Expr) -> Val do
  let w = gen_wide(g: inout g, e: e)
  line(g: inout g, s: "if (!vow_wfits(" ++ w ++ ")) " ++ exact_panic(g: g, why: "a value in it does not fit in 64 bits"))
  return plain_val(bind(g: inout g, rhs: "(V)(int64_t)" ++ w))
end fn gen_narrow

// A comparison of integers in a specification, when either side is arithmetic.
fn exact_compare(g: Gen, op: String, l: Expr, r: Expr) -> Bool do
  if not (g.exact and contains_str(xs: ["<", "<=", ">", ">=", "==", "!="], x: op)) then
    return false
  end if
  return (ty_show(type_of(info: g.info, e: l)) == "Int") and (is_int_arith(g: g, e: l) or is_int_arith(g: g, e: r))
end fn exact_compare

// Checks refinements, with 'it' the C value it.
fn gen_preds(g: inout Gen, preds: List<Expr>, subject: String, what: String) do
  if len(preds) == 0 then
    return
  end if
  let saved = g.it_c
  set g = g with (it_c: subject)
  for p in preds do
    gen_check(g: inout g, e: p, what: what)
  end for
  set g = g with (it_c: saved)
end fn gen_preds

// Checks a value's refinements, its own (desc names it: "'x'", "parameter 'x'") and
// those inside its type arguments.
fn gen_rty(g: inout Gen, r: RTy, subject: String, desc: String) do
  gen_preds(g: inout g, preds: r.preds, subject: subject, what: "refinement of " ++ desc ++ " failed")
  gen_inner(g: inout g, r: r, subject: subject, desc: desc)
end fn gen_rty

// The refinements inside a value's type arguments: of each element of a list, of the
// value in an option, of the fields of an instance of a generic type.
fn gen_inner(g: inout Gen, r: RTy, subject: String, desc: String) do
  if len(r.args) == 0 then
    return
  end if
  let a = r.args[0]
  match r.ty
  case TList(elem: et) then
    let k = fresh_tmp(inout g)
    line(g: inout g, s: "for (int64_t " ++ k ++ " = 0; " ++ k ++ " < VL(" ++ subject ++ ")->len; " ++ k ++ "++) {")
    indent(inout g)
    gen_rty(g: inout g, r: a, subject: "VB(VL(" ++ subject ++ ")->buf)->items[" ++ k ++ "]", desc: "an element of " ++ desc)
    dedent(inout g)
    line(g: inout g, s: "}")
  case TOpt(inner: ot) then
    line(g: inout g, s: "if (VP(" ++ subject ++ ")[0] == 1) {")
    indent(inout g)
    gen_rty(g: inout g, r: a, subject: "VP(" ++ subject ++ ")[1]", desc: "the value in " ++ desc)
    dedent(inout g)
    line(g: inout g, s: "}")
  case TStruct(name: sn) then
    let fields = struct_fields(info: g.info, name: sn)
    let refs = struct_field_refs(info: g.info, name: sn, args: r.args)
    for i in 0..len(fields) do
      if (i < len(refs)) and not is_plain(refs[i]) then
        gen_rty(g: inout g, r: refs[i], subject: "VP(" ++ subject ++ ")[" ++ int_to_str(i) ++ "]", desc: "field '" ++ fields[i].name ++ "' of " ++ desc)
      end if
    end for
  case TEnum(name: en) then
    match variants_of(info: g.info, t: r.ty)
    case Some(value: vs) then
      let refs = variant_field_refs(info: g.info, name: en, args: r.args)
      for vi in 0..len(vs) do
        if vi < len(refs) then
          for fi in 0..len(vs[vi].fields) do
            if (fi < len(refs[vi])) and not is_plain(refs[vi][fi]) then
              line(g: inout g, s: "if (VP(" ++ subject ++ ")[0] == " ++ int_to_str(vi) ++ ") {")
              indent(inout g)
              gen_rty(g: inout g, r: refs[vi][fi], subject: "VP(" ++ subject ++ ")[" ++ int_to_str(fi + 1) ++ "]",
                desc: "field '" ++ vs[vi].fields[fi].name ++ "' of " ++ desc ++ " (when " ++ vs[vi].name ++ ")")
              dedent(inout g)
              line(g: inout g, s: "}")
            end if
          end for
        end if
      end for
    case None then
    end match
  else
  end match
end fn gen_inner

fn gen_invs(g: inout Gen, invs: List<Expr>) do
  for i in invs do
    gen_check(g: inout g, e: i, what: "loop invariant failed")
  end for
end fn gen_invs

// The field refinements of the struct or variant value r just built, whose fields start
// at offset; a refinement names its sibling fields.
fn gen_field_checks(g: inout Gen, r: String, fields: List<FieldInfo>, offset: Int, tname: String) do
  var any = false
  for f in fields do
    if not is_plain(f.rty) then
      set any = true
    end if
  end for
  if not any then
    return
  end if
  let saved = g.spec_binds
  var binds = saved
  for i in 0..len(fields) do
    set binds = insert(map: binds, key: fields[i].name, value: "VP(" ++ r ++ ")[" ++ int_to_str(i + offset) ++ "]")
  end for
  set g = g with (spec_binds: binds)
  for i in 0..len(fields) do
    let what = "refinement of field '" ++ fields[i].name ++ "' of " ++ tname ++ " failed"
    gen_preds(g: inout g, preds: fields[i].rty.preds, subject: "VP(" ++ r ++ ")[" ++ int_to_str(i + offset) ++ "]", what: what)
    gen_inner(g: inout g, r: fields[i].rty, subject: "VP(" ++ r ++ ")[" ++ int_to_str(i + offset) ++ "]",
      desc: "field '" ++ fields[i].name ++ "' of " ++ tname)
  end for
  set g = g with (spec_binds: saved)
end fn gen_field_checks

// Whether value is push(list: name, item: ...), the built-in on the variable itself.
fn pushes_onto(g: Gen, value: Expr, name: String) -> Bool do
  match call_info(info: g.info, e: value)
  case Some(value: ci) then
    if (ci.kind != "builtin") or (ci.name != "push") then
      return false
    end if
  case None then
    return false
  end match
  match value.kind
  case Call(callee: c, args: args) then
    if len(args) != 2 then
      return false
    end if
    var at = 0
    if args[1].name == "list" then
      set at = 1
    end if
    match args[at].value.kind
    case Var(name: n) then
      return n == name
    else
      return false
    end match
  else
    return false
  end match
end fn pushes_onto

// The refinements of the variables a statement passed inout, which may have changed.
fn gen_inout_checks(g: inout Gen, e: Expr) do
  if not g.contracts then
    return
  end if
  var io: List<String> = []
  inout_in_expr(e: e, out: inout io)
  for n in io do
    gen_rty(g: inout g, r: value_or(opt: lookup(map: g.var_preds, key: n), default: plain(Ty.TUnknown)), subject: cvar(g: g, n: n),
      desc: "'" ++ n ++ "'")
  end for
end fn gen_inout_checks

// On entry: the parameters' refinements and the preconditions; and the entry values of
// the inout parameters that old(x) names. Only those: a kept entry value is a second
// reference, so every update of the parameter in the body would copy it.
// For a part d of a function's measure that is one of its parameters, whole and with a
// rank: the parameter's C name, else "". A parameter that is not inout is borrowed and
// cannot be assigned, so it is the value on entry for as long as the function runs.
fn whole_param(g: Gen, fi: FnInfo, d: Expr) -> String do
  if not is_ranked(type_of(info: g.info, e: d)) then
    return ""
  end if
  match d.kind
  case Var(name: n) then
    for i in 0..len(fi.params) do
      if (fi.params[i].name == n) and not ((i < len(fi.io)) and fi.io[i]) then
        return cvar(g: g, n: n)
      end if
    end for
    return ""
  else
    return ""
  end match
end fn whole_param

fn gen_entry_checks(g: inout Gen, f: FnDecl) do
  match get_fn(info: g.info, name: f.name)
  case Some(value: fi) then
    let named = olds_named(f: f, info: g.info)
    for i in 0..len(fi.params) do
      let p = fi.params[i]
      gen_rty(g: inout g, r: p.rty, subject: cvar(g: g, n: p.name), desc: "parameter '" ++ p.name ++ "'")
      if (i < len(fi.io)) and fi.io[i] then
        set g = g with (var_preds: insert(map: g.var_preds, key: p.name, value: p.rty))
        if contains_str(xs: named, x: p.name) then
          let o = "o_" ++ p.name
          line(g: inout g, s: "V " ++ o ++ " = " ++ cvar(g: g, n: p.name) ++ ";")
          if is_heap(p.rty.ty) then
            line(g: inout g, s: "vdup(" ++ o ++ ");")
            declare_owned(g: inout g, c: o)
          end if
          set g = g with (olds: insert(map: g.olds, key: p.name, value: o))
        end if
      end if
    end for
    for r in fi.pre do
      gen_check(g: inout g, e: r, what: "precondition failed")
    end for
    // The measure on entry, which each call within the function's recursive group must
    // decrease (gen_call_measure_check).
    if len(fi.dec) > 0 then
      var names: List<String> = []
      var lazy: List<String> = []
      for i in 0..len(fi.dec) do
        var nm = "vow_dec"
        if i > 0 then
          set nm = "vow_dec" ++ int_to_str(i)
        end if
        let whole = whole_param(g: g, fi: fi, d: fi.dec[i])
        if len(whole) > 0 then
          line(g: inout g, s: "int64_t " ++ nm ++ " = -1;")
        else
          line(g: inout g, s: "int64_t " ++ nm ++ " = 0;")
        end if
        set names = push(list: names, item: nm)
        set lazy = push(list: lazy, item: whole)
      end for
      line(g: inout g, s: "if (vow_spec_depth == 0) {")
      indent(inout g)
      line(g: inout g, s: "vow_spec_depth++;")
      push_frame(inout g)
      for i in 0..len(fi.dec) do
        let d = fi.dec[i]
        if (i < len(lazy)) and (len(lazy[i]) == 0) then
          let v = gen_expr(g: inout g, e: d)
          let m = c_measure(g: inout g, d: d, c: v.c)
          if i < len(names) then
            line(g: inout g, s: names[i] ++ " = " ++ m ++ ";")
          end if
        end if
      end for
      pop_frame(inout g)
      line(g: inout g, s: "vow_spec_depth--;")
      dedent(inout g)
      line(g: inout g, s: "}")
      set g = g with (dec_c: names, dec_lazy: lazy)
    end if
  case None then
  end match
end fn gen_entry_checks

// A measure's value as a C int64_t: an Int measure is itself, any other value its rank
// (as in the verifier's as_measure).
fn c_measure(g: inout Gen, d: Expr, c: String) -> String do
  let t = type_of(info: g.info, e: d)
  if ty_show(t) == "Int" then
    return "VI(" ++ c ++ ")"
  end if
  return c_rank(g: inout g, t: t, a: c)
end fn c_measure

// Before a call within the caller's recursive group (checked builds): the caller's
// measure on entry is not negative, and the callee's measure on the arguments, p in
// parameter order, is smaller. As in the verifier, which proves it at the call.
fn gen_call_measure_check(g: inout Gen, pos: Pos, name: String, args: List<Arg>, order: List<Int>, p: List<Val>) do
  if (not g.contracts) or (len(g.dec_c) == 0) then
    return
  end if
  let mine = dec_exprs(g)
  let k = scc_of_fn(info: g.info, name: g.fname)
  if (name != g.fname) and ((k < 0) or (scc_of_fn(info: g.info, name: name) != k)) then
    return
  end if
  match get_fn(info: g.info, name: name)
  case Some(value: fi) then
    var cd = mine
    if len(fi.dec) > 0 then
      set cd = fi.dec
    end if
    if len(cd) > 0 then
      // The callee's parameters, bound to the arguments' values (an inout argument's
      // value is its var's).
      var binds = g.spec_binds
      for i in 0..len(fi.params) do
        if (i < len(p)) and (i < len(order)) then
          var c = p[i].c
          let ai = order[i]
          if (ai >= 0) and (ai < len(args)) and args[ai].is_inout then
            match args[ai].value.kind
            case Var(name: n) then
              set c = cvar(g: g, n: n)
            else
            end match
          end if
          set binds = insert(map: binds, key: fi.params[i].name, value: c)
        end if
      end for
      let io = g.inout_vars
      let mid = g.move_id
      let steals = g.steal_ids
      let saved = g.spec_binds
      set g = g with (inout_vars: [], move_id: -1, steal_ids: [], spec_binds: binds)
      line(g: inout g, s: "if (vow_spec_depth == 0) {")
      indent(inout g)
      line(g: inout g, s: "vow_spec_depth++;")
      push_frame(inout g)
      // Compared lexicographically on the parts both measures have.
      var parts = len(cd)
      if len(g.dec_c) < parts then
        set parts = len(g.dec_c)
      end if
      // For each part, C for "smaller than on entry" and for "the same as on entry".
      var less: List<String> = []
      var same: List<String> = []
      let decs = g.dec_c
      let lazies = g.dec_lazy
      for i in 0..parts do
        let d = cd[i]
        let v = gen_expr(g: inout g, e: d)
        let t = type_of(info: g.info, e: d)
        var was = "0"
        var entry = ""
        if (i < len(decs)) and (i < len(lazies)) then
          set was = decs[i]
          set entry = lazies[i]
        end if
        if (len(entry) > 0) and (i < len(mine)) then
          // The entry value is a parameter, whose rank has not been computed.
          let et = type_of(info: g.info, e: mine[i])
          need_rank(g: inout g, t: et)
          if is_ranked(t) then
            need_rank(g: inout g, t: t)
            let cmp = fresh_tmp(inout g)
            let steps = rank_step_name(t) ++ ", " ++ v.c ++ ", " ++ rank_step_name(et) ++ ", " ++ entry
            line(g: inout g, s: "int " ++ cmp ++ " = vow_rank_cmp(" ++ steps ++ ", &" ++ was ++ ");")
            set less = push(list: less, item: "(" ++ cmp ++ " < 0)")
            set same = push(list: same, item: "(" ++ cmp ++ " == 0)")
            continue
          end if
          line(g: inout g, s: "if (" ++ was ++ " < 0) " ++ was ++ " = " ++ rank_c_name(et) ++ "(" ++ entry ++ ");")
        end if
        let now = c_measure(g: inout g, d: d, c: v.c)
        set less = push(list: less, item: "((" ++ was ++ " >= 0) && (" ++ now ++ " < " ++ was ++ "))")
        set same = push(list: same, item: "(" ++ now ++ " == " ++ was ++ ")")
      end for
      line(g: inout g, s: "vow_spec_depth--;")
      var what = "recursive call to '" ++ name ++ "' did not decrease its measure: " ++ pretty_measure(cd)
      if name != g.fname then
        set what = "call to '" ++ name ++ "' did not decrease the measure of '" ++ g.fname ++ "': " ++ measure_text(measure_prefix(ds: cd, k: parts)) ++ " < " ++ measure_text(measure_prefix(ds: mine, k: parts))
      end if
      line(g: inout g, s: "if (!" ++ c_lex_parts(less: less, same: same) ++ ") " ++ panic_at(g: g, pos: pos, msg: c_string(what)))
      pop_frame(inout g)
      dedent(inout g)
      line(g: inout g, s: "}")
      set g = g with (inout_vars: io, move_id: mid, steal_ids: steals, spec_binds: saved)
    end if
  case None then
  end match
end fn gen_call_measure_check

// The caller's measure.
fn dec_exprs(g: Gen) -> List<Expr> do
  match get_fn(info: g.info, name: g.fname)
  case Some(value: fi) then
    return fi.dec
  case None then
    return []
  end match
end fn dec_exprs

// C for a lexicographic comparison, given for each part C for "smaller" and for "the
// same": some part is smaller and every part before it is the same.
fn c_lex_parts(less: List<String>, same: List<String>) -> String do
  var k = len(less)
  if len(same) < k then
    set k = len(same)
  end if
  if k == 0 then
    return "0"
  end if
  var i = k - 1
  var acc = less[i]
  while i > 0 invariant (i >= 0) and (i < len(less)) and (i < len(same)) do
    set i = i - 1
    set acc = "(" ++ less[i] ++ " || (" ++ same[i] ++ " && " ++ acc ++ "))"
  end while
  return acc
end fn c_lex_parts

// C for: the measure's parts now are lexicographically smaller than at entry, on the
// parts both have (as the verifier's lex_less).
fn c_lex_less(now: List<String>, entry: List<String>) -> String do
  var k = len(now)
  if len(entry) < k then
    set k = len(entry)
  end if
  if k == 0 then
    return "0"
  end if
  var i = k - 1
  var acc = "((" ++ entry[i] ++ " >= 0) && (" ++ now[i] ++ " < " ++ entry[i] ++ "))"
  while i > 0 invariant (i >= 0) and (i < len(now)) and (i < len(entry)) do
    set i = i - 1
    let part = "((" ++ entry[i] ++ " >= 0) && (" ++ now[i] ++ " < " ++ entry[i] ++ "))"
    set acc = "(" ++ part ++ " || ((" ++ now[i] ++ " == " ++ entry[i] ++ ") && " ++ acc ++ "))"
  end while
  return acc
end fn c_lex_less

// On return: the result's refinements and the postconditions, with res the C value
// returned ("0" for Unit).
fn gen_exit_checks(g: inout Gen, res: String) do
  match get_fn(info: g.info, name: g.fname)
  case Some(value: fi) then
    gen_preds(g: inout g, preds: fi.ret.preds, subject: res, what: "refinement of the result failed")
    gen_inner(g: inout g, r: fi.ret, subject: res, desc: "the result")
    let saved = g.result_c
    set g = g with (result_c: res)
    for en in fi.post do
      gen_check(g: inout g, e: en, what: "postcondition failed")
    end for
    set g = g with (result_c: saved)
  case None then
  end match
end fn gen_exit_checks

fn push_loop_ctx(g: inout Gen, invs: List<Expr>, decs: List<Expr>, m: List<String>) do
  set g = g with (loop_invs: push(list: g.loop_invs, item: invs), loop_dec: push(list: g.loop_dec, item: decs),
    loop_m: push(list: g.loop_m, item: m))
end fn push_loop_ctx

fn pop_loop_ctx(g: inout Gen) do
  let n = len(g.loop_invs)
  if (n > 0) and (n == len(g.loop_dec)) and (n == len(g.loop_m)) then
    set g = g with (loop_invs: slice(of: g.loop_invs, from: 0, to: n - 1), loop_dec: slice(of: g.loop_dec, from: 0, to: n - 1),
      loop_m: slice(of: g.loop_m, from: 0, to: n - 1))
  end if
end fn pop_loop_ctx

// At the end of an iteration of the innermost loop, or a continue: its measure (if it
// has one) is smaller than when the iteration began.
fn gen_measure_check(g: inout Gen) do
  let n = len(g.loop_m)
  if (not g.contracts) or (n == 0) or (n != len(g.loop_dec)) then
    return
  end if
  let m = g.loop_m[n - 1]
  let ds = g.loop_dec[n - 1]
  if (len(m) == 0) or (len(ds) == 0) or (len(m) != len(ds)) then
    return
  end if
  let d = ds[0]
  let io = g.inout_vars
  set g = g with (inout_vars: [])
  push_frame(inout g)
  var now: List<String> = []
  for x in ds do
    let v = gen_expr(g: inout g, e: x)
    set now = push(list: now, item: c_measure(g: inout g, d: x, c: v.c))
  end for
  if (len(ds) == 1) and (len(now) == 1) then
    line(g: inout g, s: "if (!(" ++ now[0] ++ " < " ++ m[0] ++ ")) " ++ panic_at(g: g, pos: d.pos, msg: c_string("loop measure did not decrease: " ++ pretty_expr(d))))
  else
    line(g: inout g, s: "if (!" ++ c_lex_less(now: now, entry: m) ++ ") " ++ panic_at(g: g, pos: d.pos, msg: c_string("loop measure did not decrease: " ++ pretty_measure(ds))))
  end if
  pop_frame(inout g)
  set g = g with (inout_vars: io)
end fn gen_measure_check

// An if with elif arms is a sequence, not a nest: each arm tests its condition and, if
// it holds, runs its body and jumps past the rest. (With each arm inside the else of
// the one before, an if of 2,000 arms was nested too deep for a C compiler.)
fn gen_if(g: inout Gen, arms: List<Arm> where len(it) > 0, els: Option<List<Stmt>>) do
  if len(arms) == 1 then
    let a = arms[0]
    let cv = gen_top(g: inout g, e: a.cond)
    flush(inout g)
    line(g: inout g, s: "if (" ++ cv.c ++ ") {")
    braced(g: inout g, stmts: a.body)
    match els
    case Some(value: b) then
      line(g: inout g, s: "} else {")
      braced(g: inout g, stmts: b)
      line(g: inout g, s: "}")
    case None then
      line(g: inout g, s: "}")
    end match
    return
  end if
  let done = "done_" ++ fresh_tmp(inout g)
  line(g: inout g, s: "{")
  indent(inout g)
  for a in arms do
    // A panic in the condition names the condition's line.
    set g = g with (src: a.cond.pos)
    let cv = gen_top(g: inout g, e: a.cond)
    flush(inout g)
    line(g: inout g, s: "if (" ++ cv.c ++ ") {")
    braced(g: inout g, stmts: a.body)
    indent(inout g)
    line(g: inout g, s: "goto " ++ done ++ ";")
    dedent(inout g)
    line(g: inout g, s: "}")
  end for
  match els
  case Some(value: b) then
    gen_scoped(g: inout g, stmts: b)
  case None then
  end match
  dedent(inout g)
  line(g: inout g, s: "}")
  line(g: inout g, s: done ++ ": ;")
end fn gen_if

// The match that 'try' is sugar for (see desugar_try in parser.vow): its scrutinee is
// the variable the parser made for the value tried, named with a digit first, which is
// the newest owned variable; the first case returns the error, and the second holds
// the rest of the block. True if this is one, and then it is generated here, with the
// rest of the block at the same depth and not inside the case, so that a function with
// hundreds of 'try' statements is not hundreds of levels deep in C; and the value
// tried is released once its payload is taken out, so that the returns further on do
// not each have to release it.
fn gen_try(g: inout Gen, scrut: Expr, cases: List<Case>, els: Option<List<Stmt>>) -> Bool do
  var name = ""
  match scrut.kind
  case Var(name: n) then
    set name = n
  else
  end match
  if (len(name) == 0) or (len(cases) != 2) or is_some(els) then
    return false
  end if
  if not is_digit(name[0]) then
    return false
  end if
  let v = cvar(g: g, n: name)
  let no = len(g.owned_vars)
  if no == 0 then
    return false
  end if
  if g.owned_vars[no - 1] != v then
    return false
  end if
  var variants: List<VariantInfo> = []
  match variants_of(info: g.info, t: type_of(info: g.info, e: scrut))
  case Some(value: vs) then
    set variants = vs
  case None then
    return false
  end match
  let tag = bind(g: inout g, rhs: "VP(" ++ v ++ ")[0]")
  // The error: its binder borrows from the value tried, which the return releases.
  let bad = cases[0]
  match bad.pat
  case PVariant(name: vn, binds: binds) then
    let vi = find_variant(vs: variants, name: vn)
    line(g: inout g, s: "if (" ++ tag ++ " == " ++ int_to_str(vi) ++ ") {")
    indent(inout g)
    if vi >= 0 then
      for b in binds do
        let fi = find_field(fields: variants[vi].fields, name: b.field)
        line(g: inout g, s: "V l_" ++ b.binder ++ " = VP(" ++ v ++ ")[" ++ int_to_str(fi + 1) ++ "];")
      end for
    end if
    gen_scoped(g: inout g, stmts: bad.body)
    dedent(inout g)
    line(g: inout g, s: "}")
  else
  end match
  // The value: its binder takes a reference of its own, and the value tried goes.
  let good = cases[1]
  var kept: List<String> = []
  match good.pat
  case PVariant(name: vn, binds: binds) then
    let vi = find_variant(vs: variants, name: vn)
    if vi >= 0 then
      for b in binds do
        let fi = find_field(fields: variants[vi].fields, name: b.field)
        line(g: inout g, s: "V l_" ++ b.binder ++ " = VP(" ++ v ++ ")[" ++ int_to_str(fi + 1) ++ "];")
        if (fi >= 0) and (fi < len(variants[vi].fields)) then
          if is_heap(variants[vi].fields[fi].rty.ty) then
            line(g: inout g, s: "vdup(l_" ++ b.binder ++ ");")
            set kept = push(list: kept, item: "l_" ++ b.binder)
          end if
        end if
      end for
    end if
  else
  end match
  line(g: inout g, s: "vdrop(" ++ v ++ ");")
  let owned = g.owned_vars
  if len(owned) > 0 then
    set g = g with (owned_vars: slice(of: owned, from: 0, to: len(owned) - 1))
  end if
  for k in kept do
    declare_owned(g: inout g, c: k)
  end for
  gen_block(g: inout g, stmts: good.body)
  return true
end fn gen_try

fn gen_match(g: inout Gen, scrut: Expr, cases: List<Case>, els: Option<List<Stmt>>) do
  if gen_try(g: inout g, scrut: scrut, cases: cases, els: els) then
    return
  end if
  let st = type_of(info: g.info, e: scrut)
  enter_scope(inout g)
  let sv = gen_top(g: inout g, e: scrut)
  var v = sv.c
  if is_heap(st) and not ((not sv.owned) and stays(g: g, e: scrut)) then
    // The match owns its scrutinee, so binders stay valid even if the arm reassigns
    // the variable it came from. (A value that stays is only borrowed.)
    let owned_scrut = take(g: inout g, v: sv, heap: true)
    set v = bind(g: inout g, rhs: owned_scrut)
    declare_owned(g: inout g, c: v)
  end if
  flush(inout g)
  var variants: List<VariantInfo> = []
  var is_enum = false
  match variants_of(info: g.info, t: st)
  case Some(value: vs) then
    set variants = vs
    set is_enum = true
  case None then
  end match
  var tag = v
  if is_enum then
    set tag = bind(g: inout g, rhs: "VP(" ++ v ++ ")[0]")
  end if
  // The cases are a sequence, as the arms of an if are (see gen_if): one that matches
  // runs its body and jumps past the rest.
  let done = "done_" ++ fresh_tmp(inout g)
  for cs in cases do
    var cond = ""
    match cs.pat
    case PInt(value: n) then
      set cond = "VI(" ++ tag ++ ") == " ++ c_int(n)
    case PStr(value: s) then
      let l = str_lit(g: inout g, s: s)
      set cond = "vstr_eq(" ++ tag ++ ", " ++ l ++ ")"
    case PVariant(name: name, binds: binds) then
      set cond = tag ++ " == " ++ int_to_str(find_variant(vs: variants, name: name))
    end match
    line(g: inout g, s: "if (" ++ cond ++ ") {")
    indent(inout g)
    match cs.pat
    case PVariant(name: name, binds: binds) then
      let vi = find_variant(vs: variants, name: name)
      if vi >= 0 then
        let fields = variants[vi].fields
        for b in binds do
          let fi = find_field(fields: fields, name: b.field)
          line(g: inout g, s: "V l_" ++ b.binder ++ " = VP(" ++ v ++ ")[" ++ int_to_str(fi + 1) ++ "];")
        end for
      end if
    else
    end match
    gen_scoped(g: inout g, stmts: cs.body)
    line(g: inout g, s: "goto " ++ done ++ ";")
    dedent(inout g)
    line(g: inout g, s: "}")
  end for
  match els
  case Some(value: b) then
    line(g: inout g, s: "{")
    braced(g: inout g, stmts: b)
    line(g: inout g, s: "}")
  case None then
    if len(cases) > 0 then
      line(g: inout g, s: "vow_panic(\"unreachable: corrupt enum tag\");")
    end if
  end match
  line(g: inout g, s: done ++ ": ;")
  leave_scope(inout g)
end fn gen_match

// ---- expressions ----

fn elem_heap(t: Ty) -> Bool do
  match t
  case TList(elem: e) then
    return is_heap(e)
  else
    return false
  end match
end fn elem_heap

// Runtime flags for a map type: 1 heap keys, 2 heap values, 4 string keys.
fn map_flags(t: Ty) -> String do
  var k = Ty.TUnknown
  var v = Ty.TUnknown
  match t
  case TMap(key: kk, val: vv) then
    set k = kk
    set v = vv
  case THashMap(key: kk, val: vv) then
    set k = kk
    set v = vv
  else
    return "0"
  end match
  var f = 0
  if ty_show(k) == "String" then
    set f = 5
  end if
  if is_heap(v) then
    set f = f + 2
  end if
  return int_to_str(f)
end fn map_flags

// The runtime function prefix for a map type: ordered trees or hash tables.
fn map_ops(t: Ty) -> String do
  match t
  case THashMap(key: k, val: v) then
    return "vhm"
  else
    return "vmap"
  end match
end fn map_ops

fn flag(b: Bool) -> String do
  if b then
    return "1"
  end if
  return "0"
end fn flag

// C for a new object of the given number of words, word i + offset holding field i.
// Up to 63 words, the header's mask says which words are heap values (bit i for word
// i; the compiler's Int has 63 bits to give). A wider object points at a bitmap
// instead, one 64-bit mask for each 64 words.
fn new_fields(g: inout Gen, fields: List<FieldInfo>, offset: Int where it >= 0, words: Int) -> String do
  if words <= 63 then
    var mask = 0
    var bit = 1
    for i in 0..offset do
      if bit < 4611686018427387904 then
        set bit = bit * 2
      end if
    end for
    for f in fields do
      if is_heap(f.rty.ty) then
        set mask = mask + bit
      end if
      if bit < 4611686018427387904 then
        set bit = bit * 2
      end if
    end for
    return "vow_fields(" ++ int_to_str(words) ++ ", UINT64_C(" ++ int_to_str(mask) ++ "))"
  end if
  var bits: List<Bool> = []
  for i in 0..offset do
    set bits = push(list: bits, item: false)
  end for
  for f in fields do
    set bits = push(list: bits, item: is_heap(f.rty.ty))
  end for
  var masks: List<String> = []
  var from = 0
  while from < words invariant from >= 0 do
    set masks = push(list: masks, item: bitmap_word(bits: bits, from: from))
    set from = from + 64
  end while
  let text = join(parts: masks, sep: ", ")
  var at = -1
  for i in 0..len(g.wide) do
    if g.wide[i] == text then
      set at = i
    end if
  end for
  if at < 0 then
    set at = len(g.wide)
    set g = g with (wide: push(list: g.wide, item: text))
  end if
  return "vow_fields_wide(" ++ int_to_str(words) ++ ", vow_wide_" ++ int_to_str(at) ++ ")"
end fn new_fields

// Bits from .. from + 63 as a C constant, bit from + k at 2^k.
fn bitmap_word(bits: List<Bool>, from: Int) -> String do
  var digits: List<String> = []
  for k in 0..16 do
    let low = from + ((15 - k) * 4)
    var d = 0
    if bit_at(bits: bits, i: low) then
      set d = d + 1
    end if
    if bit_at(bits: bits, i: low + 1) then
      set d = d + 2
    end if
    if bit_at(bits: bits, i: low + 2) then
      set d = d + 4
    end if
    if bit_at(bits: bits, i: low + 3) then
      set d = d + 8
    end if
    set digits = push(list: digits, item: hex_digit(d))
  end for
  return "UINT64_C(0x" ++ join(parts: digits, sep: "") ++ ")"
end fn bitmap_word

fn bit_at(bits: List<Bool>, i: Int) -> Bool do
  if (i >= 0) and (i < len(bits)) then
    return bits[i]
  end if
  return false
end fn bit_at

fn gen_expr(g: inout Gen, e: Expr) -> Val do
  match e.kind
  case IntLit(value: n) then
    return plain_val("(V)" ++ c_int(n))
  case FloatLit(text: t) then
    return plain_val("DV(" ++ t ++ ")")
  case StrLit(value: s) then
    return plain_val(str_lit(g: inout g, s: s))
  case BoolLit(value: b) then
    if b then
      return plain_val("1")
    end if
    return plain_val("0")
  case Var(name: n) then
    match lookup(map: g.spec_binds, key: n)
    case Some(value: c) then
      return plain_val(c)
    case None then
    end match
    if e.id == g.move_id then
      // `set` moves the variable's old value into the operation consuming it.
      set g = g with (moved: true)
      return Val(c: cvar(g: g, n: n), owned: true)
    end if
    if heap_of(g: g, e: e) and contains_str(xs: g.inout_vars, x: n) then
      // The statement passes this variable inout, which may replace it: keep our own
      // reference so nothing borrowed from it can dangle.
      return owned_tmp(g: inout g, rhs: "vdup(" ++ cvar(g: g, n: n) ++ ")", heap: true)
    end if
    // Copied so that a later inout argument in the same call cannot change it.
    return plain_val(bind(g: inout g, rhs: cvar(g: g, n: n)))
  case It then
    if len(g.it_c) > 0 then
      return plain_val(g.it_c)
    end if
    return plain_val("0 /* spec-only */")
  case Result then
    if len(g.result_c) > 0 then
      return plain_val(g.result_c)
    end if
    return plain_val("0 /* spec-only */")
  case Hole(name: n) then
    return plain_val("0 /* spec-only */")
  case Call(callee: callee, args: args) then
    return gen_call(g: inout g, e: e, args: args)
  case ListLit(items: items) then
    let eh = elem_heap(type_of(info: g.info, e: e))
    let acc = owned_tmp(g: inout g, rhs: "vlist_empty(" ++ flag(eh) ++ ")", heap: true)
    for x in items do
      let v = gen_expr(g: inout g, e: x)
      let c = take(g: inout g, v: v, heap: eh)
      line(g: inout g, s: acc.c ++ " = vlist_push(" ++ acc.c ++ ", " ++ c ++ ");")
    end for
    return acc
  case EmptyMap then
    return plain_val("vmap_empty()")
  case Index(obj: o, idx: i) then
    let ov = gen_expr(g: inout g, e: o)
    let iv = gen_expr(g: inout g, e: i)
    match type_of(info: g.info, e: o)
    case TStr then
      return plain_val(bind(g: inout g, rhs: "vstr_byte(" ++ ov.c ++ ", " ++ iv.c ++ ")"))
    else
      return plain_val(bind(g: inout g, rhs: "vlist_get(" ++ ov.c ++ ", " ++ iv.c ++ ")"))
    end match
  case Field(obj: o, name: f) then
    match call_info(info: g.info, e: e)
    case Some(value: ci) then
      if ci.kind == "variant" then
        // A variant written without its fields has none, or only Unit ones (zero).
        var k = 0
        match variants_of(info: g.info, t: type_of(info: g.info, e: e))
        case Some(value: vs) then
          if (ci.variant >= 0) and (ci.variant < len(vs)) then
            set k = len(vs[ci.variant].fields)
          end if
        case None then
        end match
        if k == 0 then
          return owned_tmp(g: inout g, rhs: "vow_variant0(" ++ int_to_str(ci.variant) ++ ")", heap: true)
        end if
        let unit_only: List<FieldInfo> = []
        let made = new_fields(g: inout g, fields: unit_only, offset: 1, words: k + 1)
        let r = owned_tmp(g: inout g, rhs: made, heap: true)
        line(g: inout g, s: "VP(" ++ r.c ++ ")[0] = " ++ int_to_str(ci.variant) ++ ";")
        return r
      end if
    case None then
    end match
    var sn = ""
    match type_of(info: g.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fi = find_field(fields: struct_fields(info: g.info, name: sn), name: f)
    if int_list_contains(xs: g.steal_ids, x: e.id) then
      match o.kind
      case Var(name: n) then
        // Moved out of the variable for an update that writes it back (see steal_candidates).
        return owned_tmp(g: inout g, rhs: "vow_steal(" ++ cvar(g: g, n: n) ++ ", " ++ int_to_str(fi) ++ ")", heap: true)
      else
      end match
    end if
    let ov = gen_expr(g: inout g, e: o)
    return plain_val(bind(g: inout g, rhs: "VP(" ++ ov.c ++ ")[" ++ int_to_str(fi) ++ "]"))
  case With(obj: o, args: args) then
    // An element that `set xs = set_at(list: xs, at: i, value: xs[i] with (...))`
    // moves out of xs (see steal_candidates): taken once the new fields are computed,
    // which may read it.
    let stolen = int_list_contains(xs: g.steal_ids, x: o.id) and is_index(o)
    var ov = plain_val("0")
    if not stolen then
      set ov = gen_expr(g: inout g, e: o)
    end if
    var sn = ""
    match type_of(info: g.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fields = struct_fields(info: g.info, name: sn)
    var vals: List<Val> = []
    for a in args do
      let v = gen_expr(g: inout g, e: a.value)
      set vals = push(list: vals, item: v)
    end for
    var base = ""
    if stolen then
      set base = gen_stolen(g: inout g, e: o)
    else
      set base = take(g: inout g, v: ov, heap: true)
    end if
    var cs: List<String> = []
    for i in 0..len(args) do
      if i < len(vals) then
        let fi = find_field(fields: fields, name: args[i].name)
        var fh = false
        if (fi >= 0) and (fi < len(fields)) then
          set fh = is_heap(fields[fi].rty.ty)
        end if
        let c = take(g: inout g, v: vals[i], heap: fh)
        set cs = push(list: cs, item: c)
      end if
    end for
    let r = owned_tmp(g: inout g, rhs: "vow_with(" ++ base ++ ")", heap: true)
    for i in 0..len(args) do
      if i < len(cs) then
        let fi = find_field(fields: fields, name: args[i].name)
        if (fi >= 0) and (fi < len(fields)) and is_heap(fields[fi].rty.ty) then
          line(g: inout g, s: "vdrop(VP(" ++ r.c ++ ")[" ++ int_to_str(fi) ++ "]);")
        end if
        line(g: inout g, s: "VP(" ++ r.c ++ ")[" ++ int_to_str(fi) ++ "] = " ++ cs[i] ++ ";")
      end if
    end for
    if g.contracts then
      gen_field_checks(g: inout g, r: r.c, fields: fields, offset: 0, tname: sn)
    end if
    return r
  case Unary(op: op, x: x) then
    if g.exact and is_int_arith(g: g, e: e) then
      return gen_narrow(g: inout g, e: e)
    end if
    let v = gen_expr(g: inout g, e: x)
    if op == "-" then
      if ty_show(type_of(info: g.info, e: x)) == "Float" then
        return plain_val(bind(g: inout g, rhs: "vfneg(" ++ v.c ++ ")"))
      end if
      return plain_val(bind(g: inout g, rhs: "vneg(" ++ v.c ++ ")"))
    end if
    return plain_val(bind(g: inout g, rhs: "(V)!" ++ v.c))
  case Binary(op: op, l: l, r: r) then
    if g.exact and is_int_arith(g: g, e: e) then
      return gen_narrow(g: inout g, e: e)
    end if
    if exact_compare(g: g, op: op, l: l, r: r) then
      let wl = gen_wide(g: inout g, e: l)
      let wr = gen_wide(g: inout g, e: r)
      return plain_val(bind(g: inout g, rhs: "(V)(" ++ wl ++ " " ++ op ++ " " ++ wr ++ ")"))
    end if
    return gen_binary(g: inout g, op: op, l: l, r: r)
  case Quant(q: q, name: v, lo: lo, hi: hi, body: body) then
    let a = gen_expr(g: inout g, e: lo)
    let b = gen_expr(g: inout g, e: hi)
    let is_forall = q == "forall"
    var init = "0"
    if is_forall then
      set init = "1"
    end if
    let t = bind(g: inout g, rhs: init)
    // A C name of its own: in a contract check, names the quantifier shares with the
    // refined variable, a field or a caller's variable are bound too, and must not
    // capture it.
    let lv = "q_" ++ fresh_tmp(inout g) ++ "_" ++ v
    line(g: inout g, s: "for (V " ++ lv ++ " = " ++ a.c ++ "; VI(" ++ lv ++ ") < VI(" ++ b.c ++ "); " ++ lv ++ " = (V)(VI(" ++ lv ++ ") + 1)) {")
    indent(inout g)
    push_frame(inout g)
    let saved_binds = g.spec_binds
    set g = g with (spec_binds: insert(map: g.spec_binds, key: v, value: lv))
    let bv = gen_expr(g: inout g, e: body)
    set g = g with (spec_binds: saved_binds)
    pop_frame(inout g)
    if is_forall then
      line(g: inout g, s: "if (!" ++ bv.c ++ ") { " ++ t ++ " = 0; break; }")
    else
      line(g: inout g, s: "if (" ++ bv.c ++ ") { " ++ t ++ " = 1; break; }")
    end if
    dedent(inout g)
    line(g: inout g, s: "}")
    return plain_val(t)
  end match
end fn gen_expr

fn gen_binary(g: inout Gen, op: String, l: Expr, r: Expr) -> Val do
  if (op == "and") or (op == "or") or (op == "implies") then
    let a = gen_expr(g: inout g, e: l)
    var init = a.c
    if op == "implies" then
      set init = "1"
    end if
    let t = bind(g: inout g, rhs: init)
    var guard = a.c
    if op == "or" then
      set guard = "!" ++ t
    end if
    line(g: inout g, s: "if (" ++ guard ++ ") {")
    indent(inout g)
    push_frame(inout g)
    let b = gen_expr(g: inout g, e: r)
    line(g: inout g, s: t ++ " = " ++ b.c ++ ";")
    pop_frame(inout g)
    dedent(inout g)
    line(g: inout g, s: "}")
    return plain_val(t)
  end if
  let is_str = ty_show(type_of(info: g.info, e: l)) == "String"
  if is_str and (op == "++") then
    return gen_str_cat(g: inout g, l: l, r: r)
  end if
  let a = gen_expr(g: inout g, e: l)
  let b = gen_expr(g: inout g, e: r)
  if ty_show(type_of(info: g.info, e: l)) == "Float" then
    match op
    case "+" then
      return plain_val(bind(g: inout g, rhs: "vfadd(" ++ a.c ++ ", " ++ b.c ++ ")"))
    case "-" then
      return plain_val(bind(g: inout g, rhs: "vfsub(" ++ a.c ++ ", " ++ b.c ++ ")"))
    case "*" then
      return plain_val(bind(g: inout g, rhs: "vfmul(" ++ a.c ++ ", " ++ b.c ++ ")"))
    case "/" then
      return plain_val(bind(g: inout g, rhs: "vfdiv(" ++ a.c ++ ", " ++ b.c ++ ")"))
    case "==" then
      return plain_val(bind(g: inout g, rhs: "(V)(VD(" ++ a.c ++ ") == VD(" ++ b.c ++ "))"))
    case "!=" then
      return plain_val(bind(g: inout g, rhs: "(V)(VD(" ++ a.c ++ ") != VD(" ++ b.c ++ "))"))
    else
      return plain_val(bind(g: inout g, rhs: "(V)(VD(" ++ a.c ++ ") " ++ op ++ " VD(" ++ b.c ++ "))"))
    end match
  end if
  if is_str and contains_str(xs: ["<", "<=", ">", ">="], x: op) then
    return plain_val(bind(g: inout g, rhs: "(V)(vstr_cmp(" ++ a.c ++ ", " ++ b.c ++ ") " ++ op ++ " 0)"))
  end if
  match op
  case "++" then
    let ac = take(g: inout g, v: a, heap: true)
    return owned_tmp(g: inout g, rhs: "vlist_cat(" ++ ac ++ ", " ++ b.c ++ ")", heap: true)
  case "+" then
    return plain_val(bind(g: inout g, rhs: "vadd(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "-" then
    return plain_val(bind(g: inout g, rhs: "vsub(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "*" then
    return plain_val(bind(g: inout g, rhs: "vmul(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "/" then
    return plain_val(bind(g: inout g, rhs: "vdiv(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "%" then
    return plain_val(bind(g: inout g, rhs: "vmod(" ++ a.c ++ ", " ++ b.c ++ ")"))
  case "==" then
    let t = type_of(info: g.info, e: l)
    let cmp = c_eq(g: inout g, t: t, a: a.c, b: b.c)
    return plain_val(bind(g: inout g, rhs: "(V)" ++ cmp))
  case "!=" then
    let t = type_of(info: g.info, e: l)
    let cmp = c_eq(g: inout g, t: t, a: a.c, b: b.c)
    return plain_val(bind(g: inout g, rhs: "(V)!" ++ cmp))
  else
    return plain_val(bind(g: inout g, rhs: "(V)(VI(" ++ a.c ++ ") " ++ op ++ " VI(" ++ b.c ++ "))"))
  end match
end fn gen_binary

// ---- structural equality ----

fn eq_c_name(t: Ty) -> String do
  return "veq_" ++ mangle(ty_show(t))
end fn eq_c_name

fn eq_step_name(t: Ty) -> String do
  return "veqs_" ++ mangle(ty_show(t))
end fn eq_step_name

// Notes that the program compares values of type t with its equality functions.
fn need_eq(g: inout Gen, t: Ty) do
  let name = eq_c_name(t)
  var known = false
  for x in g.eqs do
    if eq_c_name(x) == name then
      set known = true
    end if
  end for
  if not known then
    set g = g with (eqs: push(list: g.eqs, item: t))
  end if
end fn need_eq

// A C expression comparing a and b, values of type t (both borrowed).
fn c_eq(g: inout Gen, t: Ty, a: String, b: String) -> String do
  if ty_show(t) == "String" then
    return "vstr_eq(" ++ a ++ ", " ++ b ++ ")"
  end if
  if ty_show(t) == "Float" then
    return "(VD(" ++ a ++ ") == VD(" ++ b ++ "))"
  end if
  if simple_eq(t) then
    return "(" ++ a ++ " == " ++ b ++ ")"
  end if
  need_eq(g: inout g, t: t)
  return eq_c_name(t) ++ "(" ++ a ++ ", " ++ b ++ ")"
end fn c_eq

// Whether a value of type t is, or can hold at any depth, a value of the type shown as
// target.
fn type_holds(info: Info, t: Ty, target: String, seen: inout List<String>) -> Bool do
  if ty_show(t) == target then
    return true
  end if
  match t
  case TList(elem: x) then
    return type_holds(info: info, t: x, target: target, seen: inout seen)
  case TOpt(inner: x) then
    return type_holds(info: info, t: x, target: target, seen: inout seen)
  case TStruct(name: n) then
    if contains_str(xs: seen, x: n) then
      return false
    end if
    set seen = push(list: seen, item: n)
    for f in struct_fields(info: info, name: n) do
      if type_holds(info: info, t: f.rty.ty, target: target, seen: inout seen) then
        return true
      end if
    end for
    return false
  case TEnum(name: n) then
    if contains_str(xs: seen, x: n) then
      return false
    end if
    set seen = push(list: seen, item: n)
    match lookup(map: info.enums, key: n)
    case Some(value: vs) then
      for vi in vs do
        for f in vi.fields do
          if type_holds(info: info, t: f.rty.ty, target: target, seen: inout seen) then
            return true
          end if
        end for
      end for
    case None then
    end match
    return false
  else
    return false
  end match
end fn type_holds

// Whether the step function of owner pushes a field of type ft for a later step, where
// it could call that type's step function at once. It must when ft can hold an owner:
// such calls would nest as deep as the value. Any other field's step is called, and
// those calls nest only as deep as the types do.
fn step_pushes(g: Gen, owner: Ty, ft: Ty) -> Bool do
  var seen: List<String> = []
  return type_holds(info: g.info, t: ft, target: ty_show(owner), seen: inout seen)
end fn step_pushes

// C comparing the fields of a and b, values of type owner with field i at word
// i + offset: first those compared on the spot, then the others pushed to be compared
// later, the first of them on top.
fn eq_fields(g: inout Gen, owner: Ty, fields: List<FieldInfo>, offset: Int, pad: String) -> List<String> do
  var out: List<String> = []
  for i in 0..len(fields) do
    let ft = fields[i].rty.ty
    let at = "VP(a)[" ++ int_to_str(i + offset) ++ "]"
    let bt = "VP(b)[" ++ int_to_str(i + offset) ++ "]"
    if simple_eq(ft) then
      set out = push(list: out, item: pad ++ "if (!" ++ c_eq(g: inout g, t: ft, a: at, b: bt) ++ ") return 0;")
    elif not step_pushes(g: g, owner: owner, ft: ft) then
      need_eq(g: inout g, t: ft)
      set out = push(list: out, item: pad ++ "if (!" ++ eq_step_name(ft) ++ "(" ++ at ++ ", " ++ bt ++ ")) return 0;")
    end if
  end for
  for j in 0..len(fields) do
    let i = (len(fields) - 1) - j
    let ft = fields[i].rty.ty
    if (not simple_eq(ft)) and step_pushes(g: g, owner: owner, ft: ft) then
      need_eq(g: inout g, t: ft)
      let w = int_to_str(i + offset)
      set out = push(list: out, item: pad ++ "vow_work_push(" ++ eq_step_name(ft) ++ ", VP(a)[" ++ w ++ "], VP(b)[" ++ w ++ "]);")
    end if
  end for
  return out
end fn eq_fields

// The equality functions for t. The step function compares one pair of values: shared
// values are equal at once; otherwise their parts are compared, or pushed to be
// compared by a later step (vow_work_run) when comparing them here could recurse
// (step_pushes), so that comparing a long chain does not use the C stack. A list's
// step calls its elements' steps: lists nest only as deep as their type.
fn gen_eq_fn(g: inout Gen, t: Ty) -> List<String> do
  var out = ["static int " ++ eq_step_name(t) ++ "(V a, V b) {"]
  // A value is not equal to itself when it holds a NaN, so only values without floats
  // may be equal because they are the same object.
  if not contains_float(info: g.info, t: t) then
    set out = push(list: out, item: "    if (a == b) return 1;")
  end if
  match t
  case TStruct(name: n) then
    set out = out ++ eq_fields(g: inout g, owner: t, fields: struct_fields(info: g.info, name: n), offset: 0, pad: "    ")
  case TList(elem: et) then
    set out = push(list: out, item: "    if (VL(a)->len != VL(b)->len) return 0;")
    set out = push(list: out, item: "    for (int64_t i = 0; i < VL(a)->len; i++) {")
    let at = "VB(VL(a)->buf)->items[i]"
    let bt = "VB(VL(b)->buf)->items[i]"
    if simple_eq(et) then
      set out = push(list: out, item: "        if (!" ++ c_eq(g: inout g, t: et, a: at, b: bt) ++ ") return 0;")
    else
      need_eq(g: inout g, t: et)
      set out = push(list: out, item: "        if (!" ++ eq_step_name(et) ++ "(" ++ at ++ ", " ++ bt ++ ")) return 0;")
    end if
    set out = push(list: out, item: "    }")
  else
    match variants_of(info: g.info, t: t)
    case Some(value: vs) then
      set out = push(list: out, item: "    if (VP(a)[0] != VP(b)[0]) return 0;")
      set out = push(list: out, item: "    switch (VP(a)[0]) {")
      for i in 0..len(vs) do
        let fields = vs[i].fields
        if len(fields) > 0 then
          set out = push(list: out, item: "    case " ++ int_to_str(i) ++ ":")
          set out = out ++ eq_fields(g: inout g, owner: t, fields: fields, offset: 1, pad: "        ")
          set out = push(list: out, item: "        break;")
        end if
      end for
      set out = push(list: out, item: "    }")
    case None then
    end match
  end match
  set out = push(list: out, item: "    return 1;")
  set out = push(list: out, item: "}")
  set out = push(list: out, item: "static V " ++ eq_c_name(t) ++ "(V a, V b) { return vow_work_run(" ++ eq_step_name(t) ++ ", a, b); }")
  set out = push(list: out, item: "")
  return out
end fn gen_eq_fn

fn rank_c_name(t: Ty) -> String do
  return "vrank_" ++ mangle(ty_show(t))
end fn rank_c_name

fn rank_step_name(t: Ty) -> String do
  return "vranks_" ++ mangle(ty_show(t))
end fn rank_step_name

// Whether values of type t have parts, and so a rank of their own.
fn is_ranked(t: Ty) -> Bool do
  match t
  case TList(elem: x) then
    return true
  case TOpt(inner: x) then
    return true
  case TStruct(name: n) then
    return true
  case TEnum(name: n) then
    return true
  else
    return false
  end match
end fn is_ranked

// Notes that the program needs the rank functions for t.
fn need_rank(g: inout Gen, t: Ty) do
  let name = rank_c_name(t)
  var known = false
  for x in g.ranks do
    if rank_c_name(x) == name then
      set known = true
    end if
  end for
  if not known then
    set g = g with (ranks: push(list: g.ranks, item: t))
  end if
end fn need_rank

// A value's rank, for a structural measure: its height, where an enum or option value
// and a list are one more than their highest part, a struct as high as its highest
// field, and anything else 0. Each part has a smaller rank than an enum value or list,
// and no larger than a struct, as the verifier assumes (rank_part).
fn c_rank(g: inout Gen, t: Ty, a: String) -> String do
  if not is_ranked(t) then
    return "0"
  end if
  need_rank(g: inout g, t: t)
  return rank_c_name(t) ++ "(" ++ a ++ ")"
end fn c_rank

// C visiting, at depth d, the fields of a that have a rank (a is a value of type owner
// with field i at word i + offset): called or pushed as for equality.
fn rank_fields(g: inout Gen, owner: Ty, fields: List<FieldInfo>, offset: Int, pad: String) -> List<String> do
  var out: List<String> = []
  for i in 0..len(fields) do
    let ft = fields[i].rty.ty
    if is_ranked(ft) then
      need_rank(g: inout g, t: ft)
      let part = "VP(a)[" ++ int_to_str(i + offset) ++ "]"
      if step_pushes(g: g, owner: owner, ft: ft) then
        set out = push(list: out, item: pad ++ "vow_rank_push(" ++ rank_step_name(ft) ++ ", " ++ part ++ ", d);")
      else
        set out = push(list: out, item: pad ++ rank_step_name(ft) ++ "(" ++ part ++ ", d);")
      end if
    end if
  end for
  return out
end fn rank_fields

// The rank functions for t. A value's height is the greatest depth of anything in it,
// counting enum values, options and lists but not structs, so it is found on the way
// down, without recursion: the step function is given a value and its parent's depth
// d, records its own depth (vow_rank_max) and visits its parts as an equality step
// does (vow_rank_run).
fn gen_rank_fn(g: inout Gen, t: Ty) -> List<String> do
  var out = ["static int " ++ rank_step_name(t) ++ "(V a, V d) {", "    if (vow_rank_skip(a, d)) return 1;"]
  // d counts in twos (see vow_rank_max in the runtime).
  let deeper = ["    d += 2;", "    if ((VI(d) >> 1) > vow_rank_max) vow_rank_max = VI(d) >> 1;"]
  match t
  case TStruct(name: n) then
    let fields = struct_fields(info: g.info, name: n)
    var ranked = 0
    for fl in fields do
      if is_ranked(fl.rty.ty) then
        set ranked = ranked + 1
      end if
    end for
    if ranked > 1 then
      // Any of them may be the largest: a field met from here on is no larger than
      // the struct, and that is all a search can say of it.
      set out = push(list: out, item: "    d |= 1;")
    end if
    set out = out ++ rank_fields(g: inout g, owner: t, fields: fields, offset: 0, pad: "    ")
  case TList(elem: et) then
    set out = out ++ deeper
    if is_ranked(et) then
      need_rank(g: inout g, t: et)
      // A search looks at every element before it enters any: a list may be long.
      let item = "VB(VL(a)->buf)->items[i]"
      let seen = "if (" ++ item ++ " == vow_rank_seek) { vow_rank_found = 1; break; }"
      set out = push(list: out, item: "    if (vow_rank_left >= 0 && !vow_rank_found) for (int64_t i = 0; i < VL(a)->len; i++) " ++ seen)
      set out = push(list: out, item: "    for (int64_t i = 0; i < VL(a)->len && VOW_RANK_GOING; i++) " ++ rank_step_name(et) ++ "(" ++ item ++ ", d);")
    end if
  else
    set out = out ++ deeper
    match variants_of(info: g.info, t: t)
    case Some(value: vs) then
      set out = push(list: out, item: "    switch (VP(a)[0]) {")
      for i in 0..len(vs) do
        let body = rank_fields(g: inout g, owner: t, fields: vs[i].fields, offset: 1, pad: "        ")
        if len(body) > 0 then
          set out = push(list: out, item: "    case " ++ int_to_str(i) ++ ":")
          set out = out ++ body
          set out = push(list: out, item: "        break;")
        end if
      end for
      set out = push(list: out, item: "    }")
    case None then
    end match
  end match
  set out = push(list: out, item: "    return 1;")
  set out = push(list: out, item: "}")
  set out = push(list: out, item: "static int64_t " ++ rank_c_name(t) ++ "(V a) { return vow_rank_run(" ++ rank_step_name(t) ++ ", a); }")
  set out = push(list: out, item: "")
  return out
end fn gen_rank_fn

fn gen_call(g: inout Gen, e: Expr, args: List<Arg>) -> Val do
  var ci = CallInfo(kind: "", name: "", variant: 0, order: [])
  match call_info(info: g.info, e: e)
  case Some(value: x) then
    set ci = x
  case None then
  end match
  if (ci.kind == "builtin") and ((ci.name == "value_or") or (ci.name == "is_some") or (ci.name == "is_none")) then
    match gen_looked_up(g: inout g, e: e, name: ci.name, args: args, order: ci.order)
    case Some(value: made) then
      return made
    case None then
    end match
  end if
  // Evaluate arguments in written order, then pass them in parameter order.
  var vals: List<Val> = []
  for a in args do
    var v = plain_val("0")
    var done = false
    if a.is_inout then
      match a.value.kind
      case Var(name: n) then
        if contains_str(xs: g.io_params, x: n) then
          set v = plain_val("l_" ++ n)
        else
          set v = plain_val("&l_" ++ n)
        end if
        set done = true
      else
      end match
    end if
    if not done then
      set v = gen_expr(g: inout g, e: a.value)
    end if
    set vals = push(list: vals, item: v)
  end for
  var p: List<Val> = []
  var pe: List<Expr> = []
  for i in ci.order do
    if (i >= 0) and (i < len(vals)) and (i < len(args)) then
      set p = push(list: p, item: vals[i])
      set pe = push(list: pe, item: args[i].value)
    end if
  end for
  if ci.kind == "old" then
    // Only in a checked build: the value the inout parameter had on entry.
    if (len(args) > 0) then
      match args[0].value.kind
      case Var(name: n) then
        match lookup(map: g.olds, key: n)
        case Some(value: o) then
          return plain_val(o)
        case None then
        end match
      else
      end match
    end if
  end if
  let rh = heap_of(g: g, e: e)
  if ci.kind == "user" then
    gen_call_measure_check(g: inout g, pos: e.pos, name: ci.name, args: args, order: ci.order, p: p)
    // Parameters are borrowed: the arguments stay owned by this statement.
    var cs: List<String> = []
    for v in p do
      set cs = push(list: cs, item: v.c)
    end for
    return owned_tmp(g: inout g, rhs: c_fn(ci.name) ++ "(" ++ join(parts: cs, sep: ", ") ++ ")", heap: rh)
  end if
  if (ci.kind == "struct") or (ci.kind == "variant") then
    var fields: List<FieldInfo> = []
    var offset = 0
    if ci.kind == "struct" then
      set fields = struct_fields(info: g.info, name: ci.name)
    else
      set offset = 1
      match variants_of(info: g.info, t: type_of(info: g.info, e: e))
      case Some(value: vs) then
        if (ci.variant >= 0) and (ci.variant < len(vs)) then
          set fields = vs[ci.variant].fields
        end if
      case None then
      end match
    end if
    var cs: List<String> = []
    for i in 0..len(p) do
      var fh = false
      if i < len(fields) then
        set fh = is_heap(fields[i].rty.ty)
      end if
      let c = take(g: inout g, v: p[i], heap: fh)
      set cs = push(list: cs, item: c)
    end for
    let made = new_fields(g: inout g, fields: fields, offset: offset, words: len(p) + offset)
    let r = owned_tmp(g: inout g, rhs: made, heap: true)
    if offset == 1 then
      line(g: inout g, s: "VP(" ++ r.c ++ ")[0] = " ++ int_to_str(ci.variant) ++ ";")
    end if
    for i in 0..len(cs) do
      line(g: inout g, s: "VP(" ++ r.c ++ ")[" ++ int_to_str(i + offset) ++ "] = " ++ cs[i] ++ ";")
    end for
    if g.contracts then
      gen_field_checks(g: inout g, r: r.c, fields: fields, offset: offset, tname: ty_show(type_of(info: g.info, e: e)))
    end if
    return r
  end if
  return gen_builtin(g: inout g, e: e, name: ci.name, p: p, pe: pe)
end fn gen_call

// value_or, is_some or is_none of a map's lookup, without making the Option: the value
// is read from the map, or the key looked for, directly. None for any other call.
// The arguments are evaluated in the order they are written, as for any call.
fn gen_looked_up(g: inout Gen, e: Expr, name: String, args: List<Arg>, order: List<Int>) -> Option<Val> do
  if (len(order) == 0) or (order[0] < 0) or (order[0] >= len(args)) then
    return Option.None
  end if
  let oi = order[0]
  var largs: List<Arg> = []
  var lorder: List<Int> = []
  match args[oi].value.kind
  case Call(callee: c, args: inner) then
    match call_info(info: g.info, e: args[oi].value)
    case Some(value: li) then
      if (li.kind != "builtin") or (li.name != "lookup") or (len(li.order) != 2) then
        return Option.None
      end if
      set largs = inner
      set lorder = li.order
    case None then
      return Option.None
    end match
  else
    return Option.None
  end match
  if (lorder[0] < 0) or (lorder[0] >= len(largs)) or (lorder[1] < 0) or (lorder[1] >= len(largs)) then
    return Option.None
  end if
  var lvals: List<Val> = []
  var other = plain_val("0")
  for i in 0..len(args) do
    if i == oi then
      for a in largs do
        let lv = gen_expr(g: inout g, e: a.value)
        set lvals = push(list: lvals, item: lv)
      end for
    else
      set other = gen_expr(g: inout g, e: args[i].value)
    end if
  end for
  if len(lvals) != len(largs) then
    return Option.None
  end if
  let mt = type_of(info: g.info, e: largs[lorder[0]].value)
  let found = map_ops(mt) ++ "_has(" ++ lvals[lorder[0]].c ++ ", " ++ lvals[lorder[1]].c ++ ", " ++ map_flags(mt) ++ ")"
  if name == "is_some" then
    return Option.Some(value: plain_val(bind(g: inout g, rhs: found)))
  end if
  if name == "is_none" then
    return Option.Some(value: plain_val(bind(g: inout g, rhs: "(V)(" ++ found ++ " == 0)")))
  end if
  let rh = heap_of(g: g, e: e)
  let d = take(g: inout g, v: other, heap: rh)
  let got = map_ops(mt) ++ "_get_or(" ++ lvals[lorder[0]].c ++ ", " ++ lvals[lorder[1]].c ++ ", " ++ d ++ ", " ++ map_flags(mt) ++ ")"
  return Option.Some(value: owned_tmp(g: inout g, rhs: got, heap: rh))
end fn gen_looked_up

fn is_index(e: Expr) -> Bool do
  match e.kind
  case Index(obj: o, idx: i) then
    return true
  else
    return false
  end match
end fn is_index

// The element xs[i] moved out of the list xs (vlist_steal_at): a value the caller owns.
fn gen_stolen(g: inout Gen, e: Expr) -> String do
  match e.kind
  case Index(obj: o, idx: i) then
    let lv = gen_expr(g: inout g, e: o)
    let iv = gen_expr(g: inout g, e: i)
    return bind(g: inout g, rhs: "vlist_steal(" ++ lv.c ++ ", " ++ iv.c ++ ")")
  else
    return "0"
  end match
end fn gen_stolen

fn arg_val(p: List<Val>, i: Int) -> Val do
  if (i >= 0) and (i < len(p)) then
    return p[i]
  end if
  return plain_val("0")
end fn arg_val

fn gen_builtin(g: inout Gen, e: Expr, name: String, p: List<Val>, pe: List<Expr>) -> Val do
  let v0 = arg_val(p: p, i: 0)
  let v1 = arg_val(p: p, i: 1)
  let v2 = arg_val(p: p, i: 2)
  var t0 = Ty.TUnknown
  if len(pe) > 0 then
    set t0 = type_of(info: g.info, e: pe[0])
  end if
  let s0 = ty_show(t0)
  let rt = type_of(info: g.info, e: e)
  let rh = is_heap(rt)
  match name
  case "len" then
    if s0 == "String" then
      return plain_val(bind(g: inout g, rhs: "vstr_len(" ++ v0.c ++ ")"))
    elif starts_with(s: s0, p: "Map<") or starts_with(s: s0, p: "HashMap<") then
      return plain_val(bind(g: inout g, rhs: map_ops(t0) ++ "_len(" ++ v0.c ++ ")"))
    end if
    return plain_val(bind(g: inout g, rhs: "vlist_len(" ++ v0.c ++ ")"))
  case "push" then
    let l = take(g: inout g, v: v0, heap: true)
    let x = take(g: inout g, v: v1, heap: elem_heap(t0))
    return owned_tmp(g: inout g, rhs: "vlist_push(" ++ l ++ ", " ++ x ++ ")", heap: true)
  case "set_at" then
    let l = take(g: inout g, v: v0, heap: true)
    let x = take(g: inout g, v: v2, heap: elem_heap(t0))
    return owned_tmp(g: inout g, rhs: "vlist_set_at(" ++ l ++ ", " ++ v1.c ++ ", " ++ x ++ ")", heap: true)
  case "slice" then
    if s0 == "String" then
      return owned_tmp(g: inout g, rhs: "vstr_slice(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ v2.c ++ ")", heap: true)
    end if
    let whole = take(g: inout g, v: v0, heap: true)
    return owned_tmp(g: inout g, rhs: "vlist_cut(" ++ whole ++ ", " ++ v1.c ++ ", " ++ v2.c ++ ")", heap: true)
  case "join" then
    return owned_tmp(g: inout g, rhs: "vjoin(" ++ v0.c ++ ", " ++ v1.c ++ ")", heap: true)
  case "int_to_str" then
    return owned_tmp(g: inout g, rhs: "vint_to_str(" ++ v0.c ++ ")", heap: true)
  case "str_to_int" then
    return owned_tmp(g: inout g, rhs: "vstr_to_int(" ++ v0.c ++ ")", heap: true)
  case "char" then
    return owned_tmp(g: inout g, rhs: "vchar(" ++ v0.c ++ ")", heap: true)
  case "hash" then
    return owned_tmp(g: inout g, rhs: "vhash(" ++ v0.c ++ ")", heap: true)
  case "insert" then
    let f = map_flags(t0)
    var kh = false
    var vh = false
    match t0
    case TMap(key: k, val: v) then
      set kh = is_heap(k)
      set vh = is_heap(v)
    case THashMap(key: k, val: v) then
      set kh = is_heap(k)
      set vh = is_heap(v)
    else
    end match
    let m = take(g: inout g, v: v0, heap: true)
    let k = take(g: inout g, v: v1, heap: kh)
    let x = take(g: inout g, v: v2, heap: vh)
    return owned_tmp(g: inout g, rhs: map_ops(t0) ++ "_insert(" ++ m ++ ", " ++ k ++ ", " ++ x ++ ", " ++ f ++ ")", heap: true)
  case "lookup" then
    return owned_tmp(g: inout g, rhs: map_ops(t0) ++ "_lookup(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ map_flags(t0) ++ ")", heap: true)
  case "has" then
    return plain_val(bind(g: inout g, rhs: map_ops(t0) ++ "_has(" ++ v0.c ++ ", " ++ v1.c ++ ", " ++ map_flags(t0) ++ ")"))
  case "keys" then
    return owned_tmp(g: inout g, rhs: map_ops(t0) ++ "_keys(" ++ v0.c ++ ", " ++ map_flags(t0) ++ ")", heap: true)
  case "panic" then
    line(g: inout g, s: panic_at(g: g, pos: e.pos, msg: "VS(" ++ v0.c ++ ")->data"))
    return plain_val("0")
  case "exit" then
    line(g: inout g, s: "vexit(" ++ v0.c ++ ");")
    return plain_val("0")
  case "print" then
    return plain_val(bind(g: inout g, rhs: "vprint(" ++ v0.c ++ ")"))
  case "eprint" then
    return plain_val(bind(g: inout g, rhs: "veprint(" ++ v0.c ++ ")"))
  case "read_file" then
    return owned_tmp(g: inout g, rhs: "vread_file(" ++ v0.c ++ ")", heap: true)
  case "write_file" then
    return plain_val(bind(g: inout g, rhs: "vwrite_file(" ++ v0.c ++ ", " ++ v1.c ++ ")"))
  case "args" then
    return owned_tmp(g: inout g, rhs: "vargs()", heap: true)
  case "make_dir" then
    return plain_val(bind(g: inout g, rhs: "vmake_dir(" ++ v0.c ++ ")"))
  case "list_dir" then
    return owned_tmp(g: inout g, rhs: "vlist_dir(" ++ v0.c ++ ")", heap: true)
  case "real_path" then
    return owned_tmp(g: inout g, rhs: "vreal_path(" ++ v0.c ++ ")", heap: true)
  case "getenv" then
    return owned_tmp(g: inout g, rhs: "vgetenv(" ++ v0.c ++ ")", heap: true)
  case "read_line" then
    return owned_tmp(g: inout g, rhs: "vread_line()", heap: true)
  case "int_to_float" then
    return plain_val(bind(g: inout g, rhs: "vint_to_float(" ++ v0.c ++ ")"))
  case "float_to_int" then
    return owned_tmp(g: inout g, rhs: "vfloat_to_int(" ++ v0.c ++ ")", heap: true)
  case "float_to_str" then
    return owned_tmp(g: inout g, rhs: "vfloat_to_str(" ++ v0.c ++ ")", heap: true)
  case "float_to_fixed" then
    return owned_tmp(g: inout g, rhs: "vfloat_to_fixed(" ++ v0.c ++ ", " ++ v1.c ++ ")", heap: true)
  case "str_to_float" then
    return owned_tmp(g: inout g, rhs: "vstr_to_float(" ++ v0.c ++ ")", heap: true)
  case "floor" then
    return plain_val(bind(g: inout g, rhs: "vfloor(" ++ v0.c ++ ")"))
  case "ceil" then
    return plain_val(bind(g: inout g, rhs: "vceil(" ++ v0.c ++ ")"))
  case "round" then
    return plain_val(bind(g: inout g, rhs: "vround(" ++ v0.c ++ ")"))
  case "sqrt" then
    return plain_val(bind(g: inout g, rhs: "vsqrt(" ++ v0.c ++ ")"))
  case "abs_float" then
    return plain_val(bind(g: inout g, rhs: "vabs_float(" ++ v0.c ++ ")"))
  case "is_nan" then
    return plain_val(bind(g: inout g, rhs: "vis_nan(" ++ v0.c ++ ")"))
  case "read_bytes" then
    return owned_tmp(g: inout g, rhs: "vread_bytes(" ++ v0.c ++ ")", heap: true)
  case "input_ready" then
    return plain_val(bind(g: inout g, rhs: "vinput_ready(" ++ v0.c ++ ")"))
  case "run" then
    return owned_tmp(g: inout g, rhs: "vrun(" ++ v0.c ++ ", " ++ v1.c ++ ")", heap: true)
  case "run_attached" then
    return plain_val(bind(g: inout g, rhs: "vrun_attached(" ++ v0.c ++ ")"))
  case "is_some" then
    return plain_val(bind(g: inout g, rhs: "(V)(VP(" ++ v0.c ++ ")[0] == 1)"))
  case "is_none" then
    return plain_val(bind(g: inout g, rhs: "(V)(VP(" ++ v0.c ++ ")[0] == 0)"))
  case "value_or" then
    let d = take(g: inout g, v: v1, heap: rh)
    return owned_tmp(g: inout g, rhs: "vvalue_or(" ++ v0.c ++ ", " ++ d ++ ", " ++ flag(rh) ++ ")", heap: rh)
  else
    return plain_val("0")
  end match
end fn gen_builtin
