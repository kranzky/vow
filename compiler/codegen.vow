// C code generation. Every expression is lowered to temporaries in written order,
// because C leaves argument evaluation order unspecified. The output must match the
// bootstrap compiler's byte for byte.

import "check.vow"
import "pretty.vow"

struct Gen
  info: Info,
  files: List<String>,
  out: List<String>,
  ind: Int,
  tmp: Int,
  strs: List<String>,
  str_index: Map<String, Int>,
  io_params: List<String>,
end struct Gen

fn c_string(s: String) -> String do
  var parts: List<String> = ["\""]
  for i in 0..len(s) do
    let b = s[i]
    if b == '"' then
      set parts = push(list: parts, item: "\\\"")
    elif b == '\\' then
      set parts = push(list: parts, item: "\\\\")
    elif b == '?' then
      set parts = push(list: parts, item: "\\?")
    elif (b >= 32) and (b <= 126) then
      set parts = push(list: parts, item: char(b))
    else
      set parts = push(list: parts, item: "\\" ++ octal3(b))
    end if
  end for
  set parts = push(list: parts, item: "\"")
  return join(parts: parts, sep: "")
end fn c_string

fn c_params(f: FnDecl) -> String do
  if len(f.params) == 0 then
    return "void"
  end if
  var ps: List<String> = []
  for p in f.params do
    if p.is_inout then
      set ps = push(list: ps, item: "V * l_" ++ p.name)
    else
      set ps = push(list: ps, item: "V l_" ++ p.name)
    end if
  end for
  return join(parts: ps, sep: ", ")
end fn c_params

fn generate(items: List<Item>, info: Info, files: List<String>, verified: Bool) -> String do
  var g = Gen(info: info, files: files, out: [], ind: 0, tmp: 0, strs: [], str_index: {}, io_params: [])
  var body: List<String> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      set g = g with (out: [], tmp: 0)
      gen_function(g: inout g, f: f)
      set body = body ++ g.out
    else
    end match
  end for
  var c: List<String> = ["// Generated by vowc. Do not edit."]
  if verified then
    set c = push(list: c, item: "#define VOW_VERIFIED 1")
  end if
  set c = push(list: c, item: "#include \"vow_rt.h\"")
  set c = push(list: c, item: "")
  var n = len(g.strs)
  if n < 1 then
    set n = 1
  end if
  set c = push(list: c, item: "static V vow_s[" ++ int_to_str(n) ++ "];")
  for item in items do
    match item
    case FnItem(decl: f) then
      set c = push(list: c, item: "static V f_" ++ f.name ++ "(" ++ c_params(f) ++ ");")
    else
    end match
  end for
  set c = push(list: c, item: "")
  set c = c ++ body
  set c = push(list: c, item: "int main(int argc, char **argv) {")
  set c = push(list: c, item: "    vow_argc = argc;")
  set c = push(list: c, item: "    vow_argv = argv;")
  for i in 0..len(g.strs) do
    let s = g.strs[i]
    set c = push(list: c, item: "    vow_s[" ++ int_to_str(i) ++ "] = vstr_new(" ++ c_string(s) ++ ", " ++ int_to_str(len(s)) ++ ");")
  end for
  set c = push(list: c, item: "    f_main();")
  set c = push(list: c, item: "    fflush(stdout);")
  set c = push(list: c, item: "    return 0;")
  set c = push(list: c, item: "}")
  return join(parts: c, sep: "\n") ++ "\n"
end fn generate

fn line(g: inout Gen, s: String) do
  set g = g with (out: push(list: g.out, item: repeat(s: "    ", n: g.ind) ++ s))
end fn line

fn fresh_tmp(g: inout Gen) -> String do
  set g = g with (tmp: g.tmp + 1)
  return "t" ++ int_to_str(g.tmp)
end fn fresh_tmp

fn bind(g: inout Gen, rhs: String) -> String do
  let t = fresh_tmp(inout g)
  line(g: inout g, s: "V " ++ t ++ " = " ++ rhs ++ ";")
  return t
end fn bind

fn str_lit(g: inout Gen, s: String) -> String do
  match lookup(map: g.str_index, key: s)
  case Some(value: i) then
    return "vow_s[" ++ int_to_str(i) ++ "]"
  case None then
    let i = len(g.strs)
    set g = g with (strs: push(list: g.strs, item: s), str_index: insert(map: g.str_index, key: s, value: i))
    return "vow_s[" ++ int_to_str(i) ++ "]"
  end match
end fn str_lit

fn loc(g: Gen, pos: Pos) -> String do
  var f = "?"
  if (pos.file >= 0) and (pos.file < len(g.files)) then
    set f = g.files[pos.file]
  end if
  return f ++ ":" ++ int_to_str(pos.line)
end fn loc

fn cvar(g: Gen, n: String) -> String do
  if contains_str(xs: g.io_params, x: n) then
    return "(*l_" ++ n ++ ")"
  end if
  return "l_" ++ n
end fn cvar

fn indent(g: inout Gen) do
  set g = g with (ind: g.ind + 1)
end fn indent

fn dedent(g: inout Gen) do
  set g = g with (ind: g.ind - 1)
end fn dedent

fn gen_function(g: inout Gen, f: FnDecl) do
  var io: List<String> = []
  for p in f.params do
    if p.is_inout then
      set io = push(list: io, item: p.name)
    end if
  end for
  set g = g with (io_params: io)
  line(g: inout g, s: "static V f_" ++ f.name ++ "(" ++ c_params(f) ++ ") {")
  indent(inout g)
  gen_block(g: inout g, stmts: f.body)
  line(g: inout g, s: "return 0;")
  dedent(inout g)
  line(g: inout g, s: "}")
  line(g: inout g, s: "")
end fn gen_function

fn gen_block(g: inout Gen, stmts: List<Stmt>) do
  for s in stmts do
    gen_stmt(g: inout g, s: s)
  end for
end fn gen_block

fn braced(g: inout Gen, stmts: List<Stmt>) do
  indent(inout g)
  gen_block(g: inout g, stmts: stmts)
  dedent(inout g)
end fn braced

fn gen_stmt(g: inout Gen, s: Stmt) do
  match s.kind
  case Let(name: name, ty: ty, value: value, mutable: m) then
    let v = gen_expr(g: inout g, e: value)
    line(g: inout g, s: "V l_" ++ name ++ " = " ++ v ++ ";")
  case Set(name: name, value: value) then
    let v = gen_expr(g: inout g, e: value)
    line(g: inout g, s: cvar(g: g, n: name) ++ " = " ++ v ++ ";")
  case Return(value: rv) then
    match rv
    case None then
      line(g: inout g, s: "return 0;")
    case Some(value: e) then
      let v = gen_expr(g: inout g, e: e)
      line(g: inout g, s: "return " ++ v ++ ";")
    end match
  case If(arms: arms, els: els) then
    if len(arms) > 0 then
      gen_if(g: inout g, arms: arms, els: els)
    end if
  case While(cond: cond, invs: invs, body: body) then
    line(g: inout g, s: "for (;;) {")
    indent(inout g)
    let c = gen_expr(g: inout g, e: cond)
    line(g: inout g, s: "if (!" ++ c ++ ") break;")
    gen_block(g: inout g, stmts: body)
    dedent(inout g)
    line(g: inout g, s: "}")
  case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
    let a = gen_expr(g: inout g, e: lo)
    let b = gen_expr(g: inout g, e: hi)
    let lv = "l_" ++ v
    line(g: inout g, s: "for (V " ++ lv ++ " = " ++ a ++ "; VI(" ++ lv ++ ") < VI(" ++ b ++ "); " ++ lv ++ " = (V)(VI(" ++ lv ++ ") + 1)) {")
    braced(g: inout g, stmts: body)
    line(g: inout g, s: "}")
  case ForEach(name: v, list: l, invs: invs, body: body) then
    let lv = gen_expr(g: inout g, e: l)
    let k = fresh_tmp(inout g)
    line(g: inout g, s: "for (int64_t " ++ k ++ " = 0; " ++ k ++ " < VL(" ++ lv ++ ")->len; " ++ k ++ "++) {")
    indent(inout g)
    line(g: inout g, s: "V l_" ++ v ++ " = VL(" ++ lv ++ ")->buf->items[" ++ k ++ "];")
    gen_block(g: inout g, stmts: body)
    dedent(inout g)
    line(g: inout g, s: "}")
  case Match(scrut: scrut, cases: cases, els: els) then
    gen_match(g: inout g, scrut: scrut, cases: cases, els: els)
  case Assert(e: e) then
    line(g: inout g, s: "#ifndef VOW_VERIFIED")
    let c = gen_expr(g: inout g, e: e)
    let msg = "assertion failed at " ++ loc(g: g, pos: s.pos) ++ ": " ++ pretty_expr(e)
    line(g: inout g, s: "if (!" ++ c ++ ") vow_panic(" ++ c_string(msg) ++ ");")
    line(g: inout g, s: "#endif")
  case Check(e: e) then
    let c = gen_expr(g: inout g, e: e)
    let msg = "check failed at " ++ loc(g: g, pos: s.pos) ++ ": " ++ pretty_expr(e)
    line(g: inout g, s: "if (!" ++ c ++ ") vow_panic(" ++ c_string(msg) ++ ");")
  case Break then
    line(g: inout g, s: "break;")
  case Continue then
    line(g: inout g, s: "continue;")
  case ExprStmt(e: e) then
    let v = gen_expr(g: inout g, e: e)
    line(g: inout g, s: "(void)" ++ v ++ ";")
  end match
end fn gen_stmt

fn gen_if(g: inout Gen, arms: List<Arm> where len(it) > 0, els: Option<List<Stmt>>) do
  let a = arms[0]
  let cv = gen_expr(g: inout g, e: a.cond)
  line(g: inout g, s: "if (" ++ cv ++ ") {")
  braced(g: inout g, stmts: a.body)
  if len(arms) > 1 then
    line(g: inout g, s: "} else {")
    indent(inout g)
    gen_if(g: inout g, arms: slice(of: arms, from: 1, to: len(arms)), els: els)
    dedent(inout g)
    line(g: inout g, s: "}")
    return
  end if
  match els
  case Some(value: b) then
    line(g: inout g, s: "} else {")
    braced(g: inout g, stmts: b)
    line(g: inout g, s: "}")
  case None then
    line(g: inout g, s: "}")
  end match
end fn gen_if

fn gen_match(g: inout Gen, scrut: Expr, cases: List<Case>, els: Option<List<Stmt>>) do
  let st = type_of(info: g.info, e: scrut)
  let v = gen_expr(g: inout g, e: scrut)
  var variants: List<VariantInfo> = []
  var is_enum = false
  match variants_of(info: g.info, t: st)
  case Some(value: vs) then
    set variants = vs
    set is_enum = true
  case None then
  end match
  var tag = v
  if is_enum then
    set tag = bind(g: inout g, rhs: "VP(" ++ v ++ ")[0]")
  end if
  var first = true
  for cs in cases do
    var cond = ""
    match cs.pat
    case PInt(value: n) then
      set cond = "VI(" ++ tag ++ ") == INT64_C(" ++ int_to_str(n) ++ ")"
    case PStr(value: s) then
      let l = str_lit(g: inout g, s: s)
      set cond = "vstr_eq(" ++ tag ++ ", " ++ l ++ ")"
    case PVariant(name: name, binds: binds) then
      set cond = tag ++ " == " ++ int_to_str(find_variant(vs: variants, name: name))
    end match
    var kw = "} else if"
    if first then
      set kw = "if"
    end if
    set first = false
    line(g: inout g, s: kw ++ " (" ++ cond ++ ") {")
    indent(inout g)
    match cs.pat
    case PVariant(name: name, binds: binds) then
      let vi = find_variant(vs: variants, name: name)
      if vi >= 0 then
        let fields = variants[vi].fields
        for b in binds do
          let fi = find_field(fields: fields, name: b.field)
          line(g: inout g, s: "V l_" ++ b.binder ++ " = VP(" ++ v ++ ")[" ++ int_to_str(fi + 1) ++ "];")
        end for
      end if
    else
    end match
    gen_block(g: inout g, stmts: cs.body)
    dedent(inout g)
  end for
  match els
  case Some(value: b) then
    if first then
      line(g: inout g, s: "{")
    else
      line(g: inout g, s: "} else {")
    end if
    braced(g: inout g, stmts: b)
    line(g: inout g, s: "}")
  case None then
    if not first then
      line(g: inout g, s: "} else {")
      line(g: inout g, s: "    vow_panic(\"unreachable: corrupt enum tag\");")
      line(g: inout g, s: "}")
    end if
  end match
end fn gen_match

fn is_str_map(g: Gen, e: Expr) -> String do
  match type_of(info: g.info, e: e)
  case TMap(key: k, val: v) then
    if ty_show(k) == "String" then
      return "1"
    end if
    return "0"
  else
    return "0"
  end match
end fn is_str_map

fn gen_expr(g: inout Gen, e: Expr) -> String do
  match e.kind
  case IntLit(value: n) then
    return "(V)INT64_C(" ++ int_to_str(n) ++ ")"
  case StrLit(value: s) then
    return str_lit(g: inout g, s: s)
  case BoolLit(value: b) then
    if b then
      return "1"
    end if
    return "0"
  case Var(name: n) then
    // Copied so that a later inout argument in the same call cannot change it.
    return bind(g: inout g, rhs: cvar(g: g, n: n))
  case It then
    return "0 /* spec-only */"
  case Result then
    return "0 /* spec-only */"
  case Hole(name: n) then
    return "0 /* spec-only */"
  case Call(callee: callee, args: args) then
    return gen_call(g: inout g, e: e, args: args)
  case ListLit(items: items) then
    let acc = bind(g: inout g, rhs: "vlist_empty()")
    for x in items do
      let v = gen_expr(g: inout g, e: x)
      line(g: inout g, s: acc ++ " = vlist_push(" ++ acc ++ ", " ++ v ++ ");")
    end for
    return acc
  case EmptyMap then
    return "vmap_empty()"
  case Index(obj: o, idx: i) then
    let ov = gen_expr(g: inout g, e: o)
    let iv = gen_expr(g: inout g, e: i)
    match type_of(info: g.info, e: o)
    case TStr then
      return bind(g: inout g, rhs: "vstr_byte(" ++ ov ++ ", " ++ iv ++ ")")
    else
      return bind(g: inout g, rhs: "vlist_get(" ++ ov ++ ", " ++ iv ++ ")")
    end match
  case Field(obj: o, name: f) then
    match call_info(info: g.info, e: e)
    case Some(value: ci) then
      if ci.kind == "variant" then
        return bind(g: inout g, rhs: "vow_variant0(" ++ int_to_str(ci.variant) ++ ")")
      end if
    case None then
    end match
    let ov = gen_expr(g: inout g, e: o)
    var sn = ""
    match type_of(info: g.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fi = find_field(fields: struct_fields(info: g.info, name: sn), name: f)
    return bind(g: inout g, rhs: "VP(" ++ ov ++ ")[" ++ int_to_str(fi) ++ "]")
  case With(obj: o, args: args) then
    let ov = gen_expr(g: inout g, e: o)
    var sn = ""
    match type_of(info: g.info, e: o)
    case TStruct(name: n) then
      set sn = n
    else
    end match
    let fields = struct_fields(info: g.info, name: sn)
    var names: List<String> = []
    var vals: List<String> = []
    for a in args do
      let v = gen_expr(g: inout g, e: a.value)
      set names = push(list: names, item: a.name)
      set vals = push(list: vals, item: v)
    end for
    let r = bind(g: inout g, rhs: "vow_copy(" ++ ov ++ ", " ++ int_to_str(len(fields)) ++ ")")
    for i in 0..len(names) do
      if i < len(vals) then
        let fi = find_field(fields: fields, name: names[i])
        line(g: inout g, s: "VP(" ++ r ++ ")[" ++ int_to_str(fi) ++ "] = " ++ vals[i] ++ ";")
      end if
    end for
    return r
  case Unary(op: op, x: x) then
    let v = gen_expr(g: inout g, e: x)
    if op == "-" then
      return bind(g: inout g, rhs: "vneg(" ++ v ++ ")")
    end if
    return bind(g: inout g, rhs: "(V)!" ++ v)
  case Binary(op: op, l: l, r: r) then
    return gen_binary(g: inout g, op: op, l: l, r: r)
  end match
end fn gen_expr

fn gen_binary(g: inout Gen, op: String, l: Expr, r: Expr) -> String do
  if (op == "and") or (op == "or") or (op == "implies") then
    let a = gen_expr(g: inout g, e: l)
    var init = a
    if op == "implies" then
      set init = "1"
    end if
    let t = bind(g: inout g, rhs: init)
    var guard = a
    if op == "or" then
      set guard = "!" ++ t
    end if
    line(g: inout g, s: "if (" ++ guard ++ ") {")
    indent(inout g)
    let b = gen_expr(g: inout g, e: r)
    line(g: inout g, s: t ++ " = " ++ b ++ ";")
    dedent(inout g)
    line(g: inout g, s: "}")
    return t
  end if
  let a = gen_expr(g: inout g, e: l)
  let b = gen_expr(g: inout g, e: r)
  let is_str = ty_show(type_of(info: g.info, e: l)) == "String"
  var rhs = ""
  match op
  case "+" then
    set rhs = "vadd(" ++ a ++ ", " ++ b ++ ")"
  case "-" then
    set rhs = "vsub(" ++ a ++ ", " ++ b ++ ")"
  case "*" then
    set rhs = "vmul(" ++ a ++ ", " ++ b ++ ")"
  case "/" then
    set rhs = "vdiv(" ++ a ++ ", " ++ b ++ ")"
  case "%" then
    set rhs = "vmod(" ++ a ++ ", " ++ b ++ ")"
  case "==" then
    if is_str then
      set rhs = "vstr_eq(" ++ a ++ ", " ++ b ++ ")"
    else
      set rhs = "(V)(" ++ a ++ " == " ++ b ++ ")"
    end if
  case "!=" then
    if is_str then
      set rhs = "(V)!vstr_eq(" ++ a ++ ", " ++ b ++ ")"
    else
      set rhs = "(V)!(V)(" ++ a ++ " == " ++ b ++ ")"
    end if
  case "++" then
    if is_str then
      set rhs = "vstr_cat(" ++ a ++ ", " ++ b ++ ")"
    else
      set rhs = "vlist_cat(" ++ a ++ ", " ++ b ++ ")"
    end if
  else
    set rhs = "(V)(VI(" ++ a ++ ") " ++ op ++ " VI(" ++ b ++ "))"
  end match
  return bind(g: inout g, rhs: rhs)
end fn gen_binary

fn gen_call(g: inout Gen, e: Expr, args: List<Arg>) -> String do
  var ci = CallInfo(kind: "", name: "", variant: 0, order: [])
  match call_info(info: g.info, e: e)
  case Some(value: x) then
    set ci = x
  case None then
  end match
  // Evaluate arguments in written order, then pass them in parameter order.
  var vals: List<String> = []
  for a in args do
    var v = ""
    var done = false
    if a.is_inout then
      match a.value.kind
      case Var(name: n) then
        if contains_str(xs: g.io_params, x: n) then
          set v = "l_" ++ n
        else
          set v = "&l_" ++ n
        end if
        set done = true
      else
      end match
    end if
    if not done then
      set v = gen_expr(g: inout g, e: a.value)
    end if
    set vals = push(list: vals, item: v)
  end for
  var p: List<String> = []
  var pe: List<Expr> = []
  for i in ci.order do
    if (i >= 0) and (i < len(vals)) and (i < len(args)) then
      set p = push(list: p, item: vals[i])
      set pe = push(list: pe, item: args[i].value)
    end if
  end for
  if ci.kind == "user" then
    return bind(g: inout g, rhs: "f_" ++ ci.name ++ "(" ++ join(parts: p, sep: ", ") ++ ")")
  end if
  if ci.kind == "struct" then
    let r = bind(g: inout g, rhs: "vow_new(" ++ int_to_str(len(p)) ++ ")")
    for i in 0..len(p) do
      line(g: inout g, s: "VP(" ++ r ++ ")[" ++ int_to_str(i) ++ "] = " ++ p[i] ++ ";")
    end for
    return r
  end if
  if ci.kind == "variant" then
    let r = bind(g: inout g, rhs: "vow_new(" ++ int_to_str(len(p) + 1) ++ ")")
    line(g: inout g, s: "VP(" ++ r ++ ")[0] = " ++ int_to_str(ci.variant) ++ ";")
    for i in 0..len(p) do
      line(g: inout g, s: "VP(" ++ r ++ ")[" ++ int_to_str(i + 1) ++ "] = " ++ p[i] ++ ";")
    end for
    return r
  end if
  return gen_builtin(g: inout g, name: ci.name, p: p, pe: pe)
end fn gen_call

fn arg_at(p: List<String>, i: Int) -> String do
  if (i >= 0) and (i < len(p)) then
    return p[i]
  end if
  return "0"
end fn arg_at

fn gen_builtin(g: inout Gen, name: String, p: List<String>, pe: List<Expr>) -> String do
  let a0 = arg_at(p: p, i: 0)
  let a1 = arg_at(p: p, i: 1)
  let a2 = arg_at(p: p, i: 2)
  var t0 = Ty.TUnknown
  var sm = "0"
  if len(pe) > 0 then
    set t0 = type_of(info: g.info, e: pe[0])
    set sm = is_str_map(g: g, e: pe[0])
  end if
  let s0 = ty_show(t0)
  var rhs = ""
  match name
  case "len" then
    if s0 == "String" then
      set rhs = "vstr_len(" ++ a0 ++ ")"
    elif starts_with(s: s0, p: "Map<") then
      set rhs = "vmap_len(" ++ a0 ++ ")"
    else
      set rhs = "vlist_len(" ++ a0 ++ ")"
    end if
  case "push" then
    set rhs = "vlist_push(" ++ a0 ++ ", " ++ a1 ++ ")"
  case "slice" then
    if s0 == "String" then
      set rhs = "vstr_slice(" ++ a0 ++ ", " ++ a1 ++ ", " ++ a2 ++ ")"
    else
      set rhs = "vlist_slice(" ++ a0 ++ ", " ++ a1 ++ ", " ++ a2 ++ ")"
    end if
  case "join" then
    set rhs = "vjoin(" ++ a0 ++ ", " ++ a1 ++ ")"
  case "int_to_str" then
    set rhs = "vint_to_str(" ++ a0 ++ ")"
  case "str_to_int" then
    set rhs = "vstr_to_int(" ++ a0 ++ ")"
  case "char" then
    set rhs = "vchar(" ++ a0 ++ ")"
  case "hash" then
    set rhs = "vhash(" ++ a0 ++ ")"
  case "insert" then
    set rhs = "vmap_insert(" ++ a0 ++ ", " ++ a1 ++ ", " ++ a2 ++ ", " ++ sm ++ ")"
  case "lookup" then
    set rhs = "vmap_lookup(" ++ a0 ++ ", " ++ a1 ++ ", " ++ sm ++ ")"
  case "has" then
    set rhs = "vmap_has(" ++ a0 ++ ", " ++ a1 ++ ", " ++ sm ++ ")"
  case "keys" then
    set rhs = "vmap_keys(" ++ a0 ++ ")"
  case "panic" then
    line(g: inout g, s: "vow_panic(VS(" ++ a0 ++ ")->data);")
    return "0"
  case "exit" then
    line(g: inout g, s: "vexit(" ++ a0 ++ ");")
    return "0"
  case "print" then
    set rhs = "vprint(" ++ a0 ++ ")"
  case "eprint" then
    set rhs = "veprint(" ++ a0 ++ ")"
  case "read_file" then
    set rhs = "vread_file(" ++ a0 ++ ")"
  case "write_file" then
    set rhs = "vwrite_file(" ++ a0 ++ ", " ++ a1 ++ ")"
  case "args" then
    set rhs = "vargs()"
  case "getenv" then
    set rhs = "vgetenv(" ++ a0 ++ ")"
  case "run" then
    set rhs = "vrun(" ++ a0 ++ ", " ++ a1 ++ ")"
  else
    set rhs = "0"
  end match
  return bind(g: inout g, rhs: rhs)
end fn gen_builtin
