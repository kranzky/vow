// Content addressing. A function's body hash covers its canonical text. Its
// verification key also covers the contracts of everything it calls and all type
// declarations, which is exactly what its proof depends on.

import "check.vow"
import "pretty.vow"

// Part of every verification cache key. Bump it whenever the SMT the verifier emits
// changes (tests/fingerprint.sh enforces this), so that results proved by an earlier
// verifier, which might have had a soundness bug since fixed, are not reused.
fn verifier_version() -> String do
  return "vow-verifier-4"
end fn verifier_version

fn calls_in_expr(e: Expr, info: Info, out: inout List<String>) do
  match call_info(info: info, e: e)
  case Some(value: ci) then
    if ci.kind == "user" then
      // A call to an instance of a generic function relies on the generic contract.
      match lookup(map: info.origins, key: ci.name)
      case Some(value: g) then
        add_name(out: inout out, n: g)
      case None then
        add_name(out: inout out, n: ci.name)
      end match
    end if
  case None then
  end match
  match e.kind
  case Call(callee: c, args: args) then
    calls_in_expr(e: c, info: info, out: inout out)
    for a in args do
      calls_in_expr(e: a.value, info: info, out: inout out)
    end for
  case With(obj: c, args: args) then
    calls_in_expr(e: c, info: info, out: inout out)
    for a in args do
      calls_in_expr(e: a.value, info: info, out: inout out)
    end for
  case ListLit(items: items) then
    for x in items do
      calls_in_expr(e: x, info: info, out: inout out)
    end for
  case Index(obj: a, idx: b) then
    calls_in_expr(e: a, info: info, out: inout out)
    calls_in_expr(e: b, info: info, out: inout out)
  case Binary(op: op, l: a, r: b) then
    calls_in_expr(e: a, info: info, out: inout out)
    calls_in_expr(e: b, info: info, out: inout out)
  case Field(obj: a, name: n) then
    calls_in_expr(e: a, info: info, out: inout out)
  case Unary(op: op, x: a) then
    calls_in_expr(e: a, info: info, out: inout out)
  case Quant(q: q, name: n, lo: lo, hi: hi, body: b) then
    calls_in_expr(e: lo, info: info, out: inout out)
    calls_in_expr(e: hi, info: info, out: inout out)
    calls_in_expr(e: b, info: info, out: inout out)
  else
  end match
end fn calls_in_expr

fn calls_in_all(es: List<Expr>, info: Info, out: inout List<String>) do
  for e in es do
    calls_in_expr(e: e, info: info, out: inout out)
  end for
end fn calls_in_all

fn calls_in_opt_expr(e: Option<Expr>, info: Info, out: inout List<String>) do
  match e
  case Some(value: x) then
    calls_in_expr(e: x, info: info, out: inout out)
  case None then
  end match
end fn calls_in_opt_expr

fn add_name(out: inout List<String>, n: String) do
  if not contains_str(xs: out, x: n) then
    set out = push(list: out, item: n)
  end if
end fn add_name

fn calls_in_opt(b: Option<List<Stmt>>, info: Info, out: inout List<String>) do
  match b
  case Some(value: s) then
    calls_in_block(stmts: s, info: info, out: inout out)
  case None then
  end match
end fn calls_in_opt

fn calls_in_block(stmts: List<Stmt>, info: Info, out: inout List<String>) do
  for s in stmts do
    match s.kind
    case Let(name: n, ty: t, value: value, mutable: m) then
      calls_in_expr(e: value, info: info, out: inout out)
    case Set(name: n, value: value) then
      calls_in_expr(e: value, info: info, out: inout out)
    case Return(value: v) then
      match v
      case Some(value: e) then
        calls_in_expr(e: e, info: info, out: inout out)
      case None then
      end match
    case Assert(e: e) then
      calls_in_expr(e: e, info: info, out: inout out)
    case Check(e: e) then
      calls_in_expr(e: e, info: info, out: inout out)
    case ExprStmt(e: e) then
      calls_in_expr(e: e, info: info, out: inout out)
    case If(arms: arms, els: els) then
      for a in arms do
        calls_in_expr(e: a.cond, info: info, out: inout out)
        calls_in_block(stmts: a.body, info: info, out: inout out)
      end for
      calls_in_opt(b: els, info: info, out: inout out)
    case While(cond: c, invs: invs, dec: dec, body: body) then
      calls_in_expr(e: c, info: info, out: inout out)
      calls_in_all(es: invs, info: info, out: inout out)
      calls_in_opt_expr(e: dec, info: info, out: inout out)
      calls_in_block(stmts: body, info: info, out: inout out)
    case ForRange(name: v, lo: lo, hi: hi, invs: invs, body: body) then
      calls_in_expr(e: lo, info: info, out: inout out)
      calls_in_expr(e: hi, info: info, out: inout out)
      calls_in_all(es: invs, info: info, out: inout out)
      calls_in_block(stmts: body, info: info, out: inout out)
    case ForEach(name: v, list: l, invs: invs, body: body) then
      calls_in_expr(e: l, info: info, out: inout out)
      calls_in_all(es: invs, info: info, out: inout out)
      calls_in_block(stmts: body, info: info, out: inout out)
    case Match(scrut: sc, cases: cases, els: els) then
      calls_in_expr(e: sc, info: info, out: inout out)
      for cs in cases do
        calls_in_block(stmts: cs.body, info: info, out: inout out)
      end for
      calls_in_opt(b: els, info: info, out: inout out)
    else
    end match
  end for
end fn calls_in_block

fn is_inline(info: Info, name: String) -> Bool do
  match get_fn(info: info, name: name)
  case Some(value: fi) then
    return is_some(fi.inline) or is_some(fi.spec_body)
  case None then
    return false
  end match
end fn is_inline

struct FnHash
  name: String,
  body: String,
  contract: String,
  key: String,
end struct FnHash

fn hash_program(items: List<Item>, info: Info) -> List<FnHash> do
  var types: List<String> = []
  for item in items do
    match item
    case FnItem(decl: f) then
    else
      set types = push(list: types, item: pretty_item(item) ++ "\n")
    end match
  end for
  // Type refinements may call specification functions, whose bodies are part of the
  // logic. All of them are covered here, so a change to one invalidates every proof
  // that could rely on it, however indirectly.
  for item in items do
    match item
    case FnItem(decl: f) then
      if is_inline(info: info, name: f.name) then
        set types = push(list: types, item: pretty_item(item) ++ "\n")
      end if
    else
    end match
  end for
  let types_hash = hash(join(parts: types, sep: ""))
  // An expression function is inlined into specifications, so its body is part of
  // what callers rely on.
  var contracts: Map<String, String> = {}
  for item in items do
    match item
    case FnItem(decl: f) then
      if is_inline(info: info, name: f.name) then
        set contracts = insert(map: contracts, key: f.name, value: hash(pretty_item(item)))
      else
        set contracts = insert(map: contracts, key: f.name, value: hash(fn_contract(f)))
      end if
    else
    end match
  end for
  var out: List<FnHash> = []
  for item in items do
    match item
    case FnItem(decl: f) then
      let body = hash(pretty_item(item))
      // Calls anywhere the proof looks: the body, its specifications and the
      // function's own contract (which may call expression functions).
      var callees: List<String> = []
      calls_in_block(stmts: f.body, info: info, out: inout callees)
      calls_in_all(es: f.pre, info: info, out: inout callees)
      calls_in_all(es: f.post, info: info, out: inout callees)
      for p in f.params do
        calls_in_opt_expr(e: p.ty.refine, info: info, out: inout callees)
      end for
      calls_in_opt_expr(e: f.dec, info: info, out: inout callees)
      // Sorted, like the bootstrap compiler's BTreeSet.
      var sorted: Map<String, String> = {}
      for c in callees do
        match lookup(map: contracts, key: c)
        case Some(value: h) then
          set sorted = insert(map: sorted, key: c, value: h)
        case None then
        end match
      end for
      var material = verifier_version() ++ "\n" ++ body ++ "\n" ++ types_hash ++ "\n"
      for c in keys(sorted) do
        match lookup(map: sorted, key: c)
        case Some(value: h) then
          set material = material ++ c ++ "=" ++ h ++ "\n"
        case None then
        end match
      end for
      var contract = ""
      match lookup(map: contracts, key: f.name)
      case Some(value: h) then
        set contract = h
      case None then
      end match
      set out = push(list: out, item: FnHash(name: f.name, body: body, contract: contract, key: hash(material)))
    else
    end match
  end for
  return out
end fn hash_program
