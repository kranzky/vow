// Prints a Vow function that returns the contents of a file as a string literal.
// Usage: embed <file> <function-name>

fn escape(s: String) -> String do
  var parts: List<String> = []
  for i in 0..len(s) do
    let c = s[i]
    if c == '\n' then
      set parts = push(list: parts, item: "\\n\" ++\n    \"")
    elif c == '\t' then
      set parts = push(list: parts, item: "\\t")
    elif c == '\\' then
      set parts = push(list: parts, item: "\\\\")
    elif c == '"' then
      set parts = push(list: parts, item: "\\\"")
    else
      set parts = push(list: parts, item: char(c))
    end if
  end for
  return join(parts: parts, sep: "")
end fn escape

fn main() uses console, fs, proc do
  let a = args()
  if len(a) < 2 then
    eprint("usage: embed <file> <function-name>\n")
    exit(2)
  end if
  match read_file(a[0])
  case Some(value: text) then
    print("// Generated by tools/embed.vow from " ++ a[0] ++ ". Do not edit.\n\n")
    print("fn " ++ a[1] ++ "() -> String do\n  return \"" ++ escape(text) ++ "\"\nend fn " ++ a[1] ++ "\n")
  case None then
    eprint("cannot read " ++ a[0] ++ "\n")
    exit(1)
  end match
end fn main
