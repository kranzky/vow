// language: 0.4
// Generic functions, structs and enums; Result and try.

struct Pair<A, B>
  first: A,
  second: B,
end struct Pair

enum Tree<T>
  Leaf,
  Node(left: Tree<T>, value: T, right: Tree<T>),
end enum Tree

struct Stack<T>
  items: List<T>,
  limit: Int where (it >= 0) and (len(items) <= it),
end struct Stack

fn first_of<T>(xs: List<T> where len(it) > 0) -> T do
  return xs[0]
end fn first_of

fn reversed<T>(xs: List<T>) -> List<T>
  ensures len(result) == len(xs)
do
  var out: List<T> = []
  var i = len(xs)
  while i > 0 invariant (0 <= i) and (i <= len(xs)) invariant len(out) == (len(xs) - i) decreases i do
    set i = i - 1
    set out = push(list: out, item: xs[i])
  end while
  return out
end fn reversed

fn swap<A, B>(p: Pair<A, B>) -> Pair<B, A> do
  return Pair(first: p.second, second: p.first)
end fn swap

fn size<T>(t: Tree<T>) -> Int
  ensures result >= 0
do
  match t
  case Leaf then
    return 0
  case Node(left: l, value: v, right: r) then
    return (size(l) + 1) + size(r)
  end match
end fn size

fn in_order<T>(t: Tree<T>, out: inout List<T>) do
  match t
  case Leaf then
  case Node(left: l, value: v, right: r) then
    in_order(t: l, out: inout out)
    set out = push(list: out, item: v)
    in_order(t: r, out: inout out)
  end match
end fn in_order

fn insert_int(t: Tree<Int>, x: Int) -> Tree<Int> do
  match t
  case Leaf then
    return Tree.Node(left: Tree.Leaf, value: x, right: Tree.Leaf)
  case Node(left: l, value: v, right: r) then
    if x < v then
      return Tree.Node(left: insert_int(t: l, x: x), value: v, right: r)
    end if
    return Tree.Node(left: l, value: v, right: insert_int(t: r, x: x))
  end match
end fn insert_int

fn push_item<T>(s: Stack<T>, x: T) -> Option<Stack<T>> do
  if len(s.items) >= s.limit then
    return Option.None
  end if
  return Option.Some(value: s with (items: push(list: s.items, item: x)))
end fn push_item

fn lookup_all<K, V>(m: Map<K, V>, ks: List<K>) -> List<Option<V>> do
  var out: List<Option<V>> = []
  for k in ks do
    set out = push(list: out, item: lookup(map: m, key: k))
  end for
  return out
end fn lookup_all

fn parse_digit(c: Int where (0 <= it) and (it < 256)) -> Result<Int, String> do
  if (c >= '0') and (c <= '9') then
    return Result.Ok(value: c - '0')
  end if
  return Result.Err(error: "not a digit: " ++ char(c))
end fn parse_digit

fn parse_number(s: String) -> Result<Int, String> do
  if len(s) == 0 then
    return Result.Err(error: "empty")
  end if
  var n = 0
  for i in 0..len(s) do
    let d = try parse_digit(s[i])
    set n = (n * 10) + d
  end for
  return Result.Ok(value: n)
end fn parse_number

fn sum_pair(a: String, b: String) -> Result<Int, String> do
  let x = try parse_number(a)
  var y = 0
  set y = try parse_number(b)
  return Result.Ok(value: x + y)
end fn sum_pair

fn second_char(s: String) -> Option<Int> do
  let p = try str_to_int(s)
  if p < 10 then
    return Option.None
  end if
  return Option.Some(value: p % 10)
end fn second_char

fn show(r: Result<Int, String>) -> String do
  match r
  case Ok(value: v) then
    return "ok " ++ int_to_str(v)
  case Err(error: e) then
    return "error: " ++ e
  end match
end fn show

fn main() uses console do
  print(int_to_str(first_of([3, 4, 5])) ++ " " ++ first_of(["a", "b"]) ++ "\n")
  print(join(parts: reversed(["x", "y", "z"]), sep: ",") ++ "\n")
  let r = reversed([1, 2, 3])
  print(int_to_str(r[0]) ++ "\n")
  let p = Pair(first: 1, second: "one")
  let q = swap(p)
  print(q.first ++ " " ++ int_to_str(q.second) ++ "\n")
  var t: Tree<Int> = Tree.Leaf
  for x in [5, 2, 8, 1, 9, 3] do
    set t = insert_int(t: t, x: x)
  end for
  var xs: List<Int> = []
  in_order(t: t, out: inout xs)
  print(int_to_str(size(t)) ++ ": ")
  for x in xs do
    print(int_to_str(x) ++ " ")
  end for
  print("\n")
  let words = Tree.Node(left: Tree.Leaf, value: "hi", right: Tree.Leaf)
  print(int_to_str(size(words)) ++ "\n")
  var s = Stack(items: [10], limit: 2)
  match push_item(s: s, x: 20)
  case Some(value: s2) then
    set s = s2
  case None then
  end match
  print(int_to_str(len(s.items)) ++ "\n")
  if is_none(push_item(s: s, x: 30)) then
    print("full\n")
  end if
  var m: Map<String, Int> = {}
  set m = insert(map: m, key: "a", value: 1)
  for o in lookup_all(m: m, ks: ["a", "b"]) do
    print(int_to_str(value_or(opt: o, default: -1)) ++ " ")
  end for
  print("\n")
  print(show(parse_number("123")) ++ "\n")
  print(show(parse_number("12x")) ++ "\n")
  print(show(sum_pair(a: "40", b: "2")) ++ "\n")
  print(show(sum_pair(a: "40", b: "")) ++ "\n")
  print(int_to_str(value_or(opt: second_char("47"), default: -1)) ++ "\n")
  print(int_to_str(value_or(opt: second_char("x"), default: -1)) ++ "\n")
end fn main
