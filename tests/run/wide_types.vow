end fn wide

fn many(tag: String) -> Big do
  return Big.Many(a0: 0, a1: tag ++ "1", a2: 2, a3: tag ++ "3", a4: 4, a5: tag ++ "5", a6: 6, a7: tag ++ "7", a8: 8, a9: tag ++ "9", a10: 10, a11: tag ++ "11", a12: 12, a13: tag ++ "13", a14: 14, a15: tag ++ "15", a16: 16, a17: tag ++ "17", a18: 18, a19: tag ++ "19", a20: 20, a21: tag ++ "21", a22: 22, a23: tag ++ "23", a24: 24, a25: tag ++ "25", a26: 26, a27: tag ++ "27", a28: 28, a29: tag ++ "29", a30: 30, a31: tag ++ "31", a32: 32, a33: tag ++ "33", a34: 34, a35: tag ++ "35", a36: 36, a37: tag ++ "37", a38: 38, a39: tag ++ "39", a40: 40, a41: tag ++ "41", a42: 42, a43: tag ++ "43", a44: 44, a45: tag ++ "45", a46: 46, a47: tag ++ "47", a48: 48, a49: tag ++ "49", a50: 50, a51: tag ++ "51", a52: 52, a53: tag ++ "53", a54: 54, a55: tag ++ "55", a56: 56, a57: tag ++ "57", a58: 58, a59: tag ++ "59", a60: 60, a61: tag ++ "61", a62: 62, a63: tag ++ "63", a64: 64, a65: tag ++ "65", a66: 66, a67: tag ++ "67", a68: 68, a69: tag ++ "69")
end fn many

fn describe(b: Big) -> String do
  match b
  case Few(x: x) then
    return "few " ++ int_to_str(x)
  case Many(a62: p, a63: q, a69: r) then
    return "many " ++ int_to_str(p) ++ " " ++ q ++ " " ++ r
  case Units then
    return "units"
  end match
end fn describe

fn yn(b: Bool) -> String do
  if b then
    return "true"
  end if
  return "false"
end fn yn

fn main() uses console do
  let w = wide("s")
  let changed = w with (f198: "new", f199: 7, f63: "mid")
  print(w.f0 ++ " " ++ w.f63 ++ " " ++ int_to_str(w.f64) ++ " " ++ w.f198 ++ " " ++ int_to_str(w.f199) ++ "\n")
  print(changed.f0 ++ " " ++ changed.f63 ++ " " ++ int_to_str(changed.f64) ++ " " ++ changed.f198 ++ " " ++ int_to_str(changed.f199) ++ "\n")
  var again = wide("s")
  print(yn(w == again) ++ " " ++ yn(w == changed) ++ "\n")
  set again = again with (f195: "last")
  print(again.f195 ++ " " ++ again.f192 ++ "\n")
  let bs = [many("m"), Big.Few(x: 1), Big.Units, many("n")]
  for b in bs do
    print(describe(b) ++ "\n")
  end for
  print(yn(many("m") == bs[0]) ++ " " ++ yn(bs[0] == bs[3]) ++ " " ++ yn(bs[2] == Big.Units) ++ "\n")
end fn main
