end enum Big

fn wide(tag: String) -> Wide do
  return Wide(f0: tag ++ "0", f1: 1, f2: 2, f3: tag ++ "3", f4: 4, f5: 5, f6: tag ++ "6", f7: 7, f8: 8, f9: tag ++ "9", f10: 10, f11: 11, f12: tag ++ "12", f13: 13, f14: 14, f15: tag ++ "15", f16: 16, f17: 17, f18: tag ++ "18", f19: 19, f20: 20, f21: tag ++ "21", f22: 22, f23: 23, f24: tag ++ "24", f25: 25, f26: 26, f27: tag ++ "27", f28: 28, f29: 29, f30: tag ++ "30", f31: 31, f32: 32, f33: tag ++ "33", f34: 34, f35: 35, f36: tag ++ "36", f37: 37, f38: 38, f39: tag ++ "39", f40: 40, f41: 41, f42: tag ++ "42", f43: 43, f44: 44, f45: tag ++ "45", f46: 46, f47: 47, f48: tag ++ "48", f49: 49, f50: 50, f51: tag ++ "51", f52: 52, f53: 53, f54: tag ++ "54", f55: 55, f56: 56, f57: tag ++ "57", f58: 58, f59: 59, f60: tag ++ "60", f61: 61, f62: 62, f63: tag ++ "63", f64: 64, f65: 65, f66: tag ++ "66", f67: 67, f68: 68, f69: tag ++ "69", f70: 70, f71: 71, f72: tag ++ "72", f73: 73, f74: 74, f75: tag ++ "75", f76: 76, f77: 77, f78: tag ++ "78", f79: 79, f80: 80, f81: tag ++ "81", f82: 82, f83: 83, f84: tag ++ "84", f85: 85, f86: 86, f87: tag ++ "87", f88: 88, f89: 89, f90: tag ++ "90", f91: 91, f92: 92, f93: tag ++ "93", f94: 94, f95: 95, f96: tag ++ "96", f97: 97, f98: 98, f99: tag ++ "99", f100: 100, f101: 101, f102: tag ++ "102", f103: 103, f104: 104, f105: tag ++ "105", f106: 106, f107: 107, f108: tag ++ "108", f109: 109, f110: 110, f111: tag ++ "111", f112: 112, f113: 113, f114: tag ++ "114", f115: 115, f116: 116, f117: tag ++ "117", f118: 118, f119: 119, f120: tag ++ "120", f121: 121, f122: 122, f123: tag ++ "123", f124: 124, f125: 125, f126: tag ++ "126", f127: 127, f128: 128, f129: tag ++ "129", f130: 130, f131: 131, f132: tag ++ "132", f133: 133, f134: 134, f135: tag ++ "135", f136: 136, f137: 137, f138: tag ++ "138", f139: 139, f140: 140, f141: tag ++ "141", f142: 142, f143: 143, f144: tag ++ "144", f145: 145, f146: 146, f147: tag ++ "147", f148: 148, f149: 149, f150: tag ++ "150", f151: 151, f152: 152, f153: tag ++ "153", f154: 154, f155: 155, f156: tag ++ "156", f1