enum Big
  Few(x: Int),
  Many(a0: Int, a1: String, a2: Int, a3: String, a4: Int, a5: String, a6: Int, a7: String, a8: Int, a9: String, a10: Int, a11: String, a12: Int, a13: String, a14: Int, a15: String, a16: Int, a17: String, a18: Int, a19: String, a20: Int, a21: String, a22: Int, a23: String, a24: Int, a25: String, a26: Int, a27: String, a28: Int, a29: String, a30: Int, a31: String, a32: Int, a33: String, a34: Int, a35: String, a36: Int, a37: String, a38: Int, a39: String, a40: Int, a41: String, a42: Int, a43: String, a44: Int, a45: String, a46: Int, a47: String, a48: Int, a49: String, a50: Int, a51: String, a52: Int, a53: String, a54: Int, a55: String, a56: Int, a57: String, a58: Int, a59: String, a60: Int, a61: String, a62: Int, a63: String, a64: Int, a65: String, a66: Int, a67: String, a68: Int, a69: String),
