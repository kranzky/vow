// language: 0.9
// a calls b with a larger argument, which is fine while b does not call back.
fn a(n: Int) -> Int uses console
  requires n >= 0
  decreases n
do
  print("a\n")
  return b(n + 1)
end fn a

fn b(n: Int) -> Int uses console
  requires n >= 0
  decreases n
do
  print("b\n")
  return 0
end fn b

fn main() uses console do
  let x = a(0)
end fn main
