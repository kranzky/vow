// error: cannot prove assertion: a == b
// language: 0.4

struct Pair<A, B>
  first: A,
  second: B,
end struct Pair

// Equal second fields say nothing about the first ones.
fn same<T: Eq>(a: Pair<T, Int>, b: Pair<T, Int>) requires a.second == b.second do
  assert a == b
end fn same

fn main() do
  same(a: Pair(first: 1, second: 2), b: Pair(first: 3, second: 2))
end fn main
