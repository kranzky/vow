// error: cannot prove every element of 'xs' satisfies it >= 0
// language: 0.9
// A var passed inout to an unrefined parameter must still satisfy its refinement after
// the call, which here nothing says.
type Nat = Int where it >= 0
fn g(xs: inout List<Int>) do
  set xs = push(list: xs, item: 0 - 1)
end fn g

fn main() do
  var xs: List<Nat> = []
  g(xs: inout xs)
end fn main
