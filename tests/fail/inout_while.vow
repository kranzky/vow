// error: an inout argument cannot be in a 'while' condition, which is evaluated before every iteration
// language: 0.9
// Unsound before: the loop head ignored the change the condition made to x, so the
// assertion was proved and failed.
fn bump(x: inout Int) -> Bool
  ensures x == (old(x) + 1)
do
  set x = x + 1
  return x < 3
end fn bump

fn main() uses console do
  var x = 0
  while bump(x: inout x) do
  end while
  assert x == 1
  print(int_to_str(x) ++ "\n")
end fn main
