// error: cannot prove call to 'kids_total' decreases the measure of 'total': (ks, 0) < (r, 0)
// language: 0.9
// Measures of different lengths are compared on the parts both have. A struct's field
// is no larger than the struct, so the second part must decrease here.

struct Rose
  label: Int,
  kids: List<Rose>,
end struct Rose

fn total(r: Rose) -> Int decreases r, 0 do
  return r.label + kids_total(ks: r.kids, i: 0)
end fn total

fn kids_total(ks: List<Rose>, i: Int where (0 <= it) and (it <= len(ks))) -> Int
  decreases ks, 0, len(ks) - i
do
  if i == len(ks) then
    return 0
  end if
  return total(ks[i]) + kids_total(ks: ks, i: i + 1)
end fn kids_total

fn main() do
  let _ = total(Rose(label: 1, kids: []))
end fn main
