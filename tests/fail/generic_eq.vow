// error: '!=' on Pair<Int, T> needs the bound Eq: declare 'T: Eq' in the function's type parameters
// language: 0.9

struct Pair<A, B>
  first: A,
  second: B,
end struct Pair

// T may hold a map, which '==' does not compare: the error is at the comparison, not
// at a call.
fn differ<T>(a: Pair<Int, T>, b: Pair<Int, T>) -> Bool do
  return a != b
end fn differ

fn main() do
  var m: Map<String, Int> = {}
  let _ = differ(a: Pair(first: 1, second: m), b: Pair(first: 1, second: m))
end fn main
