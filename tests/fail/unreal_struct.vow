// error: cannot prove assertion: x > 0
// language: 0.9
// Unsound before: P(n: x) was described by a global fact, so outside the branch that
// builds it the axioms of f (true only of real P values) proved x > 0.
struct P
  n: Int where it > 0,
end struct P

// Recursive only so that it is axiomatised; the recursive branch never runs.
fn f(p: P) -> Int ensures result > 0 decreases 0 do
  if p.n != p.n then
    return f(p: p)
  end if
  return p.n
end fn f

fn g(x: Int) do
  if x > 0 then
    let p = P(n: x)
    var i = 0
    while i < 1 decreases f(p: p) - i do
      set i = 1
    end while
  end if
  assert x > 0
end fn g

fn main() do
  g(x: 0 - 5)
end fn main
