// error: cannot prove every element of argument 'xs' of 'f' satisfies it >= 0
// language: 0.9
// An argument is checked against the refinement of its parameter's elements.
type Nat = Int where it >= 0
fn f(xs: List<Nat>) -> Int do
  return len(xs)
end fn f

fn main() do
  let ys = [1, 0 - 2]
  let _ = f(xs: ys)
end fn main
