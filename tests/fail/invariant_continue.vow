// error: cannot prove loop invariant holds at 'continue': c == i
// language: 0.9
fn count(xs: List<Int>) -> Int
  ensures result == len(xs)
do
  var c = 0
  for i in 0..len(xs)
    invariant c == i
  do
    if xs[i] == 0 then
      continue
    end if
    set c = c + 1
  end for
  return c
end fn count

fn main() do
  let n = count([1, 0, 2])
end fn main
