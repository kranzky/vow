// error: a lexicographic measure is written without parentheses: 'decreases a, b'
// language: 0.9

fn count(a: Int where it >= 0, b: Int where it >= 0) -> Int decreases (a, b) do
  if b > 0 then
    return count(a: a, b: b - 1)
  elif a > 0 then
    return count(a: a - 1, b: 10)
  end if
  return 0
end fn count

fn main() do
  let _ = count(a: 2, b: 2)
end fn main
