// error: 'pong' is mutually recursive with 'ping', which has a 'decreases' measure; give 'pong' one too
// language: 0.5

fn ping(n: Int where it >= 0) -> Int decreases n do
  if n == 0 then
    return 0
  end if
  return pong(n - 1)
end fn ping

fn pong(n: Int where it >= 0) -> Int do
  return ping(n)
end fn pong

fn main() do
  let _ = ping(3)
end fn main
