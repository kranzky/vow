// Binary search with a full functional specification: on sorted input, a returned
// index holds the target, and -1 means the target is absent. Every index is proved in
// bounds and the loop is proved to terminate, so the compiled code has no bounds
// checks at all.

fn is_sorted(xs: List<Int>) -> Bool do
  return forall i in 0..len(xs): forall j in i..len(xs): xs[i] <= xs[j]
end fn is_sorted

fn search(xs: List<Int>, target: Int) -> Int
  requires is_sorted(xs)
  ensures (-1 <= result) and (result < len(xs))
  ensures (result >= 0) implies (xs[result] == target)
  ensures (result == -1) implies (forall i in 0..len(xs): xs[i] != target)
do
  var lo = 0
  var hi = len(xs)
  while lo < hi
    invariant 0 <= lo
    invariant lo <= hi
    invariant hi <= len(xs)
    invariant forall i in 0..lo: xs[i] < target
    invariant forall i in hi..len(xs): xs[i] > target
    decreases hi - lo
  do
    let mid = lo + ((hi - lo) / 2)
    let x = xs[mid]
    if x == target then
      return mid
    elif x < target then
      set lo = mid + 1
    else
      set hi = mid
    end if
  end while
  return -1
end fn search

fn main() uses console do
  let xs = [1, 3, 5, 7, 9, 11, 13]
  for t in [7, 1, 13, 4] do
    print(int_to_str(t) ++ " -> " ++ int_to_str(search(xs: xs, target: t)) ++ "\n")
  end for
end fn main
