// language: 0.9
// Rose trees: a tree whose nodes have any number of children, walked through a helper
// over the child list. Termination needs a lexicographic measure: a struct's field is
// no larger than the struct, so the step from a node into its child list keeps the
// first part and drops the second; a call back to total is on an element, smaller than
// its list; and the helper's call to itself drops only the third part.

struct Rose
  label: Int,
  kids: List<Rose>,
end struct Rose

fn total(r: Rose) -> Int decreases r, 1 do
  return r.label + kids_total(ks: r.kids, i: 0)
end fn total

fn kids_total(ks: List<Rose>, i: Int where (0 <= it) and (it <= len(ks))) -> Int
  decreases ks, 0, len(ks) - i
do
  if i == len(ks) then
    return 0
  end if
  return total(ks[i]) + kids_total(ks: ks, i: i + 1)
end fn kids_total

// The number of nodes, with the same shape of measure; at least one per node.
fn size(r: Rose) -> Int ensures result >= 1 decreases r, 1 do
  return 1 + kids_size(ks: r.kids, i: 0)
end fn size

fn kids_size(ks: List<Rose>, i: Int where (0 <= it) and (it <= len(ks))) -> Int
  ensures result >= (len(ks) - i)
  decreases ks, 0, len(ks) - i
do
  if i == len(ks) then
    return 0
  end if
  return size(ks[i]) + kids_size(ks: ks, i: i + 1)
end fn kids_size

fn main() uses console do
  let leaf = Rose(label: 3, kids: [])
  let t = Rose(label: 1, kids: [leaf, Rose(label: 2, kids: [leaf, leaf]), leaf])
  print("total " ++ int_to_str(total(t)) ++ ", size " ++ int_to_str(size(t)) ++ "\n")
end fn main
